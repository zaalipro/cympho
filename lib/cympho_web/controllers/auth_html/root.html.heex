<!DOCTYPE html>
<html lang="en" data-mode={Map.get(assigns, :theme, "system")}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta :if={assigns[:noindex]} name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href={~p"/images/favicon.svg"} />
    <title>{@page_title} · Cympho</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href={~p"/assets/app.css"} />
  </head>
  <body class="cy-r3">
    <.r3_sprite />
    <main data-page="auth">
      <div class="auth-card">
        <p class="auth-brand"><span class="tile-co" aria-hidden="true">Cy</span>Cympho</p>
        {@inner_content}
      </div>
    </main>
  </body>
</html>
