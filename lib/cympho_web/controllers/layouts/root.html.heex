<!DOCTYPE html>
<html lang="en" data-mode={Map.get(assigns, :theme, "system")} data-ui-mode="simple">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={Plug.CSRFProtection.get_csrf_token()} />
    <link rel="icon" type="image/svg+xml" href={~p"/images/favicon.svg"} />
    <.live_title suffix=" · Cympho">{Map.get(assigns, :page_title, "Cympho")}</.live_title>
    <script nonce={assigns[:csp_nonce]}>
      (() => {
        try {
          const mode = localStorage.getItem("cympho-ui-mode") === "advanced" ? "advanced" : "simple";
          document.documentElement.dataset.uiMode = mode;
        } catch (_) {
          document.documentElement.dataset.uiMode = "simple";
        }
      })();
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
    <link phx-track-static rel="stylesheet" href={~p"/assets/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/app.js"}>
    </script>
    <script
      src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.6/Sortable.min.js"
      integrity="sha256-bQqDH8GbS66FF5etM5MVfoYa+3hiRZwRImNZsn4sQzc="
      crossorigin="anonymous"
      referrerpolicy="no-referrer"
    >
    </script>
  </head>
  <body class="cy-r3 flex h-[100dvh] min-h-[100svh] flex-col bg-canvas text-text-primary font-sans antialiased overflow-hidden">
    <a href="#main-content" class="skip">Skip to main content</a>
    <.r3_sprite />
    <p id="interface-mode-help" class="sr-only">
      Simple shows guided essentials. Advanced shows full controls and diagnostics.
    </p>
    <span class="sr-only" data-ui-mode-status aria-live="polite" aria-atomic="true"></span>
    <div
      id="toast-container"
      phx-hook="Toast"
      class="safe-area-toast fixed z-[70] flex flex-col gap-2 pointer-events-none"
    >
    </div>
    <% shell? = assigns[:shell] != :bare
    shell_company = assigns[:current_company]

    on_settings? =
      match?({"settings", _}, CymphoWeb.Components.NavRail.current(@conn.request_path)) %>
    <%!-- Phone only (r3.css): company tile, Search, New task, Settings. A deep page draws the same tools in its own header. --%>
    <header :if={shell?} class="topbar" aria-label="Company and quick actions">
      <.company_tile company={shell_company} />
      <span class="tb-sp"></span>
      <.link class="ib" navigate={~p"/search"} aria-label="Search">
        <.r3_icon name="i-search" class="ico" />
      </.link>
      <a class="ib new" href={~p"/issues/new"} data-quick-create-trigger>
        <.r3_icon name="i-plus" class="ico" />New
      </a>
      <a
        class="ib"
        href="/settings"
        aria-label="Settings"
        data-nav-settings
        aria-current={on_settings? && "page"}
      >
        <.r3_icon name="i-settings" class="ico" />
      </a>
    </header>
    <div class="shell" data-shell={!shell? && "bare"}>
      <aside :if={shell?} class="rail" aria-label="Company and navigation">
        <.company_switch
          company={shell_company}
          current_path={@conn.request_path}
          runtime_controls_allowed={assigns[:runtime_controls_allowed] || false}
          dispatcher_on={Cympho.Orchestrator.Dispatcher.enabled?()}
        />
        <form action={~p"/search"} method="get" role="search">
          <.search_capsule label="Search tasks, people and pages" placeholder="Search" kbd="⌘K" />
        </form>
        <a class="btn-new" href={~p"/issues/new"} data-quick-create-trigger>
          <.r3_icon name="i-plus" />New task
        </a>
        <.nav_rail
          current_path={@conn.request_path}
          company_count={length(assigns[:user_companies] || [])}
          inbox_count={assigns[:nav_inbox_count] || 0}
        />
        {if shell_company && assigns[:current_user],
          do:
            live_render(CymphoWeb.TeamRailLive.layout_conn(@conn), CymphoWeb.TeamRailLive,
              id: "team-rail",
              session: %{},
              container: {:div, class: "team-live"}
            )}
        <.user_menu user={assigns[:current_user]} />
      </aside>
      <main id="main-content" class="col mobile-shell-content">
        <div class="page-enter relative z-[1]">
          {@inner_content}
        </div>
      </main>
    </div>

    <% quick_projects = assigns[:nav_projects] || []
    quick_agents = assigns[:nav_agents] || []
    quick_goals = assigns[:nav_goals] || []
    quick_ceo = Enum.find(quick_agents, &(&1.role == :ceo))
    quick_user = assigns[:current_user]
    quick_company = assigns[:current_company]

    quick_swarm_admin? =
      match?(%{id: _}, quick_user) and
        match?(%{id: _}, quick_company) and
        (Cympho.Companies.admin?(quick_user.id, quick_company.id) or
           Cympho.Companies.is_board_member?(quick_user.id, quick_company.id))

    quick_proxy_profiles =
      if quick_swarm_admin? do
        Cympho.Proxies.list_proxy_profiles(quick_company.id)
      else
        []
      end

    quick_default_goal =
      case quick_goals do
        [goal] -> goal
        _ -> nil
      end

    quick_default_project_id =
      cond do
        quick_default_goal && quick_default_goal.project_id -> quick_default_goal.project_id
        Enum.empty?(quick_projects) -> ""
        true -> List.first(quick_projects).id
      end %>
    
<!-- Quick create issue modal (press C). data-ui-complex-page scopes the
     simple/advanced CSS: .ui-advanced-only only hides inside such a container,
     and the modal lives outside every page's own scope. -->
    <div
      id="quick-create-modal"
      data-ui-complex-page
      class="safe-area-dialog hidden fixed inset-0 z-[70] flex items-start justify-center overflow-y-auto bg-black/40 px-4 py-6 sm:py-10"
    >
      <form
        action={~p"/issues/quick-create"}
        method="post"
        class="max-h-[calc(100dvh-3rem-env(safe-area-inset-top,0px)-env(safe-area-inset-bottom,0px))] w-full max-w-3xl overflow-y-auto rounded-2xl border border-hairline bg-surface-2 shadow-dialog"
        id="quick-create-form"
      >
        <input type="hidden" name="_csrf_token" value={Plug.CSRFProtection.get_csrf_token()} />
        <input type="hidden" name="company_id" value={quick_company && quick_company.id} />
        <div class="px-4 pt-3 pb-2 border-b border-hairline flex items-center gap-2">
          <span class="hero-plus-mini text-ink-tertiary w-4 h-4" />
          <span class="text-caption text-ink-muted">New issue</span>
          <span class="ml-auto text-caption text-ink-tertiary">
            Enter to save · Esc to cancel
          </span>
        </div>
        <input
          type="text"
          name="title"
          id="quick-create-title"
          required
          autocomplete="off"
          placeholder="Issue title…"
          class="w-full px-4 py-3 bg-transparent text-body text-ink placeholder:text-ink-tertiary focus:outline-none"
        />
        <div
          data-testid="quick-create-fields"
          data-ui-simple-single-column
          class="grid grid-cols-1 gap-3 border-y border-hairline px-4 py-3 sm:grid-cols-2 lg:grid-cols-4"
        >
          <div>
            <span class="mb-1 block text-[11px] font-590 uppercase tracking-[0.08em] text-ink-tertiary">
              Project
            </span>
            <.select_menu
              id="quick-create-project"
              label="Project"
              name="project_id"
              placeholder="No project"
              options={
                if Enum.empty?(quick_projects),
                  do: [{"No project", ""}],
                  else: Enum.map(quick_projects, &{&1.name, &1.id})
              }
              value={quick_default_project_id}
            />
          </div>

          <div>
            <span class="mb-1 block text-[11px] font-590 uppercase tracking-[0.08em] text-ink-tertiary">
              Goal
            </span>
            <.select_menu
              id="quick-create-goal"
              label="Goal"
              name="goal_id"
              placeholder="No goal"
              options={
                [{"No goal", ""}] ++
                  Enum.map(quick_goals, fn goal ->
                    {"#{String.capitalize(to_string(goal.goal_type))}: #{goal.title}", goal.id}
                  end)
              }
              value={if quick_default_goal, do: quick_default_goal.id, else: ""}
            />
          </div>

          <div>
            <span class="mb-1 block text-[11px] font-590 uppercase tracking-[0.08em] text-ink-tertiary">
              Begin with
            </span>
            <.select_menu
              id="quick-create-work-mode"
              label="Begin with"
              name="work_mode"
              value="standard"
              options={[
                {"Start work", "standard"},
                {"Plan first", "planning"},
                {"Ask me first", "ask"}
              ]}
            />
            <p class="ui-advanced-only mt-1 text-[10px] leading-4 text-text-quaternary">
              Planning and Ask pause side effects until the owner responds.
            </p>
          </div>

          <div class="ui-advanced-only">
            <span class="mb-1 block text-[11px] font-590 uppercase tracking-[0.08em] text-ink-tertiary">
              Assignee
            </span>
            <.select_menu
              id="quick-create-assignee"
              label="Assignee"
              name="assignee_id"
              options={[{"Unassigned", ""} | Enum.map(quick_agents, &{&1.name, &1.id})]}
              value={if quick_ceo, do: quick_ceo.id, else: ""}
            />
          </div>

          <div class="ui-advanced-only">
            <span class="mb-1 block text-[11px] font-590 uppercase tracking-[0.08em] text-ink-tertiary">
              Status
            </span>
            <.select_menu
              id="quick-create-status"
              label="Status"
              name="status"
              value="todo"
              options={[
                {"Backlog", "backlog"},
                {"To Do", "todo"},
                {"In Progress", "in_progress"},
                {"In Review", "in_review"},
                {"Blocked", "blocked"},
                {"Done", "done"},
                {"Cancelled", "cancelled"}
              ]}
            />
          </div>
        </div>
        <div
          :if={quick_swarm_admin?}
          data-testid="quick-create-swarm-controls"
          class="ui-advanced-only border-b border-hairline px-4 py-3"
        >
          <input
            id="quick-create-swarm-enabled"
            type="checkbox"
            name="swarm[enabled]"
            value="true"
            class="peer float-left mt-0.5 h-4 w-4 rounded border-hairline bg-canvas text-brand focus:ring-brand/40"
          />
          <label for="quick-create-swarm-enabled" class="ml-7 block cursor-pointer">
            <span class="min-w-0">
              <span class="block text-[11px] font-590 uppercase tracking-[0.08em] text-ink-muted">
                Swarm mode
              </span>
              <span class="mt-0.5 block text-xs leading-5 text-ink-tertiary">
                Spin up temporary workers to tackle this together, then hand the result back to your CEO.
              </span>
            </span>
          </label>

          <.swarm_configuration
            id="quick-create-swarm-config"
            title="Swarm setup"
            description="Pick how many workers and which models. The rest is automatic."
            compact
            swarm_params={
              %{
                "agent_count" => "3",
                "mix_rows" => default_mix_rows(),
                "proxy_mode" => "none",
                "proxy_profile_ids" => [],
                "proxy_pool" => []
              }
            }
            proxy_profiles={quick_proxy_profiles}
            class="clear-both mt-3 hidden peer-checked:block"
          />
        </div>
        <div class="px-4 py-3 flex items-center justify-end gap-2">
          <button
            type="button"
            data-quick-create-cancel
            class="text-caption text-ink-muted hover:text-ink px-2.5 h-7 rounded-sm"
          >
            Cancel
          </button>
          <button
            type="submit"
            class="text-caption text-on-primary bg-brand hover:bg-accent-hover px-3 h-7 rounded-md font-590"
          >
            Create
          </button>
        </div>
      </form>
    </div>
    
<!-- Command palette -->
    <div
      id="command-palette"
      data-ui-complex-page
      class="hidden fixed inset-0 z-[60] flex items-start justify-center pt-[15vh] bg-black/40 backdrop-blur-sm"
    >
      <div class="dialog-enter bg-surface-2 border border-hairline rounded-2xl shadow-dialog w-full max-w-lg mx-4 overflow-hidden">
        <div class="flex items-center gap-3 px-4 border-b border-border">
          <svg
            class="w-4 h-4 text-text-quaternary shrink-0"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"
            />
          </svg>
          <input
            id="command-input"
            type="text"
            placeholder="Type a command or search..."
            class="flex-1 bg-transparent text-text-primary text-sm py-3.5 placeholder:text-text-quaternary focus:outline-none"
            autocomplete="off"
          />
          <kbd class="kbd shrink-0">ESC</kbd>
        </div>
        <div id="command-results" class="max-h-72 overflow-y-auto p-2">
          <div class="px-2 py-1.5 text-[10px] font-510 text-text-quaternary uppercase tracking-wider">
            Navigation
          </div>
          <a
            href="/"
            class="command-item flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm text-text-secondary hover:bg-surface-hover hover:text-text-primary transition-colors cursor-pointer"
          >
            <.r3_icon name="i-home" />
            <span>Go to Home</span>
            <kbd class="kbd ml-auto">G H</kbd>
          </a>
          <a
            href="/inbox"
            class="command-item flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm text-text-secondary hover:bg-surface-hover hover:text-text-primary transition-colors cursor-pointer"
          >
            <.r3_icon name="i-inbox" />
            <span>Go to Inbox</span>
          </a>
          <a
            href="/issues"
            class="command-item flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm text-text-secondary hover:bg-surface-hover hover:text-text-primary transition-colors cursor-pointer"
          >
            <.r3_icon name="i-tasks" />
            <span>Go to Tasks</span>
            <kbd class="kbd ml-auto">G I</kbd>
          </a>
          <a
            href="/kanban"
            class="command-item flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm text-text-secondary hover:bg-surface-hover hover:text-text-primary transition-colors cursor-pointer"
          >
            <.r3_icon name="i-tasks" />
            <span>Go to Board</span>
            <kbd class="kbd ml-auto">G K</kbd>
          </a>
          <a
            href="/agents"
            class="command-item flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm text-text-secondary hover:bg-surface-hover hover:text-text-primary transition-colors cursor-pointer"
          >
            <.r3_icon name="i-team" />
            <span>Go to Team</span>
            <kbd class="kbd ml-auto">G A</kbd>
          </a>
          <a
            href="/costs"
            class="command-item flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm text-text-secondary hover:bg-surface-hover hover:text-text-primary transition-colors cursor-pointer"
          >
            <.r3_icon name="i-spend" />
            <span>Go to Spending</span>
          </a>
          <a
            href="/settings"
            class="command-item flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm text-text-secondary hover:bg-surface-hover hover:text-text-primary transition-colors cursor-pointer"
          >
            <.r3_icon name="i-settings" />
            <span>Go to Settings</span>
            <kbd class="kbd ml-auto">G S</kbd>
          </a>
          <a
            href="/projects"
            class="command-item flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm text-text-secondary hover:bg-surface-hover hover:text-text-primary transition-colors cursor-pointer"
          >
            <.r3_icon name="i-tasks" />
            <span>Go to Projects</span>
            <kbd class="kbd ml-auto">G P</kbd>
          </a>
          <a
            href="/goals"
            class="command-item ui-advanced-only flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm text-text-secondary hover:bg-surface-hover hover:text-text-primary transition-colors cursor-pointer"
          >
            <.r3_icon name="i-tasks" />
            <span>Go to Goals</span>
            <kbd class="kbd ml-auto">G G</kbd>
          </a>
          <a
            href="/docs"
            class="command-item flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm text-text-secondary hover:bg-surface-hover hover:text-text-primary transition-colors cursor-pointer"
          >
            <.r3_icon name="i-question" />
            <span>Go to Documentation</span>
            <kbd class="kbd ml-auto">G D</kbd>
          </a>
          <div class="px-2 py-1.5 mt-1 text-[10px] font-510 text-text-quaternary uppercase tracking-wider">
            Actions
          </div>
          <a
            href="/issues/new"
            class="command-item flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm text-text-secondary hover:bg-surface-hover hover:text-text-primary transition-colors cursor-pointer"
          >
            <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M12 4v16m8-8H4"
              />
            </svg>
            <span>New task</span>
            <kbd class="kbd ml-auto">C</kbd>
          </a>
        </div>
      </div>
    </div>
    
<!-- Keyboard shortcuts cheatsheet -->
    <div
      id="shortcuts-modal"
      data-ui-complex-page
      class="hidden fixed inset-0 z-[60] flex items-center justify-center bg-black/30"
    >
      <div class="bg-surface-2 border border-hairline rounded-2xl shadow-dialog w-full max-w-md mx-4 overflow-hidden">
        <div class="flex items-center justify-between px-5 py-4 border-b border-border">
          <h2 class="font-serif text-sm font-serif text-text-primary">Keyboard Shortcuts</h2>
          <button
            type="button"
            data-close-shortcuts-btn
            aria-label="Close keyboard shortcuts"
            title="Close keyboard shortcuts"
            class="p-1 rounded-lg text-text-quaternary hover:text-text-primary transition-colors"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M6 18L18 6M6 6l12 12"
              />
            </svg>
          </button>
        </div>
        <div class="p-5 space-y-5 max-h-[60vh] overflow-y-auto">
          <div>
            <h3 class="font-serif text-[10px] font-510 text-text-quaternary uppercase tracking-wider mb-2">
              General
            </h3>
            <div class="space-y-2">
              <div class="flex items-center justify-between text-sm">
                <span class="text-text-secondary">Switch company</span>
                <div class="flex gap-1">
                  <kbd class="kbd">Cmd</kbd><kbd class="kbd">Shift</kbd><kbd class="kbd">K</kbd>
                </div>
              </div>
              <div class="flex items-center justify-between text-sm">
                <span class="text-text-secondary">Show shortcuts</span>
                <kbd class="kbd">?</kbd>
              </div>
              <div class="flex items-center justify-between text-sm">
                <span class="text-text-secondary">Close modal / dialog</span>
                <kbd class="kbd">Esc</kbd>
              </div>
              <div class="flex items-center justify-between text-sm">
                <span class="text-text-secondary">Simple / advanced view</span>
                <kbd class="kbd">U</kbd>
              </div>
              <div class="flex items-center justify-between text-sm">
                <span class="text-text-secondary">Compact / detailed page</span>
                <kbd class="kbd">V</kbd>
              </div>
            </div>
          </div>
          <div>
            <h3 class="font-serif text-[10px] font-510 text-text-quaternary uppercase tracking-wider mb-2">
              Navigation
            </h3>
            <div class="space-y-2">
              <div class="flex items-center justify-between text-sm">
                <span class="text-text-secondary">Go to Home</span>
                <div class="flex gap-1"><kbd class="kbd">G</kbd><kbd class="kbd">H</kbd></div>
              </div>
              <div class="flex items-center justify-between text-sm">
                <span class="text-text-secondary">Go to Tasks</span>
                <div class="flex gap-1"><kbd class="kbd">G</kbd><kbd class="kbd">I</kbd></div>
              </div>
              <div class="flex items-center justify-between text-sm">
                <span class="text-text-secondary">Go to Board</span>
                <div class="flex gap-1"><kbd class="kbd">G</kbd><kbd class="kbd">K</kbd></div>
              </div>
              <div class="flex items-center justify-between text-sm">
                <span class="text-text-secondary">Go to Team</span>
                <div class="flex gap-1"><kbd class="kbd">G</kbd><kbd class="kbd">A</kbd></div>
              </div>
              <div class="flex items-center justify-between text-sm">
                <span class="text-text-secondary">Go to Settings</span>
                <div class="flex gap-1"><kbd class="kbd">G</kbd><kbd class="kbd">S</kbd></div>
              </div>
              <div class="flex items-center justify-between text-sm">
                <span class="text-text-secondary">Go to Projects</span>
                <div class="flex gap-1"><kbd class="kbd">G</kbd><kbd class="kbd">P</kbd></div>
              </div>
              <div class="ui-advanced-only flex items-center justify-between text-sm">
                <span class="text-text-secondary">Go to Goals</span>
                <div class="flex gap-1"><kbd class="kbd">G</kbd><kbd class="kbd">G</kbd></div>
              </div>
              <div class="flex items-center justify-between text-sm">
                <span class="text-text-secondary">Go to Documentation</span>
                <div class="flex gap-1"><kbd class="kbd">G</kbd><kbd class="kbd">D</kbd></div>
              </div>
            </div>
          </div>
          <div>
            <h3 class="font-serif text-[10px] font-510 text-text-quaternary uppercase tracking-wider mb-2">
              Actions
            </h3>
            <div class="space-y-2">
              <div class="flex items-center justify-between text-sm">
                <span class="text-text-secondary">New task</span>
                <div class="flex gap-1"><kbd class="kbd">C</kbd></div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    
<!-- Company switcher -->
    <.company_switcher_static
      companies={assigns[:user_companies] || []}
      current_company_id={if assigns[:current_company], do: @current_company.id, else: nil}
    />
  </body>
</html>
