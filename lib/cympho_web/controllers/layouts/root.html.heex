<!DOCTYPE html>
<html lang="en" data-theme={Map.get(assigns, :theme, "claude")} data-ui-mode="simple">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={Plug.CSRFProtection.get_csrf_token()} />
    <link rel="icon" type="image/svg+xml" href={~p"/images/favicon.svg"} />
    <.live_title suffix=" · Cympho">{Map.get(assigns, :page_title, "Cympho")}</.live_title>
    <script>
      (() => {
        try {
          const mode = localStorage.getItem("cympho-ui-mode") === "advanced" ? "advanced" : "simple";
          document.documentElement.dataset.uiMode = mode;
        } catch (_) {
          document.documentElement.dataset.uiMode = "simple";
        }
      })();
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Source+Serif+4:opsz,wght@8..60,400;8..60,500;8..60,600;8..60,700&family=DM+Sans:wght@400;500;600;700&family=EB+Garamond:ital,wght@0,400;0,500;1,400&family=JetBrains+Mono:wght@400;500;700&family=Saira+Condensed:wght@300;400;600;700&display=swap"
      rel="stylesheet"
    />
    <link phx-track-static rel="stylesheet" href={~p"/assets/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/app.js"}>
    </script>
    <script
      src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.6/Sortable.min.js"
      integrity="sha256-bQqDH8GbS66FF5etM5MVfoYa+3hiRZwRImNZsn4sQzc="
      crossorigin="anonymous"
      referrerpolicy="no-referrer"
    >
    </script>
  </head>
  <body class="h-[100dvh] min-h-[100svh] bg-canvas text-text-primary font-sans antialiased overflow-hidden">
    <a href="#main-content" class="skip-to-content">Skip to main content</a>
    <p id="interface-mode-help" class="sr-only">
      Simple shows guided essentials. Advanced shows full controls and diagnostics.
    </p>
    <span class="sr-only" data-ui-mode-status aria-live="polite" aria-atomic="true"></span>
    <div
      id="toast-container"
      phx-hook="Toast"
      class="safe-area-toast fixed z-[70] flex flex-col gap-2 pointer-events-none"
    >
    </div>
    <div class="flex h-[100dvh] min-h-[100svh] w-full overflow-hidden">
      <!-- Sidebar overlay for mobile -->
      <div
        id="sidebar-overlay"
        aria-hidden="true"
        class="fixed inset-0 bg-black/30 z-40 lg:hidden hidden"
      >
      </div>
      
<!-- Desktop sidebar / Mobile drawer -->
      <aside
        class="w-64 lg:w-[var(--sidebar-w)] shrink-0 bg-surface-1 border-r border-hairline flex flex-col fixed inset-y-0 left-0 z-50 -translate-x-full lg:translate-x-0 transition-transform duration-300 ease-[cubic-bezier(0.32,0.72,0,1)]"
        id="sidebar"
        data-mobile-drawer
      >
        <div id="sidebar-resize-handle" aria-hidden="true"></div>
        <.company_rail
          company={assigns[:current_company]}
          current_path={@conn.request_path}
          runtime_controls_allowed={assigns[:runtime_controls_allowed] || false}
        />
        <.nav_rail
          current_path={@conn.request_path}
          projects={assigns[:nav_projects] || []}
          agents={assigns[:nav_agents] || []}
          inbox_count={assigns[:nav_inbox_count] || 0}
          approval_count={assigns[:nav_approval_count] || 0}
        />
        <!-- Bottom user pill -->
        <div class="border-t border-border px-2 py-2">
          <div
            data-ui-mode-switch
            data-sidebar-ui-mode-switch
            data-sidebar-ui-mode-toggle
            role="group"
            aria-label="Interface mode"
            aria-describedby="interface-mode-help"
            class="mb-1 grid grid-cols-2 gap-1 rounded-xl border border-hairline bg-canvas/60 p-1"
          >
            <button
              type="button"
              data-ui-mode-option="simple"
              data-active="true"
              aria-pressed="true"
              aria-controls="main-content"
              title="Simple view — guided essentials"
              class="ui-mode-option flex h-11 items-center justify-center gap-1.5 rounded-lg px-2 text-[11px] font-510 transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand/40"
            >
              <span
                data-ui-mode-option-icon
                class="hero-squares-2x2-mini h-3.5 w-3.5"
              >
              </span>
              <span>Simple</span>
            </button>
            <button
              type="button"
              data-ui-mode-option="advanced"
              data-active="false"
              aria-pressed="false"
              aria-controls="main-content"
              title="Advanced view — full controls and diagnostics"
              class="ui-mode-option flex h-11 items-center justify-center gap-1.5 rounded-lg px-2 text-[11px] font-510 transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand/40"
            >
              <span
                data-ui-mode-option-icon
                class="hero-adjustments-horizontal-mini h-3.5 w-3.5"
              >
              </span>
              <span>Advanced</span>
            </button>
          </div>
          <.user_menu user={assigns[:current_user]} current_path={@conn.request_path} />
          <button
            type="button"
            id="sidebar-collapse-btn"
            data-sidebar-collapse
            aria-label="Collapse sidebar"
            class="mt-1 hidden h-8 w-full items-center justify-center rounded-lg text-text-quaternary transition-colors hover:bg-surface-hover hover:text-text-secondary lg:flex"
            title="Collapse sidebar"
          >
            <.icon name="hero-chevron-double-left-mini" class="h-3.5 w-3.5" />
            <span class="sr-only">Collapse sidebar</span>
          </button>
        </div>
      </aside>
      <!-- Floating expand button — shown only when the desktop sidebar is collapsed -->
      <button
        type="button"
        id="sidebar-expand-btn"
        data-sidebar-expand
        class="fixed left-3 top-3 z-[55] items-center justify-center rounded-lg border border-hairline bg-surface-1/95 p-2 text-text-secondary shadow-card backdrop-blur transition-colors hover:text-text-primary"
        aria-label="Expand sidebar"
        title="Expand sidebar"
      >
        <.icon name="hero-chevron-double-right-mini" class="h-4 w-4" />
      </button>
      <script>
        (() => {
          const sidebar = document.getElementById("sidebar");
          if (!sidebar) return;

          const mobile = window.matchMedia("(max-width: 1023px)").matches;
          if (mobile && sidebar.classList.contains("-translate-x-full")) {
            sidebar.setAttribute("inert", "");
            sidebar.setAttribute("aria-hidden", "true");
          }

          // ── Resizable / collapsible desktop sidebar ──────────────────────
          const root = document.documentElement;
          const MIN = 200, MAX = 420, DEFAULT = 256;
          const WIDTH_KEY = "cympho:sidebar-width";
          const COLLAPSED_KEY = "cympho:sidebar-collapsed";

          const clamp = (n) => Math.max(MIN, Math.min(MAX, n));

          const savedWidth = parseInt(localStorage.getItem(WIDTH_KEY) || "", 10);
          if (!Number.isNaN(savedWidth)) {
            root.style.setProperty("--sidebar-w", clamp(savedWidth) + "px");
          }
          if (localStorage.getItem(COLLAPSED_KEY) === "true") {
            root.setAttribute("data-sidebar-collapsed", "true");
          }

          const setCollapsed = (val) => {
            if (val) {
              root.setAttribute("data-sidebar-collapsed", "true");
            } else {
              root.removeAttribute("data-sidebar-collapsed");
            }
            localStorage.setItem(COLLAPSED_KEY, val ? "true" : "false");
          };

          document.addEventListener("click", (e) => {
            if (e.target.closest("[data-sidebar-collapse]")) setCollapsed(true);
            else if (e.target.closest("[data-sidebar-expand]")) setCollapsed(false);
          });

          // Drag-to-resize on the right edge of the rail.
          const handle = document.getElementById("sidebar-resize-handle");
          if (handle) {
            const onMove = (e) => {
              const x = e.touches ? e.touches[0].clientX : e.clientX;
              root.style.setProperty("--sidebar-w", clamp(x) + "px");
            };
            const onUp = () => {
              root.removeAttribute("data-sidebar-dragging");
              const w = parseInt(getComputedStyle(root).getPropertyValue("--sidebar-w"), 10);
              if (!Number.isNaN(w)) localStorage.setItem(WIDTH_KEY, String(clamp(w)));
              window.removeEventListener("mousemove", onMove);
              window.removeEventListener("mouseup", onUp);
              window.removeEventListener("touchmove", onMove);
              window.removeEventListener("touchend", onUp);
              document.body.style.userSelect = "";
            };
            const onDown = (e) => {
              e.preventDefault();
              root.setAttribute("data-sidebar-dragging", "true");
              document.body.style.userSelect = "none";
              window.addEventListener("mousemove", onMove);
              window.addEventListener("mouseup", onUp);
              window.addEventListener("touchmove", onMove, {passive: false});
              window.addEventListener("touchend", onUp);
            };
            handle.addEventListener("mousedown", onDown);
            handle.addEventListener("touchstart", onDown, {passive: false});
            // Double-click the handle to reset to the default width.
            handle.addEventListener("dblclick", () => {
              root.style.setProperty("--sidebar-w", DEFAULT + "px");
              localStorage.setItem(WIDTH_KEY, String(DEFAULT));
            });
          }
        })();
      </script>
      
<!-- Mobile top bar -->
      <header class="lg:hidden fixed top-0 left-0 right-0 z-30 h-16 bg-surface-1 border-b border-hairline flex items-center justify-between px-4">
        <button
          type="button"
          data-mobile-menu-btn
          aria-controls="sidebar"
          aria-expanded="false"
          aria-label="Open navigation"
          title="Open navigation"
          class="p-2 -ml-2 rounded-lg text-text-secondary hover:text-text-primary hover:bg-surface-hover transition-colors"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M4 6h16M4 12h16M4 18h16"
            />
          </svg>
        </button>
        <button
          type="button"
          data-company-switcher-btn
          class="flex items-center gap-2 px-2 -mx-2 rounded-lg text-text-secondary hover:text-text-primary hover:bg-surface-hover transition-colors"
        >
          <%= if @current_company do %>
            <%= if @current_company.logo_url do %>
              <img
                src={@current_company.logo_url}
                alt={@current_company.name}
                class="w-5 h-5 rounded object-cover border border-border"
              />
            <% else %>
              <div class="w-5 h-5 rounded bg-brand/10 flex items-center justify-center">
                <span class="text-[10px] font-590 text-brand">C</span>
              </div>
            <% end %>
            <span class="text-sm font-590 text-text-primary truncate max-w-[150px]">
              {@current_company.name}
            </span>
          <% else %>
            <span class="text-sm font-590 text-text-primary">Cympho</span>
          <% end %>
          <svg
            class="w-4 h-4 text-text-quaternary"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M19 9l-7 7-7-7"
            />
          </svg>
        </button>
        <div class="flex items-center gap-1">
          <button
            type="button"
            data-ui-mode-toggle
            data-mobile-ui-mode-toggle
            aria-label="Switch to Advanced view"
            aria-describedby="interface-mode-help"
            aria-controls="main-content"
            title="Simple view active. Switch to Advanced view (U)"
            aria-pressed="false"
            class="ui-mode-toggle flex h-11 w-11 items-center justify-center rounded-lg border border-border bg-surface-2 text-text-secondary transition-colors hover:bg-surface-hover hover:text-text-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand/40"
          >
            <span data-ui-mode-icon class="hero-squares-2x2-mini h-4 w-4"></span>
            <span class="sr-only" data-ui-mode-label>Switch to Advanced view</span>
          </button>
          <.runtime_control_menu
            :if={assigns[:runtime_controls_allowed] && assigns[:current_company]}
            company={assigns[:current_company]}
            current_path={@conn.request_path}
          />
        </div>
      </header>
      
<!-- Main content -->
      <main
        id="main-content"
        class="cympho-ambient mobile-shell-content h-[100dvh] min-h-[100svh] flex-1 min-w-0 overflow-x-hidden overflow-y-auto lg:ml-[var(--sidebar-w)] pt-16 lg:pt-0"
      >
        <div class="page-enter relative z-[1]">
          {@inner_content}
        </div>
      </main>
    </div>
    
<!-- Mobile bottom navigation -->
    <nav
      class="lg:hidden fixed bottom-0 left-0 right-0 z-30 bg-surface-1 border-t border-hairline safe-area-bottom"
      id="mobile-nav"
    >
      <div class="flex items-center justify-around h-14">
        <a
          href="/dashboard"
          class="mobile-nav-item flex flex-col items-center gap-0.5 px-3 py-1.5 text-text-quaternary active:text-brand transition-colors min-w-[48px] min-h-[44px] justify-center"
          data-mobile-nav-path="/dashboard"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"
            />
          </svg>
          <span class="text-[10px] font-510">Home</span>
        </a>
        <a
          href="/kanban"
          class="mobile-nav-item flex flex-col items-center gap-0.5 px-3 py-1.5 text-text-quaternary active:text-brand transition-colors min-w-[48px] min-h-[44px] justify-center"
          data-mobile-nav-path="/kanban"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M9 17V7m0 10a2 2 0 01-2 2H5a2 2 0 01-2-2V7a2 2 0 012-2h2a2 2 0 012 2m0 10a2 2 0 002 2h2a2 2 0 002-2M9 7a2 2 0 012-2h2a2 2 0 012 2m0 10V7m0 10a2 2 0 002 2h2a2 2 0 002-2V7a2 2 0 00-2-2h-2a2 2 0 00-2 2"
            />
          </svg>
          <span class="text-[10px] font-510">Board</span>
        </a>
        <button
          type="button"
          data-quick-create-trigger
          class="mobile-nav-item flex min-h-[44px] min-w-[48px] flex-col items-center justify-center gap-0.5 px-3 py-1.5 text-brand transition-colors"
          aria-label="New issue"
        >
          <span class="flex h-7 w-7 items-center justify-center rounded-full bg-brand text-on-primary shadow-card">
            <span class="hero-plus-mini h-4 w-4"></span>
          </span>
          <span class="text-[10px] font-590">New</span>
        </button>
        <a
          href="/inbox"
          class="mobile-nav-item relative flex flex-col items-center gap-0.5 px-3 py-1.5 text-text-quaternary active:text-brand transition-colors min-w-[48px] min-h-[44px] justify-center"
          data-mobile-nav-path="/inbox"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
            />
          </svg>
          <span class="text-[10px] font-510">Inbox</span>
          <span
            :if={(assigns[:inbox_badge_count] || 0) > 0}
            class="absolute top-1 right-2 min-w-[14px] rounded-full bg-brand px-1 text-[9px] font-590 leading-[14px] text-on-primary text-center"
            data-testid="mobile-nav-badge-inbox"
          >
            {min(assigns[:inbox_badge_count] || 0, 99)}
          </span>
        </a>
        <a
          href="/agents"
          class="mobile-nav-item flex flex-col items-center gap-0.5 px-3 py-1.5 text-text-quaternary active:text-brand transition-colors min-w-[48px] min-h-[44px] justify-center"
          data-mobile-nav-path="/agents"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M12 11c0 3.517-1.009 6.799-2.753 9.571m-3.44-2.04l.054-.09A13.916 13.916 0 008 11a4 4 0 118 0c0 1.017-.07 2.019-.203 3m-2.118 6.844A21.88 21.88 0 0015.171 17m3.839 1.132c.645-2.266.99-4.659.99-7.131A8 8 0 008 3.239c-4.828 4.596-5.212 11.611-.647 16.656A21.866 21.866 0 0012 21.942a21.866 21.866 0 003.99-.385M19.337 17.81a15.79 15.79 0 01-2.326 1.575"
            />
          </svg>
          <span class="text-[10px] font-510">Team</span>
        </a>
      </div>
    </nav>

    <% quick_projects = assigns[:nav_projects] || []
    quick_agents = assigns[:nav_agents] || []
    quick_goals = assigns[:nav_goals] || []
    quick_ceo = Enum.find(quick_agents, &(&1.role == :ceo))
    quick_user = assigns[:current_user]
    quick_company = assigns[:current_company]

    quick_swarm_admin? =
      match?(%{id: _}, quick_user) and
        match?(%{id: _}, quick_company) and
        (Cympho.Companies.admin?(quick_user.id, quick_company.id) or
           Cympho.Companies.is_board_member?(quick_user.id, quick_company.id))

    quick_proxy_profiles =
      if quick_swarm_admin? do
        Cympho.Proxies.list_proxy_profiles(quick_company.id)
      else
        []
      end

    quick_default_goal =
      case quick_goals do
        [goal] -> goal
        _ -> nil
      end

    quick_default_project_id =
      cond do
        quick_default_goal && quick_default_goal.project_id -> quick_default_goal.project_id
        Enum.empty?(quick_projects) -> ""
        true -> List.first(quick_projects).id
      end %>
    
<!-- Quick create issue modal (press C). data-ui-complex-page scopes the
     simple/advanced CSS: .ui-advanced-only only hides inside such a container,
     and the modal lives outside every page's own scope. -->
    <div
      id="quick-create-modal"
      data-ui-complex-page
      class="safe-area-dialog hidden fixed inset-0 z-[70] flex items-start justify-center overflow-y-auto bg-black/40 px-4 py-6 sm:py-10"
    >
      <form
        action={~p"/issues/quick-create"}
        method="post"
        class="max-h-[calc(100dvh-3rem-env(safe-area-inset-top,0px)-env(safe-area-inset-bottom,0px))] w-full max-w-3xl overflow-y-auto rounded-2xl border border-hairline bg-surface-2 shadow-dialog"
        id="quick-create-form"
      >
        <input type="hidden" name="_csrf_token" value={Plug.CSRFProtection.get_csrf_token()} />
        <input type="hidden" name="company_id" value={quick_company && quick_company.id} />
        <div class="px-4 pt-3 pb-2 border-b border-hairline flex items-center gap-2">
          <span class="hero-plus-mini text-ink-tertiary w-4 h-4" />
          <span class="text-caption text-ink-muted">New issue</span>
          <span class="ml-auto text-caption text-ink-tertiary">
            Enter to save · Esc to cancel
          </span>
        </div>
        <input
          type="text"
          name="title"
          id="quick-create-title"
          required
          autocomplete="off"
          placeholder="Issue title…"
          class="w-full px-4 py-3 bg-transparent text-body text-ink placeholder:text-ink-tertiary focus:outline-none"
        />
        <div
          data-testid="quick-create-fields"
          data-ui-simple-single-column
          class="grid grid-cols-1 gap-3 border-y border-hairline px-4 py-3 sm:grid-cols-2 lg:grid-cols-4"
        >
          <div>
            <span class="mb-1 block text-[11px] font-590 uppercase tracking-[0.08em] text-ink-tertiary">
              Project
            </span>
            <.select_menu
              id="quick-create-project"
              label="Project"
              name="project_id"
              placeholder="No project"
              options={
                if Enum.empty?(quick_projects),
                  do: [{"No project", ""}],
                  else: Enum.map(quick_projects, &{&1.name, &1.id})
              }
              value={quick_default_project_id}
            />
          </div>

          <div>
            <span class="mb-1 block text-[11px] font-590 uppercase tracking-[0.08em] text-ink-tertiary">
              Goal
            </span>
            <.select_menu
              id="quick-create-goal"
              label="Goal"
              name="goal_id"
              placeholder="No goal"
              options={
                [{"No goal", ""}] ++
                  Enum.map(quick_goals, fn goal ->
                    {"#{String.capitalize(to_string(goal.goal_type))}: #{goal.title}", goal.id}
                  end)
              }
              value={if quick_default_goal, do: quick_default_goal.id, else: ""}
            />
          </div>

          <div>
            <span class="mb-1 block text-[11px] font-590 uppercase tracking-[0.08em] text-ink-tertiary">
              Begin with
            </span>
            <.select_menu
              id="quick-create-work-mode"
              label="Begin with"
              name="work_mode"
              value="standard"
              options={[
                {"Start work", "standard"},
                {"Plan first", "planning"},
                {"Ask me first", "ask"}
              ]}
            />
            <p class="ui-advanced-only mt-1 text-[10px] leading-4 text-text-quaternary">
              Planning and Ask pause side effects until the owner responds.
            </p>
          </div>

          <div class="ui-advanced-only">
            <span class="mb-1 block text-[11px] font-590 uppercase tracking-[0.08em] text-ink-tertiary">
              Assignee
            </span>
            <.select_menu
              id="quick-create-assignee"
              label="Assignee"
              name="assignee_id"
              options={[{"Unassigned", ""} | Enum.map(quick_agents, &{&1.name, &1.id})]}
              value={if quick_ceo, do: quick_ceo.id, else: ""}
            />
          </div>

          <div class="ui-advanced-only">
            <span class="mb-1 block text-[11px] font-590 uppercase tracking-[0.08em] text-ink-tertiary">
              Status
            </span>
            <.select_menu
              id="quick-create-status"
              label="Status"
              name="status"
              value="todo"
              options={[
                {"Backlog", "backlog"},
                {"To Do", "todo"},
                {"In Progress", "in_progress"},
                {"In Review", "in_review"},
                {"Blocked", "blocked"},
                {"Done", "done"},
                {"Cancelled", "cancelled"}
              ]}
            />
          </div>
        </div>
        <div
          :if={quick_swarm_admin?}
          data-testid="quick-create-swarm-controls"
          class="ui-advanced-only border-b border-hairline px-4 py-3"
        >
          <input
            id="quick-create-swarm-enabled"
            type="checkbox"
            name="swarm[enabled]"
            value="true"
            class="peer float-left mt-0.5 h-4 w-4 rounded border-hairline bg-canvas text-brand focus:ring-brand/40"
          />
          <label for="quick-create-swarm-enabled" class="ml-7 block cursor-pointer">
            <span class="min-w-0">
              <span class="block text-[11px] font-590 uppercase tracking-[0.08em] text-ink-muted">
                Swarm mode
              </span>
              <span class="mt-0.5 block text-xs leading-5 text-ink-tertiary">
                Spin up temporary workers to tackle this together, then hand the result back to your CEO.
              </span>
            </span>
          </label>

          <.swarm_configuration
            id="quick-create-swarm-config"
            title="Swarm setup"
            description="Pick how many workers and which models. The rest is automatic."
            compact
            swarm_params={
              %{
                "agent_count" => "3",
                "mix_rows" => default_mix_rows(),
                "proxy_mode" => "none",
                "proxy_profile_ids" => [],
                "proxy_pool" => []
              }
            }
            proxy_profiles={quick_proxy_profiles}
            class="clear-both mt-3 hidden peer-checked:block"
          />
        </div>
        <div class="px-4 py-3 flex items-center justify-end gap-2">
          <button
            type="button"
            data-quick-create-cancel
            class="text-caption text-ink-muted hover:text-ink px-2.5 h-7 rounded-sm"
          >
            Cancel
          </button>
          <button
            type="submit"
            class="text-caption text-on-primary bg-brand hover:bg-accent-hover px-3 h-7 rounded-md font-590"
          >
            Create
          </button>
        </div>
      </form>
    </div>
    
<!-- Command palette -->
    <div
      id="command-palette"
      data-ui-complex-page
      class="hidden fixed inset-0 z-[60] flex items-start justify-center pt-[15vh] bg-black/40 backdrop-blur-sm"
    >
      <div class="dialog-enter bg-surface-2 border border-hairline rounded-2xl shadow-dialog w-full max-w-lg mx-4 overflow-hidden">
        <div class="flex items-center gap-3 px-4 border-b border-border">
          <svg
            class="w-4 h-4 text-text-quaternary shrink-0"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"
            />
          </svg>
          <input
            id="command-input"
            type="text"
            placeholder="Type a command or search..."
            class="flex-1 bg-transparent text-text-primary text-sm py-3.5 placeholder:text-text-quaternary focus:outline-none"
            autocomplete="off"
          />
          <kbd class="kbd shrink-0">ESC</kbd>
        </div>
        <div id="command-results" class="max-h-72 overflow-y-auto p-2">
          <div class="px-2 py-1.5 text-[10px] font-510 text-text-quaternary uppercase tracking-wider">
            Navigation
          </div>
          <a
            href="/issues"
            class="command-item ui-advanced-only flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm text-text-secondary hover:bg-surface-hover hover:text-text-primary transition-colors cursor-pointer"
          >
            <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"
              />
            </svg>
            <span>Go to Issues</span>
            <kbd class="kbd ml-auto">G I</kbd>
          </a>
          <a
            href="/projects"
            class="command-item flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm text-text-secondary hover:bg-surface-hover hover:text-text-primary transition-colors cursor-pointer"
          >
            <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"
              />
            </svg>
            <span>Go to Projects</span>
            <kbd class="kbd ml-auto">G P</kbd>
          </a>
          <a
            href="/kanban"
            class="command-item flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm text-text-secondary hover:bg-surface-hover hover:text-text-primary transition-colors cursor-pointer"
          >
            <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M9 17V7m0 10a2 2 0 01-2 2H5a2 2 0 01-2-2V7a2 2 0 012-2h2a2 2 0 012 2m0 10a2 2 0 002 2h2a2 2 0 002-2M9 7a2 2 0 012-2h2a2 2 0 012 2m0 10V7m0 10a2 2 0 002 2h2a2 2 0 002-2V7a2 2 0 00-2-2h-2a2 2 0 00-2 2"
              />
            </svg>
            <span>Go to Kanban Board</span>
            <kbd class="kbd ml-auto">G K</kbd>
          </a>
          <a
            href="/agents"
            class="command-item flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm text-text-secondary hover:bg-surface-hover hover:text-text-primary transition-colors cursor-pointer"
          >
            <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M12 11c0 3.517-1.009 6.799-2.753 9.571m-3.44-2.04l.054-.09A13.916 13.916 0 008 11a4 4 0 118 0c0 1.017-.07 2.019-.203 3m-2.118 6.844A21.88 21.88 0 0015.171 17m3.839 1.132c.645-2.266.99-4.659.99-7.131A8 8 0 008 3.239c-4.828 4.596-5.212 11.611-.647 16.656A21.866 21.866 0 0012 21.942a21.866 21.866 0 003.99-.385M19.337 17.81a15.79 15.79 0 01-2.326 1.575"
              />
            </svg>
            <span>Go to Agents</span>
            <kbd class="kbd ml-auto">G A</kbd>
          </a>
          <a
            href="/goals"
            class="command-item ui-advanced-only flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm text-text-secondary hover:bg-surface-hover hover:text-text-primary transition-colors cursor-pointer"
          >
            <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M13 10V3L4 14h7v7l9-11h-7z"
              />
            </svg>
            <span>Go to Goals</span>
            <kbd class="kbd ml-auto">G G</kbd>
          </a>
          <a
            href="/dashboard"
            class="command-item flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm text-text-secondary hover:bg-surface-hover hover:text-text-primary transition-colors cursor-pointer"
          >
            <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"
              />
            </svg>
            <span>Go to Dashboard</span>
            <kbd class="kbd ml-auto">G D</kbd>
          </a>
          <div class="px-2 py-1.5 mt-1 text-[10px] font-510 text-text-quaternary uppercase tracking-wider">
            Actions
          </div>
          <a
            href="/issues/new"
            class="command-item flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm text-text-secondary hover:bg-surface-hover hover:text-text-primary transition-colors cursor-pointer"
          >
            <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M12 4v16m8-8H4"
              />
            </svg>
            <span>Create New Issue</span>
            <kbd class="kbd ml-auto">C</kbd>
          </a>
          <a
            href="/settings/profile"
            class="command-item flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm text-text-secondary hover:bg-surface-hover hover:text-text-primary transition-colors cursor-pointer"
          >
            <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.066 2.573c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.573 1.066c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.066-2.573c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"
              /><path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"
              />
            </svg>
            <span>Settings</span>
            <kbd class="kbd ml-auto">G S</kbd>
          </a>
        </div>
      </div>
    </div>
    
<!-- Keyboard shortcuts cheatsheet -->
    <div
      id="shortcuts-modal"
      data-ui-complex-page
      class="hidden fixed inset-0 z-[60] flex items-center justify-center bg-black/30"
    >
      <div class="bg-surface-2 border border-hairline rounded-2xl shadow-dialog w-full max-w-md mx-4 overflow-hidden">
        <div class="flex items-center justify-between px-5 py-4 border-b border-border">
          <h2 class="font-serif text-sm font-serif text-text-primary">Keyboard Shortcuts</h2>
          <button
            type="button"
            data-close-shortcuts-btn
            aria-label="Close keyboard shortcuts"
            title="Close keyboard shortcuts"
            class="p-1 rounded-lg text-text-quaternary hover:text-text-primary transition-colors"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M6 18L18 6M6 6l12 12"
              />
            </svg>
          </button>
        </div>
        <div class="p-5 space-y-5 max-h-[60vh] overflow-y-auto">
          <div>
            <h3 class="font-serif text-[10px] font-510 text-text-quaternary uppercase tracking-wider mb-2">
              General
            </h3>
            <div class="space-y-2">
              <div class="flex items-center justify-between text-sm">
                <span class="text-text-secondary">Switch company</span>
                <div class="flex gap-1">
                  <kbd class="kbd">Cmd</kbd><kbd class="kbd">Shift</kbd><kbd class="kbd">K</kbd>
                </div>
              </div>
              <div class="flex items-center justify-between text-sm">
                <span class="text-text-secondary">Show shortcuts</span>
                <kbd class="kbd">?</kbd>
              </div>
              <div class="flex items-center justify-between text-sm">
                <span class="text-text-secondary">Close modal / dialog</span>
                <kbd class="kbd">Esc</kbd>
              </div>
              <div class="flex items-center justify-between text-sm">
                <span class="text-text-secondary">Simple / advanced view</span>
                <kbd class="kbd">U</kbd>
              </div>
              <div class="flex items-center justify-between text-sm">
                <span class="text-text-secondary">Compact / detailed page</span>
                <kbd class="kbd">V</kbd>
              </div>
            </div>
          </div>
          <div>
            <h3 class="font-serif text-[10px] font-510 text-text-quaternary uppercase tracking-wider mb-2">
              Navigation
            </h3>
            <div class="space-y-2">
              <div class="ui-advanced-only flex items-center justify-between text-sm">
                <span class="text-text-secondary">Go to Issues</span>
                <div class="flex gap-1"><kbd class="kbd">G</kbd><kbd class="kbd">I</kbd></div>
              </div>
              <div class="flex items-center justify-between text-sm">
                <span class="text-text-secondary">Go to Projects</span>
                <div class="flex gap-1"><kbd class="kbd">G</kbd><kbd class="kbd">P</kbd></div>
              </div>
              <div class="flex items-center justify-between text-sm">
                <span class="text-text-secondary">Go to Kanban</span>
                <div class="flex gap-1"><kbd class="kbd">G</kbd><kbd class="kbd">K</kbd></div>
              </div>
              <div class="flex items-center justify-between text-sm">
                <span class="text-text-secondary">Go to Agents</span>
                <div class="flex gap-1"><kbd class="kbd">G</kbd><kbd class="kbd">A</kbd></div>
              </div>
              <div class="ui-advanced-only flex items-center justify-between text-sm">
                <span class="text-text-secondary">Go to Goals</span>
                <div class="flex gap-1"><kbd class="kbd">G</kbd><kbd class="kbd">G</kbd></div>
              </div>
              <div class="flex items-center justify-between text-sm">
                <span class="text-text-secondary">Go to Dashboard</span>
                <div class="flex gap-1"><kbd class="kbd">G</kbd><kbd class="kbd">D</kbd></div>
              </div>
              <div class="flex items-center justify-between text-sm">
                <span class="text-text-secondary">Go to Settings</span>
                <div class="flex gap-1"><kbd class="kbd">G</kbd><kbd class="kbd">S</kbd></div>
              </div>
            </div>
          </div>
          <div>
            <h3 class="font-serif text-[10px] font-510 text-text-quaternary uppercase tracking-wider mb-2">
              Actions
            </h3>
            <div class="space-y-2">
              <div class="flex items-center justify-between text-sm">
                <span class="text-text-secondary">Create new issue</span>
                <div class="flex gap-1"><kbd class="kbd">C</kbd></div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    
<!-- Company switcher -->
    <.company_switcher_static
      companies={assigns[:user_companies] || []}
      current_company_id={if assigns[:current_company], do: @current_company.id, else: nil}
    />
  </body>
</html>
