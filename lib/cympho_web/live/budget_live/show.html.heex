<%= if @live_action == :edit do %>
  <.page_frame
    page="budget-form"
    kind={:deep}
    parent={{~p"/budgets", "Spending limit"}}
    current="Edit limit"
    data-ui-complex-page
  >
    <:head>
      <section class="head" aria-labelledby="bf-h">
        <h1 class="h1 big" id="bf-h">Edit {@budget.name}</h1>
      </section>
    </:head>

    <.flash_line flash={@flash} />

    <.live_component
      module={CymphoWeb.BudgetLive.FormComponent}
      id={@budget.id}
      action={@live_action}
      budget={@budget}
      current_user_id={@current_user.id}
      current_company_id={@current_company.id}
      patch={~p"/budgets/#{@budget.id}"}
    />
  </.page_frame>
<% else %>
  <% status = budget_status(@budget) %>
  <.page_frame
    page="budget"
    kind={:deep}
    parent={{~p"/budgets", "Spending limit"}}
    current={@budget.name}
    tray_class="split"
    data-ui-complex-page
  >
    <:head>
      <section class="head" aria-labelledby="bd-h">
        <h1 class="h1 big" id="bd-h">{@budget.name}</h1>
        <div class="chips">
          <span :if={status} class={["chip", elem(status, 0) == :waiting && "st-wait"]}>
            <.status_word kind={elem(status, 0)} word={elem(status, 1)} />
          </span>
          <span :if={@budget.status == "cancelled"} class="tag">Cancelled</span>
          <.pill navigate={~p"/budgets/#{@budget}/edit"}><.r3_icon name="i-pencil" />Edit</.pill>
        </div>
      </section>
    </:head>

    <.flash_line flash={@flash} />

    <.next_step
      :if={recovery_card?(@budget, @budget_policy)}
      id="bd-ns-"
      data-testid="budget-recovery-card"
    >
      <:problem>
        <.problem_card title="Spending hit its limit" title_id="bd-ns-t">
          <:eyebrow>
            Next step<span aria-hidden="true"> · </span>
            <span class="ui-simple-only">
              Spending limit
            </span>
            <span class="ui-advanced-only">Hard stop recovery</span>
          </:eyebrow>
          <p class="obj">
            {@budget.name} reached
            <span class="mono">{format_currency(@budget.limit_amount, @budget.currency)}</span>
            for this period.
          </p>
          <.tick_meter percent={100} class="full">
            <:legend><span class="z st">agents stop</span></:legend>
          </.tick_meter>
        </.problem_card>
      </:problem>
      <:resolution>
        <.ink_card heading="After you raise it" heading_id="bd-ns-i">
          <.consequences rows={[
            {:idle, "Raise the limit first, then resume agents that were paused by the stop."}
          ]} />
          <.ink_foot verb="raise">
            <:secondary>
              <.ghost_pill navigate={~p"/agents"} data-testid="budget-resume-after-raise">
                Resume after raise
              </.ghost_pill>
            </:secondary>
            <:primary>
              <.primary_pill
                navigate={~p"/budgets/#{@budget}/edit"}
                data-testid="budget-raise-limit"
              >
                Raise limit
              </.primary_pill>
            </:primary>
          </.ink_foot>
        </.ink_card>
      </:resolution>
    </.next_step>

    <.band_card id="bd-period-t" title="This period">
      <div class="lim">
        <p class="hero">
          <span class="mono" data-testid="budget-show-used">
            {format_currency(@budget.spent_amount, @budget.currency)}
          </span>
          <span class="u">of {format_currency(@budget.limit_amount, @budget.currency)}</span>
        </p>
        <%!-- When the limit was hit, the Next step above already draws the full meter. --%>
        <.tick_meter
          :if={!recovery_card?(@budget, @budget_policy)}
          percent={Budgets.Budget.utilization_percentage(@budget)}
          warn_percent={@budget.threshold_alert_percentage}
        />
        <% {left, left_word} = left_parts(@budget) %>
        <p class="lim-line">
          <b class="mono">{utilization_percentage(@budget)}</b>
          used<span aria-hidden="true"> · </span><b class="mono">{left}</b>
          {left_word}
        </p>
      </div>
    </.band_card>

    <.band_card id="bd-det-t" title="Details" class="aside">
      <.kv_list>
        <:item term="Applies to">{@scope_text}</:item>
        <:item term="Period">{period_label(@budget) || "No fixed window"}</:item>
        <:item term="Hard stop">{boolean_label(@budget.hard_stop)}</:item>
        <:item term="Enforced">
          <span data-testid="budget-runtime-enforcement">
            {enforcement_label(@budget_policy)}
          </span>
        </:item>
        <:item term="Warns at">
          <span class="mono">{@budget.threshold_alert_percentage}%</span>
        </:item>
      </.kv_list>
    </.band_card>
  </.page_frame>
<% end %>
