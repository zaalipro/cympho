<div
  class={[
    "p-6 lg:p-8 mx-auto ember-aurora",
    if(@live_action in [:new, :edit], do: "max-w-7xl", else: "max-w-6xl")
  ]}
  data-ui-complex-page
>
  <div class="relative z-[1]">
    <div
      :if={@flash && @flash[:info]}
      class="mb-6 bg-success/10 border border-success/20 text-success text-sm px-4 py-3 rounded-lg"
    >
      {@flash[:info]}
    </div>

    <div
      :if={@flash && @flash[:error]}
      class="mb-6 bg-red-500/10 border border-red-500/20 text-red-400 text-sm px-4 py-3 rounded-lg"
    >
      {@flash[:error]}
    </div>

    <%= if @live_action in [:new, :edit] do %>
      <section
        data-testid="budget-form-shell"
        class="space-y-5"
      >
        <.live_component
          module={CymphoWeb.BudgetLive.FormComponent}
          id={@budget.id || :new}
          title={@page_title}
          action={@live_action}
          budget={@budget}
          patch={~p"/budgets"}
        />
      </section>
    <% else %>
      <.header>
        <span class="ui-advanced-only ember-eyebrow">Spend limits</span>
        <h1 class="ember-ink mt-4 font-serif text-[clamp(30px,4.5vw,44px)] font-510 leading-[1.08] tracking-[-0.02em]">
          {@page_title}
        </h1>
        <:actions>
          <.app_link
            navigate={~p"/budgets/new"}
            class="bg-brand hover:bg-accent text-on-primary font-510 text-sm px-4 py-2 rounded-button transition-colors inline-flex items-center gap-2"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M12 4v16m8-8H4"
              />
            </svg>
            New Budget
          </.app_link>
        </:actions>
      </.header>

      <section
        id="budget-command"
        data-testid="budget-command"
        class="ui-advanced-only ember-glass mb-6 overflow-hidden"
      >
        <div class="border-b border-border bg-gradient-to-b from-surface-2/50 to-transparent px-5 py-4">
          <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
            <div class="min-w-0">
              <div class="flex flex-wrap items-center gap-2">
                <p class="text-[11px] font-590 uppercase tracking-[0.14em] text-text-quaternary">
                  Budget command
                </p>
                <span class={[
                  "rounded-full border px-2 py-0.5 text-[11px] font-510",
                  budget_command_badge_class(@budget_command.tone)
                ]}>
                  {@budget_command.badge}
                </span>
              </div>
              <h2 class="mt-2 text-lg font-590 tracking-tight text-text-primary">
                {@budget_command.title}
              </h2>
              <p class="mt-1 max-w-3xl text-sm leading-5 text-text-tertiary">
                {@budget_command.summary}
              </p>
            </div>
            <.app_link
              navigate={@budget_command.action_path}
              class={"inline-flex shrink-0 items-center justify-center gap-2 rounded-lg border px-3 py-2 text-sm font-510 transition-colors #{budget_command_action_class(@budget_command.tone)}"}
            >
              <span class="hero-arrow-right-mini h-4 w-4"></span>
              {@budget_command.action_label}
            </.app_link>
          </div>
        </div>

        <div class="grid grid-cols-2 gap-px bg-border sm:grid-cols-4">
          <div :for={metric <- @budget_command.metrics} class="bg-surface px-4 py-3">
            <p class="text-[10px] font-590 uppercase tracking-[0.12em] text-text-quaternary">
              {metric.label}
            </p>
            <p class="mt-1 break-words font-mono text-sm font-590 text-text-primary">
              {metric.value}
            </p>
          </div>
        </div>
      </section>

      <%!-- No "Budget Overview" strip: its four numbers are the same
           budgets/active/limit/spent the command strip prints directly above. --%>

      <p class="font-serif text-[13px] font-510 italic tracking-[0.02em] text-brand/90 mb-3">
        <span class="ui-advanced-only">Spending limits</span>
        <span class="ui-simple-only">Limits</span>
      </p>

      <div
        id="budget-tbody"
        phx-update="stream"
        class="grid grid-cols-1 gap-4 md:grid-cols-2 xl:grid-cols-3"
      >
        <div
          id="budget-empty"
          class="only:block hidden col-span-full rounded-card border border-dashed border-border bg-panel/50 px-6 py-12 text-center"
        >
          <p class="text-sm font-590 text-text-primary">
            <span class="ui-advanced-only">No spending limits yet</span>
            <span class="ui-simple-only">No spending limit yet</span>
          </p>
          <p class="mx-auto mt-1 max-w-md text-sm leading-5 text-text-tertiary">
            <span class="ui-advanced-only">
              Create a company budget before broad autonomous runs so provider spend has a hard stop.
            </span>
            <span class="ui-simple-only">Set one so the team can't overspend.</span>
          </p>
          <.app_link
            navigate={~p"/budgets/new"}
            class="mt-5 inline-flex h-9 items-center justify-center rounded-button bg-brand px-4 text-sm font-510 text-on-primary transition-colors hover:bg-accent"
          >
            <span class="ui-advanced-only">Create budget</span>
            <span class="ui-simple-only">Set a limit</span>
          </.app_link>
        </div>

        <%= for {dom_id, budget} <- @streams.budget do %>
          <% state = budget_state(budget, @budget_policies) %>
          <div
            id={dom_id}
            class={[
              "group card-lift flex flex-col rounded-card border border-border bg-surface/50 p-4 transition-colors hover:bg-surface-hover hover:border-border-hover",
              budget_card_accent(state.tone)
            ]}
            data-testid="budget-card"
          >
            <div class="flex min-w-0 items-start justify-between gap-3">
              <div class="min-w-0">
                <div class="flex items-center gap-2">
                  <span class={["h-2 w-2 shrink-0 rounded-full", budget_dot_class(state.tone)]}>
                  </span>
                  <.app_link
                    navigate={~p"/budgets/#{budget.id}"}
                    class="truncate text-sm font-590 text-text-primary hover:text-brand"
                  >
                    {budget.name}
                  </.app_link>
                </div>
                <p class="mt-1 text-xs text-text-tertiary">{scope_label(budget)} scope</p>
              </div>
            </div>

            <p class={["mt-3 text-sm font-510", budget_state_text_class(state.tone)]}>
              {state.word} — {state.detail}
            </p>

            <div class="mt-2 w-full bg-black/20 rounded-full h-2">
              <div
                class={"h-2 rounded-full progress-spring #{progress_color(budget)}"}
                style={"width: #{utilization_percentage(budget)}"}
              >
              </div>
            </div>

            <div class="mt-3 flex items-baseline justify-between gap-2">
              <div>
                <p class="text-[10px] font-590 uppercase tracking-[0.12em] text-text-quaternary">
                  Used
                </p>
                <p
                  class="font-serif text-lg font-510 tabular-nums text-text-primary"
                  data-testid="budget-card-used"
                >
                  {format_currency(budget.spent_amount, budget.currency)}
                </p>
              </div>
              <p class="text-xs text-text-quaternary">
                of {format_currency(budget.limit_amount, budget.currency)}
              </p>
            </div>

            <p
              class="mt-2 text-xs leading-5 text-text-tertiary"
              data-testid="budget-guardrail-note"
            >
              {guardrail_note(budget, @budget_policies)}
            </p>

            <div class="mt-4 flex items-center justify-between border-t border-border pt-3">
              <.app_link
                navigate={~p"/budgets/#{budget.id}"}
                class="inline-flex items-center gap-1 text-sm font-510 text-brand hover:text-accent"
              >
                Manage <span class="hero-arrow-right-mini h-4 w-4"></span>
              </.app_link>
              <button
                phx-click="delete_budget"
                phx-value-id={budget.id}
                class="text-xs text-text-quaternary transition-colors hover:text-red-400"
                data-confirm={"Delete #{budget.name}? Autonomous preflight will stop using this spend guardrail."}
              >
                Delete
              </button>
            </div>
          </div>
        <% end %>
      </div>

      <.infinite_scroll_footer
        id="budget"
        has_more={@infinite_scroll[:budget][:has_more?] || false}
      />
    <% end %>
  </div>
</div>
