<div
  class={[
    "p-6 lg:p-8 mx-auto ember-aurora",
    if(@live_action in [:new, :edit], do: "max-w-7xl", else: "max-w-6xl")
  ]}
  data-ui-complex-page
>
  <div class="relative z-[1]">
    <div
      :if={@flash && @flash[:info]}
      class="mb-6 bg-success/10 border border-success/20 text-success text-sm px-4 py-3 rounded-lg"
    >
      {@flash[:info]}
    </div>

    <div
      :if={@flash && @flash[:error]}
      class="mb-6 bg-red-500/10 border border-red-500/20 text-red-400 text-sm px-4 py-3 rounded-lg"
    >
      {@flash[:error]}
    </div>

    <%= if @live_action in [:new, :edit] do %>
      <section
        data-testid="budget-form-shell"
        class="space-y-5"
      >
        <.live_component
          module={CymphoWeb.BudgetLive.FormComponent}
          id={@budget.id || :new}
          title={@page_title}
          action={@live_action}
          budget={@budget}
          patch={~p"/budgets"}
        />
      </section>
    <% else %>
      <.header>
        <span class="ember-eyebrow">Spend guardrails</span>
        <h1 class="ember-ink mt-4 font-serif text-[clamp(30px,4.5vw,44px)] font-510 leading-[1.08] tracking-[-0.02em]">
          {@page_title}
        </h1>
        <:actions>
          <.app_link
            navigate={~p"/budgets/new"}
            class="bg-brand hover:bg-accent text-on-primary font-510 text-sm px-4 py-2 rounded-button transition-colors inline-flex items-center gap-2"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M12 4v16m8-8H4"
              />
            </svg>
            New Budget
          </.app_link>
        </:actions>
      </.header>

      <section
        id="budget-command"
        data-testid="budget-command"
        class="ui-advanced-only ember-glass mb-6 overflow-hidden"
      >
        <div class="border-b border-border bg-gradient-to-b from-surface-2/50 to-transparent px-5 py-4">
          <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
            <div class="min-w-0">
              <div class="flex flex-wrap items-center gap-2">
                <p class="text-[11px] font-590 uppercase tracking-[0.14em] text-text-quaternary">
                  Budget command
                </p>
                <span class={[
                  "rounded-full border px-2 py-0.5 text-[11px] font-510",
                  budget_command_badge_class(@budget_command.tone)
                ]}>
                  {@budget_command.badge}
                </span>
              </div>
              <h2 class="mt-2 text-lg font-590 tracking-tight text-text-primary">
                {@budget_command.title}
              </h2>
              <p class="mt-1 max-w-3xl text-sm leading-5 text-text-tertiary">
                {@budget_command.summary}
              </p>
            </div>
            <.app_link
              navigate={@budget_command.action_path}
              class={"inline-flex shrink-0 items-center justify-center gap-2 rounded-lg border px-3 py-2 text-sm font-510 transition-colors #{budget_command_action_class(@budget_command.tone)}"}
            >
              <span class="hero-arrow-right-mini h-4 w-4"></span>
              {@budget_command.action_label}
            </.app_link>
          </div>
        </div>

        <div class="grid grid-cols-2 gap-px bg-border sm:grid-cols-4">
          <div :for={metric <- @budget_command.metrics} class="bg-surface px-4 py-3">
            <p class="text-[10px] font-590 uppercase tracking-[0.12em] text-text-quaternary">
              {metric.label}
            </p>
            <p class="mt-1 break-words font-mono text-sm font-590 text-text-primary">
              {metric.value}
            </p>
          </div>
        </div>
      </section>

      <div class="ui-advanced-only mb-6 bg-surface border border-border rounded-xl p-6">
        <h2 class="text-xs font-590 text-text-secondary uppercase tracking-wider mb-4">
          Budget Overview
        </h2>
        <div class="grid grid-cols-2 gap-4 lg:grid-cols-4">
          <div class="ember-stat text-center">
            <div class="text-2xl font-510 text-text-primary">{@summary.total}</div>
            <div class="text-xs text-text-quaternary mt-1">Total Budgets</div>
          </div>
          <div class="ember-stat text-center">
            <div class="text-2xl font-510 text-green-400">{@summary.active}</div>
            <div class="text-xs text-text-quaternary mt-1">Active</div>
          </div>
          <div class="ember-stat text-center">
            <div class="text-2xl font-510 text-brand">
              {format_currency(@summary.total_limit)}
            </div>
            <div class="text-xs text-text-quaternary mt-1">Total Limit</div>
          </div>
          <div class="ember-stat text-center">
            <div class="text-2xl font-510 text-amber-400">
              {format_currency(@summary.total_spent)}
            </div>
            <div class="text-xs text-text-quaternary mt-1">Total Spent</div>
          </div>
        </div>
      </div>

      <div class="bg-surface border border-border rounded-xl overflow-hidden">
        <div class="overflow-x-auto">
          <table class="w-full">
            <thead class="bg-subtle border-b border-border">
              <tr>
                <th class="text-left text-xs font-510 text-text-secondary uppercase tracking-wider px-6 py-3">
                  Name
                </th>
                <th class="text-left text-xs font-510 text-text-secondary uppercase tracking-wider px-6 py-3">
                  Scope
                </th>
                <th class="text-left text-xs font-510 text-text-secondary uppercase tracking-wider px-6 py-3">
                  Limit
                </th>
                <th class="text-left text-xs font-510 text-text-secondary uppercase tracking-wider px-6 py-3">
                  Spent
                </th>
                <th class="text-left text-xs font-510 text-text-secondary uppercase tracking-wider px-6 py-3">
                  Utilization
                </th>
                <th class="text-left text-xs font-510 text-text-secondary uppercase tracking-wider px-6 py-3">
                  Status
                </th>
                <th class="text-right text-xs font-510 text-text-secondary uppercase tracking-wider px-6 py-3">
                  Actions
                </th>
              </tr>
            </thead>
            <tbody id="budget-tbody" phx-update="stream" class="divide-y divide-border">
              <tr id="budget-empty" class="only:table-row hidden">
                <td colspan="7" class="text-center py-12">
                  <div class="mx-auto max-w-md px-6">
                    <p class="text-sm font-590 text-text-primary">
                      No spend guardrails yet
                    </p>
                    <p class="mt-1 text-sm leading-5 text-text-tertiary">
                      Create a company budget before broad autonomous runs so provider spend has a hard stop.
                    </p>
                  </div>
                </td>
              </tr>
              <%= for {dom_id, budget} <- @streams.budget do %>
                <% {status_class, status_label} = status_badge(budget) %>
                <tr
                  id={dom_id}
                  class="hover:bg-subtle transition-colors hover:shadow-[inset_2px_0_0_0_var(--color-primary)]"
                >
                  <td class="px-6 py-4">
                    <.app_link
                      navigate={~p"/budgets/#{budget.id}"}
                      class="text-brand hover:text-accent font-510"
                    >
                      {budget.name}
                    </.app_link>
                  </td>
                  <td class="px-6 py-4 text-text-secondary text-sm">
                    {scope_label(budget)}
                  </td>
                  <td class="px-6 py-4 text-text-primary text-sm">
                    {format_currency(budget.limit_amount, budget.currency)}
                  </td>
                  <td class="px-6 py-4 text-text-primary text-sm">
                    {format_currency(budget.spent_amount, budget.currency)}
                  </td>
                  <td class="px-6 py-4 text-sm">
                    <div class="flex items-center gap-2">
                      <div class="w-24 bg-black/20 rounded-full h-2">
                        <div
                          class={"h-2 rounded-full progress-spring #{progress_color(budget)}"}
                          style={"width: #{utilization_percentage(budget)}"}
                        >
                        </div>
                      </div>
                      <span class="text-text-secondary">{utilization_percentage(budget)}</span>
                    </div>
                  </td>
                  <td class="px-6 py-4">
                    <span class={"inline-flex items-center px-2 py-1 rounded text-xs font-510 border #{status_class}"}>
                      {status_label}
                    </span>
                  </td>
                  <td class="px-6 py-4 text-right">
                    <div class="flex items-center justify-end gap-2">
                      <.app_link
                        navigate={~p"/budgets/#{budget.id}"}
                        class="text-text-secondary hover:text-text-primary text-sm"
                      >
                        View
                      </.app_link>
                      <button
                        phx-click="delete_budget"
                        phx-value-id={budget.id}
                        class="text-red-400 hover:text-red-300 text-sm"
                        data-confirm={"Delete #{budget.name}? Autonomous preflight will stop using this spend guardrail."}
                      >
                        Delete
                      </button>
                    </div>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>

      <.infinite_scroll_footer
        id="budget"
        has_more={@infinite_scroll[:budget][:has_more?] || false}
      />
    <% end %>
  </div>
</div>
