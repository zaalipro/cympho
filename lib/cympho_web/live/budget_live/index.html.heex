<%= if @live_action in [:new, :edit] do %>
  <.page_frame
    page="budget-form"
    kind={:deep}
    parent={{~p"/budgets", "Spending limit"}}
    current="New limit"
    data-ui-complex-page
  >
    <:head>
      <section class="head" aria-labelledby="bf-h">
        <h1 class="h1 big" id="bf-h">New limit</h1>
        <p class="sub">
          A cap on what agents spend: the whole company, one project or one agent.
        </p>
      </section>
    </:head>

    <.flash_line flash={@flash} />

    <.live_component
      module={CymphoWeb.BudgetLive.FormComponent}
      id={@budget.id || :new}
      action={@live_action}
      budget={@budget}
      current_user_id={@current_user.id}
      current_company_id={@current_company.id}
      patch={~p"/budgets"}
    />
  </.page_frame>
<% else %>
  <.page_frame page="budgets" title="Spending limit" data-ui-complex-page>
    <:header_end>
      <.pill navigate={~p"/budgets/new"}><.r3_icon name="i-plus" />New limit</.pill>
    </:header_end>

    <.flash_line flash={@flash} />

    <NextStep.paused_step :if={@spending.status == :over_budget} spending={@spending} />

    <.band_card id="budgets-list-t" title="Limits">
      <.infinite_scroll
        id="budget"
        has_more={@infinite_scroll[:budget][:has_more?] || false}
        container_class="rows"
      >
        <:empty>
          <%= if @spending.limit do %>
            <%!-- The company's own limit (no Budget owns it): Spending changes it. --%>
            <.quiet_empty title={"Spending limit: #{money(@spending.limit)} per #{window(@spending.days)}"}>
              Change it on Spending.
              <:action>
                <.pill navigate={~p"/costs"}>Open Spending</.pill>
              </:action>
            </.quiet_empty>
          <% else %>
            <div class="ui-advanced-only">
              <.quiet_empty title="No spending limits yet">
                Create a company budget before broad autonomous runs so provider spend has a hard stop.
                <:action>
                  <.pill navigate={~p"/budgets/new"}>Create budget</.pill>
                </:action>
              </.quiet_empty>
            </div>
            <div class="ui-simple-only">
              <.quiet_empty title="No spending limit yet">
                Set one so the team can't overspend.
                <:action>
                  <.pill navigate={~p"/budgets/new"}>Set a limit</.pill>
                </:action>
              </.quiet_empty>
            </div>
          <% end %>
        </:empty>

        <.list_row
          :for={{dom_id, budget} <- @streams.budget}
          tag="div"
          id={dom_id}
          title={budget.name}
          navigate={~p"/budgets/#{budget.id}"}
          status={budget_status(budget)}
          data-testid="budget-card"
        >
          <:meta>
            {scope_text(budget, @scope_names)}<span :if={period_label(budget)}><span aria-hidden="true"> · </span>{period_label(budget)}</span>
            <span aria-hidden="true">
              ·
            </span>
            <span data-testid="budget-guardrail-note">
              {guardrail_note(budget, @budget_policies)}
            </span>
          </:meta>
          <:trail>
            <span class="mono" data-testid="budget-card-used">
              {format_currency(budget.spent_amount, budget.currency)}
            </span>
            of
            <span class="mono">{format_currency(budget.limit_amount, budget.currency)}</span><span aria-hidden="true"> · </span><span class="mono">{utilization_percentage(budget)}</span>
            <span :if={budget.status == "cancelled"} class="tag">Cancelled</span>
          </:trail>
          <:actions>
            <.pill navigate={~p"/budgets/#{budget.id}/edit"} aria-label={"Edit #{budget.name}"}>
              Edit
            </.pill>
            <button
              type="button"
              class="pl warn"
              phx-click="delete_budget"
              phx-value-id={budget.id}
              aria-label={"Delete #{budget.name}"}
              data-confirm={"Delete #{budget.name}? Autonomous preflight will stop using this spend guardrail."}
            >
              Delete
            </button>
          </:actions>
        </.list_row>
      </.infinite_scroll>
    </.band_card>

    <.band_card
      id="budget-command-t"
      title="Budget overview"
      section_id="budget-command"
      class="ui-advanced-only"
      data-testid="budget-command"
    >
      <:header_end>
        <span class="meta bg-st">
          <.status_word kind={command_status(@budget_command.tone)} word={@budget_command.badge} />
        </span>
      </:header_end>
      <div class="gl-sec">
        <p class="gl-big">{@budget_command.title}</p>
        <p class="gl-sub">{@budget_command.summary}</p>
        <.text_link navigate={@budget_command.action_path}>
          {@budget_command.action_label}
        </.text_link>
      </div>
      <div class="strip s4">
        <div :for={metric <- @budget_command.metrics} class="cell">
          <span class="v mono">{metric.value}</span><span class="l">{metric.label}</span>
        </div>
      </div>
    </.band_card>
  </.page_frame>
<% end %>
