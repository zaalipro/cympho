<div data-testid="budget-form-shell">
  <% scope_type = selected_scope_type(@form, @budget) %>
  <% hard_stop? = hard_stop_enabled?(@form, @budget) %>

  <.form_pair
    id="budget-form"
    for={@form}
    phx-target={@myself}
    phx-change="validate"
    phx-submit="save"
    heading="After you save"
    verb="save"
  >
    <input type="hidden" name="budget[company_id]" value={@budget.company_id} />

    <.band_card id="bf-limit-t" title="Limit">
      <div class="flds">
        <.input
          field={@form[:name]}
          type="text"
          label="Name"
          placeholder="Monthly runtime guardrail"
          required
          wrapper_class="full"
        />
        <.input
          field={@form[:scope_type]}
          type="select"
          label="Applies to"
          options={[
            {"Company", "company"},
            {"Project", "project"},
            {"Agent", "agent"},
            {"Custom", "custom"}
          ]}
          required
        />
        <%= if scope_type == "company" do %>
          <div class="fld bf-scope">
            <input type="hidden" name="budget[scope_id]" value={@budget.company_id} />
            <p class="gl-big">Company-wide runtime</p>
            <p class="help">Applies to every autonomous preflight in this company.</p>
          </div>
        <% else %>
          <.input
            field={@form[:scope_id]}
            type="text"
            label={scope_id_label(scope_type)}
            value={scoped_scope_id_value(@form, @budget)}
            placeholder={scope_id_placeholder(scope_type)}
          />
        <% end %>
        <.input field={@form[:limit_amount]} type="number" label="Amount" step="0.01" required />
        <.input
          field={@form[:currency]}
          type="select"
          label="Currency"
          options={[{"USD", "USD"}, {"EUR", "EUR"}, {"GBP", "GBP"}]}
        />
      </div>
    </.band_card>

    <.band_card id="bf-reach-t" title="When it is reached">
      <div class="flds">
        <.input
          field={@form[:hard_stop]}
          type="checkbox"
          label="Hard stop"
          help="Blocks new agent work when spend reaches the limit."
          wrapper_class="full"
        />
        <.input
          field={@form[:threshold_alert_percentage]}
          type="number"
          label="Warn at (%)"
          min="1"
          max="100"
        />
      </div>
    </.band_card>

    <details
      id="budget-window"
      class="card tech"
      phx-mounted={JS.ignore_attributes("open")}
    >
      <summary>
        <span class="h2">Period <span class="cx">{budget_window_summary(@form)}</span></span>
        <.r3_icon name="i-chev-down" />
      </summary>
      <div class="flds">
        <.input field={@form[:period_start]} type="datetime-local" label="Starts" />
        <.input field={@form[:period_end]} type="datetime-local" label="Ends" />
      </div>
    </details>

    <:effect>
      <div class="bf-effect" data-testid="budget-preflight-behavior">
        <.consequences
          :if={hard_stop?}
          rows={[{:stopped, "Hard stop — agents stop starting new work once spend reaches it."}]}
        />
        <.consequences
          :if={!hard_stop?}
          rows={[{:waiting, "Warn only — agents keep spending after this cap."}]}
        />
        <.ink_note :if={hard_stop?}>
          An agent whose cost can't be priced stays queued until you set its Billing.
        </.ink_note>
      </div>
    </:effect>
    <:secondary>
      <.ghost_pill patch={@patch || ~p"/budgets"}>Cancel</.ghost_pill>
    </:secondary>
    <:primary>
      <.primary_pill type="submit" phx-disable-with="Saving…">
        {if @action == :new, do: "Create limit", else: "Save limit"}
      </.primary_pill>
    </:primary>
  </.form_pair>
</div>
