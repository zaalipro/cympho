<% alert = show_alert(@routine, @triggers, @runs) %>
<% last = last_run(@runs) %>
<% scheduled? = Enum.any?(@triggers, &(&1.type == "schedule")) %>
<.page_frame
  page="routine"
  kind={:deep}
  parent={{"/routines", "Repeating tasks"}}
  current={@routine.name}
  data-ui-complex-page
>
  <:head>
    <section class="head" aria-labelledby="r-h">
      <h1 class="h1 big" id="r-h">{@routine.name}</h1>
      <p :if={@routine.description not in [nil, ""]} class="sub">{@routine.description}</p>
      <div class="chips">
        <span :if={@routine.status != :active} class="tag">{routine_label(@routine.status)}</span>
        <.pill navigate={~p"/routines/#{@routine.id}/edit"}>
          <.r3_icon name="i-pencil" />Edit
        </.pill>
        <.pill :if={alert != :failed} phx-click="manual_run" phx-disable-with="Starting…">
          Run now
        </.pill>
      </div>
    </section>
  </:head>

  <.flash_line flash={@flash} />

  <%!-- Any schedule, on or off, hides the add-schedule form (as before the restyle). --%>
  <.next_step :if={alert == :trigger_gap and not scheduled?} id="rt-ns-">
    <:problem>
      <.problem_card title="Give it a schedule" title_id="rt-ns-t">
        <:eyebrow>Next step<span aria-hidden="true"> · </span>Repeating task</:eyebrow>
        <p class="obj">{show_alert_note(:trigger_gap)}</p>
      </.problem_card>
    </:problem>
    <:resolution>
      <.ink_card form="Add a schedule" id="schedule-trigger" phx-submit="create_schedule_trigger">
        <.input
          id="routine-cron"
          name="cron_expression"
          label="Schedule (cron)"
          placeholder="0 9 * * *"
          autocomplete="off"
          help="Five fields: minute, hour, day, month, weekday. 0 9 * * * is every day at 09:00."
        />
        <.ink_foot verb="add">
          <:primary>
            <.primary_pill type="submit">Add schedule</.primary_pill>
          </:primary>
        </.ink_foot>
      </.ink_card>
    </:resolution>
  </.next_step>

  <.next_step :if={alert == :failed} id="rt-ns-">
    <:problem>
      <.problem_card title="Look at the failed run" title_id="rt-ns-t">
        <:eyebrow>Next step<span aria-hidden="true"> · </span>Repeating task</:eyebrow>
        <p class="obj">{(last && last.failure_reason) || show_alert_note(:failed)}</p>
      </.problem_card>
    </:problem>
    <:resolution>
      <.ink_card heading="After you run it" heading_id="rt-ns-i">
        <.consequences rows={[{:done, "Runs it once now."}]} />
        <.ink_foot verb="run">
          <:secondary>
            <.ghost_pill navigate={~p"/routines/#{@routine.id}/edit"}>Edit</.ghost_pill>
          </:secondary>
          <:primary>
            <.primary_pill phx-click="manual_run" phx-disable-with="Starting…">
              Run now
            </.primary_pill>
          </:primary>
        </.ink_foot>
      </.ink_card>
    </:resolution>
  </.next_step>

  <.band_card id="routine-schedule-t" title="Schedule">
    <.kv_list class="wide">
      <:item term="Schedule">
        {schedule_summary(@triggers)}<span :if={raw_cron(@triggers)} class="ui-advanced-only"><span aria-hidden="true"> · </span><span class="mono">{raw_cron(
              @triggers
            )}</span></span>
      </:item>
      <:item term="Next run">{next_run(@triggers) || "Manual only"}</:item>
      <:item :if={last} term="Last run">
        <span class="rt-last">
          <.status_word
            kind={elem(run_state(last.status), 0)}
            word={elem(run_state(last.status), 1)}
          />
          <span :if={last.triggered_at}>
            <span aria-hidden="true"> · </span><span class="mono">{stamp(last.triggered_at)}</span>
          </span>
        </span>
      </:item>
    </.kv_list>
    <form
      :if={alert != :trigger_gap and not scheduled?}
      id="schedule-trigger"
      phx-submit="create_schedule_trigger"
      class="rt-cron"
    >
      <.input
        id="routine-cron"
        name="cron_expression"
        label="Add a schedule (cron)"
        placeholder="0 9 * * *"
        autocomplete="off"
      />
      <.pill type="submit">Add schedule</.pill>
    </form>
  </.band_card>

  <.band_card id="routine-policy-t" title="How it runs" class="ui-advanced-only">
    <.kv_list class="wide">
      <:item term="Priority">{routine_label(@routine.priority)}</:item>
      <:item term="Concurrency">{routine_label(@routine.concurrency_policy)}</:item>
      <:item term="Catch-up">
        {routine_label(@routine.catch_up_policy)}<span aria-hidden="true"> · </span>max
        <span class="mono">{@routine.catch_up_cap}</span>
      </:item>
    </.kv_list>
  </.band_card>

  <.band_card id="routine-runs-t" title="Run history">
    <:header_end :if={@runs != []}>
      <span class="meta">
        <span class="mono">{length(@runs)}</span> {if length(@runs) == 1,
          do: "run",
          else: "runs"}
      </span>
    </:header_end>
    <.quiet_empty :if={@runs == []} title="No runs yet">
      Run it now, or give it a schedule and it runs on its own.
    </.quiet_empty>
    <div :if={@runs != []} class="tbl-w">
      <table class="tbl">
        <thead>
          <tr>
            <th scope="col">Status</th>
            <th scope="col" class="m-hide">Trigger</th>
            <th scope="col">Triggered</th>
            <th scope="col" class="m-hide">Finished</th>
            <th scope="col"><span class="sr">Task</span></th>
          </tr>
        </thead>
        <tbody>
          <tr :for={run <- @runs} id={"routine-run-#{run.id}"}>
            <td>
              <span class="rt-st">
                <.status_word
                  kind={elem(run_state(run.status), 0)}
                  word={elem(run_state(run.status), 1)}
                />
              </span>
            </td>
            <td class="m-hide">{routine_label(run.trigger_type)}</td>
            <td><.run_time at={run.triggered_at} /></td>
            <td class="m-hide"><.run_time at={run.completed_at} /></td>
            <td>
              <.link :if={run.issue_id} class="lnk" navigate={~p"/issues/#{run.issue_id}"}>
                Task
              </.link>
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  </.band_card>
</.page_frame>
