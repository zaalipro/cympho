<div class="ember-aurora p-6 lg:p-8 max-w-6xl mx-auto w-full min-w-0" data-ui-complex-page>
  <div class="relative z-[1]">
    <.header>
      <div class="min-w-0">
        <span class="ember-eyebrow">
          Routine · {routine_label(@routine.status)}
        </span>
        <h1 class="ember-ink mt-4 font-serif text-[clamp(30px,4.5vw,44px)] font-510 leading-[1.08] tracking-[-0.02em]">
          {@routine.name}
        </h1>
        <p class="mt-2 max-w-2xl text-[15px] leading-6 text-text-tertiary">
          {@routine.description || "Routine details and run history."}
        </p>
      </div>
      <:actions>
        <.app_link
          navigate={~p"/routines"}
          class="rounded-lg border border-border bg-button px-4 py-2 text-sm font-510 text-text-secondary transition-colors hover:bg-button-hover hover:text-text-primary"
        >
          Back
        </.app_link>
        <.app_link
          navigate={~p"/routines/#{@routine.id}/edit"}
          class="rounded-lg border border-border bg-button px-4 py-2 text-sm font-510 text-text-secondary transition-colors hover:bg-button-hover hover:text-text-primary"
        >
          Edit
        </.app_link>
        <button
          type="button"
          phx-click="manual_run"
          phx-disable-with="Starting..."
          class="cta-glow rounded-button bg-brand px-4 py-2 text-sm font-510 text-on-primary transition-colors hover:bg-accent"
        >
          Run Now
        </button>
      </:actions>
    </.header>

    <section class={[
      "mb-6 rounded-2xl border p-5 shadow-card",
      show_alert_class(show_alert(@routine, @triggers, @runs))
    ]}>
      <div class="flex flex-wrap items-start justify-between gap-4">
        <div class="min-w-0">
          <p class="font-serif text-[13px] font-510 italic tracking-[0.02em] text-brand/90">
            Health at a glance
          </p>
          <div class="mt-2 flex flex-wrap items-center gap-x-6 gap-y-3">
            <div>
              <p class="text-[10px] font-590 uppercase tracking-[0.12em] text-text-quaternary">
                Schedule
              </p>
              <p class="mt-1 text-sm font-590 text-text-primary">{schedule_summary(@triggers)}</p>
            </div>
            <div>
              <p class="text-[10px] font-590 uppercase tracking-[0.12em] text-text-quaternary">
                Next run
              </p>
              <p class="mt-1 text-sm font-590 text-text-primary">
                {next_run(@triggers) || "Manual only"}
              </p>
            </div>
            <div>
              <p class="text-[10px] font-590 uppercase tracking-[0.12em] text-text-quaternary">
                Last run
              </p>
              <p class="mt-1 flex items-center gap-1.5 text-sm font-590 text-text-primary">
                <span
                  :if={last_run(@runs)}
                  class={["h-2 w-2 rounded-full", routine_run_dot(last_run(@runs).status)]}
                >
                </span>
                {if run = last_run(@runs), do: routine_label(run.status), else: "No runs yet"}
              </p>
            </div>
          </div>
          <p
            :if={show_alert_note(show_alert(@routine, @triggers, @runs))}
            class="mt-3 text-sm leading-6 text-current/80"
          >
            {show_alert_note(show_alert(@routine, @triggers, @runs))}
          </p>

          <form
            :if={Enum.all?(@triggers, &(&1.type != "schedule"))}
            id="schedule-trigger"
            phx-submit="create_schedule_trigger"
            class="mt-4 flex min-w-0 flex-wrap items-end gap-2"
          >
            <label class="min-w-[12rem] flex-1">
              <span class="text-[10px] font-590 uppercase tracking-[0.12em] text-text-quaternary">
                Cron
              </span>
              <input
                type="text"
                name="cron_expression"
                placeholder="0 9 * * *"
                class="mt-1 w-full rounded-lg border border-border bg-surface px-3 py-2 text-sm text-text-primary"
              />
            </label>
            <button
              type="submit"
              class="rounded-lg border border-brand/25 bg-brand/10 px-3 py-2 text-sm font-590 text-brand transition-colors hover:bg-brand/15"
            >
              Add trigger
            </button>
          </form>
        </div>

        <div class="ui-advanced-only grid grid-cols-2 gap-3">
          <div class="rounded-xl border border-border bg-surface/70 px-3 py-2">
            <p class="text-[10px] font-590 uppercase tracking-[0.12em] text-text-quaternary">
              Priority
            </p>
            <p class="mt-1 text-sm font-590 text-text-primary">
              {routine_label(@routine.priority)}
            </p>
          </div>
          <div class="rounded-xl border border-border bg-surface/70 px-3 py-2">
            <p class="text-[10px] font-590 uppercase tracking-[0.12em] text-text-quaternary">
              Concurrency
            </p>
            <p class="mt-1 text-sm font-590 text-text-primary">
              {routine_label(@routine.concurrency_policy)}
            </p>
          </div>
          <div class="rounded-xl border border-border bg-surface/70 px-3 py-2">
            <p class="text-[10px] font-590 uppercase tracking-[0.12em] text-text-quaternary">
              Catch-up
            </p>
            <p class="mt-1 text-sm font-590 text-text-primary">
              {routine_label(@routine.catch_up_policy)}
            </p>
          </div>
          <div class="rounded-xl border border-border bg-surface/70 px-3 py-2">
            <p class="text-[10px] font-590 uppercase tracking-[0.12em] text-text-quaternary">
              Status
            </p>
            <p class="mt-1 text-sm font-590 text-text-primary">
              {routine_label(@routine.status)}
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="ember-glass overflow-hidden">
      <div class="flex items-center justify-between border-b border-white/10 px-4 py-3">
        <h2 class="font-serif text-[15px] font-510 italic tracking-[0.02em] text-brand/90">
          Run History
        </h2>
        <span class="text-[11px] font-590 uppercase tracking-[0.14em] text-text-quaternary tabular-nums">
          {length(@runs)} {if length(@runs) == 1, do: "run", else: "runs"}
        </span>
      </div>

      <div :if={@runs != []} class="overflow-x-auto">
        <table class="w-full text-left text-sm">
          <thead class="bg-subtle text-xs uppercase tracking-wider text-text-quaternary">
            <tr>
              <th class="px-4 py-3 font-510">Status</th>
              <th class="px-4 py-3 font-510">Trigger</th>
              <th class="px-4 py-3 font-510">Triggered</th>
              <th class="px-4 py-3 font-510">Completed</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-border">
            <tr
              :for={run <- @runs}
              class="transition-colors duration-200 hover:bg-surface-hover"
            >
              <td class="px-4 py-3">
                <span class={[
                  "inline-flex items-center gap-1.5 rounded-md border px-2 py-0.5 text-xs font-510",
                  run_status_class(run.status)
                ]}>
                  <span class={["h-1.5 w-1.5 rounded-full", routine_run_dot(run.status)]}></span>
                  {routine_label(run.status)}
                </span>
              </td>
              <td class="px-4 py-3 text-text-secondary">{run.trigger_type}</td>
              <td class="px-4 py-3 text-text-tertiary">
                {format_datetime(run.triggered_at)}
              </td>
              <td class="px-4 py-3 text-text-tertiary">
                {format_datetime(run.completed_at)}
              </td>
            </tr>
          </tbody>
        </table>
      </div>

      <.empty_state
        :if={@runs == []}
        title="No runs yet"
        message="Run this routine manually or wait for a trigger."
      >
        <:actions>
          <a
            href="#schedule-trigger"
            class="rounded-lg border border-brand/25 bg-brand/10 px-3 py-2 text-sm font-590 text-brand transition-colors hover:bg-brand/15"
          >
            Add trigger
          </a>
        </:actions>
      </.empty_state>
    </section>
  </div>
</div>
