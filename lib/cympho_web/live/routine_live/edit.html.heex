<.page_frame
  page="routine-form"
  kind={:deep}
  parent={{"/routines", "Repeating tasks"}}
  current="Edit repeating task"
  data-ui-complex-page
>
  <:head>
    <section class="head" aria-labelledby="rf-h">
      <h1 class="h1 big" id="rf-h">Edit {@routine.name}</h1>
    </section>
  </:head>

  <.flash_line flash={@flash} />

  <.routine_form
    form={@form}
    agent_options={@agent_options}
    project_options={@project_options}
    effect="It runs on its schedule and files a task each time."
    submit="Save changes"
    cancel={~p"/routines/#{@routine.id}"}
  />
</.page_frame>
