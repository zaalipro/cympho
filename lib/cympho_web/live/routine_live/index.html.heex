<.page_frame
  page="routines"
  title="Repeating tasks"
  data-ui-complex-page
  data-density={@digest_density}
>
  <:header_end>
    <.pill navigate={~p"/routines/new"}><.r3_icon name="i-plus" />New repeating task</.pill>
  </:header_end>

  <.flash_line flash={@flash} />

  <.band_card id="routines-list-t" title="Repeating tasks">
    <:header_end>
      <span class="ui-advanced-only">
        <.density_switch
          density={@digest_density}
          compact_patch={routine_index_url("compact")}
          detailed_patch={routine_index_url("detailed")}
        />
      </span>
    </:header_end>
    <.infinite_scroll
      id="routine"
      has_more={@infinite_scroll[:routine][:has_more?] || false}
      container_class="rows"
    >
      <:empty>
        <.quiet_empty title="No repeating tasks yet">
          Set one up to file a task on a schedule.
          <:action>
            <.pill navigate={~p"/routines/new"}>New repeating task</.pill>
          </:action>
        </.quiet_empty>
      </:empty>

      <.routine_row
        :for={{dom_id, routine} <- @streams.routine}
        id={dom_id}
        routine={routine}
        agent_names={@agent_names}
        density={@digest_density}
      />
    </.infinite_scroll>
  </.band_card>

  <%!-- With nothing to run, the overview and the health card would restate the
       list's empty state; they appear once there is a repeating task. --%>
  <.band_card
    :if={@routine_health.metrics.total_routines > 0}
    id="routine-overview-t"
    title="Repeating tasks overview"
    class="ui-advanced-only"
    data-testid="routine-command"
  >
    <:header_end><span class="meta">{@routine_command.badge}</span></:header_end>
    <div class="gl-sec">
      <p class="gl-big">{@routine_command.heading}</p>
      <p class="gl-sub">{@routine_command.detail}</p>
      <p :if={@routine_command.focus_label} class="gl-sub">
        {@routine_command.focus_label}<span :if={@routine_command.focus_detail}><span aria-hidden="true"> · </span>{@routine_command.focus_detail}</span>
      </p>
      <.text_link navigate={@routine_command.action_path}>
        {@routine_command.action_label}
      </.text_link>
    </div>
    <div class="strip s4">
      <div class="cell">
        <span class="v mono">{@routine_command.active_count}</span><span class="l">Active</span>
      </div>
      <div class="cell">
        <span class="v mono">{@routine_command.trigger_gap_count}</span><span class="l">Trigger gaps</span>
      </div>
      <div class="cell">
        <span class="v mono">
          {@routine_command.stale_count + @routine_command.failure_count}
        </span>
        <span class="l">Stuck or failed</span>
      </div>
      <div class="cell">
        <span class="v mono">{@routine_command.paused_count}</span><span class="l">Paused</span>
      </div>
    </div>
  </.band_card>

  <.band_card
    :if={@digest_density == "detailed" and @routine_health.metrics.total_routines > 0}
    id="routine-health-t"
    title="Health"
    class="ui-advanced-only"
    data-testid="routine-health"
  >
    <:header_end><span class="meta">{@routine_health.label}</span></:header_end>
    <div class="gl-sec">
      <p class="gl-sub">{@routine_health.summary}</p>
    </div>
    <ul :if={@routine_health.recommendations != []} class="rows">
      <.list_row
        :for={{recommendation, n} <- Enum.with_index(@routine_health.recommendations)}
        id={"routine-rec-#{n}"}
        title={recommendation.label}
        icon="i-alert"
        kind={recommendation_kind(recommendation.severity)}
      >
        <:meta>{recommendation.detail}</:meta>
      </.list_row>
    </ul>
    <p :if={@routine_health.recommendations == []} class="gl-sub pn-line">
      {routine_posture_text(@routine_health.level)}
    </p>
    <div class="gl-sec" data-testid="routine-next-action">
      <p class="gh">Do this next</p>
      <p class="gl-big">{@routine_health.next_action.label}</p>
      <p class="gl-sub">{@routine_health.next_action.detail}</p>
      <.text_link navigate={routine_next_action_path(@routine_health.next_action)}>
        {@routine_health.next_action.cta}
      </.text_link>
    </div>
  </.band_card>
</.page_frame>
