<div
  class="ember-aurora mx-auto w-full max-w-6xl min-w-0 p-6 lg:p-8"
  data-ui-complex-page
  data-density={@digest_density}
>
  <div class="relative z-[1]">
    <.header>
      <div class="min-w-0">
        <span class="ember-eyebrow">
          Recurring cadence · {@routine_command.active_count} active
        </span>
        <h1 class="ember-ink mt-4 font-serif text-[clamp(30px,4.5vw,44px)] font-510 leading-[1.08] tracking-[-0.02em]">
          {@page_title}
        </h1>
        <p
          :if={@digest_density == "detailed"}
          class="mt-2 max-w-2xl text-[15px] leading-6 text-text-tertiary"
        >
          Recurring autonomous work for company operations.
        </p>
      </div>
      <:actions>
        <.density_switch
          density={@digest_density}
          compact_patch={routine_index_url("compact")}
          detailed_patch={routine_index_url("detailed")}
        />
        <.app_link
          navigate={~p"/routines/new"}
          class="inline-flex min-h-[40px] shrink-0 items-center gap-2 cta-glow rounded-button bg-brand px-4 py-2 text-sm font-510 text-on-primary transition-colors hover:bg-accent"
        >
          <.icon name="hero-plus-mini" class="h-4 w-4" /> New Routine
        </.app_link>
      </:actions>
    </.header>

    <section
      data-testid="routine-command"
      class="mb-5 overflow-hidden rounded-lg border border-border bg-panel shadow-card"
    >
      <div class={[
        "grid gap-4 lg:grid-cols-[minmax(0,1fr)_auto] lg:items-start",
        if(@digest_density == "compact", do: "p-3", else: "p-4")
      ]}>
        <div class="min-w-0">
          <div class="flex flex-wrap items-center gap-2">
            <p class="text-[11px] font-590 uppercase tracking-[0.14em] text-text-quaternary">
              Routine command
            </p>
            <span class={"rounded-full border px-2 py-0.5 text-[11px] font-510 #{routine_command_badge(@routine_command.tone)}"}>
              {@routine_command.badge}
            </span>
          </div>

          <h2 class="mt-2 text-lg font-590 text-text-primary">
            {@routine_command.heading}
          </h2>
          <p
            :if={@digest_density == "detailed"}
            class="mt-1 max-w-3xl text-sm leading-6 text-text-tertiary"
          >
            {@routine_command.detail}
          </p>

          <div
            :if={@digest_density == "detailed" and @routine_command.focus_label}
            class="mt-3 flex flex-wrap items-center gap-2 text-xs"
          >
            <span class="rounded-full border border-border bg-surface px-2 py-1 font-510 text-text-secondary">
              {@routine_command.focus_label}
            </span>
            <span
              :if={@routine_command.focus_detail}
              class="rounded-full border border-border bg-surface px-2 py-1 text-text-tertiary"
            >
              {@routine_command.focus_detail}
            </span>
          </div>

          <div :if={@digest_density == "compact"} class="mt-3 flex flex-wrap gap-1.5 text-xs">
            <span class="inline-flex items-center gap-1.5 rounded-md border border-border bg-surface px-2 py-1 font-510 text-text-secondary">
              <span class="hero-play-mini h-3.5 w-3.5 text-white"></span>
              {@routine_command.active_count} active
            </span>
            <span class="inline-flex items-center gap-1.5 rounded-md border border-border bg-surface px-2 py-1 font-510 text-text-secondary">
              <span class="hero-exclamation-triangle-mini h-3.5 w-3.5 text-white"></span>
              {@routine_command.trigger_gap_count + @routine_command.stale_count +
                @routine_command.failure_count} needs attention
            </span>
            <span class="inline-flex items-center gap-1.5 rounded-md border border-border bg-surface px-2 py-1 font-510 text-text-secondary">
              <span class="hero-pause-mini h-3.5 w-3.5 text-white"></span>
              {@routine_command.paused_count} paused
            </span>
          </div>
        </div>

        <.app_link
          navigate={@routine_command.action_path}
          class={"inline-flex shrink-0 items-center justify-center rounded-lg border px-3 py-2 text-sm font-590 transition-colors #{routine_command_action(@routine_command.tone)}"}
        >
          {@routine_command.action_label}
        </.app_link>
      </div>

      <div
        :if={@digest_density == "detailed"}
        class="grid grid-cols-2 border-t border-border sm:grid-cols-5"
      >
        <div class="ember-stat border-r border-border px-4 py-3 last:border-r-0">
          <p class="text-[10px] font-590 uppercase tracking-[0.14em] text-text-quaternary">
            Active
          </p>
          <p class="mt-1 font-mono text-xl font-590 text-emerald-300 tabular-nums">
            {@routine_command.active_count}
          </p>
        </div>
        <div class="ember-stat border-r border-border px-4 py-3 last:border-r-0">
          <p class="text-[10px] font-590 uppercase tracking-[0.14em] text-text-quaternary">
            Trigger gaps
          </p>
          <p class="mt-1 font-mono text-xl font-590 text-red-300 tabular-nums">
            {@routine_command.trigger_gap_count}
          </p>
        </div>
        <div class="ember-stat border-r border-border px-4 py-3 last:border-r-0">
          <p class="text-[10px] font-590 uppercase tracking-[0.14em] text-text-quaternary">
            Stale runs
          </p>
          <p class="mt-1 font-mono text-xl font-590 text-red-300 tabular-nums">
            {@routine_command.stale_count}
          </p>
        </div>
        <div class="ember-stat border-r border-border px-4 py-3 last:border-r-0">
          <p class="text-[10px] font-590 uppercase tracking-[0.14em] text-text-quaternary">
            Failures
          </p>
          <p class="mt-1 font-mono text-xl font-590 text-amber-300 tabular-nums">
            {@routine_command.failure_count}
          </p>
        </div>
        <div class="ember-stat px-4 py-3">
          <p class="text-[10px] font-590 uppercase tracking-[0.14em] text-text-quaternary">
            Paused
          </p>
          <p class="mt-1 font-mono text-xl font-590 text-blue-300 tabular-nums">
            {@routine_command.paused_count}
          </p>
        </div>
      </div>
    </section>

    <section
      :if={@digest_density == "detailed"}
      data-testid="routine-health"
      class="mb-5 rounded-lg border border-border bg-panel px-5 py-4"
    >
      <div class="flex flex-col gap-3 lg:flex-row lg:items-start lg:justify-between">
        <div class="min-w-0">
          <div class="flex flex-wrap items-center gap-2">
            <h2 class="text-sm font-590 text-text-primary">Routine Health</h2>
            <span class={"rounded-full border px-2 py-0.5 text-[11px] font-510 #{routine_health_badge(@routine_health.level)}"}>
              {@routine_health.label}
            </span>
          </div>
          <p class="mt-1 max-w-3xl text-sm leading-5 text-text-tertiary">
            {@routine_health.summary}
          </p>
        </div>

        <div class="grid shrink-0 grid-cols-2 gap-px overflow-hidden rounded-md border border-border bg-border sm:min-w-[360px] sm:grid-cols-4">
          <.routine_health_metric
            label="Active"
            value={@routine_health.metrics.active_routines}
            tone={if @routine_health.metrics.active_routines > 0, do: :ok, else: :neutral}
          />
          <.routine_health_metric
            label="Trigger gaps"
            value={@routine_health.metrics.active_without_triggers}
            tone={
              if @routine_health.metrics.active_without_triggers > 0, do: :critical, else: :ok
            }
          />
          <.routine_health_metric
            label="Stale runs"
            value={@routine_health.metrics.stale_runs}
            tone={if @routine_health.metrics.stale_runs > 0, do: :critical, else: :ok}
          />
          <.routine_health_metric
            label="Failures"
            value={@routine_health.metrics.recent_failures}
            tone={if @routine_health.metrics.recent_failures > 0, do: :warning, else: :ok}
          />
        </div>
      </div>

      <div class="mt-4 grid gap-3 lg:grid-cols-[minmax(0,1fr)_320px]">
        <div :if={@routine_health.recommendations != []} class="grid gap-2 lg:grid-cols-2">
          <div
            :for={recommendation <- @routine_health.recommendations}
            class={"rounded-md border px-3 py-2 #{routine_recommendation_class(recommendation.severity)}"}
          >
            <p class="text-[11px] font-590 uppercase tracking-[0.1em]">
              {recommendation.label}
            </p>
            <p class="mt-1 text-xs leading-5 opacity-85">{recommendation.detail}</p>
          </div>
        </div>

        <div
          :if={@routine_health.recommendations == []}
          class="rounded-md border border-border bg-surface px-3 py-2"
        >
          <p class="text-[11px] font-590 uppercase tracking-[0.1em] text-text-quaternary">
            {routine_posture_label(@routine_health.level)}
          </p>
          <p class="mt-1 text-xs leading-5 text-text-tertiary">
            {routine_posture_text(@routine_health.level)}
          </p>
        </div>

        <div
          data-testid="routine-next-action"
          class={"rounded-md border px-3 py-3 #{routine_next_action_class(@routine_health.next_action.tone)}"}
        >
          <p class="text-[11px] font-590 uppercase tracking-[0.1em] opacity-75">
            Next operator move
          </p>
          <p class="mt-1 text-sm font-590">{@routine_health.next_action.label}</p>
          <p class="mt-1 text-xs leading-5 opacity-85">{@routine_health.next_action.detail}</p>
          <.app_link
            navigate={routine_next_action_path(@routine_health.next_action)}
            class="mt-3 inline-flex min-h-[32px] items-center gap-1.5 rounded-md border border-current/20 px-2.5 py-1.5 text-xs font-590 opacity-90 transition hover:opacity-100"
          >
            {@routine_health.next_action.cta}
            <.icon name="hero-arrow-right-mini" class="h-3.5 w-3.5" />
          </.app_link>
        </div>
      </div>
    </section>

    <.infinite_scroll
      id="routine"
      has_more={@infinite_scroll[:routine][:has_more?] || false}
      container_class={
        if @digest_density == "compact",
          do: "grid grid-cols-1 gap-2",
          else: "grid grid-cols-1 gap-3"
      }
    >
      <:empty>
        <div class="rounded-xl border border-border bg-surface px-6 py-16 text-center">
          <div class="mx-auto mb-3 flex h-10 w-10 items-center justify-center rounded-full bg-subtle text-text-tertiary">
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M4 4v6h6M20 20v-6h-6M20 9A8 8 0 006.34 4.36M4 15a8 8 0 0013.66 4.64"
              />
            </svg>
          </div>
          <h2 class="text-sm font-590 text-text-primary">No routines yet</h2>
          <p class="mt-1 text-sm text-text-tertiary">
            Create the first routine to schedule autonomous work.
          </p>
        </div>
      </:empty>

      <div
        :for={{dom_id, routine} <- @streams.routine}
        id={dom_id}
        class={[
          "card-lift rounded-xl border border-border bg-surface transition-colors hover:border-border-hover hover:bg-surface-hover",
          if(@digest_density == "compact", do: "p-3", else: "p-4")
        ]}
      >
        <div class={[
          "flex flex-col md:flex-row md:items-start md:justify-between",
          if(@digest_density == "compact", do: "gap-2", else: "gap-4")
        ]}>
          <div class="min-w-0 flex-1">
            <div class="mb-2 flex flex-wrap items-center gap-2">
              <.app_link
                navigate={~p"/routines/#{routine.id}"}
                class="truncate text-sm font-590 text-text-primary hover:text-brand"
              >
                {routine.name}
              </.app_link>
              <span class={[
                "inline-flex items-center rounded-md border px-2 py-0.5 text-xs font-510",
                routine_status_class(routine.status)
              ]}>
                {routine_label(routine.status)}
              </span>
              <span class={[
                "inline-flex items-center rounded-md border px-2 py-0.5 text-xs font-510",
                routine_priority_class(routine.priority)
              ]}>
                {routine_label(routine.priority)}
              </span>
            </div>
            <p
              :if={@digest_density == "detailed"}
              class="max-w-3xl text-sm leading-5 text-text-tertiary"
            >
              {routine.description || "No description provided."}
            </p>
            <div
              :if={@digest_density == "detailed"}
              class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-text-quaternary"
            >
              <span>{routine_label(routine.concurrency_policy)}</span>
              <span>Catch-up: {routine_label(routine.catch_up_policy)}</span>
              <span>Cap {routine.catch_up_cap}</span>
            </div>
          </div>

          <div class="flex shrink-0 flex-wrap items-center gap-2">
            <.app_link
              navigate={~p"/routines/#{routine.id}"}
              class="rounded-lg border border-border bg-button px-3 py-2 text-xs font-510 text-text-secondary transition-colors hover:bg-button-hover hover:text-text-primary"
            >
              View
            </.app_link>
            <.app_link
              navigate={~p"/routines/#{routine.id}/edit"}
              class="rounded-lg border border-border bg-button px-3 py-2 text-xs font-510 text-text-secondary transition-colors hover:bg-button-hover hover:text-text-primary"
            >
              Edit
            </.app_link>
            <button
              :if={routine.status == :active}
              type="button"
              class="rounded-lg border border-amber-500/20 bg-amber-500/10 px-3 py-2 text-xs font-510 text-amber-400 transition-colors hover:bg-amber-500/15"
              phx-click="pause_routine"
              phx-value-id={routine.id}
              data-confirm="Pause this routine?"
            >
              Pause
            </button>
            <button
              :if={routine.status == :paused}
              type="button"
              class="rounded-lg border border-success/20 bg-success/10 px-3 py-2 text-xs font-510 text-success transition-colors hover:bg-success/15"
              phx-click="resume_routine"
              phx-value-id={routine.id}
              data-confirm="Resume this routine?"
            >
              Resume
            </button>
            <button
              :if={routine.status != :archived}
              type="button"
              class="rounded-lg border border-red-500/20 bg-red-500/10 px-3 py-2 text-xs font-510 text-red-400 transition-colors hover:bg-red-500/15"
              phx-click="delete_routine"
              phx-value-id={routine.id}
              data-confirm="Archive this routine?"
            >
              Archive
            </button>
          </div>
        </div>
      </div>
    </.infinite_scroll>
  </div>
</div>
