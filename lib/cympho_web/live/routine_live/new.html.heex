<.page size="wide" class="ember-aurora" data-ui-complex-page>
  <div class="relative z-[1]">
    <.header>
      <div class="min-w-0">
        <span class="ember-eyebrow">New automation</span>
        <h1 class="ember-ink mt-4 font-serif text-[clamp(30px,4.5vw,44px)] font-510 leading-[1.08] tracking-[-0.02em]">
          New Routine
        </h1>
        <p class="mt-2 max-w-2xl text-[15px] leading-6 text-text-tertiary">
          Schedule recurring autonomous work.
        </p>
      </div>
      <:actions>
        <.app_link
          navigate={~p"/routines"}
          class="rounded-lg border border-border bg-button px-4 py-2 text-sm font-510 text-text-secondary transition-colors hover:bg-button-hover hover:text-text-primary"
        >
          Cancel
        </.app_link>
      </:actions>
    </.header>

    <.form
      for={@form}
      phx-submit="save"
      class="grid gap-5 lg:grid-cols-[minmax(0,1fr)_320px] lg:items-start"
    >
      <section class="ember-glass overflow-hidden">
        <div class="border-b border-white/10 px-5 py-4">
          <p class="text-[11px] font-590 uppercase tracking-[0.14em] text-text-quaternary">
            Routine launch plan
          </p>
          <%!-- Each section below printed a sentence describing itself before any
               field. They stay on hover and for screen readers. --%>
          <h2
            class="mt-1 text-lg font-590 text-text-primary"
            title="Give the routine enough owner and project context that each run creates useful, reviewable work instead of floating tasks."
          >
            Create the recurring work packet<span class="sr-only">
              — give the routine enough owner and project context that each run creates useful, reviewable work instead of floating tasks.</span>
          </h2>
        </div>

        <div class="space-y-6 p-5">
          <section class="space-y-4">
            <p
              class="text-xs font-590 uppercase tracking-[0.1em] text-text-quaternary"
              title="This becomes the issue brief every time the routine fires."
            >
              Work packet<span class="sr-only">
                — this becomes the issue brief every time the routine fires.</span>
            </p>

            <.input
              field={@form[:name]}
              label="Name"
              required
              placeholder="Weekly release readiness"
            />
            <.input
              field={@form[:description]}
              label="Run brief"
              type="textarea"
              rows={5}
              placeholder="Check release blockers, update the owner, and create follow-up issues for unresolved risks."
            />
          </section>

          <section class="space-y-4 rounded-lg border border-border bg-surface/70 px-4 py-4">
            <p
              class="text-xs font-590 uppercase tracking-[0.1em] text-text-quaternary"
              title="Pick the default agent and project context for work created by this routine."
            >
              Ownership<span class="sr-only">
                — pick the default agent and project context for work created by this routine.</span>
            </p>

            <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
              <.input
                type="select"
                field={@form[:agent_id]}
                label="Default owner"
                value={@form[:agent_id].value || ""}
                options={@agent_options}
              />
              <.input
                type="select"
                field={@form[:project_id]}
                label="Project context"
                value={@form[:project_id].value || ""}
                options={@project_options}
              />
            </div>
          </section>

          <section class="space-y-4">
            <p
              class="text-xs font-590 uppercase tracking-[0.1em] text-text-quaternary"
              title="Decide how the routine behaves when a previous run is still active."
            >
              Run policy<span class="sr-only">
                — decide how the routine behaves when a previous run is still active.</span>
            </p>

            <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
              <.input
                type="select"
                field={@form[:priority]}
                label="Priority"
                value={@form[:priority].value || :medium}
                options={[
                  {"Critical", "critical"},
                  {"High", "high"},
                  {"Medium", "medium"},
                  {"Low", "low"}
                ]}
              />
              <.input
                type="select"
                field={@form[:concurrency_policy]}
                label="Concurrency policy"
                value={@form[:concurrency_policy].value || :coalesce_if_active}
                options={[
                  {"Coalesce if active", "coalesce_if_active"},
                  {"Skip if active", "skip_if_active"},
                  {"Always enqueue", "always_enqueue"}
                ]}
              />
              <.input
                type="select"
                field={@form[:catch_up_policy]}
                label="Catch-up policy"
                value={@form[:catch_up_policy].value || :skip_missed}
                options={[
                  {"Skip missed", "skip_missed"},
                  {"Enqueue missed with cap", "enqueue_missed_with_cap"}
                ]}
              />
              <.input
                type="number"
                field={@form[:catch_up_cap]}
                label="Catch-up cap"
                value={@form[:catch_up_cap].value || 5}
                min="1"
              />
            </div>
          </section>
        </div>
      </section>

      <aside class="ui-advanced-only space-y-4">
        <%!-- Steps 1 and 2 restated the form sections they sit next to. The
             checklist is worth keeping for a first routine, not worth the
             column of prose on every visit, so it opens on demand. --%>
        <details
          data-testid="routine-setup-checklist"
          class="rounded-xl border border-border bg-panel p-4 shadow-card"
        >
          <summary class="cursor-pointer list-none text-[11px] font-590 uppercase tracking-[0.14em] text-text-quaternary [&::-webkit-details-marker]:hidden">
            Setup checklist
          </summary>
          <div class="mt-4 space-y-3">
            <div class="flex gap-3">
              <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full border border-success/30 bg-success/10 text-xs font-590 text-success">
                1
              </span>
              <div>
                <p class="text-sm font-590 text-text-primary">Define the work packet</p>
                <p class="mt-1 text-xs leading-5 text-text-tertiary">
                  Name the recurring outcome and the evidence each run should produce.
                </p>
              </div>
            </div>
            <div class="flex gap-3">
              <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full border border-brand/30 bg-brand/10 text-xs font-590 text-brand">
                2
              </span>
              <div>
                <p class="text-sm font-590 text-text-primary">Assign owner context</p>
                <p class="mt-1 text-xs leading-5 text-text-tertiary">
                  Keep generated work out of the floating backlog.
                </p>
              </div>
            </div>
            <div class="flex gap-3">
              <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full border border-amber-500/30 bg-amber-500/10 text-xs font-590 text-amber-200">
                3
              </span>
              <div>
                <p class="text-sm font-590 text-text-primary">Attach a trigger after save</p>
                <p class="mt-1 text-xs leading-5 text-text-tertiary">
                  A routine is only automatic once it has a schedule or webhook trigger.
                </p>
              </div>
            </div>
          </div>
        </details>
      </aside>

      <div class="border-t border-border pt-4 lg:col-span-2">
        <div class="flex flex-col-reverse gap-2 sm:flex-row sm:items-center sm:justify-end">
          <.app_link
            navigate={~p"/routines"}
            class="inline-flex min-h-[40px] items-center justify-center rounded-lg border border-border bg-button px-4 py-2 text-sm font-510 text-text-secondary transition-colors hover:bg-button-hover hover:text-text-primary"
          >
            Cancel
          </.app_link>
          <button
            type="submit"
            class="inline-flex min-h-[40px] items-center justify-center cta-glow rounded-button bg-brand px-4 py-2 text-sm font-510 text-on-primary transition-colors hover:bg-accent"
          >
            Create Routine
          </button>
        </div>
        <%!-- Was a "Create behavior" prose panel beside the form, matching
             /projects/new: one sentence under the button that triggers it. --%>
        <p class="mt-2 text-xs leading-5 text-text-tertiary sm:text-right">
          Starts active. Attach a schedule or webhook trigger after save to make it run.
        </p>
      </div>
    </.form>
  </div>
</.page>
