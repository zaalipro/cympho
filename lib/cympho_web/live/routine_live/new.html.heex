<.page_frame
  page="routine-form"
  kind={:deep}
  parent={{"/routines", "Repeating tasks"}}
  current="New repeating task"
  data-ui-complex-page
>
  <:head>
    <section class="head" aria-labelledby="rf-h">
      <h1 class="h1 big" id="rf-h">New repeating task</h1>
      <p class="sub">Work the team should do again and again, on a schedule.</p>
    </section>
  </:head>

  <.flash_line flash={@flash} />

  <.routine_form
    form={@form}
    agent_options={@agent_options}
    project_options={@project_options}
    effect="It files a task each time it runs; you add its schedule next."
    submit="Create repeating task"
    heading="After you create it"
    verb="create"
    cancel={~p"/routines"}
  />
</.page_frame>
