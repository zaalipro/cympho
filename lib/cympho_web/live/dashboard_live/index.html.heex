<.page size="wide" data-ui-complex-page>
  <% primary_next =
    @primary_next_action || %{path: ~p"/operations", label: "Open Operations", action: "Open"} %>

  <div class="relative z-10">
    <%!-- ============================================================
         Hero — calm flat greeting on the warm canvas (Claude-style).
         The status line keeps the mission-control rhythm: animated
         pulse dot · autonomy · operating mode.
         ============================================================ --%>
    <div class="mb-8 px-1">
      <.header>
        <div class="min-w-0">
          <div class="flex items-center gap-2 text-[11px] font-510 tracking-[0.08em] text-text-quaternary">
            <span
              class={[
                "cympho-pulse-dot inline-block h-2 w-2 rounded-full",
                autonomy_dot_color(@autonomy_status)
              ]}
              style={"--cympho-pulse-color: #{autonomy_pulse_color(@autonomy_status)};"}
            >
            </span>
            <span class="text-text-tertiary">Autonomous company</span>
            <span class="text-text-quaternary/60">·</span>
            <span class={[autonomy_text_class(@autonomy_status)]}>
              {status_label(@autonomy_status)}
            </span>
            <span class="text-text-quaternary/60">·</span>
            <span class={[mode_text_class(@operating_mode)]}>
              {status_label(@operating_mode)}
            </span>
          </div>
          <h1 class="mt-3 flex items-center gap-2.5 font-serif text-headline text-text-primary">
            <.spark class="h-[0.8em] w-[0.8em] text-brand" /> What's up next?
          </h1>
          <p class="ui-advanced-only mt-1 max-w-2xl text-sm leading-5 text-text-tertiary">
            Decide what the company should do next, then watch agents execute it.
          </p>
        </div>
        <:actions>
          <.overflow_menu label="Company controls">
            <.menu_item
              :if={@company && @autonomy_status == :active && @operating_mode != :low_power}
              phx-click="low_power_company"
              data-confirm="Switch to low power? Only high and critical queued work will auto-dispatch."
            >
              Low power
            </.menu_item>
            <.menu_item
              :if={@company && @autonomy_status == :active && @operating_mode == :low_power}
              phx-click="resume_company"
            >
              Resume full power
            </.menu_item>
            <.menu_item
              :if={@company && @autonomy_status == :active}
              phx-click="pause_company"
              data-confirm="Pause autonomous execution for this company?"
            >
              Pause autonomy
            </.menu_item>
            <.menu_item :if={@company && @autonomy_status == :paused} phx-click="resume_company">
              Resume autonomy
            </.menu_item>
            <.menu_item navigate={~p"/onboarding"}>Start company setup</.menu_item>
          </.overflow_menu>
          <.app_link
            navigate={~p"/kanban"}
            class="cta-glow rounded-button bg-brand px-3 py-2 text-sm font-590 text-on-primary shadow-card hover:bg-accent-hover"
          >
            Open board
          </.app_link>
        </:actions>
      </.header>
    </div>

    <div class="ui-simple-only stagger-children mb-4 grid gap-2 sm:grid-cols-2 xl:grid-cols-4">
      <a
        href={Map.get(primary_next, :path, ~p"/operations")}
        class="ui-simple-card group flex min-w-0 items-center gap-3 px-3 py-3 transition hover:border-border-hover hover:bg-surface-hover"
      >
        <span class="ui-simple-icon">
          <span class="hero-sparkles-mini h-4 w-4"></span>
        </span>
        <span class="min-w-0">
          <span class="block text-[10px] font-590 uppercase tracking-[0.12em] text-text-quaternary">
            Next
          </span>
          <span class="mt-0.5 block truncate text-sm font-590 text-text-primary group-hover:text-brand">
            {Map.get(primary_next, :label, "Open Operations")}
          </span>
        </span>
      </a>
      <a
        href={~p"/operations"}
        class="ui-simple-card group flex min-w-0 items-center gap-3 px-3 py-3 transition hover:border-border-hover hover:bg-surface-hover"
      >
        <span class="ui-simple-icon">
          <span class="hero-bolt-mini h-4 w-4"></span>
        </span>
        <span class="min-w-0">
          <span class="block text-[10px] font-590 uppercase tracking-[0.12em] text-text-quaternary">
            Mode
          </span>
          <span class={[
            "mt-0.5 block truncate text-sm font-590",
            mode_text_class(@operating_mode)
          ]}>
            {status_label(@operating_mode)}
          </span>
        </span>
      </a>
      <a
        href={~p"/operations#runtime-capacity"}
        class="ui-simple-card group flex min-w-0 items-center gap-3 px-3 py-3 transition hover:border-border-hover hover:bg-surface-hover"
      >
        <span class="ui-simple-icon">
          <span class="hero-cpu-chip-mini h-4 w-4"></span>
        </span>
        <span class="min-w-0">
          <span class="block text-[10px] font-590 uppercase tracking-[0.12em] text-text-quaternary">
            Capacity
          </span>
          <span class="mt-0.5 block truncate text-sm font-590 text-text-primary">
            {@runtime_capacity.label}
          </span>
        </span>
      </a>
      <a
        href={~p"/issues?status=blocked"}
        class="ui-simple-card group flex min-w-0 items-center gap-3 px-3 py-3 transition hover:border-border-hover hover:bg-surface-hover"
      >
        <span class="ui-simple-icon">
          <span class="hero-no-symbol-mini h-4 w-4"></span>
        </span>
        <span class="min-w-0">
          <span class="block text-[10px] font-590 uppercase tracking-[0.12em] text-text-quaternary">
            Blocked
          </span>
          <span class={[
            "mt-0.5 block truncate text-sm font-590",
            if(@blocked_work > 0, do: "text-brand", else: "text-text-primary")
          ]}>
            {@blocked_work} needs action
          </span>
        </span>
      </a>
    </div>

    <%!-- ============================================================
         Operating-mode strip — three columns, properly proportioned
         so descriptions stop truncating. Right column hosts the
         radial pressure gauge (replaces the old 1.5px flat bar).
         ============================================================ --%>
    <div class="ui-advanced-only mb-4 grid grid-cols-1 gap-3 rounded-2xl border border-hairline bg-surface-1 p-5 shadow-card xl:grid-cols-[minmax(220px,0.85fr)_minmax(0,1.75fr)_minmax(280px,0.95fr)] xl:gap-5">
      <section class="min-w-0">
        <div class="flex flex-wrap items-center gap-2">
          <p class="text-[11px] font-590 uppercase tracking-[0.14em] text-text-quaternary">
            Operating mode
          </p>
          <span class={"inline-flex items-center rounded-full border px-2 py-0.5 text-[11px] font-510 #{mode_badge_class(@operating_mode)}"}>
            {status_label(@operating_mode)}
          </span>
        </div>
        <p class="mt-2 text-sm leading-5 text-text-tertiary">
          <%= case @operating_mode do %>
            <% :review -> %>
              Inspect and edit safely without provider spend.
            <% :autonomous -> %>
              Runtime is enabled and agents can pick up queued work.
            <% :low_power -> %>
              Runtime is live, but only high and critical queued work auto-dispatches.
            <% :paused -> %>
              Autonomy is paused; work stays visible.
            <% _ -> %>
              Finish setup so agents have a mission and roster.
          <% end %>
        </p>
      </section>

      <section class="min-w-0 border-y border-border/70 py-3 xl:border-x xl:border-y-0 xl:px-5 xl:py-0">
        <div class="flex items-center justify-between gap-3">
          <p class="text-[11px] font-590 uppercase tracking-[0.14em] text-text-quaternary">
            Owner action plan
          </p>
          <a
            href="/operations"
            class="shrink-0 text-xs font-590 text-brand hover:text-accent-hover"
          >
            Open Operations →
          </a>
        </div>

        <a
          :if={@primary_next_action}
          href={Map.get(@primary_next_action, :path, "/operations")}
          class={"mt-3 block rounded-lg border px-3 py-3 transition hover:bg-surface-hover/40 #{next_action_card_class(Map.get(@primary_next_action, :tone, :ok))}"}
        >
          <div class="flex flex-wrap items-center gap-2">
            <span class={[
              "rounded-full border px-2 py-0.5 text-[10px] font-590 uppercase tracking-[0.1em]",
              next_action_pill_class(Map.get(@primary_next_action, :tone, :ok))
            ]}>
              {primary_action_badge(@primary_next_action)}
            </span>
            <span class="text-[11px] font-590 text-text-quaternary">
              {Map.get(@primary_next_action, :action, "Open")}
            </span>
          </div>
          <p class="mt-2 text-sm font-590 text-text-primary">
            {Map.get(@primary_next_action, :label)}
          </p>
          <p class="mt-1 line-clamp-2 text-xs leading-4 text-text-tertiary">
            {Map.get(@primary_next_action, :detail)}
          </p>
        </a>

        <div
          :if={@owner_signoff_decision}
          data-testid="dashboard-owner-signoff-actions"
          class="mt-2 rounded-lg border border-teal-500/20 bg-teal-500/[0.05] px-3 py-2.5"
        >
          <p class="truncate text-xs font-590 text-text-primary">
            {@owner_signoff_decision.issue_identifier} · {@owner_signoff_decision.issue_title}
          </p>
          <p class="mt-1 line-clamp-2 text-[11px] leading-4 text-text-tertiary">
            {@owner_signoff_decision.owner_update ||
              "CEO owner update is ready for owner decision."}
          </p>
          <div class="mt-2 flex flex-wrap gap-1.5">
            <button
              type="button"
              phx-click="accept_owner_verification"
              phx-value-issue-id={@owner_signoff_decision.issue_id}
              data-confirm="Accept this CEO owner update and close the issue?"
              class="inline-flex items-center justify-center rounded-md border border-teal-500/25 bg-teal-500/10 px-2.5 py-1.5 text-xs font-510 text-teal-200 transition hover:bg-teal-500/15"
            >
              Accept and close
            </button>
            <button
              type="button"
              phx-click="request_owner_revision"
              phx-value-issue-id={@owner_signoff_decision.issue_id}
              data-confirm="Request a CEO revision, reopen this issue to To Do, and queue focused dispatch?"
              class="inline-flex items-center justify-center rounded-md border border-border bg-panel px-2.5 py-1.5 text-xs font-510 text-text-secondary transition hover:border-border-hover hover:bg-surface-hover hover:text-text-primary"
            >
              Request revision
            </button>
          </div>
        </div>

        <div :if={@secondary_next_actions != []} class="mt-3">
          <p class="text-[10px] font-590 uppercase tracking-[0.14em] text-text-quaternary">
            Up next
          </p>
          <ul class="mt-1.5 space-y-1">
            <li
              :for={{action, idx} <- Enum.with_index(Enum.take(@secondary_next_actions, 5), 2)}
              class="group min-w-0"
            >
              <a
                href={Map.get(action, :path, "/operations")}
                class="flex items-start gap-3 rounded-md border-l-2 border-transparent py-1 pl-3 pr-2 transition hover:border-brand hover:bg-surface/40"
                title={action.detail}
              >
                <span class="mt-0.5 w-5 shrink-0 font-mono text-[11px] tabular-nums text-text-quaternary">
                  {String.pad_leading(Integer.to_string(idx), 2, "0")}
                </span>
                <span class="min-w-0 flex-1">
                  <span class="block truncate text-sm font-510 text-text-primary group-hover:text-text-primary">
                    {action.label}
                  </span>
                  <span class="block truncate text-[11px] font-590 text-brand">
                    {action.action}
                  </span>
                </span>
              </a>
            </li>
          </ul>
        </div>
      </section>

      <section class="min-w-0">
        <div class="flex items-center justify-between gap-3">
          <p class="text-[11px] font-590 uppercase tracking-[0.14em] text-text-quaternary">
            Runtime capacity
          </p>
          <span class={"inline-flex items-center rounded-full border px-2 py-0.5 text-[11px] font-510 #{capacity_badge_class(@runtime_capacity.level)}"}>
            {@runtime_capacity.local_slots} local slots
          </span>
        </div>
        <div class="mt-3 flex items-center gap-4">
          <div class={["relative shrink-0", capacity_text_class(@runtime_capacity.level)]}>
            <svg viewBox="0 0 50 50" class="h-16 w-16 -rotate-90">
              <circle
                cx="25"
                cy="25"
                r="20"
                fill="none"
                stroke="rgba(255,255,255,0.06)"
                stroke-width="4"
              />
              <circle
                cx="25"
                cy="25"
                r="20"
                fill="none"
                stroke="currentColor"
                stroke-width="4"
                stroke-linecap="round"
                stroke-dasharray={gauge_arc(capacity_percent(@runtime_capacity))}
              />
            </svg>
            <div class="pointer-events-none absolute inset-0 flex flex-col items-center justify-center">
              <span class="font-mono text-[14px] font-590 leading-none tabular-nums text-text-primary">
                {capacity_percent(@runtime_capacity)}%
              </span>
            </div>
          </div>
          <div class="min-w-0 flex-1">
            <h2 class="truncate text-base font-590 text-text-primary">
              {@runtime_capacity.label}
            </h2>
            <p class="mt-0.5 text-[11px] text-text-quaternary">
              <span class="font-mono tabular-nums text-text-tertiary">
                {@runtime_capacity.running_runs}
              </span>
              running · CLI/process pressure
            </p>
            <p class="mt-1.5 line-clamp-2 text-xs leading-4 text-text-tertiary">
              {@runtime_capacity.summary}
            </p>
          </div>
        </div>
      </section>
    </div>

    <section
      :if={@ceo_command_lane}
      id="dashboard-ceo-command-lane"
      data-testid="dashboard-ceo-command-lane"
      class="ui-advanced-only mb-5 overflow-hidden rounded-2xl border border-hairline bg-surface-1 shadow-card"
    >
      <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,1.6fr)_minmax(260px,0.8fr)]">
        <div class="min-w-0 p-4">
          <div class="flex flex-wrap items-center gap-2">
            <p class="text-[11px] font-590 uppercase tracking-[0.14em] text-text-quaternary">
              CEO command lane
            </p>
            <span class={"inline-flex items-center rounded-full border px-2 py-0.5 text-[11px] font-510 #{ceo_command_stage_class(@ceo_command_lane.stage)}"}>
              {@ceo_command_lane.label}
            </span>
          </div>
          <h2 class="mt-1 text-base font-590 text-text-primary">
            First useful CEO result
          </h2>
          <p class="mt-1 max-w-3xl text-sm leading-5 text-text-tertiary">
            {@ceo_command_lane.summary}
          </p>

          <div
            :if={@ceo_command_lane.candidate}
            class="mt-4 border-t border-border pt-3"
          >
            <div class="flex flex-col gap-2 sm:flex-row sm:items-start sm:justify-between">
              <a
                href={@ceo_command_lane.candidate.target_path}
                class="group min-w-0 text-sm font-590 text-text-primary hover:text-brand"
              >
                <span class="font-mono text-[12px] text-brand">
                  {@ceo_command_lane.candidate.identifier}
                </span>
                <span class="mx-1 text-text-quaternary">/</span>
                <span class="break-words group-hover:text-brand">
                  {@ceo_command_lane.candidate.title}
                </span>
              </a>
              <span class="shrink-0 rounded-full border border-border bg-surface/50 px-2 py-0.5 text-[11px] font-510 text-text-tertiary">
                {@ceo_command_lane.candidate.status_label}
              </span>
            </div>

            <div class="mt-2 flex flex-wrap gap-2">
              <span class={"inline-flex items-center rounded-full border px-2 py-0.5 text-[11px] font-510 #{ceo_command_stage_class(@ceo_command_lane.candidate.brief_readiness_status)}"}>
                Owner brief {@ceo_command_lane.candidate.brief_readiness_score || "-"}
              </span>
              <span class={"inline-flex items-center rounded-full border px-2 py-0.5 text-[11px] font-510 #{ceo_command_stage_class(@ceo_command_lane.candidate.preflight_status)}"}>
                {@ceo_command_lane.candidate.preflight_label}
              </span>
            </div>

            <p class="mt-2 line-clamp-2 text-xs leading-4 text-text-tertiary">
              {@ceo_command_lane.candidate.brief_readiness_label} · {@ceo_command_lane.candidate.brief_readiness_next ||
                @ceo_command_lane.candidate.preflight_summary}
            </p>

            <div
              :if={
                @ceo_command_lane.candidate.focused_command &&
                  @ceo_command_lane.candidate.brief_readiness_status == :ready
              }
              id="dashboard-ceo-focused-command"
              data-testid="dashboard-ceo-focused-command"
              phx-hook="CopyToClipboard"
              class="mt-3 rounded-lg border border-border bg-canvas/70 px-3 py-2.5"
            >
              <div class="flex flex-wrap items-center justify-between gap-2">
                <p class="text-[10px] font-590 uppercase tracking-[0.14em] text-text-quaternary">
                  Focused command
                </p>
                <button
                  type="button"
                  data-copy-text={@ceo_command_lane.candidate.focused_command}
                  data-copy-label="Copy command"
                  data-copy-success-label="Copied"
                  class="rounded-md border border-border bg-panel px-2 py-1 text-[11px] font-510 text-text-secondary transition hover:border-border-hover hover:bg-surface-hover hover:text-text-primary"
                >
                  Copy command
                </button>
              </div>
              <code class="mt-1.5 block overflow-x-auto whitespace-pre-wrap font-mono text-[11px] leading-5 text-text-secondary">
                {@ceo_command_lane.candidate.focused_command}
              </code>
            </div>
          </div>
        </div>

        <div class="border-t border-border p-4 lg:border-l lg:border-t-0">
          <p class="text-[11px] font-590 uppercase tracking-[0.14em] text-text-quaternary">
            Next operator move
          </p>
          <a
            href={@ceo_command_lane.action_path}
            class={"mt-3 inline-flex w-full items-center justify-between gap-3 rounded-lg border px-3 py-2.5 text-sm font-590 transition hover:bg-surface-hover/50 #{next_action_card_class(@ceo_command_lane.action_tone)}"}
          >
            <span class="min-w-0 truncate text-text-primary">
              {@ceo_command_lane.action_label}
            </span>
            <span class={"shrink-0 rounded-full border px-2 py-0.5 text-[10px] uppercase tracking-[0.1em] #{next_action_pill_class(@ceo_command_lane.action_tone)}"}>
              Open
            </span>
          </a>

          <a
            href="/operations#ceo-flow-verifier"
            class="mt-3 inline-flex text-xs font-590 text-text-tertiary hover:text-text-primary"
          >
            Inspect CEO flow in Operations
          </a>
        </div>
      </div>

      <div
        :if={@ceo_command_lane.steps != []}
        class="stagger-children grid grid-cols-2 border-t border-border md:grid-cols-4"
      >
        <div
          :for={step <- @ceo_command_lane.steps}
          class={"min-w-0 border-r border-border px-4 py-3 last:border-r-0 #{ceo_command_step_class(step.state)}"}
        >
          <div class="flex items-center justify-between gap-2">
            <p class="truncate text-[10px] font-590 uppercase tracking-[0.12em] text-text-quaternary">
              {step.label}
            </p>
            <span class={["h-2 w-2 shrink-0 rounded-full", ceo_command_step_dot(step.state)]}>
            </span>
          </div>
          <div class="mt-1 flex items-end gap-2">
            <span class="font-mono text-[24px] font-590 leading-none tabular-nums text-text-primary">
              {step.value}
            </span>
            <span class="pb-0.5 text-[11px] font-510 text-text-tertiary">
              {status_label(step.state)}
            </span>
          </div>
          <p class="mt-1 truncate text-xs text-text-quaternary">{step.detail}</p>
        </div>
      </div>
    </section>

    <section
      data-testid="autonomy-readiness"
      class="ui-advanced-only mb-5 rounded-2xl border border-hairline bg-surface-1 p-4 shadow-card"
    >
      <div class="flex flex-col gap-4 lg:flex-row lg:items-start lg:justify-between">
        <div class="min-w-0">
          <div class="flex flex-wrap items-center gap-2">
            <p class="text-[11px] font-590 uppercase tracking-[0.14em] text-text-quaternary">
              Autonomy readiness
            </p>
            <span class={"inline-flex items-center rounded-full border px-2 py-0.5 text-[11px] font-510 #{readiness_badge_class(@autonomy_readiness.level)}"}>
              {@autonomy_readiness.label}
            </span>
          </div>
          <h2 class="mt-1 text-base font-590 text-text-primary">
            Can agents run, inspect, and report safely?
          </h2>
          <p class="mt-1 max-w-3xl text-sm leading-5 text-text-tertiary">
            {@autonomy_readiness.summary}
          </p>
        </div>

        <div class="flex shrink-0 items-end gap-2">
          <p class={[
            "font-mono text-[40px] font-590 leading-none tabular-nums",
            readiness_score_text(@autonomy_readiness.level)
          ]}>
            {@autonomy_readiness.score}
          </p>
          <p class="pb-1 text-[11px] font-590 uppercase tracking-[0.14em] text-text-quaternary">
            / 100
          </p>
        </div>
      </div>

      <div class="stagger-children mt-4 grid grid-cols-1 gap-2 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-6">
        <a
          :for={signal <- @autonomy_readiness.signals}
          href={signal.path}
          class={"group rounded-lg border px-3 py-3 transition hover:bg-surface-hover/50 #{readiness_signal_class(signal.level)}"}
        >
          <div class="flex items-start justify-between gap-2">
            <div class="min-w-0">
              <p class="text-[10px] font-590 uppercase tracking-[0.12em] text-text-quaternary">
                {signal.label}
              </p>
              <p class={["mt-1 text-sm font-590", readiness_signal_text(signal.level)]}>
                {signal.health_label}
              </p>
            </div>
            <span class={[
              "shrink-0 font-mono text-[18px] font-590 tabular-nums",
              readiness_signal_text(signal.level)
            ]}>
              {signal.metric}
            </span>
          </div>
          <p class="mt-2 line-clamp-2 min-h-8 text-xs leading-4 text-text-tertiary">
            {signal.summary}
          </p>
          <div class="mt-3 flex items-center justify-between gap-2 text-[11px] font-590 text-text-secondary transition group-hover:text-text-primary">
            <span>{Map.get(signal, :action_label, "Open")}</span>
            <span class="hero-arrow-up-right-mini h-3.5 w-3.5 shrink-0"></span>
          </div>
        </a>
      </div>

      <div
        :if={@autonomy_readiness.paperclip}
        data-testid="operating-readiness"
        class="mt-4 rounded-lg border border-border bg-canvas/55 p-3"
      >
        <div class="flex flex-col gap-3 lg:flex-row lg:items-start lg:justify-between">
          <div class="min-w-0">
            <div class="flex flex-wrap items-center gap-2">
              <p class="text-[11px] font-590 uppercase tracking-[0.14em] text-text-quaternary">
                Autonomous operating readiness
              </p>
              <span class={"inline-flex items-center rounded-full border px-2 py-0.5 text-[11px] font-510 #{readiness_badge_class(@autonomy_readiness.paperclip.level)}"}>
                {@autonomy_readiness.paperclip.label}
              </span>
            </div>
            <p class="mt-1 max-w-3xl text-sm leading-5 text-text-tertiary">
              {@autonomy_readiness.paperclip.summary}
            </p>
          </div>

          <div class="grid shrink-0 grid-cols-3 divide-x divide-border overflow-hidden rounded-md border border-border bg-surface/40">
            <div class="px-3 py-2">
              <p class="text-[10px] font-590 uppercase tracking-[0.12em] text-text-quaternary">
                Ready
              </p>
              <p class="mt-1 font-mono text-[20px] font-590 leading-none tabular-nums text-teal-300">
                {@autonomy_readiness.paperclip.ready_count}
              </p>
            </div>
            <div class="px-3 py-2">
              <p class="text-[10px] font-590 uppercase tracking-[0.12em] text-text-quaternary">
                Review
              </p>
              <p class="mt-1 font-mono text-[20px] font-590 leading-none tabular-nums text-amber-300">
                {@autonomy_readiness.paperclip.attention_count}
              </p>
            </div>
            <div class="px-3 py-2">
              <p class="text-[10px] font-590 uppercase tracking-[0.12em] text-text-quaternary">
                Setup
              </p>
              <p class="mt-1 font-mono text-[20px] font-590 leading-none tabular-nums text-text-tertiary">
                {@autonomy_readiness.paperclip.missing_count}
              </p>
            </div>
          </div>
        </div>

        <div class="stagger-children mt-3 grid gap-2 md:grid-cols-2 xl:grid-cols-3">
          <a
            :for={primitive <- @autonomy_readiness.paperclip.primitives}
            href={primitive.path}
            class={"group rounded-md border px-3 py-2.5 transition hover:bg-surface-hover/50 #{readiness_signal_class(primitive.level)}"}
          >
            <div class="flex items-start justify-between gap-2">
              <div class="min-w-0">
                <p class="truncate text-[10px] font-590 uppercase tracking-[0.12em] text-text-quaternary">
                  {primitive.label}
                </p>
                <p class={["mt-1 text-sm font-590", readiness_signal_text(primitive.level)]}>
                  {primitive.health_label}
                </p>
              </div>
              <span class={[
                "shrink-0 font-mono text-[16px] font-590 tabular-nums",
                readiness_signal_text(primitive.level)
              ]}>
                {primitive.metric}
              </span>
            </div>
            <p class="mt-1.5 line-clamp-2 min-h-8 text-xs leading-4 text-text-tertiary">
              {primitive.summary}
            </p>
            <div class="mt-3 flex items-center justify-between gap-2 text-[11px] font-590 text-text-secondary transition group-hover:text-text-primary">
              <span>{Map.get(primitive, :action_label, "Open")}</span>
              <span class="hero-arrow-up-right-mini h-3.5 w-3.5 shrink-0"></span>
            </div>
          </a>
        </div>
      </div>
    </section>

    <%!-- ============================================================
         Execution Health — tone-keyed tiles with gradient atmosphere,
         monospace display-md numbers, hero-icon accents.
         ============================================================ --%>
    <div class="mb-5 rounded-2xl border border-hairline bg-surface-1 p-4 shadow-card">
      <div class="mb-4 flex flex-col gap-1 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <p class="text-[11px] font-590 uppercase tracking-[0.14em] text-text-quaternary">
            Execution health
          </p>
          <h2 class="mt-1 text-base font-590 text-text-primary">Owner morning brief</h2>
        </div>
        <a href="/operations" class="text-xs font-590 text-text-tertiary hover:text-text-primary">
          Open Operations →
        </a>
      </div>

      <div class="stagger-children grid grid-cols-2 gap-2.5 md:grid-cols-3 xl:grid-cols-6">
        <a
          :for={signal <- @execution_health}
          href={signal.path}
          class={"group relative overflow-hidden rounded-lg border px-3 py-3 transition hover:bg-surface-hover/40 #{health_signal_class(signal.tone)}"}
        >
          <div class={"pointer-events-none absolute inset-0 bg-gradient-to-br opacity-25 transition group-hover:opacity-40 #{health_tone_glow(signal.tone)}"}>
          </div>
          <div class="relative">
            <div class="flex items-start justify-between gap-2">
              <p class="truncate text-[10px] font-590 uppercase tracking-[0.12em] text-text-quaternary">
                {signal.label}
              </p>
              <span class={["shrink-0", health_tone_text(signal.tone)]}>
                <span class={"hero-#{health_tone_icon(signal.tone)}-mini opacity-70"}></span>
              </span>
            </div>
            <p class={[
              "mt-2 font-mono text-[32px] font-590 leading-none tabular-nums",
              health_tone_text(signal.tone)
            ]}>
              {signal.value}
            </p>
            <p class="mt-2 min-h-8 text-xs leading-4 text-text-tertiary">{signal.hint}</p>
          </div>
        </a>
      </div>
    </div>

    <%!-- ============================================================
         Work Metrics — single instrument band. Five inline columns
         with vertical dividers. Monospace numerals + sparklines.
         ============================================================ --%>
    <div class="stagger-children mb-5 grid grid-cols-2 divide-y divide-border overflow-hidden rounded-2xl border border-hairline bg-surface-1 sm:grid-cols-3 sm:divide-y-0 sm:divide-x lg:grid-cols-6">
      <%!-- Queued --%>
      <div class="px-4 py-3.5 sm:border-r sm:border-border">
        <div class="flex items-center justify-between">
          <p class="text-[10px] font-590 uppercase tracking-[0.14em] text-text-quaternary">
            Queued
          </p>
          <svg
            viewBox="0 0 60 20"
            preserveAspectRatio="none"
            class="h-5 w-14 text-text-quaternary/60"
          >
            <polyline
              points={sparkline_points(throughput_counts(@throughput.created))}
              fill="none"
              stroke="currentColor"
              stroke-width="1.2"
              stroke-linejoin="round"
              stroke-linecap="round"
            />
          </svg>
        </div>
        <p class="mt-1.5 font-mono text-[28px] font-590 leading-none tabular-nums text-text-primary">
          {@queued_work}
        </p>
        <p class="mt-1 truncate text-xs text-text-quaternary">
          Total {total_issues(@issue_status_counts)} issues
        </p>
      </div>

      <%!-- Running --%>
      <div class="px-4 py-3.5 sm:border-r-0 lg:border-r lg:border-border">
        <div class="flex items-center justify-between">
          <p class="text-[10px] font-590 uppercase tracking-[0.14em] text-text-quaternary">
            Running
          </p>
          <span class="hero-play-mini text-brand/70"></span>
        </div>
        <p class="mt-1.5 font-mono text-[28px] font-590 leading-none tabular-nums text-brand">
          {@running_work}
        </p>
        <p class="mt-1 truncate text-xs text-text-quaternary">Checked out</p>
      </div>

      <%!-- Blocked --%>
      <div class="px-4 py-3.5 lg:border-r lg:border-border">
        <div class="flex items-center justify-between">
          <p class="text-[10px] font-590 uppercase tracking-[0.14em] text-text-quaternary">
            Blocked
          </p>
          <span class="hero-no-symbol-mini text-brand/70"></span>
        </div>
        <p class={[
          "mt-1.5 font-mono text-[28px] font-590 leading-none tabular-nums",
          if(@blocked_work > 0, do: "text-brand", else: "text-text-primary")
        ]}>
          {@blocked_work}
        </p>
        <p class="mt-1 truncate text-xs text-text-quaternary">Needs action</p>
      </div>

      <%!-- Agents --%>
      <div class="px-4 py-3.5 lg:border-r lg:border-border">
        <div class="flex items-center justify-between">
          <p class="text-[10px] font-590 uppercase tracking-[0.14em] text-text-quaternary">
            Agents
          </p>
          <span class="hero-user-group-mini text-green-400/70"></span>
        </div>
        <p class="mt-1.5 font-mono text-[28px] font-590 leading-none tabular-nums text-green-300">
          {@active_agents}<span class="text-text-quaternary/80">/{@total_agents}</span>
        </p>
        <p class="mt-1 truncate text-xs text-text-quaternary">Active capacity</p>
      </div>

      <%!-- Goal alignment --%>
      <div class="px-4 py-3.5 lg:border-r lg:border-border">
        <div class="flex items-center justify-between">
          <p class="text-[10px] font-590 uppercase tracking-[0.14em] text-text-quaternary">
            Goal links
          </p>
          <span class="hero-flag-mini text-teal-400/70"></span>
        </div>
        <p class={[
          "mt-1.5 font-mono text-[28px] font-590 leading-none tabular-nums",
          alignment_text_class(@goal_alignment.status)
        ]}>
          {@goal_alignment.aligned_percent}<span class="text-text-quaternary/80">%</span>
        </p>
        <p class="mt-1 truncate text-xs text-text-quaternary">
          {@goal_alignment.floating} floating · {@goal_alignment.goals_without_work} idle goals
        </p>
      </div>

      <%!-- Closed 7d --%>
      <div class="px-4 py-3.5">
        <div class="flex items-center justify-between">
          <p class="text-[10px] font-590 uppercase tracking-[0.14em] text-text-quaternary">
            Closed 7d
          </p>
          <svg viewBox="0 0 60 20" preserveAspectRatio="none" class="h-5 w-14 text-green-400/70">
            <polyline
              points={sparkline_points(throughput_counts(@throughput.closed))}
              fill="none"
              stroke="currentColor"
              stroke-width="1.2"
              stroke-linejoin="round"
              stroke-linecap="round"
            />
          </svg>
        </div>
        <p class="mt-1.5 font-mono text-[28px] font-590 leading-none tabular-nums text-text-primary">
          {throughput_total(@throughput.closed)}
        </p>
        <p class="mt-1 flex min-w-0 items-center gap-1.5 text-xs">
          <span class="truncate text-text-quaternary">
            {cost_period_label(@cost_summary)} {format_cost(@cost_summary.period_cost)}
            <span :if={Map.get(@cost_summary, :has_unpriced_usage?)} class="text-amber-300">
              + unpriced
            </span>
          </span>
          <span class={[
            "shrink-0 font-590",
            cost_text_class(@cost_summary.budget_status)
          ]}>
            {cost_status_label(@cost_summary)}
          </span>
        </p>
      </div>
    </div>

    <%!-- ============================================================
         Mid row — Active Agents | Twin donuts | Inbox
         ============================================================ --%>
    <div class="stagger-children grid grid-cols-1 gap-4 lg:grid-cols-3 lg:items-stretch">
      <.panel class="flex flex-col overflow-hidden">
        <div class="flex items-center justify-between border-b border-border px-4 py-3">
          <div>
            <h2 class="text-sm font-590 text-text-primary">Active Agents</h2>
            <p class="mt-0.5 text-[11px] text-text-quaternary">Current execution roster</p>
          </div>
          <.app_link
            navigate={~p"/org-chart"}
            class="text-xs text-text-tertiary hover:text-text-primary"
          >
            Org chart →
          </.app_link>
        </div>

        <.empty_state
          :if={Enum.empty?(@active_agent_list)}
          title="No active agents"
          message="Start a company to create the CEO, CTO, and engineers."
          class="py-10"
        />

        <div :if={!Enum.empty?(@active_agent_list)} class="divide-y divide-border">
          <div
            :for={agent <- @active_agent_list}
            class="group flex items-center gap-3 border-l-2 border-transparent px-4 py-3 transition hover:border-brand hover:bg-surface-hover/70"
          >
            <div class="relative shrink-0">
              <div class="flex h-10 w-10 items-center justify-center rounded-xl border border-border bg-gradient-to-br from-brand/15 to-surface text-xs font-590 text-brand">
                {agent_initials(agent)}
              </div>
              <span
                class={[
                  "absolute -bottom-0.5 -right-0.5 h-3 w-3 rounded-full border-2 border-panel",
                  agent_status_dot(agent.status),
                  agent.status == :running && "cympho-pulse-dot"
                ]}
                style={
                  if agent.status == :running, do: "--cympho-pulse-color: rgba(93,184,166,0.6);"
                }
              >
              </span>
            </div>
            <div class="min-w-0 flex-1">
              <p class="truncate text-sm font-510 text-text-primary">{agent.name}</p>
              <p class="truncate text-[11px] text-text-quaternary">
                {agent.title || status_label(agent.role)}
              </p>
            </div>
            <span class="hidden font-mono text-[10px] uppercase tracking-[0.1em] text-text-quaternary group-hover:inline">
              {status_label(agent.status)}
            </span>
          </div>
        </div>
      </.panel>

      <%!-- Twin donuts: Issues + Agents by status --%>
      <.panel class="flex flex-col p-4">
        <div class="grid grid-cols-2 gap-4">
          <%= for {title, counts, color_fun, total} <- [
            {"Issues by Status", @issue_status_counts, &status_stroke/1, total_issues(@issue_status_counts)},
            {"Agents by Status", @agent_status_counts, &agent_stroke/1, @total_agents}
          ] do %>
            <div class="min-w-0">
              <h2 class="text-[11px] font-590 uppercase tracking-[0.14em] text-text-quaternary">
                {title}
              </h2>
              <div class="mt-3 flex flex-col items-center">
                <div class="relative h-28 w-28">
                  <svg viewBox="0 0 36 36" class="h-28 w-28 -rotate-90">
                    <circle
                      cx="18"
                      cy="18"
                      r="15.9155"
                      fill="none"
                      stroke="rgba(255,255,255,0.05)"
                      stroke-width="3.2"
                    />
                    <%= for arc <- donut_arcs(counts, color_fun) do %>
                      <circle
                        cx="18"
                        cy="18"
                        r="15.9155"
                        fill="none"
                        stroke={arc.color}
                        stroke-width="3.2"
                        stroke-linecap="butt"
                        stroke-dasharray={arc.dash_array}
                        stroke-dashoffset={arc.dash_offset}
                      />
                    <% end %>
                  </svg>
                  <div class="pointer-events-none absolute inset-0 flex flex-col items-center justify-center">
                    <span class="font-mono text-[26px] font-590 leading-none tabular-nums text-text-primary">
                      {if total > 0, do: total, else: "—"}
                    </span>
                    <span class="mt-1 text-[10px] uppercase tracking-[0.12em] text-text-quaternary">
                      Total
                    </span>
                  </div>
                </div>
                <ul class="mt-3 w-full space-y-1">
                  <li
                    :for={%{status: status, count: count} <- counts}
                    :if={count > 0}
                    class="flex items-center gap-2"
                  >
                    <span
                      class="h-2 w-2 shrink-0 rounded-full"
                      style={"background: #{color_fun.(status)};"}
                    >
                    </span>
                    <span class="min-w-0 flex-1 truncate text-[11px] text-text-tertiary">
                      {status_label(status)}
                    </span>
                    <span class="font-mono text-[11px] tabular-nums text-text-secondary">
                      {count}
                    </span>
                  </li>
                </ul>
              </div>
            </div>
          <% end %>
        </div>
      </.panel>

      <.panel class="flex flex-col overflow-hidden">
        <div class="flex items-center justify-between border-b border-border px-4 py-3">
          <div>
            <h2 class="text-sm font-590 text-text-primary">Inbox</h2>
            <p class="mt-0.5 text-[11px] text-text-quaternary">Latest agent inbox items</p>
          </div>
          <.app_link
            navigate={~p"/inbox"}
            class="text-xs text-text-tertiary hover:text-text-primary"
          >
            Open inbox →
          </.app_link>
        </div>

        <.empty_state
          :if={Enum.empty?(@recent_inbox)}
          title="Inbox empty"
          message="Agent activity will surface here as it arrives."
          class="py-10"
        />

        <div :if={!Enum.empty?(@recent_inbox)} class="divide-y divide-border">
          <.app_link
            :for={item <- @recent_inbox}
            navigate={inbox_item_link(item)}
            class="group flex items-start gap-3 border-l-2 border-transparent px-4 py-3 transition hover:border-brand hover:bg-surface-hover/70"
          >
            <span class={[
              "mt-1.5 h-2 w-2 shrink-0 rounded-full",
              inbox_dot(item.status)
            ]}>
            </span>
            <div class="min-w-0 flex-1">
              <p class={[
                "truncate text-sm text-text-primary",
                if(item.status == "unread", do: "font-590", else: "font-510")
              ]}>
                {inbox_item_title(item)}
              </p>
              <p class="mt-0.5 truncate text-[11px] text-text-quaternary">
                {inbox_item_meta(item)}
              </p>
            </div>
            <span class="ml-2 shrink-0 rounded-md border border-border/60 bg-surface/40 px-1.5 py-0.5 font-mono text-[10px] tabular-nums text-text-quaternary">
              {Calendar.strftime(item.inserted_at, "%b %d")}
            </span>
          </.app_link>
        </div>
      </.panel>
    </div>

    <%!-- ============================================================
         Bottom row — Throughput chart | Activity / Bottlenecks / Routine
         ============================================================ --%>
    <div class="mt-4 grid grid-cols-1 gap-4 lg:grid-cols-[minmax(0,1.5fr)_minmax(320px,1fr)]">
      <.panel class="p-4">
        <div class="mb-4 flex items-center justify-between">
          <div>
            <h2 class="text-sm font-590 text-text-primary">Issue Throughput</h2>
            <p class="mt-0.5 text-[11px] text-text-quaternary">Created vs. closed, last 7 days</p>
          </div>
          <div class="flex items-center gap-3 text-[11px] text-text-quaternary">
            <span class="inline-flex items-center gap-1.5">
              <span class="h-2 w-2 rounded-sm bg-brand"></span> Created
            </span>
            <span class="inline-flex items-center gap-1.5">
              <span class="h-2 w-2 rounded-sm bg-green-400/70"></span> Closed
            </span>
          </div>
        </div>
        <div
          class="relative flex h-40 items-end gap-2 rounded-md"
          style="background-image: repeating-linear-gradient(to top, rgba(255,255,255,0.04) 0, rgba(255,255,255,0.04) 1px, transparent 1px, transparent 33.333%);"
        >
          <div
            :for={%{date: date, count: count} <- @throughput.created}
            class="group flex flex-1 flex-col items-center gap-2"
          >
            <span class="font-mono text-[10px] tabular-nums text-text-quaternary opacity-0 transition group-hover:opacity-100">
              {count}
            </span>
            <div class="relative flex h-28 w-full items-end justify-center gap-0.5">
              <div
                class="w-2/5 rounded-t-md bg-gradient-to-t from-brand/25 to-brand transition group-hover:from-brand/40 group-hover:to-accent-hover"
                style={"height: #{chart_height(count, @throughput.created)}%;"}
              >
              </div>
              <div
                class="w-2/5 rounded-t-md bg-gradient-to-t from-green-500/15 to-green-400/80 transition group-hover:from-green-500/25 group-hover:to-green-300"
                style={"height: #{chart_height(closed_for(date, @throughput.closed), @throughput.closed)}%;"}
              >
              </div>
            </div>
            <span class="w-full truncate text-center font-mono text-[10px] tabular-nums text-text-quaternary">
              {format_date(date)}
            </span>
          </div>
        </div>
      </.panel>

      <div class="space-y-4">
        <.panel class="overflow-hidden">
          <div class="border-b border-border px-4 py-3">
            <h2 class="text-sm font-590 text-text-primary">Recent Activity</h2>
          </div>

          <.empty_state
            :if={Enum.empty?(@recent_activities)}
            title="No recent activity"
            message="Agent and issue events will appear here."
            class="py-10"
          />

          <div
            :if={!Enum.empty?(@recent_activities)}
            class="relative max-h-72 overflow-y-auto px-4 py-2"
          >
            <div class="absolute bottom-2 left-[22px] top-2 w-px bg-border"></div>
            <ul class="relative space-y-2.5">
              <li
                :for={activity <- @recent_activities}
                class={[
                  "relative flex items-start gap-3 rounded-md py-1 pl-4 transition hover:bg-surface-hover/60",
                  @flash_activity_id == activity.id && "cympho-activity-flash"
                ]}
              >
                <span class={[
                  "absolute left-[2px] top-2 h-2 w-2 rounded-full ring-2 ring-panel",
                  activity_icon(activity.action)
                ]}>
                </span>
                <div class="min-w-0 flex-1">
                  <p class="truncate text-sm text-text-primary">
                    {activity_label(activity.action)}
                    <span
                      :if={activity.issue_id}
                      class="font-mono text-[11px] text-text-quaternary"
                    >
                      {activity.issue_id |> String.slice(0, 8)}
                    </span>
                  </p>
                  <p class="mt-0.5 font-mono text-[10px] tabular-nums text-text-quaternary">
                    {Calendar.strftime(activity.inserted_at, "%b %d · %H:%M")}
                  </p>
                </div>
              </li>
            </ul>
          </div>
        </.panel>

        <.panel class="p-4" data-testid="autonomy-patrol">
          <div class="mb-3 flex items-start justify-between gap-3">
            <div class="min-w-0">
              <p class="text-[11px] font-590 uppercase tracking-[0.14em] text-text-quaternary">
                Bottlenecks
              </p>
              <h2 class="mt-1 text-sm font-590 text-text-primary">Autonomy patrol</h2>
            </div>
            <span class={"shrink-0 rounded-full border px-2 py-0.5 text-[11px] font-510 #{patrol_badge_class(@patrol_summary.level)}"}>
              {@patrol_summary.label}
            </span>
          </div>

          <div class="grid grid-cols-3 divide-x divide-border overflow-hidden rounded-lg border border-border bg-surface/40">
            <div class="px-3 py-2.5">
              <p class="text-[10px] font-590 uppercase tracking-[0.12em] text-text-quaternary">
                Stalled
              </p>
              <p class={[
                "mt-1 font-mono text-[24px] font-590 leading-none tabular-nums",
                patrol_metric_text(@patrol_summary.level)
              ]}>
                {@patrol_summary.stuck_count}
              </p>
            </div>
            <div class="px-3 py-2.5">
              <p class="text-[10px] font-590 uppercase tracking-[0.12em] text-text-quaternary">
                Wakes
              </p>
              <p class="mt-1 font-mono text-[24px] font-590 leading-none tabular-nums text-text-primary">
                {@patrol_summary.pending_wakes}
              </p>
            </div>
            <div class="px-3 py-2.5">
              <p class="text-[10px] font-590 uppercase tracking-[0.12em] text-text-quaternary">
                Blocked
              </p>
              <p class={[
                "mt-1 font-mono text-[24px] font-590 leading-none tabular-nums",
                if(@patrol_summary.blocked_count > 0, do: "text-brand", else: "text-text-primary")
              ]}>
                {@patrol_summary.blocked_count}
              </p>
            </div>
          </div>

          <p class="mt-3 text-sm leading-5 text-text-tertiary">
            {@patrol_summary.summary}
          </p>

          <div
            :if={Enum.empty?(@patrol_summary.issues)}
            class="mt-4 rounded-lg border border-border bg-surface/30 px-3 py-3"
          >
            <p class="text-sm font-510 text-text-primary">No patrol candidates</p>
            <p class="mt-1 text-xs leading-4 text-text-tertiary">
              In-progress, review, and blocked work are moving inside the current thresholds.
            </p>
          </div>

          <div :if={!Enum.empty?(@patrol_summary.issues)} class="mt-4 space-y-2">
            <.app_link
              :for={issue <- @patrol_summary.issues}
              navigate={~p"/issues/#{issue.id}"}
              class={"block rounded-lg border px-3 py-2 transition hover:bg-surface-hover/40 #{patrol_issue_class(issue.status)}"}
            >
              <div class="flex items-start justify-between gap-2">
                <p class="min-w-0 flex-1 truncate text-sm font-510 text-text-primary">
                  {issue.title}
                </p>
                <span class="shrink-0 rounded-md bg-canvas/70 px-1.5 py-0.5 font-mono text-[10px] tabular-nums text-text-tertiary">
                  {patrol_age(issue)}
                </span>
              </div>
              <div class="mt-1 flex min-w-0 flex-wrap items-center gap-x-2 gap-y-1 text-[11px]">
                <span class="font-590 text-text-secondary">{status_label(issue.status)}</span>
                <span class="text-text-quaternary">/</span>
                <span class="min-w-0 truncate text-text-quaternary">
                  {patrol_route_label(issue)}
                </span>
              </div>
            </.app_link>
          </div>
        </.panel>

        <.panel class="p-4">
          <h2 class="mb-3 text-sm font-590 text-text-primary">Routine Health</h2>
          <div class={"flex items-center gap-3 rounded-md px-3 py-2 " <> routine_health_bg_class(@routine_health)}>
            <span class={"h-2.5 w-2.5 shrink-0 rounded-full " <> routine_health_dot_class(@routine_health)}>
            </span>
            <span class="text-sm text-text-tertiary">{@routine_health.message}</span>
          </div>
        </.panel>
      </div>
    </div>
    <%!-- ============================================================
         Prompt bar — Claude-style task entry. Reuses the quick-create
         modal (click / Enter → new issue) and the command palette
         (inner search button, a sibling so the two delegated
         data-* handlers never collide). No new backend.
         ============================================================ --%>
    <div class="mt-8">
      <div class="flex items-center gap-2 rounded-2xl border border-hairline bg-surface-1 px-4 py-3 shadow-card transition-colors focus-within:border-hairline-strong hover:border-hairline-strong">
        <div
          role="button"
          tabindex="0"
          data-quick-create-trigger
          aria-label="Describe a task — create a new issue"
          class="group flex flex-1 items-center gap-3 min-w-0 cursor-text rounded-xl focus:outline-none"
        >
          <.spark class="h-5 w-5 shrink-0 text-brand" />
          <span class="flex-1 truncate text-left text-[15px] text-text-tertiary">
            Describe a task or ask a question…
          </span>
          <kbd class="kbd shrink-0">C</kbd>
        </div>
        <button
          type="button"
          data-action="open-command-palette"
          aria-label="Open command palette"
          class="ml-1 hidden sm:inline-flex items-center gap-1.5 rounded-lg px-2 py-1.5 text-text-quaternary hover:bg-surface-hover hover:text-text-primary transition-colors shrink-0"
        >
          <span class="hero-magnifying-glass-mini w-4 h-4"></span>
          <kbd class="kbd">⌘K</kbd>
        </button>
      </div>
    </div>
  </div>
</.page>
