<.page_frame page="approvals" title="Approval history" data-ui-complex-page>
  <.flash_line flash={@flash} />

  <div class="tbar">
    <.segmented label="Status">
      <:item
        :for={lane <- @approval_command.lanes}
        patch={lane.url}
        current={lane.current?}
      >
        {lane.label} <span class="mono">{lane.count}</span>
      </:item>
    </.segmented>
  </div>

  <.band_card id="approvals-list-t" title="Approvals" data-testid="approvals-responsive-queue">
    <div id="approvals-list" phx-update="stream" class="rows">
      <div id="approvals-empty" class="only:block hidden">
        <.quiet_empty title={approval_empty_title(@status_filter)}>
          {approval_empty_detail(@status_filter)}
          <:action>
            <div class="ap-acts">
              <.text_link :if={@status_filter} patch={approval_filter_path(nil)}>
                Clear filter
              </.text_link>
              <.text_link navigate={~p"/activity?filter_action=approval_created"}>
                Activity
              </.text_link>
            </div>
          </:action>
        </.quiet_empty>
      </div>

      <.list_row
        :for={{dom_id, approval} <- @streams.approvals}
        tag="div"
        id={dom_id}
        data-testid={"approval-row-#{approval.id}"}
        icon="i-shield"
        title={humanize_type(approval.type)}
        navigate={~p"/approvals/#{approval.id}"}
        status={approval_status(approval.status, @can_resolve_approvals)}
      >
        <:meta>
          Requested by {requester_name(approval)}
          <span aria-hidden="true">·</span>
          <span class="mono">{CymphoWeb.AgentLive.Parts.stamp(approval.inserted_at)}</span>
          <span :if={approval.issues != []} aria-hidden="true">·</span>
          <span :if={approval.issues != []}>{linked_tasks(approval.issues)}</span>
        </:meta>
        <:trail>
          <span class="ui-advanced-only mono">{approval.type}</span>
        </:trail>
        <:actions :if={approval.status == :pending and @can_resolve_approvals}>
          <.pill
            phx-click="approve"
            phx-value-id={approval.id}
            data-testid={"approval-approve-#{approval.id}"}
          >
            Approve
          </.pill>
          <button
            type="button"
            class="pl warn"
            phx-click="deny"
            phx-value-id={approval.id}
            data-testid={"approval-deny-#{approval.id}"}
            data-confirm="Deny this approval? The requesting agent will be told to stop or revise."
          >
            Deny
          </button>
        </:actions>
        <:below :if={approval.issues != []}>
          <details
            id={"approval-issues-#{approval.id}"}
            class="earlier"
            phx-mounted={JS.ignore_attributes("open")}
          >
            <summary>
              Tasks waiting on this <.r3_icon name="i-chev-down" class="ico s14" />
            </summary>
            <ul class="ap-tasks">
              <li :for={issue <- approval.issues}>
                <.link class="ul" navigate={~p"/issues/#{issue.id}"}>{issue.title}</.link>
                <span :if={issue.identifier} class="mono">{issue.identifier}</span>
              </li>
            </ul>
          </details>
        </:below>
      </.list_row>
    </div>

    <.infinite_scroll_footer
      id="approvals"
      has_more={@infinite_scroll[:approvals][:has_more?] || false}
    />
  </.band_card>

  <div class="ui-advanced-only">
    <.band_card id="approval-command-t" title="Decision queue" data-testid="approval-command">
      <div class="gl-sec">
        <p class="gl-big">{@approval_command.summary}</p>
        <p :if={@approval_command.pending_count > 0} class="gl-sub">
          Oldest: {@approval_command.oldest_pending_label}
        </p>
        <div class="ap-acts">
          <.text_link :for={action <- @approval_command.actions} navigate={action.url}>
            {action.label}
          </.text_link>
        </div>
      </div>
    </.band_card>
  </div>
</.page_frame>
