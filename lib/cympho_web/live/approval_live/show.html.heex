<div class="p-6 lg:p-8" data-ui-complex-page>
  <div class="mx-auto max-w-5xl">
    <.header>
      <div class="min-w-0">
        <p class="font-serif text-[13px] font-510 italic tracking-[0.02em] text-brand/90">
          Your decision
        </p>
        <h1 class="mt-1 font-serif text-[clamp(24px,3.5vw,34px)] font-510 leading-[1.1] tracking-[-0.01em] text-text-primary">
          {humanize_type(@approval.type)}
        </h1>
        <p class="ui-advanced-only mt-1 max-w-2xl text-body-sm text-text-tertiary">
          An agent is asking for your go-ahead. Review what's below, then decide.
        </p>
      </div>
      <:actions>
        <.app_link
          navigate={~p"/approvals"}
          class="inline-flex h-9 items-center justify-center gap-2 rounded-lg border border-border bg-surface px-3 text-sm font-510 text-text-secondary transition-colors hover:bg-surface-hover hover:text-text-primary"
        >
          <.icon name="hero-arrow-left-mini" class="h-4 w-4" />
          <span>Approvals</span>
        </.app_link>
      </:actions>
    </.header>

    <div
      id="approval-decision-packet"
      data-testid="approval-decision-packet"
      class={[
        "overflow-hidden rounded-xl border",
        decision_packet_tone(@approval.status)
      ]}
    >
      <div class="px-5 py-4">
        <div class="flex flex-wrap items-start justify-between gap-3">
          <div class="min-w-0">
            <h2 class="text-card-title text-text-primary">
              {@decision_packet.stance}
            </h2>
            <p class="mt-2 max-w-3xl text-sm leading-6 text-text-secondary">
              {@decision_packet.recommendation}
            </p>
          </div>
          <span class={[
            "inline-flex items-center rounded-full border px-2.5 py-1 text-xs font-510",
            decision_packet_status_class(@approval.status)
          ]}>
            {@decision_packet.status_label}
          </span>
        </div>

        <div class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-1.5 text-xs text-text-tertiary">
          <span>
            Requested by
            <span class="font-510 text-text-secondary">{@decision_packet.requested_by}</span>
          </span>
          <span aria-hidden="true" class="text-text-quaternary">·</span>
          <span>{@decision_packet.age}</span>
          <span aria-hidden="true" class="text-text-quaternary">·</span>
          <span>
            {@decision_packet.linked_issue_count} linked {if @decision_packet.linked_issue_count ==
                                                               1,
                                                             do: "issue",
                                                             else: "issues"}
          </span>
          <span :if={@approval.status != :pending} aria-hidden="true" class="text-text-quaternary">
            ·
          </span>
          <span :if={@approval.status != :pending}>
            Resolved by
            <span class="font-510 text-text-secondary">{@decision_packet.resolved_by}</span>
          </span>
        </div>
      </div>
    </div>

    <div class="mt-6 grid gap-6 lg:grid-cols-[minmax(0,1fr)_320px]">
      <div class="space-y-6">
        <div class="rounded-xl border border-border bg-panel p-5">
          <div class="flex flex-wrap items-center justify-between gap-3">
            <div>
              <p class="text-eyebrow uppercase text-text-quaternary">Request</p>
              <h3 class="mt-1 text-card-title text-text-primary">
                {humanize_type(@approval.type)}
                <span class="ml-2 font-mono text-xs font-400 text-text-quaternary">
                  {@approval.type}
                </span>
              </h3>
            </div>
            <span class={"rounded-full px-2.5 py-1 text-xs font-510 capitalize " <> status_badge_class(@approval.status)}>
              {@approval.status}
            </span>
          </div>

          <div class="mt-5 grid gap-3 sm:grid-cols-2">
            <div class={detail_stat_class()}>
              <p class="text-eyebrow uppercase text-text-quaternary">Created</p>
              <p class="mt-2 text-sm text-text-primary">
                {Calendar.strftime(@approval.inserted_at, "%b %d, %Y %H:%M")}
              </p>
            </div>
            <div class={detail_stat_class()}>
              <p class="text-eyebrow uppercase text-text-quaternary">Resolution</p>
              <p class="mt-2 text-sm text-text-primary">{@decision_packet.resolution}</p>
            </div>
          </div>
        </div>

        <div class="rounded-xl border border-border bg-panel p-5">
          <p class="text-eyebrow uppercase text-text-quaternary">Evidence</p>
          <h3 class="mt-1 text-card-title text-text-primary">What the agent submitted</h3>

          <div
            :if={payload_entries(@approval.payload) == []}
            class="mt-4 rounded-lg border border-dashed border-border px-4 py-6 text-center text-sm text-text-tertiary"
          >
            No payload was attached to this request.
          </div>

          <dl
            :if={payload_entries(@approval.payload) != []}
            class="mt-4 divide-y divide-border/70 rounded-lg border border-border bg-surface-1"
          >
            <div
              :for={{label, value} <- payload_entries(@approval.payload)}
              class="grid gap-1 px-4 py-3 sm:grid-cols-[160px_minmax(0,1fr)] sm:gap-4"
            >
              <dt class="text-xs font-590 uppercase tracking-[0.08em] text-text-quaternary sm:pt-0.5">
                {label}
              </dt>
              <dd class="min-w-0 break-words text-sm leading-6 text-text-primary">{value}</dd>
            </div>
          </dl>

          <details :if={@approval.payload} class="ui-advanced-only group mt-3">
            <summary class="inline-flex cursor-pointer select-none items-center gap-1.5 text-xs font-510 text-text-tertiary transition-colors hover:text-text-primary [&::-webkit-details-marker]:hidden">
              <span class="hero-chevron-right-mini h-3.5 w-3.5 transition-transform group-open:rotate-90">
              </span>
              Raw payload
            </summary>
            <pre class="mt-2 max-h-72 overflow-auto rounded-lg border border-border bg-surface p-3 text-xs text-text-tertiary"><%= Jason.encode!(@approval.payload, pretty: true) %></pre>
          </details>
        </div>

        <div class="rounded-xl border border-border bg-panel p-5">
          <div class="flex items-center justify-between gap-3">
            <div>
              <p class="text-eyebrow uppercase text-text-quaternary">Linked work</p>
              <h3 class="mt-1 text-card-title text-text-primary">
                Issues waiting on this decision
              </h3>
            </div>
          </div>

          <div
            :if={Enum.empty?(@approval.issues)}
            class="mt-4 rounded-lg border border-dashed border-border px-4 py-8 text-center text-sm text-text-tertiary"
          >
            No linked issues.
          </div>

          <div :if={!Enum.empty?(@approval.issues)} class="mt-4 space-y-2">
            <.app_link
              :for={issue <- @approval.issues}
              navigate={~p"/issues/#{issue.id}"}
              class="block rounded-lg border border-border bg-surface-1 px-4 py-3 transition-colors hover:bg-surface-2"
            >
              <div class="flex min-w-0 flex-wrap items-center justify-between gap-2">
                <div class="min-w-0">
                  <p class="truncate text-sm font-590 text-text-primary">{issue.title}</p>
                  <p class="mt-1 text-xs text-text-tertiary">
                    {if issue.identifier, do: issue.identifier <> " / ", else: ""}{issue.status}
                  </p>
                </div>
                <.icon name="hero-arrow-right-mini" class="h-4 w-4 shrink-0 text-text-quaternary" />
              </div>
            </.app_link>
          </div>
        </div>
      </div>

      <aside class="space-y-6">
        <div class="rounded-xl border border-border bg-panel p-5 lg:sticky lg:top-6">
          <p class="text-eyebrow uppercase text-text-quaternary">Decision actions</p>
          <%= if @approval.status == :pending do %>
            <div class="mt-4 grid gap-2">
              <button
                type="button"
                phx-click="approve"
                class="btn-press inline-flex h-10 items-center justify-center gap-2 rounded-lg bg-emerald-600 px-4 text-sm font-590 text-white transition-colors hover:bg-emerald-700"
              >
                <.icon name="hero-check-mini" class="h-4 w-4" /> Approve
              </button>
              <button
                type="button"
                phx-click="deny"
                data-confirm="Deny this approval? The requesting agent will be told to stop or revise."
                class="btn-press inline-flex h-10 items-center justify-center gap-2 rounded-lg border border-red-500/30 bg-red-500/10 px-4 text-sm font-590 text-red-300 transition-colors hover:bg-red-500/20"
              >
                <.icon name="hero-x-mark-mini" class="h-4 w-4" /> Deny
              </button>
              <p class="mt-1 text-xs leading-5 text-text-tertiary">
                Approving unblocks the linked work immediately. Denying returns a stop signal to the requesting agent.
              </p>
            </div>
          <% else %>
            <p class="mt-3 text-sm leading-6 text-text-tertiary">
              This approval is already resolved. It's kept here for the record.
            </p>
          <% end %>
        </div>

        <div class="ui-advanced-only rounded-xl border border-border bg-panel p-5">
          <p class="text-eyebrow uppercase text-text-quaternary">Payload keys</p>
          <div
            :if={@decision_packet.payload_keys == []}
            class="mt-3 rounded-lg border border-dashed border-border px-3 py-4 text-sm text-text-tertiary"
          >
            No payload keys.
          </div>
          <div :if={@decision_packet.payload_keys != []} class="mt-3 flex flex-wrap gap-2">
            <span
              :for={key <- @decision_packet.payload_keys}
              class="rounded-full border border-border bg-surface px-2.5 py-1 font-mono text-xs text-text-secondary"
            >
              {key}
            </span>
          </div>
        </div>
      </aside>
    </div>
  </div>
</div>
