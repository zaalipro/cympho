<% pending? = @approval.status == :pending %>
<% requester = @decision_packet.requested_by %>
<% evidence = payload_entries(@approval.payload) %>

<.page_frame
  page="approval"
  kind={:deep}
  parent={{~p"/approvals", "Approval history"}}
  current={humanize_type(@approval.type)}
  from={@from}
  tray_class="split"
  data-ui-complex-page
>
  <:head>
    <section class="head" aria-labelledby="ap-h">
      <h1 class="h1 big" id="ap-h">{humanize_type(@approval.type)}</h1>
      <p class="sub">
        Requested by {requester}<span aria-hidden="true"> · </span>
        <span class="nw">
          {day(@approval.inserted_at)} <span class="mono">{clock(@approval.inserted_at)}</span>
        </span>
      </p>
      <div class="chips">
        <span class={["chip", pending? && "st-wait"]}>
          <.status_word
            kind={elem(status(@approval.status, @can_resolve_approvals), 0)}
            word={elem(status(@approval.status, @can_resolve_approvals), 1)}
          />
        </span>
      </div>
      <.flash_line flash={@flash} />
    </section>
  </:head>

  <%!-- The decision (v7 §2.6): the request, then what approving or denying does. --%>
  <.next_step :if={pending?} id="ap-ns-" data-testid="approval-decision-packet">
    <:problem>
      <.problem_card title={"Decide on #{requester}'s request"} title_id="ap-ns-t">
        <:eyebrow>Next step<span aria-hidden="true"> · </span>Approval</:eyebrow>
        <p class="obj">
          <b>{humanize_type(@approval.type)}</b><span :if={evidence != []}>
            — {elem(hd(evidence), 0)}: {elem(hd(evidence), 1)}</span>
        </p>
        <p :if={!@can_resolve_approvals} class="obj">
          Only owners, admins and board members can decide this.
        </p>
        <:foot>
          <span class="who">
            <span class="tile-ag sm" aria-hidden="true">{initials(requester)}</span>
            <span>
              Requested by
              <b>{requester}</b><span aria-hidden="true"> · </span><span class="mono">{CymphoWeb.AgentLive.Parts.stamp(@approval.inserted_at)}</span>
            </span>
          </span>
        </:foot>
      </.problem_card>
    </:problem>
    <:resolution :if={@can_resolve_approvals}>
      <.ink_card heading="Your decision" heading_id="ap-ns-i">
        <.consequences rows={[
          {:done, "After you approve: the linked work can continue."},
          {:stopped, "After you deny: #{requester} is told to stop or revise."}
        ]} />
        <.ink_foot verb="approve">
          <:secondary>
            <.ghost_pill
              phx-click="deny"
              data-confirm="Deny this approval? The requesting agent will be told to stop or revise."
            >
              Deny
            </.ghost_pill>
          </:secondary>
          <:primary>
            <.primary_pill phx-click="approve">Approve</.primary_pill>
          </:primary>
        </.ink_foot>
      </.ink_card>
    </:resolution>
  </.next_step>

  <.band_card id="ap-evidence-t" title="Evidence">
    <.kv_list :if={evidence != []} class="wide">
      <:item :for={{label, value} <- evidence} term={label}>{value}</:item>
    </.kv_list>
    <.quiet_empty :if={evidence == []} title="No payload was attached to this request." />
    <details
      :if={@approval.payload}
      id="approval-payload-json"
      class="earlier ui-advanced-only"
      phx-mounted={JS.ignore_attributes("open")}
    >
      <summary>Raw payload <.r3_icon name="i-chev-down" class="ico s14" /></summary>
      <pre class="ap-raw"><%= Jason.encode!(@approval.payload, pretty: true) %></pre>
    </details>
  </.band_card>

  <.band_card :if={@approval.issues != []} id="ap-tasks-t" title="Tasks waiting on this">
    <ul class="rows">
      <.list_row
        :for={issue <- @approval.issues}
        id={"ap-task-#{issue.id}"}
        title={issue.title}
        navigate={~p"/issues/#{issue.id}"}
      >
        <:meta>
          <span :if={issue.identifier} class="mono">{issue.identifier}</span><span
            :if={issue.identifier}
            aria-hidden="true"
          > · </span>{task_state(issue.status)}
        </:meta>
      </.list_row>
    </ul>
  </.band_card>

  <.band_card
    id="ap-det-t"
    title="Details"
    class="aside"
    data-testid={!pending? && "approval-decision-packet"}
  >
    <.kv_list>
      <:item term="Type"><span class="mono">{@approval.type}</span></:item>
      <:item term="Created">
        {day(@approval.inserted_at)} <span class="mono">{clock(@approval.inserted_at)}</span>
      </:item>
      <:item :if={!pending?} term="Resolution">{@decision_packet.resolution}</:item>
      <:item :if={!pending?} term="Resolved by">{@decision_packet.resolved_by}</:item>
    </.kv_list>
  </.band_card>
</.page_frame>
