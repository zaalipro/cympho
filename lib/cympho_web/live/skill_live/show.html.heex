<.page_frame
  page="skill"
  kind={:deep}
  parent={{"/skills", "Skills"}}
  current={@skill.name}
  tray_class="split"
  data-ui-complex-page
>
  <:head>
    <section class="head" aria-labelledby="sk-h">
      <h1 class="h1 big" id="sk-h">{@skill.name}</h1>
      <div class="chips">
        <span :if={!@skill.enabled} class="tag">Off</span>
        <.pill phx-click="toggle_skill">
          {if @skill.enabled, do: "Turn off", else: "Turn on"}
        </.pill>
        <.pill navigate={~p"/skills/#{@skill.id}/edit"}><.r3_icon name="i-pencil" />Edit</.pill>
      </div>
    </section>
  </:head>

  <.flash_line flash={@flash} />

  <.band_card id="sk-what-t" title="What it does">
    <div class="gl-sec">
      <p :if={@skill.description not in [nil, ""]} class="sk-desc">{@skill.description}</p>
      <p :if={@skill.description in [nil, ""]} class="gl-sub">No usage brief yet.</p>
      <p :if={capabilities(@skill) != []} class="sk-caps">
        <span class="gl-h">This skill can</span>
        <span :for={capability <- capabilities(@skill)} class="tag mono">{capability}</span>
      </p>
    </div>
  </.band_card>

  <section class="card ui-advanced-only" aria-label="Manifest">
    <details id="skill-manifest" class="tech" phx-mounted={JS.ignore_attributes("open")}>
      <summary>
        <span class="h2">Manifest</span> <.r3_icon name="i-chev-down" />
      </summary>
      <pre class="mono sk-pre"><%= Jason.encode!(@skill.manifest || %{}, pretty: true) %></pre>
    </details>
  </section>

  <.band_card id="sk-det-t" title="Details" class="aside">
    <.kv_list>
      <:item term="Identifier"><span class="mono hr-wrap">{@skill.identifier}</span></:item>
      <:item term="Version"><span class="mono">{@skill.version || "0.0.0"}</span></:item>
      <:item :if={@skill.author} term="Author">{@skill.author}</:item>
      <:item term="Scope">{(@skill.company && @skill.company.name) || "Global"}</:item>
      <:item :if={@skill.project} term="Project">{@skill.project.name}</:item>
    </.kv_list>
  </.band_card>

  <section class="card" aria-label="Delete this skill">
    <ul class="rows">
      <.list_row id="sk-delete" title="Delete this skill">
        <:meta>Agents can no longer use it.</:meta>
        <:actions>
          <button
            type="button"
            class="pl warn"
            phx-click="delete"
            data-confirm="Delete this skill?"
          >
            Delete
          </button>
        </:actions>
      </.list_row>
    </ul>
  </section>
</.page_frame>
