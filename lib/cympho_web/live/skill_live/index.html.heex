<.page_frame page="skills" title="Skills" data-ui-complex-page>
  <:header_end>
    <.pill navigate={~p"/skills/new"}><.r3_icon name="i-plus" />New skill</.pill>
  </:header_end>

  <.flash_line flash={@flash} />

  <form
    :if={length(@companies) > 1}
    id="skill-company-filter"
    phx-change="filter_company"
    phx-submit="filter_company"
    class="tbar"
  >
    <.select_menu
      id="skill-company"
      name="company_id"
      value={@selected_company_id || ""}
      options={Enum.map(@companies, &{&1.name, &1.id})}
      label="Company"
      class="sk-co"
    />
  </form>

  <.band_card id="sk-list-t" title="Skills">
    <.infinite_scroll
      id="skill"
      has_more={@infinite_scroll[:skill][:has_more?] || false}
      container_class="rows"
    >
      <:empty>
        <.quiet_empty title={skill_empty_title(@selected_company_id)} data-testid="skills-empty">
          {skill_empty_detail(@selected_company_id)}
          <:action>
            <.pill navigate={~p"/skills/new"}>New skill</.pill>
          </:action>
        </.quiet_empty>
      </:empty>

      <.list_row
        :for={{dom_id, skill} <- @streams.skill}
        tag="div"
        id={dom_id}
        title={skill.name}
        navigate={~p"/skills/#{skill.id}"}
        icon="i-doc-check"
        status={skill_manifest_gap?(skill) && {:stopped, "Manifest gap"}}
      >
        <:meta>
          <span class="mono">{skill.identifier}</span><span aria-hidden="true"> · </span><span class="mono">v{skill.version || "0.0.0"}</span><span :if={
            skill.author
          }><span aria-hidden="true"> · </span>{skill.author}</span>
        </:meta>
        <:trail :if={!skill.enabled}><span class="tag">Off</span></:trail>
        <:actions>
          <.pill phx-click="toggle_skill" phx-value-id={skill.id}>
            {if skill.enabled, do: "Turn off", else: "Turn on"}
          </.pill>
          <.pill navigate={~p"/skills/#{skill.id}/edit"}>Edit</.pill>
          <button
            type="button"
            class="pl warn"
            phx-click="delete"
            phx-value-id={skill.id}
            data-confirm="Delete this skill?"
          >
            Delete
          </button>
        </:actions>
      </.list_row>
    </.infinite_scroll>
  </.band_card>

  <CymphoWeb.SkillLive.HealthBand.health_band
    :if={@skill_health.metrics.total_skills > 0}
    id="sk-health-t"
    title="Skill health"
    data-testid="skill-health"
    health={@skill_health}
    cells={[
      {"Enabled", @skill_health.metrics.enabled_skills},
      {"Manifest errors", @skill_health.metrics.invalid_manifest_skills},
      {"Capability gaps", @skill_health.metrics.capabilityless_enabled_skills},
      {"Disabled", @skill_health.metrics.disabled_skills}
    ]}
    next_path={skill_next_action_path(@skill_health.next_action)}
    next_testid="skill-next-action"
  >
    Auto-reload {if @skill_health.metrics.hot_reloader_running?, do: "is on", else: "is off"}: edited
    skill manifests {if @skill_health.metrics.hot_reloader_running?,
      do: "refresh without a restart.",
      else: "need a restart to refresh."}
  </CymphoWeb.SkillLive.HealthBand.health_band>
</.page_frame>
