<.page_frame
  page="skill-form"
  kind={:deep}
  parent={{"/skills", "Skills"}}
  current="New skill"
  data-ui-complex-page
>
  <:head>
    <section class="head" aria-labelledby="sf-h">
      <h1 class="h1 big" id="sf-h">New skill</h1>
      <p class="sub">A reusable capability agents can call.</p>
    </section>
  </:head>

  <.flash_line flash={@flash} />

  <CymphoWeb.SkillLive.FormHelpers.skill_form
    form={@form}
    project_options={@project_options}
    heading="After you create it"
    submit="Create skill"
    cancel={~p"/skills"}
  />
</.page_frame>
