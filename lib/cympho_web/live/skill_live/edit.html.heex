<.page_frame
  page="skill-form"
  kind={:deep}
  parent={{"/skills", "Skills"}}
  current="Edit skill"
  data-ui-complex-page
>
  <:head>
    <section class="head" aria-labelledby="sf-h">
      <h1 class="h1 big" id="sf-h">{@page_title}</h1>
    </section>
  </:head>

  <.flash_line flash={@flash} />

  <CymphoWeb.SkillLive.FormHelpers.skill_form
    form={@form}
    project_options={@project_options}
    heading="After you save"
    submit="Save skill"
    cancel={~p"/skills/#{@skill.id}"}
  />
</.page_frame>
