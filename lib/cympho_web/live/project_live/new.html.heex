<.page_frame
  page="project-form"
  kind={:deep}
  parent={{"/projects", "Projects"}}
  current="New project"
  data-ui-complex-page
>
  <:head>
    <section class="head" aria-labelledby="pf-h">
      <h1 class="h1 big" id="pf-h">New project</h1>
      <p class="sub">Name the project and tell the team what it owns.</p>
    </section>
  </:head>

  <.flash_line flash={@flash} />

  <.form_pair
    id="project-form"
    for={@form}
    phx-submit="save"
    heading="After you create it"
    verb="create"
  >
    <.band_card id="pf-project-t" title="Project">
      <div class="flds">
        <.input
          field={@form[:name]}
          label="Name"
          required
          placeholder="Acme Backend"
          wrapper_class="full"
        />
        <.input
          field={@form[:description]}
          label="Description"
          type="textarea"
          rows={5}
          placeholder="What this project owns and what evidence proves progress."
          wrapper_class="full"
        />
      </div>
    </.band_card>

    <.band_card id="pf-identity-t" title="Identity" data-testid="project-identifier-fields">
      <div class="flds">
        <.input
          field={@form[:prefix]}
          label="Prefix"
          required
          placeholder="ACME"
          help="Becomes the task ID prefix, like ACME-12."
        />
        <div class="ui-advanced-only" data-testid="project-repository-field">
          <.input
            field={@form[:repo_url]}
            label="Repository URL"
            placeholder="https://github.com/owner/repo"
          />
        </div>
      </div>
    </.band_card>

    <.band_card
      id="pf-look-t"
      title="Status and colour"
      class="ui-advanced-only"
      data-testid="project-workspace-posture"
    >
      <div class="flds">
        <.input
          type="select"
          field={@form[:status]}
          label="Status"
          value={@form[:status].value || :active}
          options={[{"Active", "active"}, {"Archived", "archived"}]}
        />
        <.color_swatch_picker field={@form[:color]} />
      </div>
    </.band_card>

    <:effect>
      <.consequences rows={[{:done, "Tasks can be filed under it right away."}]} />
    </:effect>
    <:secondary>
      <.ghost_pill navigate={~p"/projects"}>Cancel</.ghost_pill>
    </:secondary>
    <:primary>
      <.primary_pill type="submit" phx-disable-with="Creating…">Create project</.primary_pill>
    </:primary>
  </.form_pair>
</.page_frame>
