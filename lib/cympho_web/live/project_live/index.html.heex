<.page_frame page="projects" title="Projects" data-ui-complex-page>
  <:header_end>
    <.pill navigate={~p"/projects/new"}><.r3_icon name="i-plus" />New project</.pill>
  </:header_end>

  <.flash_line flash={@flash} />

  <.band_card id="projects-list-t" title="Projects">
    <:header_end>
      <span class="meta">{@project_overview.active_projects} active</span>
    </:header_end>
    <.infinite_scroll
      id="projects"
      has_more={@infinite_scroll[:projects][:has_more?] || false}
      container_class="rows"
    >
      <:empty>
        <.quiet_empty title="No projects yet">
          Group tasks by the codebase or outcome they belong to.
          <:action>
            <.pill navigate={~p"/projects/new"}>New project</.pill>
          </:action>
        </.quiet_empty>
      </:empty>

      <%= for {dom_id, project} <- @streams.projects do %>
        <% health = project_health(@project_work_health, project.id) %>
        <.list_row
          tag="div"
          id={dom_id}
          title={project.name}
          navigate={~p"/projects/#{project.id}"}
          status={project_status(project, health)}
        >
          <:meta>
            <span
              :if={project.color not in [nil, ""]}
              class="sw"
              style={"background:#{project.color}"}
              aria-hidden="true"
            >
            </span>
            <span class="mono">{project.prefix}</span><span aria-hidden="true"> · </span>
            <span :if={project.repo_url not in [nil, ""]} class="pn-wrap">
              {strip_protocol(project.repo_url)}
            </span>
            <span :if={project.repo_url in [nil, ""]} class="ui-advanced-only">
              No repository configured
            </span>
            <span :if={project.repo_url in [nil, ""]} class="ui-simple-only">
              No code repo yet
            </span>
            <span aria-hidden="true"> · </span>{health.open} open
          </:meta>
          <:trail :if={project.status == :archived}><span class="tag">Archived</span></:trail>
          <:actions>
            <.pill navigate={~p"/issues?project_id=#{project.id}"}>Tasks</.pill>
            <button
              :if={project.status != :archived}
              type="button"
              class="pl warn"
              aria-label={"Archive #{project.name}"}
              phx-click="delete_project"
              phx-value-id={project.id}
              data-confirm="Archive this project?"
            >
              Archive
            </button>
          </:actions>
        </.list_row>
      <% end %>
    </.infinite_scroll>
  </.band_card>

  <.band_card
    id="project-health-t"
    title="Workstream health"
    class="ui-advanced-only"
    data-testid="project-workstream-health"
  >
    <:header_end>
      <span class="meta">{overview_status_label(@project_overview.status)}</span>
    </:header_end>
    <p class="gl-sub pn-line">
      {workstream_summary(@project_overview)}. {overview_status_detail(@project_overview.status)}
    </p>
    <div class="strip s4">
      <div class="cell">
        <span class="v mono">{@project_overview.open_issues}</span><span class="l">Open tasks</span>
      </div>
      <div class="cell">
        <span class="v mono">{@project_overview.blocked_projects}</span><span class="l">Blocked</span>
      </div>
      <div class="cell">
        <span class="v mono">{@project_overview.review_projects}</span><span class="l">In review</span>
      </div>
      <div class="cell">
        <span class="v mono">{@project_overview.missing_repo_projects}</span><span class="l">No repo</span>
      </div>
    </div>
  </.band_card>
</.page_frame>
