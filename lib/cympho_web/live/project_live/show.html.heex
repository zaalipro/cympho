<.page_frame
  page="project"
  kind={:deep}
  parent={{"/projects", "Projects"}}
  current={if @editing?, do: "Edit project", else: @project.name}
  tray_class="split"
  data-ui-complex-page
>
  <:head>
    <section class="head" aria-labelledby="p-h">
      <h1 class="h1 big" id="p-h">
        <span
          :if={@project.color not in [nil, ""]}
          class="sw"
          style={"background:#{@project.color}"}
          aria-hidden="true"
        ></span>{@project.name}
      </h1>
      <p
        :if={@project.description not in [nil, ""]}
        class="sub pj-sub"
        title={@project.description}
      >
        {@project.description}
      </p>
      <div class="chips">
        <span :if={@project.status == :archived} class="tag">Archived</span>
        <.pill :if={!@editing?} href="#project-settings">
          <.r3_icon name="i-pencil" />Edit
        </.pill>
        <.pill navigate={~p"/issues/new?project_id=#{@project.id}"}>
          <.r3_icon name="i-plus" />New task in it
        </.pill>
      </div>
    </section>
  </:head>

  <.flash_line flash={@flash} />

  <.band_card id="pj-next-t" title="Next for this project" data-testid="project-command">
    <div class="gl-sec">
      <p class="gl-big">{@project_command.heading}</p>
      <p class="gl-sub">{@project_command.detail}</p>
      <.text_link navigate={@project_command.action_path}>
        {@project_command.action_label}
      </.text_link>
    </div>
    <div class="ui-advanced-only" data-testid="project-health-strip">
      <div class="strip s4">
        <div class="cell">
          <span class="v mono">{@project_health.open}</span><span class="l">Open</span>
        </div>
        <div class="cell">
          <span class="v mono">{@project_health.progress_percent}%</span><span class="l">Done</span>
        </div>
        <div class="cell">
          <span class="v mono">{@project_health.in_review}</span><span class="l">In review</span>
        </div>
        <div class="cell">
          <span class="v mono">{@project_health.blocked}</span><span class="l">Blocked</span>
        </div>
      </div>
    </div>
  </.band_card>

  <.band_card id="pj-tasks-t" title="Recent tasks">
    <:header_end>
      <.text_link navigate={~p"/issues?project_id=#{@project.id}"}>Open all</.text_link>
    </:header_end>
    <ul :if={@issues != []} class="rows">
      <.list_row
        :for={issue <- @issues}
        id={"pj-task-#{issue.id}"}
        title={issue.title}
        navigate={~p"/issues/#{issue.id}"}
        status={CymphoWeb.IssueLive.MyIssues.status_state(issue.status)}
      >
        <:meta :if={issue.identifier}><span class="mono">{issue.identifier}</span></:meta>
        <:trail :if={issue.priority in [:high, :critical]}>
          <CymphoWeb.IssueLive.Tasks.priority priority={issue.priority} />
        </:trail>
      </.list_row>
    </ul>
    <.quiet_empty :if={@issues == []} title="No tasks in this project yet">
      Add the first task so an agent can start on it.
    </.quiet_empty>
  </.band_card>

  <.band_card id="pj-goals-t" title="Goals" data-testid="project-goals">
    <:header_end>
      <.text_link navigate={~p"/goals"}>All goals</.text_link>
    </:header_end>
    <ul :if={@goal_progress != []} class="rows">
      <.list_row
        :for={{goal, progress} <- @goal_progress}
        id={"pj-goal-#{goal.id}"}
        title={goal.title}
        navigate={~p"/goals/#{goal.id}"}
      >
        <:meta>
          {goal_type_label(goal.goal_type)}<span aria-hidden="true"> · </span>
          <span :if={progress.total > 0}>
            {progress.done} of {progress.total} tasks done
          </span>
          <span :if={progress.total == 0}>No tasks linked yet</span>
        </:meta>
        <:trail>
          <span :if={goal.status != "active"} class="tag">{String.capitalize(goal.status)}</span>
          <span :if={progress.total > 0} class="mono">{progress.percent}%</span>
        </:trail>
      </.list_row>
    </ul>
    <.quiet_empty :if={@goal_progress == []} title="No goals linked">
      Connect this project to a goal so its work stays aimed at it.
    </.quiet_empty>
  </.band_card>

  <.band_card id="pj-details-t" title="Details" class="aside">
    <.kv_list class="wide">
      <:item term="Prefix"><span class="mono">{@project.prefix}</span></:item>
      <:item term="Repository">
        <a
          :if={@project.repo_url not in [nil, ""]}
          class="ul pn-wrap"
          href={@project.repo_url}
          target="_blank"
          rel="noopener"
        >
          {@project.repo_url}
        </a>
        <span :if={@project.repo_url in [nil, ""]}>None yet</span>
      </:item>
      <:item term="Created">
        {Calendar.strftime(@project.inserted_at, "%a %-d %b")}
        <span class="mono">{Calendar.strftime(@project.inserted_at, "%H:%M")}</span>
      </:item>
    </.kv_list>
  </.band_card>

  <%!-- /projects/:id/edit is this page (owner decision O1): there, focusing the
       form's first field brings it into view. --%>
  <.form_pair
    id="project-settings"
    for={@form}
    phx-submit="save"
    phx-mounted={@editing? && JS.focus_first()}
    heading="After you save"
    verb="save"
  >
    <.band_card id="pj-settings-t" title="Project settings">
      <div class="flds">
        <.input field={@form[:name]} label="Name" required />
        <.input field={@form[:prefix]} label="Prefix" required placeholder="PROJ" />
        <.input
          field={@form[:description]}
          label="Description"
          type="textarea"
          rows={3}
          wrapper_class="full"
        />
        <div class="ui-advanced-only" data-testid="project-status-field">
          <.input
            type="select"
            field={@form[:status]}
            label="Status"
            value={to_string(@project.status || :active)}
            options={[{"Active", "active"}, {"Archived", "archived"}]}
          />
        </div>
        <div class="ui-advanced-only" data-testid="project-settings-repository-field">
          <.input
            field={@form[:repo_url]}
            label="Repository URL"
            placeholder="https://github.com/owner/repo"
          />
        </div>
        <div class="ui-advanced-only full" data-testid="project-color-field">
          <.color_swatch_picker field={@form[:color]} />
        </div>
      </div>
    </.band_card>
    <:effect>
      <.consequences rows={[
        {:done, "Updates this project in place; its tasks stay where they are."}
      ]} />
    </:effect>
    <:primary>
      <.primary_pill type="submit" phx-disable-with="Saving…">Save changes</.primary_pill>
    </:primary>
  </.form_pair>

  <.band_card
    id="pj-setup-t"
    title="Setup"
    class="ui-advanced-only"
    data-testid="project-readiness"
  >
    <ul class="rows">
      <.list_row id="pj-setup-repo" title="Repository" icon="i-term">
        <:meta>
          <span :if={@project.repo_url not in [nil, ""]} class="pn-wrap">
            {@project.repo_url}
          </span>
          <span :if={@project.repo_url in [nil, ""]}>Add one in Project settings above.</span>
        </:meta>
        <:actions :if={@project.repo_url not in [nil, ""]}>
          <a class="pl" href={@project.repo_url} target="_blank" rel="noopener">
            Open<.r3_icon name="i-external" />
          </a>
        </:actions>
      </.list_row>
      <.list_row
        :for={workspace <- @project_workspaces}
        id={"pj-workspace-#{workspace.id}"}
        title={workspace.name}
        icon="i-doc-check"
        navigate={~p"/workspaces/#{workspace.id}"}
      >
        <:meta><span class="mono pn-wrap">{workspace_location(workspace)}</span></:meta>
      </.list_row>
    </ul>
    <p :if={@project_workspaces == []} class="gl-sub pn-line">No work files are attached yet.</p>
  </.band_card>

  <.band_card
    id="pj-env-t"
    title="Environment variables"
    class="ui-advanced-only"
    data-testid="project-environment-variables"
  >
    <ul :if={@secrets != []} class="rows">
      <.list_row
        :for={secret <- @secrets}
        id={"pj-env-#{secret.id}"}
        title={secret.key}
        icon="i-shield"
      >
        <:meta>Value hidden</:meta>
        <:actions>
          <button
            type="button"
            class="pl warn"
            phx-click="delete_env"
            phx-value-id={secret.id}
            data-confirm={"Remove #{secret.key}?"}
            aria-label={"Remove #{secret.key}"}
          >
            Remove
          </button>
        </:actions>
      </.list_row>
    </ul>
    <p :if={@secrets == []} class="gl-sub pn-line">No environment variables yet.</p>
    <.form for={@env_form} id="project-env-form" phx-submit="add_env" class="pj-env">
      <%!-- A text field followed by a password field looks like a login form to
           Chrome, which was autofilling the signed-in user's email and password
           into Key/Value. --%>
      <div class="flds">
        <.input field={@env_form[:key]} label="Key" placeholder="GITHUB_TOKEN" autocomplete="off" />
        <.input
          field={@env_form[:value]}
          type="password"
          label="Value"
          placeholder="ghp_..."
          autocomplete="new-password"
        />
      </div>
      <.pill type="submit">Add</.pill>
    </.form>
  </.band_card>
</.page_frame>
