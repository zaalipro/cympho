<.settings_layout active={:notifications}>
  <.flash_line flash={@flash} />

  <%= if @user != nil do %>
    <.band_card id="ev-t" title="Alerts">
      <table class="mx">
        <thead>
          <tr>
            <th scope="col">Tell me when…</th>
            <th :for={pref <- ordered_prefs(@prefs)} scope="col">
              {String.capitalize(pref.channel_type)}<small>{if pref.enabled, do: "on", else: "off"}</small>
            </th>
          </tr>
        </thead>
        <tbody>
          <tr :for={{event, label} <- alert_events()}>
            <th scope="row">{label}</th>
            <td :for={pref <- ordered_prefs(@prefs)}>
              <label class="tg">
                <input
                  type="checkbox"
                  role="switch"
                  checked={event_enabled?(pref, event)}
                  phx-click="toggle_event"
                  phx-value-pref_id={pref.id}
                  phx-value-event={event}
                />
                <span class="tg-t" aria-hidden="true"></span>
                <span class="sr">{String.capitalize(pref.channel_type)}: {label}</span>
              </label>
            </td>
          </tr>
        </tbody>
      </table>
      <p :if={Enum.empty?(@prefs)} class="cfoot">
        <span>No notification preferences are configured.</span>
      </p>
    </.band_card>

    <.band_card id="ch-t" title="Channels">
      <ul class="srows">
        <li id="channel-email" class="srow">
          <span class="kt"><.r3_icon name="i-inbox" /></span>
          <span class="row-main">
            <span class="rt">Email</span>
            <span class="rm">{@user.email}</span>
          </span>
          <span class="end">
            <.channel_switch prefs={@prefs} channel="email" />
          </span>
        </li>
        <li id="channel-telegram" class="srow">
          <span class="kt"><.r3_icon name="i-external" /></span>
          <div class="row-main">
            <span class="rt">Telegram</span>
            <span class="rm">
              {if telegram_chat_id(@prefs, @user) == "",
                do: "Not linked",
                else: telegram_chat_id(@prefs, @user)}
            </span>
            <div :if={telegram_chat_id(@prefs, @user) != ""} class="ch-a">
              <span :if={@telegram_verify_status in [:verified, :linked]} class="st">
                <.status_word
                  kind={:done}
                  word={if @telegram_verify_status == :verified, do: "Verified", else: "Linked"}
                />
              </span>
              <.pill phx-click="verify_telegram">Verify</.pill>
            </div>
            <form
              :if={telegram_chat_id(@prefs, @user) == ""}
              phx-submit="link_telegram"
              class="ch-f"
            >
              <.input
                id="telegram-chat-id"
                name="telegram_chat_id"
                label="Telegram chat ID"
                value={@telegram_chat_id_input}
                autocomplete="off"
                required
              />
              <.pill type="submit">Link</.pill>
            </form>
          </div>
          <span class="end">
            <.channel_switch prefs={@prefs} channel="telegram" />
          </span>
        </li>
        <li id="channel-webhook" class="srow ui-advanced-only">
          <span class="kt"><.r3_icon name="i-term" /></span>
          <div class="row-main">
            <span class="rt">Webhook</span>
            <span class="rm">Cympho POSTs a JSON event to your endpoint for each alert.</span>
            <form phx-submit="update_webhook_url" class="ch-f">
              <.input
                id="webhook-url"
                type="url"
                name="webhook_url"
                label="Endpoint URL"
                placeholder="https://example.com/webhook"
                value={webhook_url(@prefs, @user)}
                autocomplete="off"
              />
              <.pill type="submit">Save</.pill>
            </form>
            <div :if={webhook_url(@prefs, @user) != ""} class="ch-a">
              <.pill phx-click="test_webhook">Test Ping</.pill>
              <span :if={match?({:ok, _}, @webhook_test_result)} class="st">
                <.status_word kind={:done} word="Test passed" />
              </span>
              <span :if={match?({:error, _}, @webhook_test_result)} class="st">
                <.status_word kind={:stopped} word="Test failed" />
              </span>
            </div>
          </div>
          <span class="end">
            <.channel_switch prefs={@prefs} channel="webhook" />
          </span>
        </li>
      </ul>
    </.band_card>
  <% end %>
</.settings_layout>
