<.settings_layout active={:notifications}>
  <.header title="Alerts" subtitle="What Cympho tells you about, and where." />

  <div :if={@user != nil} class="flex flex-col gap-4">
    <.band_card id="ev-t" title="Events">
      <table class="mx">
        <thead>
          <tr>
            <th scope="col">Tell me when…</th>
            <th :for={pref <- ordered_prefs(@prefs)} scope="col">
              {String.capitalize(pref.channel_type)}<small>{if pref.enabled, do: "on", else: "off"}</small>
            </th>
          </tr>
        </thead>
        <tbody>
          <tr :for={{event, label} <- alert_events()}>
            <th scope="row">{label}</th>
            <td :for={pref <- ordered_prefs(@prefs)}>
              <label class="tg">
                <input
                  type="checkbox"
                  role="switch"
                  checked={event_enabled?(pref, event)}
                  phx-click="toggle_event"
                  phx-value-pref_id={pref.id}
                  phx-value-event={event}
                />
                <span class="tg-t" aria-hidden="true"></span>
                <span class="sr">{String.capitalize(pref.channel_type)}: {label}</span>
              </label>
            </td>
          </tr>
        </tbody>
      </table>
      <p :if={Enum.empty?(@prefs)} class="cfoot">
        <span>No notification preferences are configured.</span>
      </p>
    </.band_card>

    <.band_card id="ch-t" title="Channels">
      <ul class="srows">
        <li id="channel-email" class="srow">
          <span class="kt"><.icon name="hero-envelope" class="h-4 w-4" /></span>
          <span class="row-main">
            <span class="rt">Email</span>
            <span class="rm">{@user.email}</span>
          </span>
          <span class="end">
            <.channel_switch prefs={@prefs} channel="email" />
          </span>
        </li>
        <li id="channel-telegram" class="srow">
          <span class="kt"><.icon name="hero-paper-airplane" class="h-4 w-4" /></span>
          <div class="row-main">
            <span class="rt">Telegram</span>
            <span class="rm">
              {if telegram_chat_id(@prefs, @user) == "",
                do: "Not linked",
                else: telegram_chat_id(@prefs, @user)}
            </span>
            <div
              :if={telegram_chat_id(@prefs, @user) != ""}
              class="mt-3 flex flex-wrap items-center gap-2"
            >
              <span
                :if={@telegram_verify_status in [:verified, :linked]}
                class="rounded-md border border-success/20 bg-success/10 px-2 py-0.5 text-xs font-510 text-success"
              >
                {if @telegram_verify_status == :verified, do: "Verified", else: "Linked"}
              </span>
              <button
                type="button"
                class="pl"
                phx-click="verify_telegram"
              >
                Verify
              </button>
            </div>
            <form
              :if={telegram_chat_id(@prefs, @user) == ""}
              phx-submit="link_telegram"
              class="mt-3 flex gap-2"
            >
              <input
                type="text"
                name="telegram_chat_id"
                placeholder="Telegram chat ID"
                value={@telegram_chat_id_input}
                required
                class="min-w-0 flex-1 rounded-lg border border-border bg-surface px-3 py-2 text-sm text-text-primary placeholder:text-text-quaternary focus:border-brand focus:outline-none focus:ring-2 focus:ring-brand/30"
              />
              <button
                type="submit"
                class="pl"
              >
                Link
              </button>
            </form>
          </div>
          <span class="end">
            <.channel_switch prefs={@prefs} channel="telegram" />
          </span>
        </li>
        <li id="channel-webhook" class="srow ui-advanced-only">
          <span class="kt"><.icon name="hero-bolt" class="h-4 w-4" /></span>
          <div class="row-main">
            <span class="rt">Webhook</span>
            <span class="rm">
              {if webhook_url(@prefs, @user) == "",
                do: "No endpoint",
                else: webhook_url(@prefs, @user)}
            </span>
            <span class="rm">Cympho POSTs a JSON event to your endpoint for each alert.</span>
            <form phx-submit="update_webhook_url" class="mt-3 flex gap-2">
              <input
                type="url"
                name="webhook_url"
                placeholder="https://example.com/webhook"
                value={webhook_url(@prefs, @user)}
                class="min-w-0 flex-1 rounded-lg border border-border bg-surface px-3 py-2 text-sm text-text-primary placeholder:text-text-quaternary focus:border-brand focus:outline-none focus:ring-2 focus:ring-brand/30"
              />
              <button
                type="submit"
                class="pl"
              >
                Save
              </button>
            </form>
            <div class="mt-2 flex flex-wrap items-center gap-2">
              <button
                :if={webhook_url(@prefs, @user) != ""}
                type="button"
                class="pl"
                phx-click="test_webhook"
              >
                Test Ping
              </button>
              <span
                :if={match?({:ok, _}, @webhook_test_result)}
                class="rounded-md border border-success/20 bg-success/10 px-2 py-0.5 text-xs font-510 text-success"
              >
                Test passed
              </span>
              <span
                :if={match?({:error, _}, @webhook_test_result)}
                class="rounded-md border border-brand/20 bg-brand/10 px-2 py-0.5 text-xs font-510 text-brand"
              >
                Test failed
              </span>
            </div>
          </div>
          <span class="end">
            <.channel_switch prefs={@prefs} channel="webhook" />
          </span>
        </li>
      </ul>
    </.band_card>
  </div>
</.settings_layout>
