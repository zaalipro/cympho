<.settings_layout active={:appearance}>
  <.flash_line flash={@flash} />

  <.band_card id="ap-t" title="Appearance">
    <div class="ap">
      <form phx-change="set_theme" aria-label="Colour">
        <fieldset class="thm">
          <legend>Colour</legend>
          <div class="thm-g">
            <div :for={theme <- @themes} class="thm-w">
              <input
                class="opt-in"
                type="radio"
                id={"theme-#{theme.id}"}
                name="theme"
                value={theme.id}
                checked={theme.id == @current_theme}
              />
              <label class="thm-c" for={"theme-#{theme.id}"}>
                <span class="pv" aria-hidden="true">
                  <span :if={theme.id != "dark"} class="lt pg">
                    <span class="cd"></span><span class="ik"></span>
                  </span>
                  <span
                    :if={theme.id != "light"}
                    class={["dk pg", theme.id == "system" && "half"]}
                  >
                    <span class="cd"></span><span class="ik"></span>
                  </span>
                </span>
                <span class="thm-row">
                  <span class="thm-n">{theme.name}<small>{theme.blurb}</small></span>
                  <span class="radio" aria-hidden="true"></span>
                </span>
              </label>
            </div>
          </div>
        </fieldset>
      </form>

      <div class="ap-d">
        <p class="ap-l" id="appearance-ui-mode">Detail</p>
        <%!-- The shell's Simple/Advanced switch (app.js applyUIMode keeps data-active and aria-pressed). --%>
        <div
          class="seg"
          data-ui-mode-switch
          data-appearance-ui-mode
          role="group"
          aria-labelledby="appearance-ui-mode"
          aria-describedby="appearance-detail-help"
        >
          <button
            type="button"
            data-ui-mode-option="simple"
            data-active="true"
            aria-pressed="true"
            aria-controls="main-content"
          >
            Simple
          </button>
          <button
            type="button"
            data-ui-mode-option="advanced"
            data-active="false"
            aria-pressed="false"
            aria-controls="main-content"
          >
            Advanced
          </button>
        </div>
        <p class="help" id="appearance-detail-help">Advanced adds technical pages and details.</p>
      </div>
    </div>
  </.band_card>
</.settings_layout>
