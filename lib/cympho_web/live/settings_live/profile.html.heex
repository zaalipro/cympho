<.settings_layout active={:profile}>
  <.header title="Profile" subtitle="Your name and email, as they appear across Cympho." />

  <.panel class="max-w-xl overflow-hidden">
    <%!-- The card header printed the name and email that the two inputs below
         already show, prefilled with the same values. --%>
    <div class="p-5">
      <p class="mb-4 font-serif text-[13px] font-510 italic tracking-[0.02em] text-brand/90">
        Edit your details
      </p>
      <.simple_form for={@form} phx-change="validate" phx-submit="save" class="space-y-4">
        <.input field={@form[:name]} label="Name" required />
        <.input field={@form[:email]} type="email" label="Email" required />
        <:actions>
          <.button type="submit" phx-disable-with="Saving…">Save changes</.button>
        </:actions>
      </.simple_form>
    </div>
  </.panel>
</.settings_layout>
