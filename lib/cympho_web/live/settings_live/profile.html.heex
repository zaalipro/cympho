<.settings_layout active={:profile}>
  <.flash_line flash={@flash} />

  <.form_pair
    id="profile-form"
    for={@form}
    phx-change="validate"
    phx-submit="save"
    heading="After you save"
    verb="save"
  >
    <.band_card id="pr-t" title="Profile">
      <div class="flds">
        <.input field={@form[:name]} label="Name" required />
        <.input field={@form[:email]} type="email" label="Email" required />
      </div>
    </.band_card>
    <:effect>
      <.ink_note>Your name and email change everywhere in Cympho.</.ink_note>
    </:effect>
    <:primary>
      <.primary_pill type="submit" phx-disable-with="Saving…">Save changes</.primary_pill>
    </:primary>
  </.form_pair>

  <%!-- The rail's account menu has the other Sign out; on a phone the rail is
       hidden, and this page is reached from Settings (the top bar's gear). --%>
  <.band_card id="si-t" title="Signed in">
    <ul class="srows">
      <li class="srow">
        <span class="av" aria-hidden="true">{initials(@user.name)}</span>
        <span class="row-main"><span class="rt">{@user.email}</span></span>
        <span class="end">
          <.link href={~p"/logout"} method="delete" class="pl">Sign out</.link>
        </span>
      </li>
    </ul>
  </.band_card>
</.settings_layout>
