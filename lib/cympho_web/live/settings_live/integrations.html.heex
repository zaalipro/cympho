<.settings_layout active={:integrations}>
  <.flash_line flash={@flash} />

  <.form_pair
    id="agrenting-form"
    for={@agrenting_form}
    phx-submit="save_agrenting"
    heading="After you save"
    verb="save"
  >
    <.band_card id="in-t" title="Integrations">
      <:header_end>
        <span class="st">
          <.status_word
            kind={if agrenting_connected?(@agrenting_status), do: :done, else: :idle}
            word={connection_badge_label(@agrenting_status)}
          />
        </span>
        <button
          :if={agrenting_connected?(@agrenting_status)}
          type="button"
          class="pl warn"
          phx-click="disconnect_agrenting"
          data-confirm="Disconnect Agrenting for this company?"
        >
          Disconnect
        </button>
      </:header_end>
      <p class="sub-h">Agrenting</p>
      <p class="in-l">
        Hire marketplace agents and run them from Cympho without exposing the API key to individual users.
      </p>
      <div class="flds">
        <.input
          field={@agrenting_form[:api_key]}
          type="password"
          label="API key"
          placeholder={
            if api_key_present?(@agrenting_status),
              do: "Leave blank to keep current key",
              else: "ap_..."
          }
          autocomplete="off"
          wrapper_class="full"
        />
        <.input
          field={@agrenting_form[:base_url]}
          type="url"
          label="Base URL"
          placeholder="https://www.agrenting.com"
          help="Keep the default unless your Agrenting workspace uses a custom endpoint."
          autocomplete="off"
          wrapper_class="ui-advanced-only"
        />
        <.input
          field={@agrenting_form[:repo_access_token]}
          type="password"
          label="Repo access token"
          placeholder={
            if repo_token_present?(@agrenting_status),
              do: "Leave blank to keep current token",
              else: "Optional push token"
          }
          help="Optional. Use this when remote agents need to push work products back to a repository."
          autocomplete="off"
          wrapper_class="ui-advanced-only"
        />
      </div>
      <p :if={test_result_label(@agrenting_test_result)} class="in-r st">
        <.status_word
          kind={if match?({:ok, _}, @agrenting_test_result), do: :done, else: :stopped}
          word={test_result_label(@agrenting_test_result)}
        />
      </p>
    </.band_card>
    <:effect>
      <.ink_note>Stored as a company secret; used only for Agrenting requests.</.ink_note>
    </:effect>
    <:secondary>
      <.ghost_pill phx-click="test_agrenting" disabled={!agrenting_connected?(@agrenting_status)}>
        Test
      </.ghost_pill>
    </:secondary>
    <:primary>
      <.primary_pill type="submit" phx-disable-with="Saving…">Save connection</.primary_pill>
    </:primary>
  </.form_pair>

  <.band_card id="rh-t" title="Remote hiring">
    <div class="in-b">
      <p class="in-l">
        Once connected, marketplace agents appear in Cympho with pricing, capabilities, and a local proxy agent record.
      </p>
      <.text_link navigate={~p"/agents/remote"}>Browse agents</.text_link>
    </div>
  </.band_card>

  <div class="ui-advanced-only">
    <.band_card id="mcp-t" title="External AI control (MCP)" data-testid="mcp-command">
      <:header_end>
        <span class="st">
          <.status_word
            kind={if @mcp_status.status.tone == :ready, do: :done, else: :waiting}
            word={@mcp_status.status.label}
          />
        </span>
      </:header_end>
      <p class="in-l">
        Connect external AI clients through Cympho's MCP server. Calls are authenticated as an agent and scoped to this company.
      </p>
      <div class="strip s4">
        <div class="cell">
          <p class="v mono">{@mcp_status.tool_count}</p>
          <p class="l">MCP tools</p>
        </div>
        <div class="cell">
          <p class="v mono">{@mcp_status.agent_count}</p>
          <p class="l">Agents</p>
        </div>
        <div class="cell">
          <p class="v mono">{@mcp_status.ceo_count}</p>
          <p class="l">CEOs</p>
        </div>
        <div class="cell">
          <p class="v mono">{@mcp_status.api_key_count}</p>
          <p class="l">API keys</p>
        </div>
      </div>

      <p class="sub-h">Do this next</p>
      <p class="in-l">{@mcp_status.next_action}</p>

      <p class="sub-h">MCP setup checklist</p>
      <ol class="steps">
        <li :for={{step, n} <- Enum.with_index(@mcp_status.setup_steps, 1)} class="step">
          <span class="chk">
            <.r3_icon :if={step.tone == :ready} name="i-check" class="ico s14" />
            <span :if={step.tone != :ready} class="mono">{n}</span>
          </span>
          <span class="step-t">{step.label}<span class="rm">{step.detail}</span></span>
          <span class="step-c">{step.state}</span>
        </li>
      </ol>

      <p class="sub-h">MCP routes</p>
      <p class="in-tags">
        <span class="tag mono">GET /api/mcp/tools</span>
        <span class="tag mono">POST /api/mcp/call</span>
      </p>

      <details id="mcp-intake" class="earlier" phx-mounted={JS.ignore_attributes("open")}>
        <summary>CEO intake recipe<.r3_icon name="i-chev-down" /></summary>
        <div class="in-d">
          <p class="in-l">
            Route external requests into CEO review instead of leaving them as unowned backlog.
          </p>
          <div id="mcp-intake-copy" phx-hook="CopyToClipboard">
            <button
              type="button"
              class="pl"
              data-copy-text={@mcp_status.intake_example}
              data-copy-label="Copy recipe"
            >
              Copy recipe
            </button>
          </div>
          <pre class="code">{@mcp_status.intake_example}</pre>
        </div>
      </details>

      <details
        id="mcp-tool-catalog"
        class="earlier"
        data-testid="mcp-tool-catalog"
        phx-mounted={JS.ignore_attributes("open")}
      >
        <summary>
          Available tools<span class="mono">{@mcp_status.tool_count}</span>
          <span class="tag mono">
            X-API-Key
          </span>
          <.r3_icon name="i-chev-down" />
        </summary>
        <ul class="in-tools">
          <li :for={tool <- @mcp_status.tools}>
            <span class="mono">{tool.name}</span><span class="rm">{tool.description}</span>
          </li>
        </ul>
      </details>

      <p class="sub-h">Create MCP API key</p>
      <p class="in-l">
        Keys are bound to one agent. Use the agent identity that should own imported tasks, comments, and tool calls.
      </p>
      <form phx-submit="create_mcp_key" class="in-k">
        <div class="flds">
          <.input
            field={@mcp_key_form[:agent_id]}
            type="select"
            label="Agent identity"
            options={mcp_agent_options(@mcp_status.agents)}
            disabled={@mcp_status.agent_count == 0}
          />
          <.input
            field={@mcp_key_form[:name]}
            label="Key name"
            disabled={@mcp_status.agent_count == 0}
            autocomplete="off"
          />
        </div>
        <.pill type="submit" disabled={@mcp_status.agent_count == 0}>Create key</.pill>
      </form>

      <div :if={@mcp_key_result} data-testid="mcp-key-result" class="in-key">
        <p class="gl-big">Copy this key now</p>
        <p class="in-l">
          It authenticates as {@mcp_key_result.agent.name} and will not be shown again.
        </p>
        <code class="mono">{@mcp_key_result.plain_text_key}</code>
        <code class="mono">curl -H "X-API-Key: &lt;key&gt;" /api/mcp/tools</code>
      </div>
    </.band_card>
  </div>
</.settings_layout>
