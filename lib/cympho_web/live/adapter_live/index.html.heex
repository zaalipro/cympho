<.settings_layout active={:adapters}>
  <.flash_line flash={@flash} />
  <p :if={@adapter_event_error} class="err" role="alert">
    <.r3_icon name="i-alert" />{@adapter_event_error}
  </p>

  <.band_card id="ad-t" title="How agents run">
    <:header_end>
      <.pill phx-click="refresh_health">Check all</.pill>
    </:header_end>

    <div id="adapter-runtime-readiness" data-testid="adapter-runtime-readiness" class="ad-sum">
      <p class="gl-sub">{@runtime_readiness.summary}</p>
      <p class="ad-acts">
        <%= for action <- @runtime_readiness.actions do %>
          <span :if={action[:advanced?]} class="ui-advanced-only">
            <.text_link navigate={action.url}>{action.label}</.text_link>
          </span>
          <.text_link :if={!action[:advanced?]} navigate={action.url}>{action.label}</.text_link>
        <% end %>
      </p>
      <div class="ui-advanced-only strip s4">
        <div :for={stat <- @runtime_readiness.stats} class="cell">
          <p class="v mono">{stat.value}</p>
          <p class="l">{stat.label}<span aria-hidden="true"> · </span>{stat.note}</p>
        </div>
        <div class="cell">
          <p class="v">
            {(@runtime_readiness.attention_adapter && @runtime_readiness.attention_adapter.name) ||
              "None"}
          </p>
          <p class="l">First attention</p>
        </div>
      </div>
    </div>

    <ul :if={@adapters != []} class="rows">
      <.list_row
        :for={adapter <- @adapters}
        id={"adapter-#{adapter.key}"}
        icon="i-term"
        title={adapter.name}
        navigate={~p"/settings/adapters/#{adapter.key}"}
        status={health_status(card_health_status(adapter, Map.get(@health, adapter.key, %{})))}
      >
        <:meta>
          {agents_label(Map.get(@agents_by_adapter, adapter.key, []))}<span :if={
            health_message(@health, adapter.key)
          }><span aria-hidden="true"> · </span>{health_message(@health, adapter.key)}</span>
        </:meta>
        <:actions>
          <.pill
            phx-click="test_adapter"
            phx-value-key={adapter.key}
            aria-label={"Check #{adapter.name}"}
          >
            Check
          </.pill>
        </:actions>
      </.list_row>
    </ul>
    <.quiet_empty :if={@adapters == []} title="No adapters registered." />
  </.band_card>
</.settings_layout>
