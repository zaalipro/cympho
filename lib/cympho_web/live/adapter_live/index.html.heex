<.settings_layout active={:adapters}>
  <.header
    title={@page_title}
    subtitle="Bring your own agent runtime, test adapter health, and see whether the company is ready to launch work."
  >
    <:actions>
      <button
        type="button"
        phx-click="refresh_health"
        class="bg-surface hover:bg-surface-hover border border-border text-text-secondary hover:text-text-primary font-510 text-sm px-4 py-2 min-h-[44px] rounded-lg transition-colors inline-flex items-center gap-2"
      >
        <.icon name="hero-arrow-path-mini" class="h-4 w-4" /> Refresh Health
      </button>
    </:actions>
  </.header>

  <div
    :if={@flash && @flash[:info]}
    class="mb-6 bg-success/10 border border-success/20 text-success text-sm px-4 py-3 rounded-lg"
  >
    {@flash[:info]}
  </div>

  <div
    :if={@flash && @flash[:error]}
    class="mb-6 bg-red-500/10 border border-red-500/20 text-red-400 text-sm px-4 py-3 rounded-lg"
  >
    {@flash[:error]}
  </div>

  <div
    :if={@adapter_event_error}
    class="mb-6 bg-red-500/10 border border-red-500/20 text-red-400 text-sm px-4 py-3 rounded-lg"
  >
    {@adapter_event_error}
  </div>

  <div
    id="adapter-runtime-readiness"
    data-testid="adapter-runtime-readiness"
    class={[
      "mb-6 overflow-hidden rounded-xl border",
      runtime_panel_class(@runtime_readiness.tone)
    ]}
  >
    <div class="border-b border-border/70 px-5 py-4">
      <div class="flex flex-wrap items-start justify-between gap-3">
        <div class="min-w-0">
          <p class="text-eyebrow uppercase text-text-quaternary">Adapter Status Overview</p>
          <h2 class="mt-1 text-card-title text-text-primary">Runtime readiness</h2>
          <p class="mt-2 max-w-3xl text-sm leading-6 text-text-secondary">
            {@runtime_readiness.summary}
          </p>
        </div>
        <div class="flex flex-wrap gap-2">
          <.app_link
            :for={action <- @runtime_readiness.actions}
            navigate={action.url}
            class={runtime_action_class(action.tone)}
          >
            <.icon name={action.icon} class="h-4 w-4" />
            <span>{action.label}</span>
          </.app_link>
        </div>
      </div>
    </div>

    <div class="grid gap-3 px-5 py-4 lg:grid-cols-[minmax(0,1fr)_280px]">
      <div class="grid min-w-0 grid-cols-1 gap-2 sm:grid-cols-3">
        <div
          :for={stat <- @runtime_readiness.stats}
          class="rounded-lg border border-border bg-surface-1 px-4 py-3"
        >
          <p class="text-eyebrow uppercase text-text-quaternary">{stat.label}</p>
          <p class="mt-3 font-mono text-2xl font-590 text-text-primary">{stat.value}</p>
          <p class="mt-1 text-xs text-text-tertiary">{stat.note}</p>
        </div>
      </div>

      <div class="min-w-0 rounded-lg border border-border bg-surface-1 px-4 py-3">
        <p class="text-eyebrow uppercase text-text-quaternary">First attention</p>
        <%= if @runtime_readiness.attention_adapter do %>
          <p class="mt-3 truncate text-sm font-590 text-text-primary">
            {@runtime_readiness.attention_adapter.name}
          </p>
          <p class="mt-1 text-xs text-text-tertiary">
            Test health or configure credentials before routing more work here.
          </p>
        <% else %>
          <p class="mt-3 text-sm font-590 text-text-primary">None</p>
          <p class="mt-1 text-xs text-text-tertiary">
            Registered adapters are not reporting attention signals.
          </p>
        <% end %>
      </div>
    </div>

    <div class="grid gap-2 border-t border-border/70 px-5 py-4 sm:grid-cols-2 xl:grid-cols-4">
      <div :for={lane <- @runtime_readiness.lanes} class={runtime_lane_class(lane.tone)}>
        <p class="text-eyebrow uppercase text-text-quaternary">{lane.label}</p>
        <p class="mt-3 font-mono text-2xl font-590 text-text-primary">{lane.value}</p>
        <p class="mt-1 text-xs capitalize text-text-tertiary">{lane.state}</p>
      </div>
    </div>
  </div>
  
<!-- Adapter Grid -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
    <.card :for={adapter <- @adapters} id={"adapter-#{adapter.key}"}>
      <div class="p-5 space-y-3">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-2">
            <span class="text-lg">{adapter_icon(adapter.key)}</span>
            <h3 class="font-serif text-sm font-510 text-text-primary">{adapter.name}</h3>
          </div>
          <%= with health <- Map.get(@health, adapter.key, %{status: :unknown}) do %>
            <span class={[
              "inline-flex items-center gap-1.5 px-2 py-0.5 rounded text-xs font-510",
              health_status_class(health.status)
            ]}>
              {health_status_label(health.status)}
            </span>
          <% end %>
        </div>

        <div class="space-y-2">
          <div class="flex items-center justify-between text-xs">
            <span class="text-text-tertiary">Availability</span>
            <span class={availability_class(adapter.available)}>
              {availability_label(adapter.available)}
            </span>
          </div>
          <div class="flex items-center justify-between text-xs">
            <span class="text-text-tertiary">Assigned Agents</span>
            <span class="text-text-secondary">{agent_count(assigns, adapter.key)}</span>
          </div>
          <div class="flex items-center justify-between text-xs">
            <span class="text-text-tertiary">Config Fields</span>
            <span class="text-text-secondary">{length(adapter.config_schema)}</span>
          </div>
        </div>

        <%= with health <- Map.get(@health, adapter.key, %{}), msg <- Map.get(health, :message) do %>
          <div
            :if={msg}
            class="text-xs text-text-tertiary truncate pt-1 border-t border-border"
            title={msg}
          >
            {msg}
          </div>
        <% end %>

        <div class="flex flex-wrap items-center gap-2 pt-2">
          <.app_link
            navigate={~p"/settings/adapters/#{adapter.key}"}
            class="bg-surface hover:bg-surface-hover border border-border text-text-secondary hover:text-text-primary font-510 text-xs px-4 py-2 min-h-[44px] rounded-lg transition-colors inline-flex items-center justify-center"
          >
            Configure
          </.app_link>
          <button
            type="button"
            phx-click="test_adapter"
            phx-value-key={adapter.key}
            class="bg-brand/10 hover:bg-brand/20 text-brand border border-brand/20 font-510 text-xs px-4 py-2 min-h-[44px] rounded-lg transition-colors"
          >
            Test Health
          </button>
        </div>
      </div>
    </.card>
  </div>

  <div
    :if={Enum.empty?(@adapters)}
    class="flex flex-col items-center justify-center py-20 text-center"
  >
    <div class="w-12 h-12 rounded-full bg-surface flex items-center justify-center mb-4">
      <svg
        class="w-6 h-6 text-text-tertiary"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.066 2.573c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.573 1.066c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.066-2.573c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"
        />
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"
        />
      </svg>
    </div>
    <p class="text-sm text-text-tertiary">No adapters registered.</p>
  </div>
</.settings_layout>
