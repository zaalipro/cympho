<.page_frame
  page="adapter"
  kind={:deep}
  parent={{~p"/settings/adapters", "How agents run"}}
  current={@adapter.name}
  data-ui-complex-page
>
  <:head>
    <section class="head" aria-labelledby="ad-h">
      <h1 class="h1 big" id="ad-h">{@adapter.name}</h1>
      <p class="sub">
        <%= if @health.checked_at do %>
          Checked <span class="mono">{AgentParts.stamp(@health.checked_at)}</span>
        <% else %>
          Not checked yet
        <% end %>
      </p>
      <div class="chips">
        <span class="chip">
          <.status_word
            kind={elem(health_status(@health.status), 0)}
            word={elem(health_status(@health.status), 1)}
          />
        </span>
      </div>
    </section>
  </:head>

  <.flash_line flash={@flash} />

  <%= if @can_manage_adapter_settings do %>
    <.form_pair
      id="adapter-config"
      phx-change="validate_config"
      phx-submit="save_config"
      heading="After you save"
      verb="save"
      data-testid="adapter-config-card"
    >
      <.band_card id="cfg-t" title="Connect this provider">
        <:header_end>
          <span class="ui-advanced-only meta mono">
            {length(visible_config_schema(@config_schema))} fields
          </span>
        </:header_end>
        <p :if={@validation_error} class="err cfg-err" role="alert">
          <.r3_icon name="i-alert" />{@validation_error}
        </p>
        <%!-- Every field of some runtimes is optional (Advanced), so Simple would show an empty card. --%>
        <p :if={no_required_fields?(@config_schema)} class="gl-sub cfg-ro ui-simple-only">
          {@adapter.name} needs nothing filled in here. Advanced shows its optional settings.
        </p>
        <div class="flds">
          <.input
            :for={field <- visible_config_schema(@config_schema)}
            id={"adapter-config-#{field.key}"}
            name={"config[#{field.key}]"}
            type={input_type(field)}
            label={simple_field_label(field)}
            value={field_input_value(field, @config)}
            required={field_required?(field, @config)}
            aria-required={field_required?(field, @config) && "true"}
            placeholder={input_placeholder(field, @config)}
            autocomplete={input_autocomplete(field)}
            step={input_step(field)}
            wrapper_class={field.required != true && "ui-advanced-only"}
          />
        </div>
      </.band_card>
      <:effect>
        <.ink_note>
          Keys go to Keys and secrets, not into agent settings.
          <.text_link navigate={~p"/settings/secrets"}>Keys and secrets</.text_link>
        </.ink_note>
      </:effect>
      <:secondary>
        <.ghost_pill phx-click="send_test_heartbeat">Validate</.ghost_pill>
      </:secondary>
      <:primary>
        <.primary_pill type="submit" phx-disable-with="Saving…">
          Save configuration
        </.primary_pill>
      </:primary>
    </.form_pair>
  <% else %>
    <.band_card id="cfg-t" title="Connect this provider" data-testid="adapter-config-card">
      <p :if={@validation_error} class="err cfg-err" role="alert">
        <.r3_icon name="i-alert" />{@validation_error}
      </p>
      <p data-testid="adapter-config-read-only" class="gl-sub cfg-ro">
        Adapter settings are read-only. Only company owners, admins, and board members can
        change configuration or run validation checks.
      </p>
    </.band_card>
  <% end %>

  <.band_card id="hl-t" title="Health">
    <:header_end>
      <.pill :if={@can_manage_adapter_settings} phx-click="test_health">Check again</.pill>
    </:header_end>
    <p class="gl-sub hl-m">{@health.message || "The last check gave no details."}</p>
    <p class="cfoot">
      <span>
        This checks required settings only. Run an assigned task to verify the provider connection end to end.
      </span>
    </p>
  </.band_card>

  <.band_card id="ag-t" title="Assigned agents">
    <:header_end><span class="meta mono">{length(@agents)}</span></:header_end>
    <ul :if={@agents != []} class="rows">
      <.list_row
        :for={agent <- @agents}
        id={"adapter-agent-#{agent.id}"}
        title={agent.name}
        navigate={~p"/agents/#{agent.id}"}
        status={agent_status(agent)}
      >
        <:meta :if={distinct_role_label(agent)}>{distinct_role_label(agent)}</:meta>
      </.list_row>
    </ul>
    <.quiet_empty :if={@agents == []} title="No agents use it yet." />
  </.band_card>

  <div class="ui-advanced-only">
    <.band_card id="dt-t" title="Details">
      <.kv_list class="wide">
        <:item term="Key"><span class="mono">{@adapter_key}</span></:item>
        <:item term="Module"><span class="mono brk">{@adapter.module}</span></:item>
        <:item term="Available">{if @adapter.available, do: "Yes", else: "No"}</:item>
      </.kv_list>
    </.band_card>
  </div>
</.page_frame>
