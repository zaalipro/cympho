<.page_frame page="activity" title="Activity" data-ui-complex-page>
  <div class="tbar">
    <.filter_menu
      id="activity-filter"
      active={active_filter_count(@filter_action, @filter_actor_type)}
    >
      <form phx-change="filter" phx-submit="prevent" class="act-f">
        <.input
          type="select"
          id="activity-filter-action"
          name="filter_action"
          label="What happened"
          value={@filter_action || ""}
          options={[
            {"All actions", ""},
            {"Created", "created"},
            {"Title changed", "title_changed"},
            {"Description changed", "description_changed"},
            {"Priority changed", "priority_changed"},
            {"Status changed", "status_changed"},
            {"Assigned", "assigned"},
            {"Unassigned", "unassigned"},
            {"Blocker added", "blocker_added"},
            {"Blocker removed", "blocker_removed"},
            {"Comment added", "comment_added"},
            {"Approval created", "approval_created"},
            {"Approval approved", "approval_approved"},
            {"Approval rejected", "approval_rejected"},
            {"Approval requested changes", "approval_requested_changes"},
            {"Heartbeat started", "heartbeat_started"},
            {"Heartbeat completed", "heartbeat_completed"},
            {"Heartbeat failed", "heartbeat_failed"},
            {"Cost incurred", "cost_incurred"},
            {"Budget threshold exceeded", "budget_threshold_exceeded"},
            {"Work product created", "work_product_created"}
          ]}
        />
      </form>
      <form phx-change="filter" phx-submit="prevent" class="act-f">
        <.input
          type="select"
          id="activity-filter-actor"
          name="filter_actor_type"
          label="Who did it"
          value={@filter_actor_type || ""}
          options={[
            {"All actors", ""},
            {"Agents", "agent"},
            {"Users", "user"},
            {"System", "system"}
          ]}
        />
      </form>
      <button
        :if={@filter_action != "" or @filter_actor_type != ""}
        type="button"
        class="lnk"
        phx-click="clear_filters"
      >
        Clear filters
      </button>
    </.filter_menu>
  </div>

  <.band_card id="activity-list-t" title="What happened" section_id="activity-feed">
    <.infinite_scroll
      id="activity"
      has_more={@infinite_scroll[:activities][:has_more?] || false}
      container_class="rows"
    >
      <:empty>
        <.quiet_empty title="No activity found.">
          Create work, clear filters, or start runtime to populate the company record.
        </.quiet_empty>
      </:empty>

      <.list_row
        :for={{dom_id, activity} <- @streams.activities}
        tag="div"
        id={dom_id}
        icon={activity_icon(activity.action)}
        kind={if problem_action?(activity.action), do: :problem, else: :neutral}
        title={activity_title(activity)}
      >
        <:meta>
          {actor_name(activity, @actor_names)}<span aria-hidden="true"> · </span>
          <%= if activity.issue do %>
            <.task_link issue={activity.issue} />
          <% else %>
            Task removed
          <% end %>
          <span aria-hidden="true"> · </span><span class="nw">{Calendar.strftime(activity.inserted_at, "%a %-d %b")} <span class="mono">{Calendar.strftime(activity.inserted_at, "%H:%M")}</span></span>
        </:meta>
      </.list_row>
    </.infinite_scroll>
  </.band_card>

  <div class="ui-advanced-only">
    <.band_card id="activity-command-t" title="Activity History" data-testid="activity-command">
      <:header_end><span class="tag">{@activity_command.badge}</span></:header_end>
      <div class="gl-sec">
        <p class="gl-big">{@activity_command.heading}</p>
        <p class="gl-sub">{@activity_command.detail}</p>
        <p :if={@activity_command.focus_label} class="act-tags">
          <span class="tag">{@activity_command.focus_label}</span>
          <span :if={@activity_command.focus_detail} class="tag">
            {@activity_command.focus_detail}
          </span>
        </p>
        <.text_link navigate={@activity_command.action_path}>
          {@activity_command.action_label}
        </.text_link>
      </div>
    </.band_card>
  </div>

  <div class="ui-advanced-only">
    <.band_card
      id="activity-audit-lanes-t"
      title="Audit lanes"
      section_id="activity-audit-lanes"
      data-testid="activity-audit-lanes"
    >
      <ul class="rows">
        <.list_row
          :for={lane <- @activity_audit_lanes}
          id={"activity-lane-#{lane.category}"}
          title={lane.label}
        >
          <:meta>{lane.summary}</:meta>
          <:trail>
            <span class="mono">{lane.count}</span><span :if={lane.show_state?}><span aria-hidden="true"> · </span>{lane.state_label}</span>
          </:trail>
          <:actions>
            <.text_link navigate={lane.action_path}>{lane.action_label}</.text_link>
          </:actions>
        </.list_row>
      </ul>
    </.band_card>
  </div>
</.page_frame>
