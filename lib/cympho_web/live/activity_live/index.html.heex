<div class="p-6 lg:p-8 max-w-6xl mx-auto w-full min-w-0" data-ui-complex-page>
  <.header title={@page_title}>
    <p class="ui-advanced-only mt-1 max-w-2xl text-body-sm text-text-tertiary">
      Owner-readable history for issue, runtime, spend, and governance changes.
    </p>
  </.header>

  <section
    data-testid="activity-command"
    class="ui-advanced-only mb-5 overflow-hidden rounded-lg border border-border bg-panel shadow-card"
  >
    <div class="grid gap-4 p-4 lg:grid-cols-[minmax(0,1fr)_auto] lg:items-start">
      <div class="min-w-0">
        <div class="flex flex-wrap items-center gap-2">
          <p class="text-[11px] font-590 uppercase tracking-[0.14em] text-text-quaternary">
            Activity command
          </p>
          <span class={"rounded-full border px-2 py-0.5 text-[11px] font-510 #{activity_command_badge_class(@activity_command.tone)}"}>
            {@activity_command.badge}
          </span>
        </div>

        <h2 class="mt-2 text-lg font-590 text-text-primary">
          {@activity_command.heading}
        </h2>
        <p class="mt-1 max-w-3xl text-sm leading-6 text-text-tertiary">
          {@activity_command.detail}
        </p>

        <div
          :if={@activity_command.focus_label}
          class="mt-3 flex min-w-0 flex-wrap items-center gap-2 text-xs"
        >
          <span class="max-w-full truncate rounded-full border border-border bg-surface px-2 py-1 font-510 text-text-secondary">
            {@activity_command.focus_label}
          </span>
          <span
            :if={@activity_command.focus_detail}
            class="rounded-full border border-border bg-surface px-2 py-1 text-text-tertiary"
          >
            {@activity_command.focus_detail}
          </span>
        </div>
      </div>

      <.app_link
        navigate={@activity_command.action_path}
        class={"inline-flex shrink-0 items-center justify-center gap-2 rounded-lg border px-3 py-2 text-sm font-590 transition-colors #{activity_command_action_class(@activity_command.tone)}"}
      >
        <.icon name="hero-arrow-right-mini" class="h-4 w-4" />
        {@activity_command.action_label}
      </.app_link>
    </div>

    <div class="grid grid-cols-2 border-t border-border sm:grid-cols-3 lg:grid-cols-6">
      <div
        :for={metric <- @activity_command.metrics}
        class="border-r border-border px-4 py-3 last:border-r-0"
      >
        <p class="text-[10px] font-590 uppercase tracking-[0.14em] text-text-quaternary">
          {metric.label}
        </p>
        <p class={[
          "mt-1 font-mono text-xl font-590 tabular-nums",
          activity_metric_value_class(metric.tone)
        ]}>
          {metric.value}
        </p>
      </div>
    </div>

    <div class="border-t border-border px-4 py-3">
      <p class="text-[11px] font-590 uppercase tracking-[0.14em] text-text-quaternary">
        Audit lanes
      </p>
      <p class="mt-1 text-sm text-text-tertiary">
        Jump to the event family you need to reconstruct before the next owner decision.
      </p>
    </div>

    <div
      id="activity-audit-lanes"
      data-testid="activity-audit-lanes"
      class="grid gap-px border-t border-border bg-border md:grid-cols-2 xl:grid-cols-5"
    >
      <div
        :for={lane <- @activity_audit_lanes}
        class={"bg-panel px-4 py-3 #{activity_lane_card_class(lane.category)}"}
      >
        <div class="flex items-start justify-between gap-3">
          <div class="min-w-0">
            <p class="text-[10px] font-590 uppercase tracking-[0.14em] text-text-quaternary">
              {lane.label}
            </p>
            <p class="mt-1 text-xs leading-5 text-text-tertiary">{lane.summary}</p>
          </div>
          <div class="shrink-0 text-right">
            <p class={"font-mono text-xl font-590 tabular-nums #{activity_lane_count_class(lane.category)}"}>
              {lane.count}
            </p>
            <span class={"rounded-full border px-1.5 py-0.5 text-[10px] font-510 #{activity_lane_badge_class(lane.category, lane.count)}"}>
              {lane.state_label}
            </span>
          </div>
        </div>

        <.app_link
          navigate={lane.action_path}
          class="mt-3 inline-flex items-center gap-1.5 text-xs font-590 text-text-secondary hover:text-brand"
        >
          {lane.action_label}
          <.icon name="hero-arrow-right-mini" class="h-3.5 w-3.5" />
        </.app_link>
      </div>
    </div>
  </section>

  <section class="ui-advanced-only mb-5 rounded-lg border border-border bg-panel px-4 py-3">
    <div class="flex flex-col gap-3 lg:flex-row lg:items-center lg:justify-between">
      <div class="min-w-0">
        <p class="text-sm font-590 text-text-primary">Feed controls</p>
        <p class="mt-1 text-xs leading-5 text-text-tertiary">
          Narrow the log by action or actor when you need to reconstruct what changed.
        </p>
      </div>

      <div class="flex flex-wrap items-center gap-3">
        <form phx-change="filter" phx-submit="prevent">
          <.select_menu
            name="filter_action"
            value={@filter_action || ""}
            options={[
              {"All actions", ""},
              {"Created", "created"},
              {"Title changed", "title_changed"},
              {"Description changed", "description_changed"},
              {"Priority changed", "priority_changed"},
              {"Status changed", "status_changed"},
              {"Assigned", "assigned"},
              {"Unassigned", "unassigned"},
              {"Blocker added", "blocker_added"},
              {"Blocker removed", "blocker_removed"},
              {"Comment added", "comment_added"},
              {"Approval created", "approval_created"},
              {"Approval approved", "approval_approved"},
              {"Approval rejected", "approval_rejected"},
              {"Approval requested changes", "approval_requested_changes"},
              {"Heartbeat started", "heartbeat_started"},
              {"Heartbeat completed", "heartbeat_completed"},
              {"Heartbeat failed", "heartbeat_failed"},
              {"Cost incurred", "cost_incurred"},
              {"Budget threshold exceeded", "budget_threshold_exceeded"},
              {"Work product created", "work_product_created"}
            ]}
          />
        </form>

        <form phx-change="filter" phx-submit="prevent">
          <.select_menu
            name="filter_actor_type"
            value={@filter_actor_type || ""}
            options={[
              {"All actors", ""},
              {"Agents", "agent"},
              {"Users", "user"},
              {"System", "system"}
            ]}
          />
        </form>

        <button
          :if={@filter_action != "" or @filter_actor_type != ""}
          type="button"
          phx-click="clear_filters"
          class="rounded-md border border-border px-2.5 py-1.5 text-xs font-510 text-text-tertiary transition-colors hover:bg-surface-hover hover:text-text-primary"
        >
          Clear filters
        </button>
      </div>
    </div>
  </section>

  <section id="activity-feed" class="overflow-hidden rounded-lg border border-border bg-panel">
    <div class="border-b border-border px-4 py-3">
      <p class="text-sm font-590 text-text-primary">Activity feed</p>
      <p class="ui-advanced-only mt-1 text-xs text-text-tertiary">
        Newest events appear first. Open an issue to inspect the full execution context.
      </p>
    </div>

    <.infinite_scroll
      id="activity"
      has_more={@infinite_scroll[:activities][:has_more?] || false}
      container_class="divide-y divide-border"
    >
      <:empty>
        <div class="flex flex-col items-center justify-center px-6 py-16 text-center">
          <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-full bg-surface">
            <.icon name="hero-clipboard-document-list-mini" class="h-6 w-6 text-text-tertiary" />
          </div>
          <p class="text-sm font-510 text-text-secondary">No activity found.</p>
          <p class="mt-1 max-w-sm text-xs leading-5 text-text-tertiary">
            Create work, clear filters, or start runtime to populate the company record.
          </p>
        </div>
      </:empty>

      <div
        :for={{dom_id, activity} <- @streams.activities}
        id={dom_id}
        class="group flex items-start gap-4 p-4 transition-colors hover:bg-surface-hover"
      >
        <div class={"flex h-9 w-9 shrink-0 items-center justify-center rounded-full #{activity_icon_tone(activity.action)}"}>
          <.icon name={activity_icon(activity.action)} class="h-4 w-4" />
        </div>

        <div class="min-w-0 flex-1">
          <div class="flex flex-col gap-1 sm:flex-row sm:items-center sm:justify-between">
            <div class="min-w-0">
              <div class="flex flex-wrap items-center gap-2">
                <span class="text-sm font-590 text-text-primary">
                  {actor_name(activity)}
                </span>
                <span class="rounded-full border border-border bg-surface px-2 py-0.5 text-[11px] font-510 text-text-tertiary">
                  {format_actor_type(activity.actor_type)}
                </span>
                <span class="text-xs font-510 text-text-secondary">
                  {format_action(activity.action)}
                </span>
              </div>

              <div class="mt-1 min-w-0">
                <%= if activity.issue do %>
                  <.app_link
                    navigate={~p"/issues/#{activity.issue.id}"}
                    class="inline-block max-w-full truncate text-xs text-text-tertiary transition-colors hover:text-text-primary"
                  >
                    {activity.issue.identifier || "Issue"} - {activity.issue.title}
                  </.app_link>
                <% else %>
                  <span class="text-xs text-text-quaternary">Issue removed</span>
                <% end %>
              </div>
            </div>

            <p class="shrink-0 text-xs text-text-quaternary">
              {format_timestamp(activity.inserted_at)}
            </p>
          </div>

          <div
            :if={activity_detail_visible?(activity.action)}
            class="ui-advanced-only mt-2 rounded-md border border-border bg-surface px-3 py-2 text-xs leading-5 text-text-tertiary"
          >
            <.render_metadata metadata={activity.metadata} action={activity.action} />
          </div>
        </div>
      </div>
    </.infinite_scroll>
  </section>
</div>
