<div class="p-6 lg:p-8 max-w-6xl mx-auto">
  <.header title={@page_title} />
  
<!-- Filters -->
  <div class="space-y-3 mb-4">
    <div class="flex items-center gap-3 flex-wrap">
      <form phx-change="filter" phx-submit="prevent">
        <.select_menu
          name="filter_action"
          value={@filter_action || ""}
          options={[
            {"All Actions", ""},
            {"Created", "created"},
            {"Title Changed", "title_changed"},
            {"Description Changed", "description_changed"},
            {"Status Changed", "status_changed"},
            {"Assigned", "assigned"},
            {"Unassigned", "unassigned"},
            {"Blocker Added", "blocker_added"},
            {"Blocker Removed", "blocker_removed"},
            {"Comment Added", "comment_added"},
            {"Approval Created", "approval_created"},
            {"Approval Resolved", "approval_resolved"},
            {"Heartbeat Started", "heartbeat_started"},
            {"Heartbeat Completed", "heartbeat_completed"},
            {"Heartbeat Failed", "heartbeat_failed"}
          ]}
        />
      </form>

      <form phx-change="filter" phx-submit="prevent">
        <.select_menu
          name="filter_actor_type"
          value={@filter_actor_type || ""}
          options={[
            {"All Actors", ""},
            {"Agents", "agent"},
            {"Users", "user"},
            {"System", "system"}
          ]}
        />
      </form>

      <button
        :if={@filter_action != "" or @filter_actor_type != ""}
        type="button"
        phx-click="clear_filters"
        class="text-xs text-text-quaternary hover:text-text-secondary transition-colors"
      >
        Clear filters
      </button>
    </div>
  </div>
  
<!-- Activities List -->
  <.infinite_scroll
    id="activity"
    has_more={@infinite_scroll[:activities][:has_more?] || false}
    container_class="space-y-2"
  >
    <:empty>
      <div class="flex flex-col items-center justify-center py-20 text-center">
        <div class="w-12 h-12 rounded-full bg-surface flex items-center justify-center mb-4">
          <svg
            class="w-6 h-6 text-text-tertiary"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"
            />
          </svg>
        </div>
        <p class="text-sm text-text-tertiary">No activity found.</p>
      </div>
    </:empty>

    <div
      :for={{dom_id, activity} <- @streams.activities}
      id={dom_id}
      class="group flex items-start gap-4 p-3 rounded-lg hover:bg-surface-hover transition-colors border border-transparent hover:border-border"
    >
      <!-- Icon -->
      <div class="w-8 h-8 rounded-full bg-surface flex items-center justify-center shrink-0">
        <span class="text-lg">{activity_icon(activity.action)}</span>
      </div>
      
<!-- Content -->
      <div class="flex-1 min-w-0">
        <div class="flex items-center gap-2 flex-wrap">
          <span class="text-sm font-medium text-text-primary">
            {actor_name(activity)}
          </span>
          <span class="text-xs text-text-quaternary">
            {format_actor_type(activity.actor_type)}
          </span>
          <span class="text-xs text-text-quaternary">•</span>
          <span class="text-xs text-text-secondary font-medium">
            {format_action(activity.action)}
          </span>
        </div>

        <div class="flex items-center gap-2 mt-1">
          <%= if activity.issue do %>
            <.app_link
              navigate={~p"/issues/#{activity.issue.id}"}
              class="text-xs text-text-quaternary hover:text-text-secondary transition-colors"
            >
              {activity.issue.identifier || "Issue"}—{activity.issue.title}
            </.app_link>
          <% else %>
            <span class="text-xs text-text-quaternary">Issue removed</span>
          <% end %>
        </div>

        <p class="text-xs text-text-quaternary mt-1">
          {format_timestamp(activity.inserted_at)}
        </p>
        
<!-- Metadata display for specific actions -->
        <div :if={activity.metadata != %{}} class="mt-2 text-xs text-text-quaternary">
          <.render_metadata metadata={activity.metadata} action={activity.action} />
        </div>
      </div>
    </div>
  </.infinite_scroll>
</div>
