<.page size="wide" data-ui-complex-page data-density={@digest_density} class="ember-aurora">
  <div class="relative z-10">
    <div class="mb-5 px-1 pt-2">
      <%!-- Row 1: identity (left) + agent scope & density (right) --%>
      <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
        <div class="min-w-0">
          <h1 class="ember-ink font-serif text-[clamp(30px,4.5vw,44px)] font-510 leading-[1.08] tracking-[-0.02em]">
            Inbox
          </h1>
        </div>

        <div class="flex flex-wrap items-center gap-2 lg:shrink-0">
          <% unread_count = count_for(@inbox_counts, "unread") %>

          <form phx-change="select_agent" class="ui-advanced-only">
            <.select_menu
              name="agent_id"
              value={@selected_agent_id}
              class="min-w-[200px]"
              options={[
                {"All agents", "all"}
                | Enum.map(@agents, &{agent_option_label(&1, @agent_counts), &1.id})
              ]}
            />
          </form>

          <button
            type="button"
            phx-click="mark_unread_read"
            disabled={unread_count == 0}
            aria-label="Mark unread as read"
            title="Mark unread as read"
            class={[
              "relative inline-flex h-9 w-9 items-center justify-center rounded-lg border transition-colors",
              unread_count > 0 &&
                "border-blue-500/25 bg-blue-500/10 text-blue-200 hover:bg-blue-500/15 hover:text-blue-100",
              unread_count == 0 &&
                "cursor-not-allowed border-border bg-surface text-text-quaternary opacity-60"
            ]}
          >
            <span class="hero-check-circle-mini h-4 w-4"></span>
            <span
              :if={unread_count > 0}
              class="absolute -right-1 -top-1 min-w-[16px] rounded-full bg-blue-400 px-1 font-mono text-[9px] font-590 leading-4 text-slate-950 tabular-nums"
            >
              {unread_count}
            </span>
          </button>

          <div class="ui-advanced-only">
            <.density_switch
              density={@digest_density}
              compact_patch={
                inbox_url(@selected_agent_id, @current_status, @digest_density, %{
                  density: "compact"
                })
              }
              detailed_patch={
                inbox_url(@selected_agent_id, @current_status, @digest_density, %{
                  density: "detailed"
                })
              }
            />
          </div>
        </div>
      </div>

      <hr class="ember-rule mt-4" />

      <%!-- Row 2: status filters. Triage lanes first; the archive-keeping
           filters sit after a divider so the eye stops at what needs work. --%>
      <div class="mt-4 flex flex-wrap items-center gap-2">
        <.link
          patch={inbox_url(@selected_agent_id, @current_status, @digest_density, %{status: nil})}
          class={[
            "inline-flex items-center gap-2 rounded-full border px-3.5 py-1.5 text-xs font-510 transition-colors",
            status_tab_class(@current_status, nil)
          ]}
        >
          <span>All</span>
          <span class="font-mono text-[11px] tabular-nums opacity-70">
            {total_count(@inbox_counts)}
          </span>
        </.link>
        <%!-- Simple mode keeps only "All" and the one lane that answers "is this
             mine?". Unread/Awaiting review are ways of slicing the same list. --%>
        <.link
          :for={status <- ["action", "unread", "review"]}
          patch={
            inbox_url(@selected_agent_id, @current_status, @digest_density, %{status: status})
          }
          class={[
            "inline-flex items-center gap-2 rounded-full border px-3.5 py-1.5 text-xs font-510 transition-colors",
            status != "action" && "ui-advanced-only",
            status_tab_class(@current_status, status)
          ]}
        >
          <span class={["h-1.5 w-1.5 shrink-0 rounded-full", status_dot(status)]}></span>
          <span class="ui-advanced-only">{status_filter_label(status)}</span>
          <span :if={status == "action"} class="ui-simple-only">Needs you</span>
          <span
            :if={count_for(@inbox_counts, status) > 0}
            class="font-mono text-[11px] tabular-nums opacity-70"
          >
            {count_for(@inbox_counts, status)}
          </span>
        </.link>

        <details class="ui-advanced-only cympho-menu relative">
          <summary
            class="flex h-8 w-8 cursor-pointer list-none items-center justify-center rounded-full border border-border bg-surface text-text-quaternary transition-colors hover:bg-surface-hover hover:text-text-primary"
            aria-label="More inbox filters"
            title="More inbox filters"
          >
            <span class="hero-funnel-mini h-3.5 w-3.5"></span>
          </summary>
          <div class="cympho-menu-panel absolute left-0 z-30 mt-2 min-w-40 rounded-xl border border-border bg-panel p-1 shadow-dialog">
            <.link
              :for={status <- ["read", "dismissed", "archived"]}
              patch={
                inbox_url(@selected_agent_id, @current_status, @digest_density, %{
                  status: status
                })
              }
              class={[
                "flex items-center gap-2 rounded-md px-2.5 py-2 text-xs transition-colors hover:bg-surface-hover",
                cleanup_tab_class(@current_status, status)
              ]}
            >
              <span class="flex-1">{status_filter_label(status)}</span>
              <span class="font-mono text-[10px] tabular-nums text-text-quaternary">
                {count_for(@inbox_counts, status)}
              </span>
            </.link>
          </div>
        </details>
      </div>
    </div>

    <section
      data-testid="inbox-command"
      class={[
        "ember-glass ui-advanced-only mb-5 overflow-hidden",
        @digest_density == "compact" && "hidden"
      ]}
    >
      <div class="grid gap-4 p-4 lg:grid-cols-[minmax(0,1fr)_auto] lg:items-start">
        <div class="min-w-0">
          <div class="flex flex-wrap items-center gap-2">
            <p class="text-[11px] font-590 uppercase tracking-[0.14em] text-text-quaternary">
              Inbox command
            </p>
            <span class={"rounded-full border px-2 py-0.5 text-[11px] font-510 #{inbox_command_badge(@inbox_command.tone)}"}>
              {@inbox_command.badge}
            </span>
          </div>

          <h2 class="mt-2 text-lg font-590 text-text-primary">
            {@inbox_command.heading}
          </h2>
          <p class="mt-1 max-w-3xl text-sm leading-6 text-text-tertiary">
            {@inbox_command.detail}
          </p>

          <div
            :if={@inbox_command.focus_label}
            class="mt-3 flex flex-wrap items-center gap-2 text-xs"
          >
            <span class="rounded-full border border-border bg-surface px-2 py-1 font-510 text-text-secondary">
              {@inbox_command.focus_label}
            </span>
            <span
              :if={@inbox_command.focus_detail}
              class="rounded-full border border-border bg-surface px-2 py-1 text-text-tertiary"
            >
              {@inbox_command.focus_detail}
            </span>
          </div>
        </div>

        <.app_link
          navigate={@inbox_command.action_path}
          class={"inline-flex shrink-0 items-center justify-center rounded-lg border px-3 py-2 text-sm font-590 transition-colors #{inbox_command_action(@inbox_command.tone)}"}
        >
          {@inbox_command.action_label}
        </.app_link>
      </div>

      <div class="border-t border-hairline px-4 py-4">
        <p class="font-serif text-[13px] font-510 italic tracking-[0.02em] text-brand/90">
          Action queue
        </p>

        <div
          id="inbox-action-queue"
          data-testid="inbox-action-queue"
          class="stagger-children mt-3 grid gap-2 sm:grid-cols-2 xl:grid-cols-5"
        >
          <.app_link
            :for={queue <- @inbox_action_queue}
            navigate={queue.action_path}
            title={queue.summary}
            class={"group/queue rounded-xl border border-border bg-surface-1 px-3 py-2.5 transition-colors hover:border-border-hover hover:bg-subtle #{inbox_queue_card_class(queue.tone)} #{if queue.tone == :clear, do: "opacity-60 hover:opacity-100"}"}
          >
            <div class="flex items-center justify-between gap-2">
              <p class="truncate text-[11px] font-590 uppercase tracking-[0.1em] text-text-quaternary">
                {queue.label}
              </p>
              <span class={"shrink-0 rounded-full border px-1.5 py-0.5 text-[10px] font-510 #{inbox_queue_badge_class(queue.tone)}"}>
                {queue.state_label}
              </span>
            </div>
            <div class="mt-1.5 flex items-baseline justify-between gap-2">
              <p class={"font-mono text-xl font-590 tabular-nums #{inbox_queue_count_class(queue.tone)}"}>
                {queue.count}
              </p>
              <span class="inline-flex items-center gap-1 text-[11px] font-510 text-text-tertiary transition-colors group-hover/queue:text-brand">
                {queue.action_label}<span class="hero-arrow-right-mini h-3 w-3"></span>
              </span>
            </div>
          </.app_link>
        </div>
      </div>
    </section>

    <.infinite_scroll
      id="inbox"
      has_more={@infinite_scroll[:inbox_items][:has_more?] || false}
      container_class={
        if @digest_density == "compact",
          do: "stagger-children grid gap-1.5",
          else: "stagger-children grid gap-3"
      }
    >
      <:empty>
        <div class="ember-glass px-6 py-16 text-center">
          <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-2xl border border-brand/25 bg-brand/10 text-brand">
            <span class="hero-check-circle-mini h-7 w-7"></span>
          </div>
          <p class="ember-ink mx-auto mt-5 font-serif text-[22px] font-510 tracking-[-0.01em]">
            {empty_state_heading(@current_status)}
          </p>
          <.link
            :if={@current_status}
            patch={
              inbox_url(@selected_agent_id, @current_status, @digest_density, %{status: nil})
            }
            class="mt-4 inline-flex items-center gap-1.5 text-xs font-590 text-text-secondary hover:text-brand"
          >
            View all items <span class="hero-arrow-right-mini h-3.5 w-3.5"></span>
          </.link>
        </div>
      </:empty>
      <div
        :for={{dom_id, item} <- @streams.inbox_items}
        id={dom_id}
        class={[
          "group border border-hairline bg-surface-1 transition-all hover:border-border-hover hover:bg-surface-hover/40 hover:shadow-raised",
          if(@digest_density == "compact", do: "rounded-lg", else: "rounded-2xl"),
          if(
            item.status == "unread" or
              item_kind(item) in [:review, :human_action, :decision, :failure, :spend],
            do: "border-l-2 border-l-brand shadow-raised",
            else: "shadow-card"
          ),
          item.status in ["read", "dismissed", "archived"] && "opacity-75 hover:opacity-100"
        ]}
      >
        <div class={[
          "grid grid-cols-[auto_minmax(0,1fr)] lg:grid-cols-[auto_minmax(0,1fr)_auto] lg:items-start",
          if(@digest_density == "compact", do: "gap-2.5 p-2.5", else: "gap-3.5 p-4")
        ]}>
          <%!-- Kind glyph: lets the eye filter handoffs / reviews / evidence /
               needs-me by shape without reading a word. --%>
          <span
            class={[
              "flex shrink-0 items-center justify-center rounded-lg border",
              if(@digest_density == "compact", do: "h-7 w-7", else: "h-9 w-9"),
              kind_tile_class(item_kind(item))
            ]}
            aria-hidden="true"
          >
            <span class={[
              kind_icon(item_kind(item)),
              if(@digest_density == "compact", do: "h-3.5 w-3.5", else: "h-4 w-4")
            ]}>
            </span>
          </span>

          <div class="min-w-0">
            <div class={[
              "flex flex-wrap items-center gap-x-2 gap-y-1 text-xs",
              if(@digest_density == "compact", do: "mb-1", else: "mb-1.5")
            ]}>
              <%!-- The tile icon to the left already carries the kind, and with
                   19 rows the chip repeats verbatim down the whole column. Simple
                   drops it; the icon keeps the meaning via its own aria-label. --%>
              <span
                :if={kind_chip_label(item_kind(item))}
                class={[
                  "ui-advanced-only rounded-full border px-2 py-0.5 font-510",
                  kind_chip_class(item_kind(item))
                ]}
              >
                {kind_chip_label(item_kind(item))}
              </span>
              <span :if={kind_chip_label(item_kind(item))} class="ui-simple-only sr-only">
                {kind_chip_label(item_kind(item))}
              </span>
              <span
                :if={item_kind(item) in [:update, :deferred]}
                class="font-510 text-text-quaternary"
              >
                {status_filter_label(item.status)}
              </span>
              <span
                :if={item.review_nudge}
                class="rounded-full border border-amber-500/25 bg-amber-500/10 px-2 py-0.5 font-510 text-amber-200"
              >
                {item.review_nudge.label || "Review evidence needed"}
              </span>
              <span class="text-text-quaternary">
                To {target_agent_name(item, @selected_agent)}
              </span>
              <span
                :if={item.inserted_at}
                class="text-text-quaternary"
                title={full_timestamp(item.inserted_at)}
              >
                · {relative_time_label(item.inserted_at)}
              </span>
            </div>

            <%= cond do %>
              <% owner_decision_item?(item) -> %>
                <.app_link
                  navigate={item.target_path}
                  class="block min-w-0 text-base font-590 leading-6 text-text-primary hover:text-brand"
                >
                  {item.title}
                </.app_link>

                <%!-- Failed-run summaries are boilerplate: the same sentence on
                     every failure row. Simple hides it (the title already reads
                     "Run failed · X"); every other kind carries a real summary
                     and keeps it. --%>
                <p
                  :if={item.summary not in [nil, ""]}
                  class={[
                    "mt-1.5 max-w-3xl text-sm leading-6 text-text-tertiary",
                    item_kind(item) == :failure && "ui-advanced-only"
                  ]}
                >
                  {item.summary}
                </p>

                <p
                  :if={@digest_density == "detailed" and item.diagnostic not in [nil, ""]}
                  class="ui-advanced-only mt-2 font-mono text-xs leading-5 text-text-quaternary"
                  data-testid="owner-attention-diagnostic"
                >
                  Technical details · {item.diagnostic}
                </p>
              <% item.issue -> %>
                <.app_link
                  navigate={issue_link(item.issue)}
                  class={"block min-w-0 text-base leading-6 hover:text-brand #{if item.status == "unread", do: "font-590 text-text-primary", else: "font-510 text-text-secondary"}"}
                >
                  <span class="font-mono text-xs text-text-quaternary">
                    {item.issue.identifier || "Issue"}
                  </span>
                  <span class="mx-2 text-text-quaternary">·</span>
                  <span>{item.issue.title}</span>
                </.app_link>

                <p
                  :if={@digest_density == "detailed" and issue_description(item.issue)}
                  class="mt-2 line-clamp-2 max-w-3xl text-sm text-text-tertiary"
                >
                  {issue_description(item.issue)}
                </p>

                <div
                  :if={@digest_density == "detailed" and item.review_nudge}
                  class="mt-2 flex flex-wrap items-center gap-1.5"
                >
                  <span
                    class="line-clamp-1 text-xs text-amber-200/80"
                    title={item.review_nudge.summary}
                  >
                    {item.review_nudge.summary}
                  </span>
                  <span
                    :for={label <- item.review_nudge.blocker_labels || []}
                    class="rounded-full border border-amber-500/25 bg-amber-500/10 px-1.5 py-0.5 text-[10px] font-510 text-amber-200"
                  >
                    {label}
                  </span>
                </div>

                <.issue_digest_card
                  issue={item.issue}
                  density={@digest_density}
                  variant={if @digest_density == "compact", do: "inline", else: "card"}
                  class="mt-2"
                />

                <div class={[
                  "flex flex-wrap items-center gap-x-2.5 gap-y-1 text-xs text-text-quaternary",
                  if(@digest_density == "compact", do: "mt-1", else: "mt-2")
                ]}>
                  <span>{issue_status_label(item.issue.status)}</span>
                  <.priority_mark
                    :if={item.issue.priority in [:critical, :high, "critical", "high"]}
                    priority={item.issue.priority}
                    pill_class={"border #{priority_badge_class(item.issue.priority)}"}
                  />
                  <%!-- "To CEO" in the row header already names the owner. --%>
                  <span :if={item.issue.assigned_role} class="ui-advanced-only">
                    Role: {item.issue.assigned_role}
                  </span>
                </div>
              <% true -> %>
                <p class="text-base font-590 text-text-tertiary">Issue removed</p>
                <p class="mt-2 text-sm text-text-quaternary">
                  This inbox entry points to an issue that is no longer available.
                </p>
            <% end %>
          </div>

          <div class="col-start-2 flex flex-wrap items-center gap-1.5 self-start lg:col-start-auto lg:justify-end">
            <button
              :if={item.status in ["unread", "read"]}
              type="button"
              phx-click="dismiss"
              phx-value-issue_id={item.issue_id}
              phx-value-agent_id={item.agent_id}
              title="Dismiss — set aside without archiving"
              aria-label="Dismiss"
              class={[
                "inline-flex h-8 w-8 items-center justify-center rounded-lg border border-transparent text-text-quaternary transition-colors hover:border-border hover:bg-surface hover:text-text-secondary",
                "lg:opacity-0 lg:transition-opacity lg:duration-200 lg:group-hover:opacity-100 lg:group-focus-within:opacity-100",
                @digest_density == "compact" && "hidden"
              ]}
            >
              <span class="hero-minus-circle-mini h-4 w-4"></span>
              <span class="sr-only">Dismiss</span>
            </button>
            <button
              :if={item.status in ["unread", "read", "dismissed"]}
              type="button"
              phx-click="archive"
              phx-value-issue_id={item.issue_id}
              phx-value-agent_id={item.agent_id}
              title="Archive — file away for good"
              aria-label="Archive"
              class={[
                "inline-flex h-8 w-8 items-center justify-center rounded-lg border border-transparent text-text-quaternary transition-colors hover:border-border hover:bg-surface hover:text-text-secondary",
                "lg:opacity-0 lg:transition-opacity lg:duration-200 lg:group-hover:opacity-100 lg:group-focus-within:opacity-100",
                @digest_density == "compact" && "hidden"
              ]}
            >
              <span class="hero-archive-box-mini h-4 w-4"></span>
              <span class="sr-only">Archive</span>
            </button>
            <button
              :if={item.status == "unread"}
              type="button"
              phx-click="mark_read"
              phx-value-issue_id={item.issue_id}
              phx-value-agent_id={item.agent_id}
              title="Mark read"
              aria-label="Mark read"
              class={[
                "inline-flex items-center justify-center rounded-lg border border-blue-500/25 bg-blue-500/10 text-blue-300 transition-colors hover:bg-blue-500/15",
                if(@digest_density == "compact", do: "h-8 w-8", else: "h-9 w-9")
              ]}
            >
              <span class="hero-envelope-open-mini h-4 w-4"></span>
              <span class="sr-only">Mark read</span>
            </button>
            <.app_link
              :if={not is_nil(item.issue) and not owner_decision_item?(item)}
              navigate={issue_link(item.issue)}
              class={"rounded-lg border text-xs font-510 transition-colors #{if @digest_density == "compact", do: "px-2.5 py-1.5", else: "px-3 py-2"} #{if item.status == "unread" or item_kind(item) == :human_action, do: "border-brand/30 bg-brand/10 font-590 text-brand hover:bg-brand/20", else: "border-border bg-surface text-text-secondary hover:bg-surface-hover hover:text-text-primary"}"}
            >
              Open issue
            </.app_link>
            <button
              :if={Map.get(item, :kind) == :approval}
              type="button"
              phx-click="deny_approval"
              phx-value-approval_id={item.source_id}
              data-confirm="Deny this approval request?"
              class={[
                "rounded-lg border border-rose-500/30 bg-rose-500/10 text-xs font-510 text-rose-200 transition-colors hover:bg-rose-500/15",
                if(@digest_density == "compact", do: "px-2.5 py-1.5", else: "px-3 py-2")
              ]}
            >
              Deny
            </button>
            <button
              :if={Map.get(item, :kind) == :approval}
              type="button"
              phx-click="approve_approval"
              phx-value-approval_id={item.source_id}
              data-confirm="Approve this request and let the agent continue?"
              class={[
                "rounded-lg border border-emerald-500/30 bg-emerald-500/15 text-xs font-590 text-emerald-200 transition-colors hover:bg-emerald-500/25",
                if(@digest_density == "compact", do: "px-2.5 py-1.5", else: "px-3 py-2")
              ]}
            >
              Approve
            </button>
            <.app_link
              :if={owner_decision_item?(item) and item.target_path}
              navigate={item.target_path}
              class={"rounded-lg border border-border bg-surface text-xs font-510 text-text-secondary transition-colors hover:bg-surface-hover hover:text-text-primary #{if @digest_density == "compact", do: "px-2.5 py-1.5", else: "px-3 py-2"}"}
            >
              {item.target_label || "Open details"}
            </.app_link>
            <.app_link
              :if={item.review_nudge && item.review_nudge.target_path}
              navigate={item.review_nudge.target_path}
              class={"rounded-lg border border-amber-500/25 bg-amber-500/10 text-xs font-510 text-amber-200 transition-colors hover:bg-amber-500/15 hover:text-amber-100 #{if @digest_density == "compact", do: "px-2.5 py-1.5", else: "px-3 py-2"}"}
            >
              {item.review_nudge.target_label || "Open review queue"}
            </.app_link>
            <button
              :if={Map.get(item, :kind) == :review_queue and item.issue}
              type="button"
              phx-click="request_review_changes"
              phx-value-issue_id={item.issue_id}
              phx-value-wake_id={item.wake_id}
              class={[
                "rounded-lg border border-amber-500/30 bg-amber-500/10 text-xs font-510 text-amber-200 transition-colors hover:bg-amber-500/15",
                if(@digest_density == "compact", do: "px-2.5 py-1.5", else: "px-3 py-2")
              ]}
            >
              Request changes
            </button>
            <button
              :if={Map.get(item, :kind) == :review_queue and item.issue}
              type="button"
              phx-click="approve_review"
              phx-value-issue_id={item.issue_id}
              phx-value-wake_id={item.wake_id}
              data-confirm={"Approve #{(item.issue && item.issue.identifier) || "issue"} and close it?"}
              class={[
                "rounded-lg border border-emerald-500/30 bg-emerald-500/15 text-xs font-590 text-emerald-200 transition-colors hover:bg-emerald-500/25",
                if(@digest_density == "compact", do: "px-2.5 py-1.5", else: "px-3 py-2")
              ]}
            >
              Approve
            </button>
            <button
              :if={item.status in ["dismissed", "archived"]}
              type="button"
              phx-click="restore"
              phx-value-issue_id={item.issue_id}
              phx-value-agent_id={item.agent_id}
              class={[
                "inline-flex items-center gap-1.5 rounded-lg border border-emerald-500/25 bg-emerald-500/10 text-xs font-510 text-emerald-300 transition-colors hover:bg-emerald-500/15",
                if(@digest_density == "compact", do: "px-2.5 py-1.5", else: "px-3 py-2")
              ]}
            >
              <span class="hero-arrow-uturn-left-mini h-3.5 w-3.5"></span> Restore
            </button>
          </div>
        </div>
      </div>
    </.infinite_scroll>
  </div>
</.page>
