<.page size="wide" data-ui-complex-page data-density={@digest_density}>
  <div class="mb-5 rounded-2xl border border-hairline bg-surface-1 p-4 sm:p-5">
    <%!-- Row 1: identity (left) + agent scope & density (right) --%>
    <div class="flex flex-col gap-4 lg:flex-row lg:items-start lg:justify-between">
      <div class="min-w-0">
        <div class="flex flex-wrap items-center gap-2.5">
          <h1 class="font-serif text-2xl text-text-primary">Inbox</h1>
          <span class="rounded-full border border-hairline bg-surface px-2.5 py-1 text-xs text-text-quaternary">
            {total_count(@inbox_counts)} total
          </span>
        </div>

        <p :if={@digest_density == "detailed"} class="mt-1.5 text-sm text-text-tertiary">
          Agent handoffs, review signals, and issue notifications across the company.
        </p>
        <p class="mt-2 truncate text-sm text-text-secondary">
          <span class="font-590 text-text-quaternary">Queue scope:</span>
          <span class="font-590 text-text-primary">
            {inbox_scope_label(@selected_agent_id, @selected_agent)}
          </span>
          <span class="text-text-quaternary">·</span>
          {status_filter_label(@current_status)} items
        </p>
      </div>

      <div class="flex flex-wrap items-center gap-2 lg:shrink-0">
        <% unread_count = count_for(@inbox_counts, "unread") %>

        <form phx-change="select_agent">
          <.select_menu
            name="agent_id"
            value={@selected_agent_id}
            class="min-w-[200px]"
            options={[
              {"All agents", "all"}
              | Enum.map(@agents, &{agent_option_label(&1, @agent_counts), &1.id})
            ]}
          />
        </form>

        <button
          type="button"
          phx-click="mark_unread_read"
          disabled={unread_count == 0}
          class={[
            "inline-flex h-9 items-center gap-1.5 rounded-lg border px-3 text-xs font-510 transition-colors",
            unread_count > 0 &&
              "border-blue-500/25 bg-blue-500/10 text-blue-200 hover:bg-blue-500/15 hover:text-blue-100",
            unread_count == 0 &&
              "cursor-not-allowed border-border bg-surface text-text-quaternary opacity-60"
          ]}
        >
          <span class="hero-check-circle-mini h-4 w-4"></span>
          <span>Mark unread as read</span>
          <span
            :if={unread_count > 0}
            class="rounded-full bg-blue-400/15 px-1.5 py-0.5 font-mono text-[11px] tabular-nums"
          >
            {unread_count}
          </span>
        </button>

        <.density_switch
          density={@digest_density}
          compact_patch={
            inbox_url(@selected_agent_id, @current_status, @digest_density, %{
              density: "compact"
            })
          }
          detailed_patch={
            inbox_url(@selected_agent_id, @current_status, @digest_density, %{
              density: "detailed"
            })
          }
        />
      </div>
    </div>

    <%!-- Row 2: status filters — wrap freely to multiple rows, full labels --%>
    <div class="mt-4 flex flex-wrap gap-2 border-t border-hairline/70 pt-4">
      <.link
        patch={inbox_url(@selected_agent_id, @current_status, @digest_density, %{status: nil})}
        class={[
          "inline-flex items-center gap-2 rounded-full border px-3.5 py-1.5 text-xs font-510 transition-colors",
          status_tab_class(@current_status, nil)
        ]}
      >
        <span>All</span>
        <span class="font-mono text-[11px] tabular-nums opacity-70">
          {total_count(@inbox_counts)}
        </span>
      </.link>
      <.link
        :for={status <- ["action", "unread", "read", "dismissed", "archived", "review"]}
        patch={inbox_url(@selected_agent_id, @current_status, @digest_density, %{status: status})}
        class={[
          "inline-flex items-center gap-2 rounded-full border px-3.5 py-1.5 text-xs font-510 transition-colors",
          status_tab_class(@current_status, status)
        ]}
      >
        <span class={["h-1.5 w-1.5 shrink-0 rounded-full", status_dot(status)]}></span>
        <span>{status_filter_label(status)}</span>
        <span class="font-mono text-[11px] tabular-nums opacity-70">
          {count_for(@inbox_counts, status)}
        </span>
      </.link>
    </div>
  </div>

  <section
    data-testid="inbox-command"
    class={[
      "mb-5 overflow-hidden rounded-lg border border-hairline bg-surface-1 shadow-card",
      @digest_density == "compact" && "hidden"
    ]}
  >
    <div class="grid gap-4 p-4 lg:grid-cols-[minmax(0,1fr)_auto] lg:items-start">
      <div class="min-w-0">
        <div class="flex flex-wrap items-center gap-2">
          <p class="text-[11px] font-590 uppercase tracking-[0.14em] text-text-quaternary">
            Inbox command
          </p>
          <span class={"rounded-full border px-2 py-0.5 text-[11px] font-510 #{inbox_command_badge(@inbox_command.tone)}"}>
            {@inbox_command.badge}
          </span>
        </div>

        <h2 class="mt-2 text-lg font-590 text-text-primary">
          {@inbox_command.heading}
        </h2>
        <p class="mt-1 max-w-3xl text-sm leading-6 text-text-tertiary">
          {@inbox_command.detail}
        </p>

        <div
          :if={@inbox_command.focus_label}
          class="mt-3 flex flex-wrap items-center gap-2 text-xs"
        >
          <span class="rounded-full border border-border bg-surface px-2 py-1 font-510 text-text-secondary">
            {@inbox_command.focus_label}
          </span>
          <span
            :if={@inbox_command.focus_detail}
            class="rounded-full border border-border bg-surface px-2 py-1 text-text-tertiary"
          >
            {@inbox_command.focus_detail}
          </span>
        </div>
      </div>

      <.app_link
        navigate={@inbox_command.action_path}
        class={"inline-flex shrink-0 items-center justify-center rounded-lg border px-3 py-2 text-sm font-590 transition-colors #{inbox_command_action(@inbox_command.tone)}"}
      >
        {@inbox_command.action_label}
      </.app_link>
    </div>

    <div class="grid grid-cols-2 border-t border-hairline sm:grid-cols-3 lg:grid-cols-6">
      <div class="border-r border-hairline px-4 py-3 last:border-r-0">
        <p class="text-[10px] font-590 uppercase tracking-[0.14em] text-text-quaternary">
          My action
        </p>
        <p class="mt-1 font-mono text-xl font-590 text-white tabular-nums">
          {@inbox_command.action_count}
        </p>
      </div>
      <div class="border-r border-hairline px-4 py-3 last:border-r-0">
        <p class="text-[10px] font-590 uppercase tracking-[0.14em] text-text-quaternary">
          Unread
        </p>
        <p class="mt-1 font-mono text-xl font-590 text-blue-300 tabular-nums">
          {@inbox_command.unread_count}
        </p>
      </div>
      <div class="border-r border-hairline px-4 py-3 last:border-r-0">
        <p class="text-[10px] font-590 uppercase tracking-[0.14em] text-text-quaternary">
          Reviews
        </p>
        <p class="mt-1 font-mono text-xl font-590 text-brand tabular-nums">
          {@inbox_command.review_count}
        </p>
      </div>
      <div class="border-r border-hairline px-4 py-3 last:border-r-0">
        <p class="text-[10px] font-590 uppercase tracking-[0.14em] text-text-quaternary">
          Nudges
        </p>
        <p class="mt-1 font-mono text-xl font-590 text-amber-300 tabular-nums">
          {@inbox_command.nudge_count}
        </p>
      </div>
      <div class="border-r border-hairline px-4 py-3 last:border-r-0">
        <p class="text-[10px] font-590 uppercase tracking-[0.14em] text-text-quaternary">
          Deferred
        </p>
        <p class="mt-1 font-mono text-xl font-590 text-slate-300 tabular-nums">
          {@inbox_command.deferred_count}
        </p>
      </div>
      <div class="px-4 py-3">
        <p class="text-[10px] font-590 uppercase tracking-[0.14em] text-text-quaternary">
          Total
        </p>
        <p class="mt-1 font-mono text-xl font-590 text-text-primary tabular-nums">
          {@inbox_command.total_count}
        </p>
      </div>
    </div>

    <div class="border-t border-hairline px-4 py-3">
      <p class="text-[11px] font-590 uppercase tracking-[0.14em] text-text-quaternary">
        Action queue
      </p>
      <p class="mt-1 text-sm text-text-tertiary">
        Jump to the lane that needs the next owner decision.
      </p>
    </div>

    <div
      id="inbox-action-queue"
      data-testid="inbox-action-queue"
      class="grid gap-px border-t border-hairline bg-hairline md:grid-cols-2 xl:grid-cols-5"
    >
      <div
        :for={queue <- @inbox_action_queue}
        class={"bg-surface-1 px-4 py-3 #{inbox_queue_card_class(queue.tone)}"}
      >
        <div class="flex items-start justify-between gap-3">
          <div class="min-w-0">
            <p class="text-[10px] font-590 uppercase tracking-[0.14em] text-text-quaternary">
              {queue.label}
            </p>
            <p class="mt-1 text-sm leading-5 text-text-tertiary">{queue.summary}</p>
          </div>
          <div class="shrink-0 text-right">
            <p class={"font-mono text-xl font-590 tabular-nums #{inbox_queue_count_class(queue.tone)}"}>
              {queue.count}
            </p>
            <span class={"rounded-full border px-1.5 py-0.5 text-[10px] font-510 #{inbox_queue_badge_class(queue.tone)}"}>
              {queue.state_label}
            </span>
          </div>
        </div>

        <.app_link
          navigate={queue.action_path}
          class="mt-3 inline-flex items-center gap-1.5 text-xs font-590 text-text-secondary hover:text-brand"
        >
          {queue.action_label}
          <span class="hero-arrow-right-mini h-3.5 w-3.5"></span>
        </.app_link>
      </div>
    </div>
  </section>

  <.infinite_scroll
    id="inbox"
    has_more={@infinite_scroll[:inbox_items][:has_more?] || false}
    container_class={if @digest_density == "compact", do: "grid gap-1.5", else: "grid gap-3"}
  >
    <:empty>
      <div class="rounded-lg border border-dashed border-border bg-panel px-6 py-16 text-center">
        <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-lg border border-border bg-surface">
          <span class="hero-inbox-mini h-6 w-6 text-text-tertiary"></span>
        </div>
        <p class="mt-4 text-sm font-590 text-text-secondary">No inbox items match this view.</p>
        <p class="mx-auto mt-1 max-w-md text-sm text-text-quaternary">
          Agent handoffs, review requests, and issue updates will appear here as the autonomous
          workflow runs.
        </p>
      </div>
    </:empty>
    <div
      :for={{dom_id, item} <- @streams.inbox_items}
      id={dom_id}
      class={[
        "group border border-hairline bg-surface-1 shadow-card transition-all hover:border-border-hover hover:shadow-raised",
        if(@digest_density == "compact", do: "rounded-lg", else: "rounded-2xl"),
        item.status == "unread" && "border-l-2 border-l-brand"
      ]}
    >
      <div class={[
        "grid lg:grid-cols-[minmax(0,1fr)_auto] lg:items-start",
        if(@digest_density == "compact", do: "gap-2 p-2.5", else: "gap-4 p-4")
      ]}>
        <div class="min-w-0">
          <div class="mb-2 flex flex-wrap items-center gap-2">
            <span class={["h-2 w-2 rounded-full", status_dot(item.status)]}></span>
            <span class={[
              "rounded-full px-2 py-0.5 text-xs font-510",
              status_badge_class(item.status)
            ]}>
              {status_filter_label(item.status)}
            </span>
            <span class="text-xs text-text-quaternary">
              To {target_agent_name(item, @selected_agent)}
            </span>
            <span
              :if={item.review_nudge}
              class="rounded-full border border-amber-500/25 bg-amber-500/10 px-2 py-0.5 text-xs font-510 text-amber-200"
            >
              {item.review_nudge.label || "Review evidence needed"}
            </span>
            <span class="text-xs text-text-quaternary">·</span>
            <span class="text-xs text-text-quaternary">{format_timestamp(item.inserted_at)}</span>
          </div>

          <%= if item.issue do %>
            <.app_link
              navigate={issue_link(item.issue)}
              class="block min-w-0 text-base font-590 leading-6 text-text-primary hover:text-brand"
            >
              <span class="font-mono text-xs text-text-quaternary">
                {item.issue.identifier || "Issue"}
              </span>
              <span class="mx-2 text-text-quaternary">·</span>
              <span>{item.issue.title}</span>
            </.app_link>

            <p
              :if={@digest_density == "detailed" and issue_description(item.issue)}
              class="mt-2 line-clamp-2 max-w-3xl text-sm text-text-tertiary"
            >
              {issue_description(item.issue)}
            </p>

            <div
              :if={@digest_density == "detailed" and item.review_nudge}
              class="mt-2 flex flex-wrap items-center gap-1.5"
            >
              <span
                class="line-clamp-1 text-xs text-amber-200/80"
                title={item.review_nudge.summary}
              >
                {item.review_nudge.summary}
              </span>
              <span
                :for={label <- item.review_nudge.blocker_labels || []}
                class="rounded-full border border-amber-500/25 bg-amber-500/10 px-1.5 py-0.5 text-[10px] font-510 text-amber-200"
              >
                {label}
              </span>
            </div>

            <.issue_digest_card
              issue={item.issue}
              density={@digest_density}
              variant={if @digest_density == "compact", do: "inline", else: "card"}
              class="mt-2"
            />

            <div class={[
              "flex flex-wrap items-center gap-2 text-xs",
              if(@digest_density == "compact", do: "mt-1", else: "mt-2")
            ]}>
              <span class="rounded-full border border-border bg-surface px-2 py-0.5 text-text-secondary">
                {issue_status_label(item.issue.status)}
              </span>
              <span class={[
                "rounded-full border px-2 py-0.5 font-510",
                priority_badge_class(item.issue.priority)
              ]}>
                {priority_label(item.issue.priority)}
              </span>
              <span :if={item.issue.assigned_role} class="text-text-quaternary">
                Role: {item.issue.assigned_role}
              </span>
            </div>
          <% else %>
            <p class="text-base font-590 text-text-tertiary">Issue removed</p>
            <p class="mt-2 text-sm text-text-quaternary">
              This inbox entry points to an issue that is no longer available.
            </p>
          <% end %>
        </div>

        <div class="flex flex-wrap gap-2 lg:justify-end">
          <.app_link
            :if={item.review_nudge && item.review_nudge.target_path}
            navigate={item.review_nudge.target_path}
            class="rounded-lg border border-amber-500/25 bg-amber-500/10 px-3 py-2 text-xs font-510 text-amber-200 hover:bg-amber-500/15 hover:text-amber-100"
          >
            {item.review_nudge.target_label || "Open review queue"}
          </.app_link>
          <.app_link
            :if={item.issue}
            navigate={issue_link(item.issue)}
            class="rounded-lg border border-border bg-surface px-3 py-2 text-xs font-510 text-text-secondary hover:bg-surface-hover hover:text-text-primary"
          >
            Open issue
          </.app_link>
          <button
            :if={item.status == "unread"}
            type="button"
            phx-click="mark_read"
            phx-value-issue_id={item.issue_id}
            phx-value-agent_id={item.agent_id}
            class="rounded-lg border border-blue-500/25 bg-blue-500/10 px-3 py-2 text-xs font-510 text-blue-300 hover:bg-blue-500/15"
          >
            Mark read
          </button>
          <button
            :if={item.status in ["unread", "read"]}
            type="button"
            phx-click="dismiss"
            phx-value-issue_id={item.issue_id}
            phx-value-agent_id={item.agent_id}
            class={[
              "rounded-lg border border-border bg-surface px-3 py-2 text-xs font-510 text-text-secondary hover:bg-surface-hover hover:text-text-primary",
              @digest_density == "compact" && "hidden"
            ]}
          >
            Dismiss
          </button>
          <button
            :if={item.status in ["unread", "read", "dismissed"]}
            type="button"
            phx-click="archive"
            phx-value-issue_id={item.issue_id}
            phx-value-agent_id={item.agent_id}
            class={[
              "rounded-lg border border-border bg-surface px-3 py-2 text-xs font-510 text-text-secondary hover:bg-surface-hover hover:text-red-300",
              @digest_density == "compact" && "hidden"
            ]}
          >
            Archive
          </button>
          <button
            :if={item.status in ["dismissed", "archived"]}
            type="button"
            phx-click="restore"
            phx-value-issue_id={item.issue_id}
            phx-value-agent_id={item.agent_id}
            class={[
              "rounded-lg border border-emerald-500/25 bg-emerald-500/10 px-3 py-2 text-xs font-510 text-emerald-300 hover:bg-emerald-500/15",
              @digest_density == "compact" && "hidden"
            ]}
          >
            Restore
          </button>
          <button
            :if={Map.get(item, :kind) == :review_queue and item.issue}
            type="button"
            phx-click="approve_review"
            phx-value-issue_id={item.issue_id}
            phx-value-wake_id={item.wake_id}
            data-confirm={"Approve #{(item.issue && item.issue.identifier) || "issue"} and close it?"}
            class="rounded-lg border border-emerald-500/30 bg-emerald-500/15 px-3 py-2 text-xs font-590 text-emerald-200 hover:bg-emerald-500/25"
          >
            Approve
          </button>
          <button
            :if={Map.get(item, :kind) == :review_queue and item.issue}
            type="button"
            phx-click="request_review_changes"
            phx-value-issue_id={item.issue_id}
            phx-value-wake_id={item.wake_id}
            class="rounded-lg border border-amber-500/30 bg-amber-500/10 px-3 py-2 text-xs font-510 text-amber-200 hover:bg-amber-500/15"
          >
            Request changes
          </button>
        </div>
      </div>
    </div>
  </.infinite_scroll>
</.page>
