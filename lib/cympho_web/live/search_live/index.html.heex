<.page_frame page="search" title="Search" data-ui-complex-page>
  <section class="card srch" aria-label="Search this company">
    <form phx-submit="search" class="srch-f">
      <.search_capsule
        label="Find tasks, people, projects and goals in this company"
        placeholder="Search tasks, agents, projects, goals…"
        name="search[query]"
        value={@query}
      />
      <.pill type="submit">Search</.pill>
    </form>

    <div class="srch-tools">
      <.filter_menu id="search-filter" active={filter_count(@filters)}>
        <form phx-change="filter" phx-submit="filter" class="srch-ff">
          <div class="flds" data-testid="search-core-filters">
            <.input
              type="select"
              id="search-filter-status"
              label="Task status"
              name="filter[status]"
              value={@filters["status"] || ""}
              options={[
                {"All", ""},
                {"Later", "backlog"},
                {"To do", "todo"},
                {"In progress", "in_progress"},
                {"In review", "in_review"},
                {"Done", "done"},
                {"Blocked", "blocked"},
                {"Cancelled", "cancelled"}
              ]}
            />
            <.input
              type="select"
              id="search-filter-project"
              label="Project"
              name="filter[project_id]"
              value={@filters["project_id"] || ""}
              options={[{"All", ""} | Enum.map(@projects, &{&1.name, &1.id})]}
            />
            <.input
              type="select"
              id="search-filter-assignee"
              label="Assignee"
              name="filter[assignee_id]"
              value={@filters["assignee_id"] || ""}
              options={[{"All", ""} | Enum.map(@agents, &{&1.name, &1.id})]}
            />
            <%!-- Native date fields, not the DatePicker: its root is phx-update="ignore",
                 so a patch that clears or restores these filters (Clear filters, a recent
                 search, Back) would leave a stale date to post with the next change. --%>
            <div class="fld">
              <label for="search-date-from">From</label>
              <input
                id="search-date-from"
                type="date"
                name="filter[date_from]"
                value={@filters["date_from"] || ""}
              />
            </div>
            <div class="fld">
              <label for="search-date-to">To</label>
              <input
                id="search-date-to"
                type="date"
                name="filter[date_to]"
                value={@filters["date_to"] || ""}
              />
            </div>
          </div>

          <details
            id="search-advanced-filters"
            data-testid="search-advanced-filters"
            open={advanced_filters_active?(@filters)}
            data-open={to_string(advanced_filters_active?(@filters))}
            class="ui-advanced-only earlier"
            phx-hook="ServerOpen"
            phx-mounted={JS.ignore_attributes("open")}
          >
            <summary>
              Advanced filters
              <span class="mono">
                <%= if advanced_filter_count(@filters) > 0 do %>
                  {advanced_filter_count(@filters)} active advanced
                <% else %>
                  Optional
                <% end %>
              </span>
              <.r3_icon name="i-chev-down" class="ico s14" />
            </summary>
            <div class="flds">
              <.input
                type="select"
                id="search-filter-goal"
                label="Goal"
                name="filter[goal_id]"
                value={@filters["goal_id"] || ""}
                options={[{"All", ""} | Enum.map(@goals, &{&1.title, &1.id})]}
              />
              <.input
                type="select"
                id="search-filter-label"
                label="Label"
                name="filter[label_id]"
                value={@filters["label_id"] || ""}
                options={[{"All", ""} | Enum.map(@labels, &{&1.name, &1.id})]}
              />
              <.input
                type="select"
                id="search-filter-role"
                label="Agent role"
                name="filter[role]"
                value={@filters["role"] || ""}
                options={[{"All", ""} | @role_options]}
              />
              <.input
                type="select"
                id="search-filter-agent-status"
                label="Agent status"
                name="filter[agent_status]"
                value={@filters["agent_status"] || ""}
                options={[
                  {"All", ""},
                  {"Idle", "idle"},
                  {"Running", "running"},
                  {"Error", "error"},
                  {"Sleeping", "sleeping"},
                  {"Offline", "offline"},
                  {"Terminated", "terminated"}
                ]}
              />
              <.input
                type="select"
                id="search-filter-project-status"
                label="Project status"
                name="filter[project_status]"
                value={@filters["project_status"] || ""}
                options={[{"All", ""}, {"Active", "active"}, {"Archived", "archived"}]}
              />
              <.input
                type="select"
                id="search-filter-goal-status"
                label="Goal status"
                name="filter[goal_status]"
                value={@filters["goal_status"] || ""}
                options={[
                  {"All", ""},
                  {"Active", "active"},
                  {"Completed", "completed"},
                  {"Cancelled", "cancelled"}
                ]}
              />
              <.input
                type="select"
                id="search-filter-goal-priority"
                label="Goal priority"
                name="filter[goal_priority]"
                value={@filters["goal_priority"] || ""}
                options={[
                  {"All", ""},
                  {"Critical", "critical"},
                  {"High", "high"},
                  {"Medium", "medium"},
                  {"Low", "low"}
                ]}
              />
            </div>
          </details>
        </form>
        <button
          :if={filters_active?(@filters)}
          type="button"
          class="lnk"
          phx-click="clear_filters"
        >
          Clear filters
        </button>
      </.filter_menu>

      <div :if={@recent_searches != []} class="srch-recent">
        <span class="meta">Recent</span>
        <.chip
          :for={recent_search <- @recent_searches}
          phx-click="recent_search"
          phx-value-query={recent_search.query}
        >
          <span class="srch-q">{recent_search.query}</span>
          <span class="mono">{recent_search.search_count}</span>
        </.chip>
        <button type="button" class="lnk" phx-click="clear_recent_searches">Clear</button>
      </div>
    </div>
  </section>

  <div class="seg srch-tabs" role="group" aria-label="Result kind">
    <button
      :for={tab <- [:all, :issues, :agents, :projects, :goals]}
      type="button"
      phx-click="change_tab"
      phx-value-tab={tab}
      aria-pressed={to_string(@active_tab == tab)}
    >
      {tab_label(tab)}<span :if={tab_count(@results, tab, @total_count) > 0} class="mono">{tab_count(@results, tab, @total_count)}</span>
    </button>
  </div>

  <.band_card id="search-results-t" title="Results" section_id="search-results">
    <:header_end>
      <span class="srch-end">
        <span :if={@query != ""} class="meta">
          {result_heading(@results, @total_count, @active_tab, @query)}
        </span>
        <span :if={filters_active?(@filters)} class="tag">Filtered</span>
      </span>
    </:header_end>

    <% empty_state = result_empty_state(@query, @total_count, @filters, @search_command.actions) %>
    <.quiet_empty
      :if={empty_state}
      title={empty_state.title}
      data-testid="search-results-empty"
    >
      {empty_state.detail}
      <:action>
        <div class="srch-acts">
          <%= for action <- empty_state.actions do %>
            <span :if={action.advanced} class="ui-advanced-only">
              <.text_link navigate={action.url}>{action.label}</.text_link>
            </span>
            <.text_link :if={!action.advanced} navigate={action.url}>{action.label}</.text_link>
          <% end %>
        </div>
      </:action>
    </.quiet_empty>

    <ul :if={@query != "" and @total_count > 0} class="rows">
      <.list_row
        :for={issue <- tab_items(@results, @active_tab, :issues)}
        id={"search-issue-#{issue.id}"}
        title={issue.title}
        navigate={~p"/issues/#{issue.id}"}
      >
        <:meta>
          <span :if={issue.identifier} class="mono">{issue.identifier}</span><span
            :if={issue.identifier}
            aria-hidden="true"
          > · </span>{task_state(issue.status)}<span :if={issue.assignee}><span aria-hidden="true"> · </span>{issue.assignee.name}</span>
        </:meta>
        <:trail><span class="tag">Task</span></:trail>
      </.list_row>
      <.list_row
        :for={agent <- tab_items(@results, @active_tab, :agents)}
        id={"search-agent-#{agent.id}"}
        title={agent.name}
        navigate={~p"/agents/#{agent.id}"}
        status={CymphoWeb.AgentLive.Parts.status(agent, false)}
      >
        <:meta>{agent_line(agent)}</:meta>
        <:trail><span class="tag">Agent</span></:trail>
      </.list_row>
      <.list_row
        :for={project <- tab_items(@results, @active_tab, :projects)}
        id={"search-project-#{project.id}"}
        title={project.name}
        navigate={~p"/projects/#{project.id}"}
      >
        <:meta>
          <span class="mono">{project.prefix}</span><span :if={project.status == :archived}><span aria-hidden="true"> · </span>Archived</span><span :if={
            snippet(project.description)
          }><span aria-hidden="true"> · </span>{snippet(project.description)}</span>
        </:meta>
        <:trail><span class="tag">Project</span></:trail>
      </.list_row>
      <.list_row
        :for={goal <- tab_items(@results, @active_tab, :goals)}
        id={"search-goal-#{goal.id}"}
        title={goal.title}
        navigate={~p"/goals/#{goal.id}"}
      >
        <:meta>
          {format_search_value(goal.status)}<span :if={goal.project}><span aria-hidden="true"> · </span>{goal.project.name}</span>
        </:meta>
        <:trail><span class="tag">Goal</span></:trail>
      </.list_row>
    </ul>

    <.quiet_empty
      :if={@query != "" and @total_count > 0 and tab_empty?(@results, @active_tab)}
      title={"No #{String.downcase(tab_label(@active_tab))} found."}
    />
  </.band_card>

  <div class="ui-advanced-only">
    <.band_card
      id="search-command-t"
      title="Search Overview"
      section_id="search-command"
      data-testid="search-command"
    >
      <div class="gl-sec">
        <p class="gl-big">{@search_command.summary}</p>
        <div class="srch-acts">
          <.text_link :for={action <- @search_command.actions} navigate={action.url}>
            {action.label}
          </.text_link>
        </div>
      </div>
      <div class="strip srch-strip">
        <.link
          :for={mix <- @search_command.result_mix}
          patch={mix.url}
          class="cell"
        >
          <span class="v mono">{mix.count}</span><span class="l">{mix.label}</span>
        </.link>
      </div>
      <div class="gl-sec">
        <h3 class="gl-h">Top match</h3>
        <p :if={@search_command.top_result} class="gl-sub">
          <.top_link result={@search_command.top_result} />
          <span aria-hidden="true"> · </span>{@search_command.top_result.kind}<span aria-hidden="true"> · </span>{@search_command.top_result.subtitle}
        </p>
        <p :if={!@search_command.top_result} class="gl-sub">No top match.</p>
      </div>
    </.band_card>
  </div>
</.page_frame>
