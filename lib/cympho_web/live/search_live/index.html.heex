<.page size="wide" data-ui-complex-page class="ember-aurora">
  <div class="relative z-[1]">
    <.header>
      <h1 class="ember-ink font-serif text-[clamp(30px,4.5vw,44px)] font-510 leading-[1.08] tracking-[-0.02em]">
        Search
      </h1>
      <p class="mt-2 max-w-2xl text-[15px] leading-6 text-text-tertiary">
        Find issues, people, projects, and goals in this company.
      </p>
    </.header>

    <.panel class="mb-5 overflow-hidden">
      <div class="border-b border-border px-5 py-4">
        <form phx-submit="search" class="flex flex-col gap-3 md:flex-row">
          <div class="ember-glass relative flex-1 rounded-2xl transition-shadow duration-300 focus-within:shadow-[0_0_0_1px_rgb(var(--color-primary-rgb)/0.45),0_18px_50px_-12px_rgb(var(--color-primary-rgb)/0.5)]">
            <.icon
              name="hero-magnifying-glass-mini"
              class="pointer-events-none absolute left-4 top-1/2 h-5 w-5 -translate-y-1/2 text-text-quaternary"
            />
            <input
              type="text"
              name="search[query]"
              value={@query}
              placeholder="Search issues, agents, projects, goals..."
              class="h-12 w-full rounded-2xl border-0 bg-transparent pl-11 pr-16 text-base text-text-primary placeholder:text-text-quaternary focus:outline-none focus:ring-0"
              autocomplete="off"
            />
            <kbd class="pointer-events-none absolute right-3 top-1/2 hidden -translate-y-1/2 select-none items-center gap-1 rounded-md border border-border bg-surface px-1.5 py-0.5 text-[10px] font-510 text-text-quaternary sm:inline-flex">
              Enter
            </kbd>
          </div>
          <button
            type="submit"
            class="cta-glow inline-flex h-12 items-center justify-center gap-2 rounded-2xl bg-brand px-5 text-sm font-510 text-on-primary transition-colors hover:bg-accent-hover"
          >
            <.icon name="hero-arrow-right-mini" class="h-4 w-4" /> Search
          </button>
        </form>
      </div>

      <div class="grid gap-4 px-5 py-4 lg:grid-cols-[minmax(0,1fr)_280px]">
        <div>
          <div class="mb-3 flex flex-wrap items-center justify-between gap-2">
            <div>
              <p class="font-serif text-[13px] font-510 italic tracking-[0.02em] text-brand/90">
                Filters
              </p>
              <p class="mt-1 text-sm text-text-tertiary">
                {filter_count(@filters)} active / {@total_count} current results
              </p>
            </div>
            <button
              :if={filters_active?(@filters)}
              type="button"
              phx-click="clear_filters"
              class="rounded-lg border border-border bg-surface px-3 py-1.5 text-xs font-510 text-text-secondary transition-colors hover:bg-surface-hover hover:text-text-primary"
            >
              Clear filters
            </button>
          </div>

          <form phx-change="filter" phx-submit="filter" class="space-y-3">
            <div
              data-testid="search-core-filters"
              class="grid grid-cols-1 gap-3 md:grid-cols-3 xl:grid-cols-5"
            >
              <div>
                <label class="mb-1 block text-xs text-text-tertiary">Issue status</label>
                <.select_menu
                  name="filter[status]"
                  value={@filters["status"] || ""}
                  options={[
                    {"All", ""},
                    {"Backlog", "backlog"},
                    {"To do", "todo"},
                    {"In progress", "in_progress"},
                    {"In review", "in_review"},
                    {"Done", "done"},
                    {"Blocked", "blocked"},
                    {"Cancelled", "cancelled"}
                  ]}
                />
              </div>

              <div>
                <label class="mb-1 block text-xs text-text-tertiary">Project</label>
                <.select_menu
                  name="filter[project_id]"
                  value={@filters["project_id"] || ""}
                  options={[{"All", ""} | Enum.map(@projects, &{&1.name, &1.id})]}
                />
              </div>

              <div>
                <label class="mb-1 block text-xs text-text-tertiary">Assignee</label>
                <.select_menu
                  name="filter[assignee_id]"
                  value={@filters["assignee_id"] || ""}
                  options={[{"All", ""} | Enum.map(@agents, &{&1.name, &1.id})]}
                />
              </div>

              <div>
                <label class="mb-1 block text-xs text-text-tertiary">From</label>
                <input
                  type="date"
                  name="filter[date_from]"
                  value={@filters["date_from"] || ""}
                  class="h-9 w-full rounded-lg border border-border bg-surface px-3 text-sm text-text-primary focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20"
                />
              </div>

              <div>
                <label class="mb-1 block text-xs text-text-tertiary">To</label>
                <input
                  type="date"
                  name="filter[date_to]"
                  value={@filters["date_to"] || ""}
                  class="h-9 w-full rounded-lg border border-border bg-surface px-3 text-sm text-text-primary focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20"
                />
              </div>
            </div>

            <details
              data-testid="search-advanced-filters"
              open={advanced_filters_active?(@filters)}
              class="ui-advanced-only rounded-lg border border-border bg-surface-1/50"
            >
              <summary class="flex cursor-pointer list-none items-center justify-between gap-3 px-3 py-2.5 text-sm text-text-secondary transition-colors hover:bg-surface-hover hover:text-text-primary">
                <span class="inline-flex min-w-0 items-center gap-2">
                  <.icon name="hero-adjustments-horizontal-mini" class="h-4 w-4 shrink-0" />
                  <span class="font-510">Advanced filters</span>
                </span>
                <span class="shrink-0 rounded-full border border-border bg-surface px-2 py-0.5 text-[11px] font-510 text-text-tertiary">
                  <%= if advanced_filter_count(@filters) > 0 do %>
                    {advanced_filter_count(@filters)} active advanced
                  <% else %>
                    Optional
                  <% end %>
                </span>
              </summary>

              <div class="grid grid-cols-1 gap-3 border-t border-border px-3 py-3 md:grid-cols-3 xl:grid-cols-4">
                <div>
                  <label class="mb-1 block text-xs text-text-tertiary">Goal</label>
                  <.select_menu
                    name="filter[goal_id]"
                    value={@filters["goal_id"] || ""}
                    options={[{"All", ""} | Enum.map(@goals, &{&1.title, &1.id})]}
                  />
                </div>

                <div>
                  <label class="mb-1 block text-xs text-text-tertiary">Label</label>
                  <.select_menu
                    name="filter[label_id]"
                    value={@filters["label_id"] || ""}
                    options={[{"All", ""} | Enum.map(@labels, &{&1.name, &1.id})]}
                  />
                </div>

                <div>
                  <label class="mb-1 block text-xs text-text-tertiary">Agent role</label>
                  <.select_menu
                    name="filter[role]"
                    value={@filters["role"] || ""}
                    options={[{"All", ""} | @role_options]}
                  />
                </div>

                <div>
                  <label class="mb-1 block text-xs text-text-tertiary">Agent status</label>
                  <.select_menu
                    name="filter[agent_status]"
                    value={@filters["agent_status"] || ""}
                    options={[
                      {"All", ""},
                      {"Idle", "idle"},
                      {"Running", "running"},
                      {"Error", "error"},
                      {"Sleeping", "sleeping"},
                      {"Offline", "offline"},
                      {"Terminated", "terminated"}
                    ]}
                  />
                </div>

                <div>
                  <label class="mb-1 block text-xs text-text-tertiary">Project status</label>
                  <.select_menu
                    name="filter[project_status]"
                    value={@filters["project_status"] || ""}
                    options={[{"All", ""}, {"Active", "active"}, {"Archived", "archived"}]}
                  />
                </div>

                <div>
                  <label class="mb-1 block text-xs text-text-tertiary">Goal status</label>
                  <.select_menu
                    name="filter[goal_status]"
                    value={@filters["goal_status"] || ""}
                    options={[
                      {"All", ""},
                      {"Active", "active"},
                      {"Completed", "completed"},
                      {"Cancelled", "cancelled"}
                    ]}
                  />
                </div>

                <div>
                  <label class="mb-1 block text-xs text-text-tertiary">Goal priority</label>
                  <.select_menu
                    name="filter[goal_priority]"
                    value={@filters["goal_priority"] || ""}
                    options={[
                      {"All", ""},
                      {"Critical", "critical"},
                      {"High", "high"},
                      {"Medium", "medium"},
                      {"Low", "low"}
                    ]}
                  />
                </div>
              </div>
            </details>
          </form>
        </div>

        <div>
          <div class="flex items-center justify-between">
            <p class="font-serif text-[13px] font-510 italic tracking-[0.02em] text-brand/90">
              Recent
            </p>
            <button
              :if={@recent_searches != []}
              type="button"
              phx-click="clear_recent_searches"
              class="text-xs text-text-tertiary transition-colors hover:text-text-primary"
            >
              Clear all
            </button>
          </div>

          <div
            :if={@recent_searches == []}
            class="mt-3 rounded-lg border border-dashed border-border px-3 py-6 text-center text-sm text-text-tertiary"
          >
            No recent searches.
          </div>

          <div :if={@recent_searches != []} class="mt-3 flex flex-wrap gap-2">
            <button
              :for={recent_search <- @recent_searches}
              type="button"
              phx-click="recent_search"
              phx-value-query={recent_search.query}
              class="card-lift inline-flex items-center gap-2 rounded-lg border border-border bg-surface px-3 py-1.5 text-xs font-510 text-text-secondary hover:bg-surface-hover hover:text-text-primary"
            >
              <span class="max-w-[180px] truncate">{recent_search.query}</span>
              <span class="font-mono text-text-quaternary">{recent_search.search_count}</span>
            </button>
          </div>
        </div>
      </div>
    </.panel>

    <.panel
      id="search-command"
      data-testid="search-command"
      class="ui-advanced-only mb-5 overflow-hidden"
    >
      <div class="border-b border-border px-5 py-4">
        <div class="flex flex-wrap items-start justify-between gap-3">
          <div class="min-w-0">
            <p class="font-serif text-[13px] font-510 italic tracking-[0.02em] text-brand/90">
              Search command
            </p>
            <h2 class="mt-1 text-card-title text-text-primary">
              {@search_command.summary}
            </h2>
          </div>
          <div class="flex flex-wrap gap-2">
            <.app_link
              :for={action <- @search_command.actions}
              navigate={action.url}
              class={search_command_action_class(action.tone)}
            >
              <.icon name={action.icon} class="h-4 w-4" />
              <span>{action.label}</span>
            </.app_link>
          </div>
        </div>
      </div>

      <div class="grid min-w-0 gap-3 px-5 py-4 lg:grid-cols-[minmax(0,1fr)_320px]">
        <div class="grid min-w-0 grid-cols-1 gap-2 sm:grid-cols-2 md:grid-cols-4">
          <.link
            :for={mix <- @search_command.result_mix}
            patch={mix.url}
            class={search_mix_card_class(mix.count)}
          >
            <span class="text-eyebrow uppercase text-text-quaternary">{mix.label}</span>
            <span class={search_mix_count_class(mix.count)}>{mix.count}</span>
          </.link>
        </div>

        <div class="min-w-0 rounded-lg border border-border bg-surface-1 px-4 py-3">
          <p class="font-serif text-[13px] font-510 italic tracking-[0.02em] text-brand/90">
            Top match
          </p>
          <.app_link
            :if={@search_command.top_result}
            navigate={@search_command.top_result.url}
            class="mt-2 flex min-w-0 items-start gap-3 rounded-md border border-border/70 bg-surface px-3 py-2 transition-shadow hover:bg-surface-hover hover:shadow-[inset_2px_0_0_0_var(--color-primary)]"
          >
            <span class="mt-0.5 flex h-7 w-7 shrink-0 items-center justify-center rounded-md bg-primary/10 text-primary">
              <.icon name={@search_command.top_result.icon} class="h-4 w-4" />
            </span>
            <span class="min-w-0">
              <span class="block truncate text-sm font-590 text-text-primary">
                {@search_command.top_result.title}
              </span>
              <span class="mt-0.5 block truncate text-xs text-text-tertiary">
                {@search_command.top_result.kind} / {@search_command.top_result.subtitle}
              </span>
            </span>
          </.app_link>
          <div
            :if={!@search_command.top_result}
            class="mt-2 rounded-md border border-dashed border-border px-3 py-3 text-sm text-text-tertiary"
          >
            No top match.
          </div>
        </div>
      </div>
    </.panel>

    <div class="mb-4 flex flex-wrap gap-2">
      <button
        :for={tab <- [:all, :issues, :agents, :projects, :goals]}
        type="button"
        phx-click="change_tab"
        phx-value-tab={tab}
        class={[
          "inline-flex items-center gap-2 rounded-lg border px-3 py-2 text-sm font-510 transition-colors",
          @active_tab == tab && "border-primary/40 bg-primary/10 text-primary",
          @active_tab != tab &&
            "border-border bg-panel text-text-secondary hover:bg-surface-hover hover:text-text-primary"
        ]}
      >
        {String.capitalize(to_string(tab))}
        <span :if={tab == :all and @total_count > 0} class="font-mono text-xs text-text-tertiary">
          {@total_count}
        </span>
        <%= if count = tab_count(@results, tab) do %>
          <span class="font-mono text-xs text-text-tertiary">{count}</span>
        <% end %>
      </button>
    </div>

    <.panel class="overflow-hidden">
      <div class="border-b border-border px-5 py-4">
        <div class="flex flex-wrap items-center justify-between gap-2">
          <div>
            <p class="font-serif text-[13px] font-510 italic tracking-[0.02em] text-brand/90">
              Results
            </p>
            <h2 :if={@query != ""} class="mt-1 text-card-title text-text-primary">
              {result_heading(@results, @total_count, @active_tab, @query)}
            </h2>
          </div>
          <span
            :if={filters_active?(@filters)}
            class="rounded-full border border-amber-500/25 bg-amber-500/10 px-2.5 py-1 text-xs font-510 text-amber-300"
          >
            Filtered
          </span>
        </div>
      </div>

      <div class="p-5">
        <% empty_state =
          result_empty_state(
            @query,
            @total_count,
            @filters,
            @search_command.actions
          ) %>

        <div
          :if={empty_state}
          data-testid="search-results-empty"
          class="rounded-lg border border-dashed border-border bg-surface-1/50 px-4 py-10 text-center"
        >
          <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-full border border-border bg-surface text-text-tertiary">
            <.icon name={empty_state.icon} class="h-6 w-6" />
          </div>
          <p class="text-sm font-590 text-text-primary">{empty_state.title}</p>
          <p class="mx-auto mt-1 max-w-md text-sm leading-5 text-text-tertiary">
            {empty_state.detail}
          </p>
          <div class="mt-5 flex flex-wrap justify-center gap-2">
            <.app_link
              :for={action <- empty_state.actions}
              navigate={action.url}
              class={search_command_action_class(action.tone)}
            >
              <.icon name={action.icon} class="h-4 w-4" />
              <span>{action.label}</span>
            </.app_link>
          </div>
        </div>

        <div :if={@query != "" and @total_count > 0}>
          <div :if={@active_tab == :all} class="space-y-6">
            {render_issues(assigns, @results.issues, "Issues")}
            {render_agents(assigns, @results.agents, "Agents")}
            {render_projects(assigns, @results.projects, "Projects")}
            {render_goals(assigns, @results.goals, "Goals")}
          </div>

          <div :if={@active_tab == :issues}>
            {render_issues(assigns, @results.issues, nil)}
            <p :if={@results.issues == []} class="py-8 text-center text-sm text-text-tertiary">
              No issues found.
            </p>
          </div>

          <div :if={@active_tab == :agents}>
            {render_agents(assigns, @results.agents, nil)}
            <p :if={@results.agents == []} class="py-8 text-center text-sm text-text-tertiary">
              No agents found.
            </p>
          </div>

          <div :if={@active_tab == :projects}>
            {render_projects(assigns, @results.projects, nil)}
            <p :if={@results.projects == []} class="py-8 text-center text-sm text-text-tertiary">
              No projects found.
            </p>
          </div>

          <div :if={@active_tab == :goals}>
            {render_goals(assigns, @results.goals, nil)}
            <p :if={@results.goals == []} class="py-8 text-center text-sm text-text-tertiary">
              No goals found.
            </p>
          </div>
        </div>
      </div>
    </.panel>
  </div>
</.page>
