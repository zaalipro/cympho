<.page_frame page="docs" title="Documentation" data-ui-complex-page>
  <:header_end>
    <%!-- Below 1024 px the topic nav hides; this opens it as a sheet. --%>
    <button
      type="button"
      id="docs-topics-btn"
      class="pl dc-topics"
      phx-click="toggle_mobile_sidebar"
      aria-expanded={to_string(@mobile_sidebar_open)}
    >
      Topics
    </button>
  </:header_end>

  <div class="dc">
    <.sidebar
      topics={@topics}
      active_topic_slug={@active_topic_slug}
      active_section_slug={@active_section_slug}
    />

    <article class="card dc-art" id="doc-top" aria-labelledby="doc-title">
      <div class="dc-meta">
        <nav aria-label="Breadcrumb" class="dc-crumb">
          <.link patch={~p"/docs"}>Docs</.link><span aria-hidden="true">›</span><.link patch={
            ~p"/docs/#{@active_topic_slug}"
          }>{String.replace(@active_topic_slug, "-", " ") |> String.capitalize()}</.link><span aria-hidden="true">›</span><span aria-current="page">{@active_doc.title}</span>
        </nav>
        <span class="meta">
          <span class="mono">{@active_doc.reading_time_minutes}</span>
          min read<span aria-hidden="true"> · </span>Updated {@active_doc.last_updated}
        </span>
      </div>

      <h2 class="nt" id="doc-title">{@active_doc.title}</h2>
      <p class="dc-sum">{@active_doc.summary}</p>

      <.mobile_toc anchors={@active_doc.anchors} />

      <div class="docs-content">{@active_doc.html_content}</div>

      <nav class="dc-pn" aria-label="Pages">
        <.text_link :if={@active_doc.prev_doc} patch={@active_doc.prev_doc.path} arrow={false}>
          <.r3_icon name="i-arrow-left" /><span>Previous</span><span aria-hidden="true">·</span><span class="dc-pn-t">{@active_doc.prev_doc.title}</span>
        </.text_link>
        <span :if={!@active_doc.prev_doc}></span>
        <.text_link :if={@active_doc.next_doc} patch={@active_doc.next_doc.path}>
          <span>Next</span><span aria-hidden="true">·</span><span class="dc-pn-t">{@active_doc.next_doc.title}</span>
        </.text_link>
      </nav>
    </article>

    <.toc anchors={@active_doc.anchors} />
  </div>

  <.modal
    :if={@mobile_sidebar_open}
    id="docs-topics-sheet"
    show
    title="Topics"
    on_cancel={close_topics()}
  >
    <%!-- The sheet renders after the article, so opening it moves the keyboard in. Escape closes it,
         as it closes the search dialog, except while that dialog is open on top of it. --%>
    <div
      phx-mounted={JS.focus_first()}
      phx-window-keydown={!@search_open && close_topics()}
      phx-key="Escape"
    >
      <.sidebar
        topics={@topics}
        active_topic_slug={@active_topic_slug}
        active_section_slug={@active_section_slug}
        mobile={true}
      />
    </div>
  </.modal>

  <.search_modal
    open={@search_open}
    query={@search_query}
    results={@search_results}
    selected_index={@selected_index}
  />
</.page_frame>
