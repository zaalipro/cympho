<.page size="content" class="ember-aurora">
  <div class="relative z-[1]">
    <.header>
      <div class="min-w-0">
        <span class="ember-eyebrow">Taxonomy</span>
        <h1 class="ember-ink mt-4 font-serif text-[clamp(30px,4.5vw,44px)] font-510 leading-[1.08] tracking-[-0.02em]">
          {@page_title}
        </h1>
        <p class="mt-2 max-w-2xl text-[15px] leading-6 text-text-tertiary">
          Color-code work so the board reads at a glance.
        </p>
      </div>
    </.header>

    <div class="grid gap-5 lg:grid-cols-[minmax(0,360px)_minmax(0,1fr)] lg:items-start">
      <section class="ember-glass overflow-hidden">
        <div class="border-b border-white/10 px-5 py-4">
          <p class="font-serif text-[13px] font-510 italic tracking-[0.02em] text-brand/90">
            {(@editing_label && "Edit label") || "New label"}
          </p>
          <h2 :if={@editing_label} class="mt-1 text-lg font-590 text-text-primary">
            Editing: {@editing_label.name}
          </h2>
          <h2 :if={!@editing_label} class="mt-1 text-lg font-590 text-text-primary">
            Create a label
          </h2>
        </div>

        <.simple_form
          for={@form}
          phx-submit={(@editing_label && "update_label") || "create_label"}
          class="space-y-4 p-5"
        >
          <.input field={@form[:name]} label="Name" placeholder="Label name" />
          <.input field={@form[:color]} label="Color" placeholder="#FF0000" />
          <.input
            field={@form[:description]}
            label="Description"
            placeholder="Description (optional)"
          />
          <:actions>
            <div class="flex items-center gap-2 border-t border-white/10 pt-4">
              <.button type="submit" variant="primary" class="cta-glow">
                {(@editing_label && "Update") || "Create"} Label
              </.button>
              <button
                :if={@editing_label}
                type="button"
                phx-click="cancel_edit"
                class="rounded-lg px-4 py-2 text-sm font-510 text-text-tertiary transition-colors hover:bg-surface-hover hover:text-text-primary"
              >
                Cancel
              </button>
            </div>
          </:actions>
        </.simple_form>
      </section>

      <section class="min-w-0">
        <p class="mb-3 font-serif text-[13px] font-510 italic tracking-[0.02em] text-brand/90">
          All labels
        </p>

        <.infinite_scroll
          id="labels"
          has_more={@infinite_scroll[:labels][:has_more?] || false}
          container_class="space-y-2"
        >
          <:empty>
            <div class="rounded-xl border border-dashed border-border bg-surface/50 px-6 py-12 text-center text-sm text-text-tertiary">
              No labels yet. Create your first label to start color-coding work.
            </div>
          </:empty>

          <div
            :for={{dom_id, label} <- @streams.labels}
            id={dom_id}
            class="group flex items-center justify-between gap-4 rounded-xl border border-border bg-surface px-4 py-3 transition-colors hover:border-border-hover hover:bg-surface-hover hover:shadow-[inset_2px_0_0_0_var(--color-primary)]"
          >
            <div class="flex min-w-0 items-center gap-3">
              <span
                class="h-9 w-9 shrink-0 rounded-lg ring-1 ring-inset ring-white/10"
                style={"background-color: #{label.color}"}
              >
              </span>
              <div class="min-w-0">
                <div class="flex flex-wrap items-center gap-2">
                  <span
                    class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-590"
                    style={"background-color: #{label.color}; color: #{text_color(label.color)}"}
                  >
                    {label.name}
                  </span>
                  <code class="text-[11px] uppercase tracking-wide text-text-quaternary">
                    {label.color}
                  </code>
                </div>
                <p :if={label.description} class="mt-1 truncate text-xs text-text-tertiary">
                  {label.description}
                </p>
              </div>
            </div>

            <div class="flex shrink-0 items-center gap-1.5">
              <button
                type="button"
                phx-click="edit_label"
                phx-value-id={label.id}
                class="rounded-lg border border-border bg-surface px-3 py-1.5 text-xs font-510 text-text-secondary transition-colors hover:border-brand/40 hover:text-brand"
              >
                Edit
              </button>
              <button
                type="button"
                phx-click="delete_label"
                phx-value-id={label.id}
                data-confirm="Delete this label?"
                class="rounded-lg border border-red-500/20 bg-red-500/10 px-3 py-1.5 text-xs font-510 text-red-300 transition-colors hover:bg-red-500/15"
              >
                Delete
              </button>
            </div>
          </div>
        </.infinite_scroll>
      </section>
    </div>
  </div>
</.page>
