<.settings_layout active={:labels}>
  <.flash_line flash={@flash} />

  <.form_pair
    id="label-form"
    for={@form}
    phx-submit={(@editing_label && "update_label") || "create_label"}
    heading={(@editing_label && "After you save") || "After you add it"}
    verb={(@editing_label && "save") || "add"}
  >
    <.band_card id="lf-card-t" title={(@editing_label && "Edit label") || "New label"}>
      <div class="flds">
        <.input field={@form[:name]} label="Name" placeholder="Label name" />
        <.input field={@form[:color]} label="Colour" placeholder="#FF0000" />
        <.input
          field={@form[:description]}
          label="Description"
          placeholder="Optional"
          wrapper_class="full"
        />
      </div>
    </.band_card>
    <:effect>
      <.consequences
        :if={!@editing_label}
        rows={[{:done, "It can be added to any task right away."}]}
      />
      <.consequences
        :if={@editing_label}
        rows={[{:done, "Tasks that carry it show the new name and colour."}]}
      />
    </:effect>
    <:secondary :if={@editing_label}>
      <.ghost_pill phx-click="cancel_edit">Cancel</.ghost_pill>
    </:secondary>
    <:primary>
      <.primary_pill type="submit">
        {(@editing_label && "Save label") || "Add label"}
      </.primary_pill>
    </:primary>
  </.form_pair>

  <.band_card id="labels-list-t" title="Labels">
    <.infinite_scroll
      id="labels"
      has_more={@infinite_scroll[:labels][:has_more?] || false}
      container_class="rows"
    >
      <:empty>
        <.quiet_empty title="No labels yet">
          Add one above to color-code tasks on the board.
        </.quiet_empty>
      </:empty>

      <.list_row
        :for={{dom_id, label} <- @streams.labels}
        tag="div"
        id={dom_id}
        title={label.name}
      >
        <:meta>
          <span
            :if={label.color not in [nil, ""]}
            class="sw"
            style={"background:#{label.color}"}
            aria-hidden="true"
          >
          </span>
          <span class="mono">{label.color}</span><span :if={label.description not in [nil, ""]}><span aria-hidden="true"> · </span>{label.description}</span>
        </:meta>
        <:actions>
          <.pill phx-click="edit_label" phx-value-id={label.id} aria-label={"Edit #{label.name}"}>
            Edit
          </.pill>
          <button
            type="button"
            class="pl warn"
            phx-click="delete_label"
            phx-value-id={label.id}
            data-confirm="Delete this label?"
            aria-label={"Delete #{label.name}"}
          >
            Delete
          </button>
        </:actions>
      </.list_row>
    </.infinite_scroll>
  </.band_card>
</.settings_layout>
