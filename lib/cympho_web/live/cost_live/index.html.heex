<.page_frame page="spending" title="Spending" data-ui-complex-page>
  <:aside :if={@spending}>since {day(@since)}</:aside>

  <.limit_step
    :if={@spending}
    spending={@spending}
    policy={@limit_policy}
    can_change={@can_change_limit}
    paused={@company_paused?}
    runtime_controls={@runtime_controls_allowed}
    input={@limit_input}
  />

  <div :if={@spending && @agent_rows != []} class="money-g">
    <.band_card id="ba-t" title="By agent" band={false}>
      <:header_end>
        <span class="meta">Last 24 hours <span class="mono">{money(@day_total)}</span></span>
      </:header_end>
      <table class="money">
        <thead>
          <tr>
            <th scope="col">Agent</th>
            <th scope="col">{window(@spending.days)}</th>
            <th scope="col">24 hours</th>
          </tr>
        </thead>
        <tbody>
          <tr :for={row <- @agent_rows}>
            <th scope="row">
              <.link :if={row.agent} class="nm" navigate={"/agents/#{row.agent.id}?from=/costs"}>
                <span class="tile-ag sm" aria-hidden="true">{initials(row.agent.name)}</span>{row.agent.name}
              </.link>
              <span :if={!row.agent} class="nm">A removed agent</span>
            </th>
            <td><.amount value={row.total_cost} total={@window_total} /></td>
            <td class="mono">{money(Map.get(@day_by_agent, row.agent_id, Decimal.new(0)))}</td>
          </tr>
        </tbody>
      </table>
    </.band_card>

    <.band_card id="bt-t" title="By task" band={false}>
      <:header_end>
        <span class="meta">Last {window(@spending.days)}</span>
      </:header_end>
      <.task_table :if={@top_tasks != []} rows={@top_tasks} total={@window_total} />
      <details :if={@more_tasks != []} class="earlier more">
        <summary>
          <span>
            <span class="mono">{length(@more_tasks)}</span> more<span aria-hidden="true"> ·</span>
            <span class="mono">{" " <> money(sum(@more_tasks))}</span>
          </span>
          <.r3_icon name="i-chev-down" />
        </summary>
        <.task_table rows={@more_tasks} total={@window_total} />
      </details>
      <div :if={Decimal.gt?(@untied_total, 0)} class="untied">
        <p>
          <span class="ut-t">Not tied to a task</span>
          <span class="ut-s">Runs that were not about one task</span>
        </p>
        <.amount value={@untied_total} total={@window_total} />
      </div>
    </.band_card>
  </div>

  <.band_card
    :if={@spending && @agent_rows == []}
    id="ns-empty"
    title="Where it went"
    band={false}
  >
    <.quiet_empty title={"No spend in the last #{window(@spending.days)}"}>
      Costs appear here once agents start running.
    </.quiet_empty>
  </.band_card>

  <section
    :if={Map.get(@summary, :has_unpriced_usage?)}
    id="unpriced-usage-warning"
    data-testid="unpriced-usage-warning"
    class="card"
    aria-labelledby="up-t"
  >
    <div class="card-h">
      <h2 class="h2" id="up-t">Usage we couldn't price</h2>
    </div>
    <p class="note-l">
      {format_tokens(@summary.unpriced_tokens)} tokens across {pluralize(
        @summary.unpriced_request_count,
        "request"
      )} reported no price, so they are not in the totals above.
    </p>
    <.text_link navigate="/settings/company?section=billing">Add prices in Billing</.text_link>
  </section>

  <%!-- Advanced: by runtime, then the analytics, unchanged below the r3 blocks (plan §0.2). --%>
  <div class="ui-advanced-only">
    <section :if={@by_provider != []} class="card" aria-labelledby="rt-t">
      <div class="card-h">
        <h2 class="h2" id="rt-t">By runtime <span class="adv">Adv</span></h2>
        <span class="meta">Last {window(@days)}</span>
      </div>
      <div class="rtb" style={runtime_columns(@by_provider)} aria-hidden="true">
        <i :for={{row, n} <- Enum.with_index(@by_provider)} class={category(n)}></i>
      </div>
      <ul class="rtl">
        <li :for={{row, n} <- Enum.with_index(@by_provider)}>
          <span class={["key", category(n)]} aria-hidden="true"></span>
          <span>
            {runtime_label(row.provider)}
            <small :if={@runtime_agents[row.provider]}>{@runtime_agents[row.provider]}</small>
          </span>
          <span class="mono">{money(row.total_cost || Decimal.new(0))}</span>
        </li>
      </ul>
    </section>

    <div class="mb-6 mt-6 flex flex-wrap items-center justify-between gap-3">
      <h2 class="h2">Details</h2>
      <.form
        for={%{}}
        as={:days}
        phx-change="change_days"
        phx-submit="change_days"
        class="inline-flex"
      >
        <.input
          type="select"
          name="days"
          options={[{"7 days", "7"}, {"30 days", "30"}, {"90 days", "90"}]}
          value={to_string(@days)}
          class="text-sm"
        />
      </.form>
    </div>
    
<!-- Budget Alerts -->
    <div
      :if={not Enum.empty?(@exceeded_budgets)}
      class="mb-6 bg-brand/10 border border-brand/20 rounded-xl p-4"
    >
      <h3 class="font-serif text-sm font-510 text-brand mb-2">
        <svg class="w-4 h-4 inline mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"
          />
        </svg>
        Exceeded Budgets
      </h3>
      <div class="space-y-2">
        <%= for budget <- @exceeded_budgets do %>
          <div class="flex items-center justify-between text-sm">
            <span class="text-text-primary">{budget.name}</span>
            <span class="text-brand font-510">{budget_utilization_pct(budget)} used</span>
          </div>
        <% end %>
      </div>
    </div>

    <div
      :if={not Enum.empty?(@approaching_budgets)}
      class="mb-6 bg-amber-500/10 border border-amber-500/20 rounded-xl p-4"
    >
      <h3 class="font-serif text-sm font-510 text-amber-400 mb-2">
        <svg class="w-4 h-4 inline mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
          />
        </svg>
        Approaching Budget Limits
      </h3>
      <div class="space-y-2">
        <%= for budget <- @approaching_budgets do %>
          <div class="flex items-center justify-between text-sm">
            <span class="text-text-primary">{budget.name}</span>
            <span class="text-amber-400 font-510">{budget_utilization_pct(budget)} used</span>
          </div>
        <% end %>
      </div>
    </div>

    <section
      id="spend-runway"
      data-testid="spend-runway"
      class="mb-6 overflow-hidden rounded-lg border border-border bg-panel"
    >
      <div class="grid gap-4 px-5 py-4 lg:grid-cols-[minmax(0,1fr)_auto] lg:items-start">
        <div class="min-w-0">
          <div class="flex flex-wrap items-center gap-2">
            <p class="text-[11px] font-590 uppercase tracking-[0.14em] text-text-quaternary">
              Spend runway
            </p>
            <span class={[
              "rounded-full border px-2 py-0.5 text-[11px] font-510",
              spend_runway_badge_class(@spend_runway.tone)
            ]}>
              {@spend_runway.label}
            </span>
          </div>
          <h2 class="mt-2 text-lg font-590 tracking-tight text-text-primary">
            {@spend_runway.headline}
          </h2>
          <p class="mt-1 max-w-3xl text-sm leading-5 text-text-tertiary">
            {@spend_runway.summary}
          </p>
        </div>
        <a
          href={@spend_runway.action_path}
          class={[
            "inline-flex shrink-0 items-center justify-center gap-2 rounded-lg border px-3 py-2 text-sm font-510 transition-colors",
            spend_runway_action_class(@spend_runway.tone)
          ]}
        >
          <span class="hero-arrow-right-mini h-4 w-4"></span>
          {@spend_runway.action_label}
        </a>
      </div>

      <div class="grid grid-cols-2 gap-px bg-border sm:grid-cols-4">
        <div :for={metric <- @spend_runway.metrics} class="bg-surface px-4 py-3">
          <p class="text-[10px] font-590 uppercase tracking-[0.12em] text-text-quaternary">
            {metric.label}
          </p>
          <p class="mt-1 break-words font-mono text-sm font-590 text-text-primary">
            {metric.value}
          </p>
        </div>
      </div>
    </section>
    
<!-- One empty panel instead of nine cards each saying "no X yet" -->
    <div :if={@spend_breakdowns_empty?} class="mb-6">
      <.cost_empty_state
        testid="cost-breakdowns-empty"
        icon="hero-chart-bar-square-mini"
        title="No spend recorded in this window"
        detail="Breakdowns by agent, issue, model and provider appear once agent runs report token usage. Set a spending limit before launching more runtime."
        primary_label="Create budget"
        primary_path={~p"/budgets/new"}
        secondary_label="Open Operations"
        secondary_path={~p"/operations#runtime-launch-checklist"}
      />
    </div>
    
<!-- Daily Cost Chart -->
    <div
      :if={not @spend_breakdowns_empty?}
      class="ui-advanced-only bg-surface border border-border rounded-xl p-6 mb-6"
    >
      <h2 class="font-serif text-[13px] font-510 italic tracking-[0.02em] text-brand/90 mb-4">
        Daily Cost Trend
      </h2>
      <div :if={not Enum.empty?(@daily_costs)} class="h-40 flex items-end gap-1">
        <% max_cost = max_daily_cost(@daily_costs) %>
        <%= for day <- @daily_costs do %>
          <div class="flex-1 group relative">
            <div
              class="absolute bottom-0 w-full bg-brand hover:bg-accent transition-colors rounded-t-sm"
              style={"height: #{daily_bar_height(day.total_cost, max_cost)}"}
              title={"#{day.date}: #{format_cost(day.total_cost)}"}
            >
            </div>
          </div>
        <% end %>
      </div>
      <div :if={Enum.empty?(@daily_costs)} class="pt-2">
        <.cost_empty_state
          testid="daily-cost-empty"
          icon="hero-chart-bar-square-mini"
          title="No spend captured in this window"
          detail="Create a spending limit before launching more runtime, or open Operations when you expected agent runs to produce usage."
          primary_label="Create budget"
          primary_path={~p"/budgets/new"}
          secondary_label="Open Operations"
          secondary_path={~p"/operations#runtime-launch-checklist"}
        />
      </div>
    </div>
    
<!-- Sparklines -->
    <div
      :if={not @spend_breakdowns_empty?}
      class="ui-advanced-only grid grid-cols-1 lg:grid-cols-2 gap-6 mb-6"
    >
      <div class="bg-surface border border-border rounded-xl p-6">
        <h2 class="font-serif text-[13px] font-510 italic tracking-[0.02em] text-brand/90 mb-4">
          7-Day Cost Trend
        </h2>
        <div :if={not Enum.empty?(@sparkline_7d)} class="h-16">
          <svg viewBox="0 0 100 100" preserveAspectRatio="none" class="w-full h-full">
            <polyline
              fill="none"
              stroke="#D97757"
              stroke-width="2"
              stroke-linejoin="round"
              stroke-linecap="round"
              points={sparkline_points(@sparkline_7d)}
            />
          </svg>
          <div class="flex justify-between mt-2 text-xs text-text-quaternary">
            <span>7 days ago</span>
            <span>Today</span>
          </div>
        </div>
        <div :if={Enum.empty?(@sparkline_7d)} class="pt-1">
          <.cost_empty_state
            testid="sparkline-7d-empty"
            icon="hero-presentation-chart-line-mini"
            title="No 7-day burn line yet"
            detail="Runtime usage will draw this line once agents complete billable turns."
          />
        </div>
      </div>

      <div class="bg-surface border border-border rounded-xl p-6">
        <h2 class="font-serif text-[13px] font-510 italic tracking-[0.02em] text-brand/90 mb-4">
          30-Day Cost Trend
        </h2>
        <div :if={not Enum.empty?(@sparkline_30d)} class="h-16">
          <svg viewBox="0 0 100 100" preserveAspectRatio="none" class="w-full h-full">
            <polyline
              fill="none"
              stroke="#D97757"
              stroke-width="2"
              stroke-linejoin="round"
              stroke-linecap="round"
              points={sparkline_points(@sparkline_30d)}
            />
          </svg>
          <div class="flex justify-between mt-2 text-xs text-text-quaternary">
            <span>30 days ago</span>
            <span>Today</span>
          </div>
        </div>
        <div :if={Enum.empty?(@sparkline_30d)} class="pt-1">
          <.cost_empty_state
            testid="sparkline-30d-empty"
            icon="hero-presentation-chart-line-mini"
            title="No 30-day burn line yet"
            detail="This trend appears after enough agent usage lands in the cost ledger."
          />
        </div>
      </div>
    </div>
    
<!-- Cost by Mission / Goal -->
    <div
      :if={not @spend_breakdowns_empty?}
      class="ui-advanced-only grid grid-cols-1 lg:grid-cols-2 gap-6 mb-6"
    >
      <div class="bg-surface border border-border rounded-xl p-6">
        <h2 class="font-serif text-[13px] font-510 italic tracking-[0.02em] text-brand/90 mb-4">
          Cost by Mission
        </h2>
        <div class="space-y-3">
          <%= for item <- @by_mission do %>
            <div class="flex items-center justify-between">
              <div class="flex-1">
                <div class="flex items-center justify-between mb-1">
                  <span class="text-sm text-text-primary truncate">{item.title}</span>
                  <span class="text-sm text-text-primary font-510 ml-2">
                    {format_cost(item.total_cost)}
                  </span>
                </div>
                <div class="w-full bg-black/20 rounded-full h-1.5">
                  <div
                    class="bg-amber-400 h-1.5 rounded-full"
                    style={"width: #{bar_width(item.total_cost, hd(@by_mission).total_cost)}"}
                  >
                  </div>
                </div>
                <div class="flex justify-between mt-1 text-xs text-text-quaternary">
                  <span>{format_tokens(item.total_tokens)} tokens</span>
                  <span>{item.request_count} requests</span>
                </div>
              </div>
            </div>
          <% end %>
        </div>
        <div :if={Enum.empty?(@by_mission)} class="pt-1">
          <.cost_empty_state
            testid="cost-mission-empty"
            icon="hero-flag-mini"
            title="No mission cost drivers yet"
            detail="Costs will attach here when agent work is connected to mission goals."
          />
        </div>
      </div>

      <div class="bg-surface border border-border rounded-xl p-6">
        <h2 class="font-serif text-[13px] font-510 italic tracking-[0.02em] text-brand/90 mb-4">
          Cost by Goal (incl. children)
        </h2>
        <div class="space-y-3">
          <%= for item <- @by_goal do %>
            <div class="flex items-center justify-between">
              <div class="flex-1">
                <div class="flex items-center justify-between mb-1">
                  <div class="flex items-center gap-2">
                    <span class="text-xs px-1.5 py-0.5 rounded bg-brand/10 text-brand">
                      {goal_type_label(item.goal_type)}
                    </span>
                    <span class="text-sm text-text-primary truncate">{item.title}</span>
                  </div>
                  <span class="text-sm text-text-primary font-510 ml-2">
                    {format_cost(item.total_cost)}
                  </span>
                </div>
                <div class="w-full bg-black/20 rounded-full h-1.5">
                  <div
                    class="bg-brand h-1.5 rounded-full"
                    style={"width: #{bar_width(item.total_cost, hd(@by_goal).total_cost)}"}
                  >
                  </div>
                </div>
                <div class="flex justify-between mt-1 text-xs text-text-quaternary">
                  <span>{format_tokens(item.total_tokens)} tokens</span>
                  <span>{item.request_count} requests</span>
                </div>
              </div>
            </div>
          <% end %>
        </div>
        <div :if={Enum.empty?(@by_goal)} class="pt-1">
          <.cost_empty_state
            testid="cost-goal-empty"
            icon="hero-map-mini"
            title="No goal cost drivers yet"
            detail="Goal rollups will appear once runtime spend maps back to mission, initiative, or milestone work."
          />
        </div>
      </div>
    </div>

    <div
      :if={not @spend_breakdowns_empty?}
      id="top-cost-drivers"
      class="ui-advanced-only grid scroll-mt-6 grid-cols-1 gap-6 mb-6 lg:grid-cols-2"
    >
      <!-- Costs by Agent -->
      <div class="bg-surface border border-border rounded-xl p-6">
        <h2 class="font-serif text-[13px] font-510 italic tracking-[0.02em] text-brand/90 mb-4">
          Top Agents by Cost
        </h2>
        <div class="space-y-3">
          <%= for item <- @by_agent do %>
            <div class="flex items-center justify-between">
              <div class="flex-1">
                <div class="flex items-center justify-between mb-1">
                  <.app_link
                    navigate={~p"/agents/#{item.agent.id}"}
                    class="text-sm font-510 text-brand hover:text-accent"
                  >
                    {item.agent.name}
                  </.app_link>
                  <span class="text-sm text-text-primary">{format_cost(item.total_cost)}</span>
                </div>
                <div class="w-full bg-black/20 rounded-full h-1.5">
                  <div
                    class="bg-brand h-1.5 rounded-full"
                    style={"width: #{bar_width(item.total_cost, hd(@by_agent).total_cost)}"}
                  >
                  </div>
                </div>
                <div class="flex justify-between mt-1 text-xs text-text-quaternary">
                  <span>{format_tokens(item.total_tokens)} tokens</span>
                  <span>{item.request_count} requests</span>
                </div>
              </div>
            </div>
          <% end %>
        </div>
        <div :if={Enum.empty?(@by_agent)} class="pt-1">
          <.cost_empty_state
            testid="cost-agent-empty"
            icon="hero-sparkles-mini"
            title="No agent cost drivers yet"
            detail="Agent totals will appear here after CEO, CTO, or engineer runs report token usage."
          />
        </div>
      </div>
      
<!-- Costs by Issue -->
      <div class="bg-surface border border-border rounded-xl p-6">
        <h2 class="font-serif text-[13px] font-510 italic tracking-[0.02em] text-brand/90 mb-4">
          Top Issues by Cost
        </h2>
        <div class="space-y-3">
          <%= for item <- @by_issue do %>
            <div class="flex items-center justify-between">
              <div class="flex-1">
                <div class="flex items-center justify-between mb-1">
                  <.app_link
                    navigate={~p"/workspace/#{item.issue.id}"}
                    class="text-sm font-510 text-brand hover:text-accent truncate"
                  >
                    {item.issue.title}
                  </.app_link>
                  <span class="text-sm text-text-primary ml-2">
                    {format_cost(item.total_cost)}
                  </span>
                </div>
                <div class="w-full bg-black/20 rounded-full h-1.5">
                  <div
                    class="bg-purple-400 h-1.5 rounded-full"
                    style={"width: #{bar_width(item.total_cost, hd(@by_issue).total_cost)}"}
                  >
                  </div>
                </div>
                <div class="flex justify-between mt-1 text-xs text-text-quaternary">
                  <span>{format_tokens(item.total_tokens)} tokens</span>
                  <span>{item.request_count} requests</span>
                </div>
              </div>
            </div>
          <% end %>
        </div>
        <div :if={Enum.empty?(@by_issue)} class="pt-1">
          <.cost_empty_state
            testid="cost-issue-empty"
            icon="hero-queue-list-mini"
            title="No issue cost drivers yet"
            detail="Issue totals will appear once autonomous runs write usage against work items."
          />
        </div>
      </div>
    </div>

    <div
      :if={not @spend_breakdowns_empty?}
      class="ui-advanced-only grid grid-cols-1 lg:grid-cols-2 gap-6 mb-6"
    >
      <!-- Costs by Model -->
      <div class="bg-surface border border-border rounded-xl p-6">
        <h2 class="font-serif text-[13px] font-510 italic tracking-[0.02em] text-brand/90 mb-4">
          Cost by Model
        </h2>
        <div class="space-y-3">
          <%= for item <- @by_model do %>
            <div class="flex items-center justify-between text-sm">
              <div class="flex-1">
                <div class="flex items-center justify-between mb-1">
                  <div>
                    <span class="text-text-primary">{item.provider}</span>
                    <span class="text-text-quaternary mx-1">/</span>
                    <span class="text-text-secondary">{item.model}</span>
                  </div>
                  <span class="text-text-primary font-510">{format_cost(item.total_cost)}</span>
                </div>
                <div class="w-full bg-black/20 rounded-full h-1.5">
                  <div
                    class="bg-green-400 h-1.5 rounded-full"
                    style={"width: #{bar_width(item.total_cost, hd(@by_model).total_cost)}"}
                  >
                  </div>
                </div>
                <div class="flex justify-between mt-1 text-xs text-text-quaternary">
                  <span>{format_tokens(item.total_tokens)} tokens</span>
                  <span>{item.request_count} requests</span>
                </div>
              </div>
            </div>
          <% end %>
        </div>
        <div :if={Enum.empty?(@by_model)} class="pt-1">
          <.cost_empty_state
            testid="cost-model-empty"
            icon="hero-cpu-chip-mini"
            title="No model mix yet"
            detail="Model spend will break down here after provider usage is recorded."
          />
        </div>
      </div>
      
<!-- Costs by Provider -->
      <div class="bg-surface border border-border rounded-xl p-6">
        <h2 class="font-serif text-[13px] font-510 italic tracking-[0.02em] text-brand/90 mb-4">
          Cost by Provider
        </h2>
        <div class="space-y-3">
          <%= for item <- @by_provider do %>
            <div class="flex items-center justify-between text-sm">
              <div class="flex-1">
                <div class="flex items-center justify-between mb-1">
                  <span class="text-text-primary">{item.provider}</span>
                  <span class="text-text-primary font-510">{format_cost(item.total_cost)}</span>
                </div>
                <div class="w-full bg-black/20 rounded-full h-1.5">
                  <div
                    class="bg-blue-400 h-1.5 rounded-full"
                    style={"width: #{bar_width(item.total_cost, hd(@by_provider).total_cost)}"}
                  >
                  </div>
                </div>
                <div class="flex justify-between mt-1 text-xs text-text-quaternary">
                  <span>{format_tokens(item.total_tokens)} tokens</span>
                  <span>{item.request_count} requests</span>
                </div>
              </div>
            </div>
          <% end %>
        </div>
        <div :if={Enum.empty?(@by_provider)} class="pt-1">
          <.cost_empty_state
            testid="cost-provider-empty"
            icon="hero-cloud-mini"
            title="No provider mix yet"
            detail="Provider totals will appear here once adapters report billable model usage."
          />
        </div>
      </div>
    </div>
    
<!-- Active Budgets -->
    <div id="active-budgets" class="scroll-mt-6 bg-surface border border-border rounded-xl p-6">
      <div class="flex items-center justify-between mb-3">
        <h2 class="font-serif text-sm font-510 text-text-secondary uppercase tracking-wider">
          Active Budgets
        </h2>
        <.app_link
          navigate={~p"/budgets"}
          class="text-brand hover:text-accent text-sm"
        >
          Manage Budgets →
        </.app_link>
      </div>
      <hr class="ember-rule mb-4" />
      <div class="space-y-4">
        <%= for budget <- @active_budgets do %>
          <% {status_class, status_label} = budget_status_badge(budget) %>
          <div class="border border-border rounded-lg p-4">
            <div class="flex items-start justify-between mb-3">
              <div>
                <.app_link
                  navigate={~p"/budgets/#{budget.id}"}
                  class="text-brand hover:text-accent font-510"
                >
                  {budget.name}
                </.app_link>
                <div class="text-xs text-text-quaternary mt-1">
                  {budget.scope_type} scope
                </div>
              </div>
              <span class={"inline-flex items-center px-2 py-1 rounded text-xs font-510 border #{status_class}"}>
                {status_label}
              </span>
            </div>
            <div class="space-y-2">
              <div class="flex items-center justify-between text-sm">
                <span class="text-text-secondary">
                  {format_cost(budget.spent_amount)} of {format_cost(budget.limit_amount)}
                </span>
                <span class="text-text-primary font-510">
                  {budget_utilization_pct(budget)}
                </span>
              </div>
              <div class="w-full bg-black/20 rounded-full h-2">
                <div
                  class={"h-2 rounded-full progress-spring #{budget_progress_color(budget)}"}
                  style={"width: #{budget_utilization_pct(budget)}"}
                >
                </div>
              </div>
            </div>
          </div>
        <% end %>
      </div>
      <div :if={Enum.empty?(@active_budgets)} class="pt-1">
        <.cost_empty_state
          testid="active-budgets-empty"
          icon="hero-shield-check-mini"
          title="No active budgets"
          detail="Create a company budget so runtime launches have a clear spend envelope."
          primary_label="Create budget"
          primary_path={~p"/budgets/new"}
        />
      </div>
    </div>
  </div>
</.page_frame>
