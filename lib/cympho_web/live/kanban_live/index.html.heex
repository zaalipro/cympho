<style>
  @keyframes phx-error-shake {
    0%, 100% { transform: translateX(0); }
    10%, 30%, 50%, 70%, 90% { transform: translateX(-4px); }
    20%, 40%, 60%, 80% { transform: translateX(4px); }
  }
  .phx-error-shake { animation: phx-error-shake 0.4s ease-in-out; }

  @keyframes skeleton-pulse {
    0%, 100% { opacity: 0.4; }
    50% { opacity: 0.15; }
  }
  .kanban-skeleton { animation: skeleton-pulse 1.5s ease-in-out infinite; background: var(--color-subtle); border-radius: 6px; }

  @keyframes card-enter {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .kanban-card-enter { animation: card-enter 0.2s ease-out; }

  @media (min-width: 640px) and (max-height: 760px) {
    #kanban-flow-command {
      display: none;
    }

    #kanban-flow-command-compact {
      display: block;
    }
  }
</style>

<.page_frame
  page="board"
  title="Tasks"
  id="kanban-board"
  phx-hook="KanbanSortable"
  data-ui-complex-page
  data-density={@digest_density}
>
  <:header_end>
    <.task_view_switch current="board" params={Tasks.filter_params(@view_params)} />
  </:header_end>

  <% computed = Tasks.filter(@issues, @view_params) %>

  <Tasks.toolbar
    search={@view_params["search"] || ""}
    active={active_filter_count(assigns)}
    mine_href={~p"/my-issues"}
  >
    <:filters>
      <.combobox
        id="kanban-filter-assignee"
        label="Person"
        placeholder="Anyone"
        options={Enum.map(@agents, &%{id: &1.id, label: &1.name})}
        selected={@view_params["assignee_id"]}
        on_change="combobox_assignee"
      />
      <.combobox
        id="kanban-filter-project"
        label="Project"
        placeholder="All projects"
        options={Enum.map(@projects, &%{id: to_string(&1.id), label: &1.name})}
        selected={@selected_project_id}
        on_change="combobox_project"
      />
      <.combobox
        id="kanban-filter-priority"
        label="Priority"
        placeholder="Any priority"
        searchable?={false}
        options={
          Enum.map(
            Cympho.Issues.Issue.priority_options(),
            &%{id: to_string(&1), label: String.capitalize(to_string(&1))}
          )
        }
        selected={@view_params["priority"]}
        on_change="combobox_priority"
      />
      <button
        :if={active_filter_count(assigns) > 0}
        type="button"
        class="pl"
        phx-click="clear_filters"
      >
        Clear all
      </button>
    </:filters>
    <span class="sf-sp"></span>
    <button
      :for={status <- [:backlog, :cancelled]}
      type="button"
      class="colp"
      phx-click="toggle_column"
      phx-value-status={status}
      aria-expanded={to_string(!MapSet.member?(@collapsed_columns, status))}
    >
      {status_label(status)}
      <span class="mono">{length(issues_for_status(computed, status))}</span>
    </button>
  </Tasks.toolbar>

  <.flash_line flash={@flash} />

  <%!-- A refused move: what blocks it and where to fix it (a problem, so it leads the board) --%>
  <.band_card
    :if={@blocked_transition}
    id="kanban-blocker-t"
    title="Move blocked"
    section_id="kanban-transition-blocker"
  >
    <:header_end>
      <.pill phx-click="dismiss_transition_blocker">Dismiss</.pill>
    </:header_end>
    <div class="gl-sec">
      <p class="gl-big">{@blocked_transition.issue_title}</p>
      <p class="gl-sub">
        <span class="mono">{@blocked_transition.issue_identifier}</span><span aria-hidden="true"> · </span>{status_label(
          @blocked_transition.from_status
        )} to {status_label(@blocked_transition.to_status)}
      </p>
      <p class="gl-sub">{@blocked_transition.message}</p>
    </div>
    <ul :if={@blocked_transition.blockers != []} class="rows">
      <.list_row
        :for={{blocker, n} <- Enum.with_index(@blocked_transition.blockers)}
        id={"kanban-blocker-#{n}"}
        title={blocker.label}
        icon="i-alert"
        kind={:problem}
      >
        <:meta>{blocker.prompt}</:meta>
      </.list_row>
    </ul>
    <div :if={@blocked_transition.actions != []} class="cf">
      <.pill :for={action <- @blocked_transition.actions} navigate={action.path}>
        {action.label}
      </.pill>
    </div>
  </.band_card>

  <%!-- Advanced: re-cutting the board (swimlanes, density) and its health. --%>
  <div class="ui-advanced-only" data-testid="kanban-view-controls">
    <div class="mb-3 flex flex-wrap items-center gap-2">
      <button
        type="button"
        phx-click="toggle_swimlanes"
        title={if @swimlane_mode, do: "Flat view", else: "Swimlanes"}
        class={"inline-flex h-10 min-w-0 items-center justify-center gap-1.5 rounded-lg border px-3 text-sm font-510 transition-colors sm:shrink-0 " <> if(@swimlane_mode, do: "bg-accent/20 border-accent/30 text-accent", else: "bg-panel border-border text-text-secondary hover:text-text-primary hover:bg-surface-hover")}
      >
        <span class={[
          "h-4 w-4",
          if(@swimlane_mode, do: "hero-bars-3-mini", else: "hero-bars-4-mini")
        ]}>
        </span>
        <span class="sr-only">{if @swimlane_mode, do: "Flat View", else: "Swimlanes"}</span>
      </button>

      <.density_switch
        density={@digest_density}
        compact_patch={board_url(assigns, %{"density" => "compact"})}
        detailed_patch={board_url(assigns, %{"density" => "detailed"})}
      />
    </div>

    <div
      :if={!@runtime_enabled?}
      class="mb-3 rounded-lg border border-sky-500/25 bg-sky-500/10 px-3 py-2 text-sm text-sky-200"
    >
      Review mode is active. You can reorganize work here without starting agent runs.
    </div>

    <% flow_metrics = board_flow_metrics(computed) %>
    <% attention_metrics =
      Enum.filter(flow_metrics, &(&1.label in ["Blocked", "Review"] and &1.count > 0)) %>
    <section
      :if={attention_metrics != []}
      id="kanban-flow-health"
      class="ember-glass mb-3 flex flex-wrap items-center gap-3 px-3 py-2"
    >
      <span class="hero-exclamation-triangle-mini h-4 w-4 text-amber-300"></span>
      <span class="text-xs font-590 text-text-secondary">Board health</span>
      <span
        :for={metric <- attention_metrics}
        class="rounded-full border border-border bg-panel px-2 py-0.5 text-xs text-text-tertiary"
      >
        {metric.count} {String.downcase(metric.label)}
      </span>
    </section>
  </div>

  <% shared_digest = shared_board_digest(computed, @issue_digests) %>
  <%!-- Every card on the board is in the same state, so the pill and headline
       are stated once here instead of once per card (Advanced detail). --%>
  <section
    :if={shared_digest}
    id="kanban-shared-digest"
    class="ember-glass ui-advanced-only mb-3 flex flex-wrap items-center gap-2 px-3 py-2"
  >
    <span class="rounded-full border border-border bg-panel px-2 py-0.5 text-[11px] font-510 text-text-secondary">
      {shared_digest.label}
    </span>
    <span class="text-xs text-text-tertiary">
      All {shared_digest.count} cards: {shared_digest.headline}
    </span>
  </section>

  <%= cond do %>
    <% Enum.empty?(@issues) -> %>
      <section class="card" aria-label="No tasks yet">
        <.quiet_empty title="No tasks yet.">
          Add one and Cympho gives it to an agent with the right role.
          <:action>
            <.text_link href="/issues/new" data-quick-create-trigger>New task</.text_link>
          </:action>
        </.quiet_empty>
      </section>
    <% Enum.empty?(computed) -> %>
      <section class="card" aria-label="No matching tasks">
        <.quiet_empty title="No tasks match these filters.">
          <:action>
            <button type="button" class="lnk" phx-click="clear_filters">Clear filters</button>
          </:action>
        </.quiet_empty>
      </section>
    <% true -> %>
      <div class="bcols">
        <section
          :for={status <- board_columns(@collapsed_columns)}
          class="bcol"
          aria-labelledby={"bd-#{status}"}
        >
          <% issues = computed |> issues_for_status(status) |> Tasks.board_order(@task_ctx) %>
          <% limit = wip_limit(@selected_project, status) %>
          <h2 class="gh" id={"bd-#{status}"}>
            {status_label(status)}
            <span
              class="mono"
              title={
                cond do
                  wip_exceeded?(limit, length(issues)) -> "Over the WIP limit of #{limit}"
                  limit -> "WIP limit #{limit}"
                  true -> nil
                end
              }
            >
              {length(issues)}{if limit, do: "/#{limit}", else: ""}
            </span>
          </h2>
          <ul class="bcs" data-kanban-column={status}>
            <li :if={issues == []} class="bempty">{empty_column_message(status)}</li>
            <%= if @swimlane_mode do %>
              <%= for {assignee_name, group_issues} <- assignee_groups(issues) do %>
                <li class="lane-h">{assignee_name}</li>
                <.board_card
                  :for={issue <- group_issues}
                  issue={issue}
                  ctx={@task_ctx}
                  digest={Map.fetch!(@issue_digests, issue.id)}
                  digest_density={@digest_density}
                  agent_heartbeat_states={@agent_heartbeat_states}
                  pending_wake={Map.get(@pending_wakes, issue.id)}
                  launch_readiness={Map.get(@launch_readiness_by_issue, issue.id)}
                  digest_cause_hoisted={shared_digest != nil}
                />
              <% end %>
            <% else %>
              <.board_card
                :for={issue <- issues}
                issue={issue}
                ctx={@task_ctx}
                digest={Map.fetch!(@issue_digests, issue.id)}
                digest_density={@digest_density}
                agent_heartbeat_states={@agent_heartbeat_states}
                pending_wake={Map.get(@pending_wakes, issue.id)}
                launch_readiness={Map.get(@launch_readiness_by_issue, issue.id)}
                digest_cause_hoisted={shared_digest != nil}
              />
            <% end %>
          </ul>
        </section>
      </div>
  <% end %>
</.page_frame>

<%!-- Comment modal --%>
<%= if match?({:add_comment, _}, @editing_card_id) do %>
  <% comment_issue_id = elem(@editing_card_id, 1) %>
  <div
    class="fixed inset-0 z-50 flex items-center justify-center bg-black/50"
    phx-click="cancel_comment"
  >
    <div
      class="dialog-enter bg-surface-2 border border-hairline rounded-2xl shadow-dialog w-full max-w-md mx-4 p-4"
      phx-click-away="cancel_comment"
    >
      <h3 class="font-serif text-sm font-510 text-text-primary mb-3">Add comment</h3>
      <form phx-submit="submit_comment" phx-value-issue-id={comment_issue_id}>
        <textarea
          name="comment"
          rows="3"
          placeholder="Write a comment..."
          class="w-full bg-surface border border-border rounded-lg px-3 py-2 text-sm text-text-primary placeholder:text-text-quaternary focus:outline-none focus:ring-2 focus:ring-accent/30 focus:border-accent resize-none"
        ></textarea>
        <div class="flex justify-end gap-2 mt-2">
          <button
            type="button"
            phx-click="cancel_comment"
            class="text-sm px-3 py-1.5 rounded-lg border border-border text-text-secondary hover:text-text-primary hover:bg-surface-hover transition-colors"
          >
            Cancel
          </button>
          <button
            type="submit"
            class="text-sm px-3 py-1.5 rounded-lg bg-accent text-canvas font-590 hover:bg-accent/80 transition-colors"
          >
            Submit
          </button>
        </div>
      </form>
    </div>
  </div>
<% end %>
