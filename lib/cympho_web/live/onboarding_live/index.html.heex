<div
  class="min-h-screen flex items-start justify-center overflow-y-auto px-4 py-8"
  data-ui-complex-page
>
  <div class="ember-aurora relative w-full max-w-4xl">
    <div class="relative z-[1]">
      <!-- Progress dots -->
      <div
        :if={@onboarding_path == :start}
        class="flex items-center justify-center gap-2 mb-8"
      >
        <%= for {step, idx} <- Enum.with_index(@steps) do %>
          <div class={
          "h-2 rounded-full transition-all duration-300 " <>
          cond do
            idx < @current_step -> "w-6 bg-brand/55"
            idx == @current_step -> "w-2 bg-brand shadow-[0_0_12px_2px_rgb(var(--color-primary-rgb)/0.6)]"
            true -> "w-2 bg-white/10"
          end
        }>
          </div>
        <% end %>
      </div>
      
<!-- Step content -->
      <div :if={@onboarding_path == :start} class="text-center mb-8">
        <span class="ember-eyebrow">
          Step {@current_step + 1} of {length(@steps)}
        </span>
        <h1 class="ember-ink mt-4 mb-2 font-serif text-[clamp(28px,4vw,40px)] font-510 leading-[1.1] tracking-[-0.02em]">
          {@steps |> Enum.at(@current_step) |> Map.get(:title)}
        </h1>
        <p class="ui-advanced-only text-sm text-text-secondary">
          {@steps |> Enum.at(@current_step) |> Map.get(:description)}
        </p>
        <p class="ui-simple-only text-sm text-text-secondary">
          {@steps |> Enum.at(@current_step) |> step_simple_description()}
        </p>
      </div>

      <div
        :if={@step_error}
        class="mb-4 rounded-lg border border-red-500/40 bg-red-500/10 px-4 py-2.5 text-sm text-red-300"
      >
        {@step_error}
      </div>

      <div :if={is_nil(@onboarding_path)} class="ember-glass mb-6 p-6">
        <div class="mx-auto max-w-2xl text-center">
          <span class="ember-eyebrow">Guided setup</span>
          <h1 class="ember-ink mt-4 font-serif text-[clamp(28px,4vw,40px)] font-510 leading-[1.1] tracking-[-0.02em]">
            What would you like to do?
          </h1>
          <p class="mt-2 text-sm text-text-secondary">
            Start another autonomous company, or turn an improvement for {@current_company.name} into ready-to-run work.
          </p>
        </div>

        <div class="mt-6 grid gap-3 sm:grid-cols-2">
          <button
            type="button"
            phx-click="select_onboarding_path"
            phx-value-path="start"
            class="rounded-xl border border-border bg-surface p-5 text-left transition-colors hover:border-brand/50 hover:bg-brand/10"
          >
            <span class="hero-building-office-2-mini h-5 w-5 text-brand"></span>
            <span class="mt-3 block text-base font-590 text-text-primary">Start a company</span>
            <span class="mt-1 block text-sm leading-6 text-text-tertiary">
              Choose a blueprint, create a team, and launch starter work.
            </span>
          </button>
          <button
            type="button"
            phx-click="select_onboarding_path"
            phx-value-path="improve"
            class="rounded-xl border border-border bg-surface p-5 text-left transition-colors hover:border-brand/50 hover:bg-brand/10"
          >
            <span class="hero-arrow-trending-up-mini h-5 w-5 text-brand"></span>
            <span class="mt-3 block text-base font-590 text-text-primary">
              Improve this company
            </span>
            <span class="mt-1 block text-sm leading-6 text-text-tertiary">
              Add one focused goal and issue to {@current_company.name}; no new company is created.
            </span>
          </button>
        </div>

        <button
          type="button"
          phx-click="skip"
          class="mx-auto mt-5 block min-h-[44px] px-3 py-2 text-sm text-text-quaternary transition-colors hover:text-text-secondary"
        >
          Skip setup
        </button>
      </div>

      <div
        :if={@onboarding_path == :improve and is_nil(@bootstrap_result)}
        class="ember-glass mb-6 p-6"
      >
        <div class="mx-auto max-w-2xl">
          <span class="ember-eyebrow">Improve {@current_company.name}</span>
          <h1 class="ember-ink mt-4 font-serif text-[clamp(28px,4vw,38px)] font-510 leading-[1.1] tracking-[-0.02em]">
            Turn one outcome into ready work
          </h1>
          <p class="mt-2 text-sm leading-6 text-text-secondary">
            Cympho will create a company goal and one CEO-ready issue in your current company. No new company is created.
          </p>

          <form id="improve-company-form" phx-change="update_company_form" class="mt-6 space-y-4">
            <div>
              <label class="mb-1.5 block text-xs font-510 text-text-tertiary">
                What should improve?
              </label>
              <input
                name="company[goal_title]"
                value={@company_form["goal_title"]}
                maxlength="255"
                placeholder="Improve activation for new customers"
                class="w-full rounded-lg border border-border bg-surface px-3 py-2 text-sm text-text-primary placeholder:text-text-quaternary focus:border-accent focus:outline-none"
              />
            </div>
            <div>
              <label class="mb-1.5 block text-xs font-510 text-text-tertiary">
                Helpful context <span class="text-text-quaternary">(optional)</span>
              </label>
              <textarea
                name="company[improvement_details]"
                rows="5"
                maxlength="2000"
                placeholder="Describe the customer problem, desired outcome, and evidence to review. Never paste credentials or secrets."
                class="w-full rounded-lg border border-border bg-surface px-3 py-2 text-sm text-text-primary placeholder:text-text-quaternary focus:border-accent focus:outline-none"
              >{@company_form["improvement_details"]}</textarea>
            </div>
          </form>

          <div class="mt-5 flex flex-col-reverse gap-3 sm:flex-row sm:items-center sm:justify-between">
            <button
              type="button"
              phx-click="change_onboarding_path"
              class="min-h-[44px] px-3 py-2 text-sm text-text-tertiary hover:text-text-secondary"
            >
              Back to choices
            </button>
            <button
              type="button"
              phx-click="create_improvement"
              phx-disable-with="Creating..."
              class="cta-glow min-h-[44px] rounded-button bg-brand px-5 py-2.5 text-sm font-510 text-on-primary transition-colors hover:bg-accent-hover"
            >
              Create improvement
            </button>
          </div>
        </div>
      </div>
      
<!-- Blueprint step -->
      <div :if={@onboarding_path == :start and @current_step == 0} class="ember-glass p-6 mb-6">
        <form id="blueprint-search-form" phx-change="filter_blueprints" class="mb-3">
          <div class="flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
            <div class="min-w-0 flex-1">
              <label class="block text-xs font-510 text-text-tertiary mb-1.5">
                Search blueprints
              </label>
              <input
                type="search"
                name="blueprint_query"
                value={@blueprint_query}
                placeholder="Security, content, sales, training..."
                class="w-full rounded-lg border border-border bg-surface px-3 py-2 text-sm text-text-primary placeholder:text-text-quaternary focus:border-accent focus:outline-none"
              />
            </div>
            <p class="shrink-0 text-xs text-text-quaternary">
              {length(@filtered_blueprints)} of {length(@blueprints)}
            </p>
          </div>
        </form>

        <form id="blueprint-form" phx-change="update_company_form">
          <div class="mb-2 flex items-center justify-between gap-3">
            <label class="block text-xs font-510 text-text-tertiary">Company blueprint</label>
            <span class="text-[11px] text-text-quaternary">
              Creates agents and first issues
            </span>
          </div>
          <div class="grid min-w-0 grid-cols-1 max-h-[42vh] gap-2 overflow-y-auto pr-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5">
            <label
              :for={blueprint <- @filtered_blueprints}
              class={[
                "onboarding-blueprint-card group flex min-h-[118px] w-full min-w-0 max-w-full cursor-pointer flex-col justify-between rounded-lg border bg-surface px-3 py-3 text-left transition",
                if(@company_form["blueprint"] == blueprint.key,
                  do: "border-brand/60 bg-brand/10",
                  else: "border-border hover:border-border-hover hover:bg-surface-hover"
                )
              ]}
            >
              <input
                type="radio"
                name="company[blueprint]"
                value={blueprint.key}
                checked={@company_form["blueprint"] == blueprint.key}
                class="onboarding-blueprint-input sr-only"
              />
              <span class="min-w-0 break-words text-sm font-590 leading-5 text-text-primary">
                {blueprint.name}
              </span>
              <span
                class="mt-1 block w-full min-w-0 truncate text-[11px] leading-4 text-text-tertiary"
                title={blueprint.role_summary}
              >
                {blueprint.role_summary}
              </span>
              <span class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-1 text-[11px] font-510 text-text-quaternary">
                <span
                  class="inline-flex items-center gap-1"
                  title={"#{blueprint.default_agent_count} agents"}
                >
                  <span class="hero-user-group-mini h-3.5 w-3.5"></span>
                  {blueprint.default_agent_count}
                </span>
                <span
                  class="inline-flex items-center gap-1"
                  title={"#{blueprint.seed_issue_count} starter issues"}
                >
                  <span class="hero-clipboard-document-list-mini h-3.5 w-3.5"></span>
                  {blueprint.seed_issue_count}
                </span>
              </span>
            </label>
          </div>
          <div
            :if={Enum.empty?(@filtered_blueprints)}
            class="rounded-lg border border-border bg-surface px-3 py-6 text-center text-sm text-text-tertiary"
          >
            No matching blueprints.
          </div>
        </form>
      </div>
      
<!-- Company step -->
      <div :if={@onboarding_path == :start and @current_step == 1} class="ember-glass p-6 mb-6">
        <form id="company-step-form" phx-change="update_company_form" class="space-y-4">
          <div>
            <label class="block text-xs font-510 text-text-tertiary mb-1.5">Company name</label>
            <input
              name="company[name]"
              value={@company_form["name"]}
              class="w-full rounded-lg border border-border bg-surface px-3 py-2 text-sm text-text-primary placeholder:text-text-quaternary focus:border-accent focus:outline-none"
            />
          </div>
          <div>
            <label class="block text-xs font-510 text-text-tertiary mb-1.5">Company goal</label>
            <textarea
              name="company[goal_title]"
              rows="3"
              class="w-full rounded-lg border border-border bg-surface px-3 py-2 text-sm text-text-primary placeholder:text-text-quaternary focus:border-accent focus:outline-none"
            >{@company_form["goal_title"]}</textarea>
          </div>
          <div>
            <label class="block text-xs font-510 text-text-tertiary mb-1.5">Project name</label>
            <input
              name="company[project_name]"
              value={@company_form["project_name"]}
              maxlength="255"
              class="w-full rounded-lg border border-border bg-surface px-3 py-2 text-sm text-text-primary placeholder:text-text-quaternary focus:border-accent focus:outline-none"
            />
            <p class="mt-1 text-xs text-text-quaternary">
              The first project your agents work in — you can rename it later in project settings.
            </p>
          </div>
          <div id="onboarding-issue-prefix" class="ui-advanced-only max-w-[200px]">
            <label class="block text-xs font-510 text-text-tertiary mb-1.5">Issue prefix</label>
            <input
              name="company[issue_prefix]"
              value={@company_form["issue_prefix"]}
              maxlength="7"
              class="w-full rounded-lg border border-border bg-surface px-3 py-2 text-sm text-text-primary focus:border-accent focus:outline-none"
            />
          </div>
        </form>
      </div>
      
<!-- Team step -->
      <div :if={@onboarding_path == :start and @current_step == 2} class="ember-glass p-6 mb-6">
        <div class="mb-5 grid gap-2 sm:grid-cols-2">
          <div class="rounded-lg border border-brand/40 bg-brand/10 px-4 py-3">
            <p class="text-sm font-590 text-text-primary">CEO</p>
            <p class="mt-0.5 text-xs text-text-tertiary">
              Owns the goal, sets direction, and hands work to the team.
            </p>
          </div>
          <div class="rounded-lg border border-brand/40 bg-brand/10 px-4 py-3">
            <p class="text-sm font-590 text-text-primary">CTO</p>
            <p class="mt-0.5 text-xs text-text-tertiary">
              Turns the plan into concrete work and reviews what's done.
            </p>
          </div>
        </div>
        <p class="mb-4 text-xs text-text-quaternary">
          Also on the team: {selected_blueprint(@blueprints, @company_form).role_summary}
        </p>

        <form id="team-step-form" phx-change="update_company_form" class="space-y-4">
          <div class="max-w-[200px]">
            <label class="block text-xs font-510 text-text-tertiary mb-1.5">Engineers</label>
            <input
              type="number"
              min="0"
              max="8"
              name="company[engineer_count]"
              value={@company_form["engineer_count"]}
              class="w-full rounded-lg border border-border bg-surface px-3 py-2 text-sm text-text-primary focus:border-accent focus:outline-none"
            />
          </div>
          <div :if={engineer_count(@company_form) > 0} class="grid gap-2 sm:grid-cols-2">
            <div :for={index <- 1..engineer_count(@company_form)}>
              <label class="block text-xs font-510 text-text-tertiary mb-1.5">
                Engineer {index} name
              </label>
              <input
                name="company[engineer_names][]"
                value={engineer_name_value(@company_form, index)}
                class="w-full rounded-lg border border-border bg-surface px-3 py-2 text-sm text-text-primary focus:border-accent focus:outline-none"
              />
            </div>
          </div>

          <fieldset class="rounded-lg border border-border p-4">
            <legend class="px-1 text-xs font-510 text-text-tertiary">AI provider</legend>
            <div class="space-y-3">
              <div class="max-w-sm">
                <select
                  name="company[adapter]"
                  aria-label="Provider"
                  class="w-full rounded-lg border border-border bg-surface px-3 py-2 text-sm text-text-primary focus:border-accent focus:outline-none"
                >
                  {Phoenix.HTML.Form.options_for_select(
                    adapter_options(),
                    @company_form["adapter"]
                  )}
                </select>
              </div>
              <div
                data-testid="onboarding-ai-advanced-fields"
                class="ui-advanced-only grid gap-3 sm:grid-cols-2"
              >
                <div>
                  <label class="block text-xs font-510 text-text-tertiary mb-1.5">Model</label>
                  <input
                    name="company[runtime_model]"
                    value={@company_form["runtime_model"]}
                    placeholder={model_placeholder(@company_form["adapter"])}
                    list={"model-suggestions-#{@company_form["adapter"]}"}
                    class="w-full rounded-lg border border-border bg-surface px-3 py-2 text-sm text-text-primary placeholder:text-text-quaternary focus:border-accent focus:outline-none"
                  />
                </div>
                <div>
                  <label class="block text-xs font-510 text-text-tertiary mb-1.5">
                    Command <span class="text-text-quaternary">(optional)</span>
                  </label>
                  <input
                    name="company[runtime_command]"
                    value={@company_form["runtime_command"]}
                    placeholder={command_placeholder(@company_form["adapter"])}
                    class="w-full rounded-lg border border-border bg-surface px-3 py-2 text-sm text-text-primary placeholder:text-text-quaternary focus:border-accent focus:outline-none"
                  />
                </div>
              </div>
            </div>
            <p class="ui-advanced-only mt-2 text-[11px] leading-4 text-text-quaternary">
              Used by every agent. Leave blank to use the defaults.
            </p>
            <p class="ui-simple-only mt-2 text-[11px] leading-4 text-text-quaternary">
              Used by every agent.
            </p>

            <button
              type="button"
              phx-click="toggle_role_overrides"
              class="ui-advanced-only mt-3 inline-flex items-center gap-1.5 text-xs font-510 text-brand hover:text-accent-hover"
            >
              <span class={[
                "hero-chevron-down-mini h-3.5 w-3.5 transition-transform",
                @company_form["role_overrides"] && "rotate-180"
              ]}>
              </span>
              {if @company_form["role_overrides"],
                do: "Use the same AI for everyone",
                else: "Choose a different AI per role"}
            </button>

            <div
              :if={@company_form["role_overrides"]}
              class="ui-advanced-only mt-3 space-y-2"
            >
              <div
                :for={
                  {role, label} <- [
                    {"ceo", "CEO"},
                    {"cto", "CTO"},
                    {"engineer", "Engineers"}
                  ]
                }
                class="grid gap-2 rounded-lg border border-border bg-surface/50 p-3 sm:grid-cols-[80px_1fr_1fr_1fr] sm:items-center"
              >
                <p class="text-sm font-590 text-text-primary">{label}</p>
                <select
                  name={"company[role_runtimes][#{role}][adapter]"}
                  aria-label={"#{label} provider"}
                  class="w-full rounded-lg border border-border bg-surface px-2.5 py-1.5 text-sm text-text-primary focus:border-accent focus:outline-none"
                >
                  {Phoenix.HTML.Form.options_for_select(
                    [{"Same as above", ""} | adapter_options()],
                    role_runtime_value(@company_form, role, "adapter")
                  )}
                </select>
                <input
                  name={"company[role_runtimes][#{role}][model]"}
                  value={role_runtime_value(@company_form, role, "model")}
                  placeholder={model_placeholder(role_runtime_adapter(@company_form, role))}
                  list={"model-suggestions-#{role_runtime_adapter(@company_form, role)}"}
                  aria-label={"#{label} model"}
                  class="w-full rounded-lg border border-border bg-surface px-2.5 py-1.5 text-sm text-text-primary placeholder:text-text-quaternary focus:border-accent focus:outline-none"
                />
                <input
                  name={"company[role_runtimes][#{role}][command]"}
                  value={role_runtime_value(@company_form, role, "command")}
                  placeholder="command (optional)"
                  aria-label={"#{label} command"}
                  class="w-full rounded-lg border border-border bg-surface px-2.5 py-1.5 text-sm text-text-primary placeholder:text-text-quaternary focus:border-accent focus:outline-none"
                />
              </div>
              <p class="text-[11px] leading-4 text-text-quaternary">
                Blank fields fall back to the shared choice above.
              </p>
            </div>

            <datalist
              :for={{value, models} <- model_suggestion_lists()}
              id={"model-suggestions-#{value}"}
            >
              <option :for={model <- models} value={model}></option>
            </datalist>
          </fieldset>
        </form>
      </div>
      
<!-- Launch step -->
      <div
        :if={@onboarding_path == :start and @current_step == 3}
        class="ember-glass card-lift p-6 mb-6"
      >
        <div class="stagger-children space-y-2 text-sm">
          <div class="flex items-center justify-between py-1.5 px-3 rounded-lg bg-surface">
            <span class="text-text-secondary">Company</span>
            <span class="text-text-primary font-590">{@company_form["name"]}</span>
          </div>
          <div class="flex items-center justify-between py-1.5 px-3 rounded-lg bg-surface">
            <span class="text-text-secondary">Blueprint</span>
            <span class="text-text-primary font-590">
              {selected_blueprint(@blueprints, @company_form).name}
            </span>
          </div>
          <div class="flex items-center justify-between gap-3 py-1.5 px-3 rounded-lg bg-surface">
            <span class="text-text-secondary">Goal</span>
            <span
              class="max-w-[280px] truncate text-text-primary"
              title={@company_form["goal_title"]}
            >
              {@company_form["goal_title"]}
            </span>
          </div>
          <div class="ui-advanced-only flex items-center justify-between py-1.5 px-3 rounded-lg bg-surface">
            <span class="text-text-secondary">Issue prefix</span>
            <span class="text-text-primary font-mono font-590">
              {@company_form["issue_prefix"]}
            </span>
          </div>
          <div class="flex items-center justify-between gap-3 py-1.5 px-3 rounded-lg bg-surface">
            <span class="text-text-secondary">Engineers</span>
            <span class="max-w-[280px] truncate text-text-primary font-590">
              {engineer_count(@company_form)}<span :if={engineer_count(@company_form) > 0}>
                · {Enum.map_join(
                  1..engineer_count(@company_form),
                  ", ",
                  &engineer_name_value(@company_form, &1)
                )}</span>
            </span>
          </div>
          <div class="flex items-center justify-between py-1.5 px-3 rounded-lg bg-surface">
            <span class="text-text-secondary">AI</span>
            <span class="text-text-primary font-590">
              {runtime_summary(@company_form["adapter"], @company_form["runtime_model"])}
            </span>
          </div>
          <div
            :for={{role, label} <- [{"ceo", "CEO"}, {"cto", "CTO"}, {"engineer", "Engineers"}]}
            :if={
              @company_form["role_overrides"] and role_runtime_customized?(@company_form, role)
            }
            class="flex items-center justify-between py-1.5 px-3 rounded-lg bg-surface"
          >
            <span class="text-text-secondary">{label} AI</span>
            <span class="text-text-primary font-590">
              {runtime_summary(
                role_runtime_adapter(@company_form, role),
                role_runtime_value(@company_form, role, "model")
              )}
            </span>
          </div>
        </div>
        <button
          type="button"
          phx-click="start_autonomous_company"
          phx-disable-with="Launching..."
          class="mt-5 w-full cta-glow rounded-button bg-brand px-4 py-2.5 text-sm font-510 text-on-primary hover:bg-accent-hover transition-colors"
        >
          Launch autonomous company
        </button>
      </div>
      
<!-- Ready step -->
      <div
        :if={@onboarding_path == :start and @current_step == 4}
        class="ember-glass card-lift p-6 mb-6"
      >
        <div class="flex flex-col gap-4">
          <div class="flex flex-col items-center gap-3 text-center">
            <div class="w-14 h-14 rounded-full bg-emerald/10 ring-1 ring-emerald/40 shadow-[0_0_30px_rgb(var(--color-success-rgb)/0.5)] flex items-center justify-center">
              <svg
                class="w-7 h-7 text-emerald"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"
                />
              </svg>
            </div>
            <p class="text-sm text-text-secondary">
              Your company, team, project, and starter issues were created. Cympho will show any provider setup still needed before agents run.
            </p>
          </div>

          <%= if @bootstrap_result do %>
            <div class="stagger-children space-y-2 text-sm">
              <div class="flex items-center justify-between py-1.5 px-3 rounded-lg bg-surface">
                <span class="text-text-secondary">Company</span>
                <span class="text-text-primary font-590">{@bootstrap_result.company.name}</span>
              </div>
              <div class="flex items-center justify-between py-1.5 px-3 rounded-lg bg-surface">
                <span class="text-text-secondary">Goal</span>
                <span
                  class="text-text-primary truncate max-w-[280px]"
                  title={@bootstrap_result.goal.title}
                >
                  {@bootstrap_result.goal.title}
                </span>
              </div>
              <div class="flex items-center justify-between py-1.5 px-3 rounded-lg bg-surface">
                <span class="text-text-secondary">Your team</span>
                <span class="text-text-primary font-590">
                  {length(@bootstrap_result.agents)} ({Enum.map_join(
                    @bootstrap_result.agents,
                    ", ",
                    &role_label(&1.role)
                  )})
                </span>
              </div>
              <div class="py-1.5 px-3">
                <span class="text-text-secondary text-xs">First issues</span>
                <div class="mt-1.5 space-y-1">
                  <%= for issue <- @bootstrap_result.seed_issues do %>
                    <div class="flex items-center gap-2">
                      <span class="text-xs text-accent font-mono">{issue.identifier}</span>
                      <span class="text-xs text-text-tertiary truncate">{issue.title}</span>
                    </div>
                  <% end %>
                </div>
              </div>
            </div>
          <% else %>
            <p class="text-sm text-text-tertiary text-center">
              You're ready to start using Cympho. Create your first project or jump straight to the issue board.
            </p>
          <% end %>

          <div class="border-t border-border pt-4">
            <p class="mb-3 text-xs text-text-quaternary">
              A few keys that make Cympho faster to move around:
            </p>
            <div class="stagger-children space-y-3">
              <div class="flex items-center justify-between text-sm">
                <span class="text-text-secondary">Command palette</span>
                <div class="flex gap-1"><kbd class="kbd">Cmd</kbd><kbd class="kbd">K</kbd></div>
              </div>
              <div class="flex items-center justify-between text-sm">
                <span class="text-text-secondary">New issue</span>
                <kbd class="kbd">C</kbd>
              </div>
              <div class="flex items-center justify-between text-sm">
                <span class="text-text-secondary">Go to Issues</span>
                <div class="flex gap-1"><kbd class="kbd">G</kbd><kbd class="kbd">I</kbd></div>
              </div>
              <div class="flex items-center justify-between text-sm">
                <span class="text-text-secondary">Go to Board</span>
                <div class="flex gap-1"><kbd class="kbd">G</kbd><kbd class="kbd">K</kbd></div>
              </div>
              <div class="flex items-center justify-between text-sm">
                <span class="text-text-secondary">Show shortcuts</span>
                <kbd class="kbd">?</kbd>
              </div>
            </div>
          </div>

          <div class="flex gap-3 w-full pt-2">
            <.link
              :if={@bootstrap_result}
              href={"/switch-company/#{@bootstrap_result.company.id}?return_to=/issues"}
              class="flex-1 text-center cta-glow bg-brand hover:bg-accent text-on-primary font-590 text-sm px-4 py-2.5 rounded-button transition-colors"
            >
              Enter Cympho
            </.link>
          </div>
        </div>
      </div>

      <div
        :if={@onboarding_path == :improve and @bootstrap_result}
        class="ember-glass card-lift mb-6 p-6"
      >
        <div class="mx-auto max-w-2xl text-center">
          <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-emerald/10 ring-1 ring-emerald/40">
            <span class="hero-check-mini h-7 w-7 text-emerald"></span>
          </div>
          <h1 class="ember-ink mt-4 font-serif text-3xl font-510">Improvement ready</h1>
          <p class="mt-2 text-sm leading-6 text-text-secondary">
            The goal and its first issue were added to {@bootstrap_result.company.name}. No new company was created.
          </p>
        </div>

        <div class="mt-6 space-y-2 text-sm">
          <div class="flex items-center justify-between gap-3 rounded-lg bg-surface px-3 py-2">
            <span class="text-text-secondary">Goal</span>
            <span class="truncate font-590 text-text-primary">
              {@bootstrap_result.goal.title}
            </span>
          </div>
          <div class="flex items-center justify-between gap-3 rounded-lg bg-surface px-3 py-2">
            <span class="text-text-secondary">First issue</span>
            <span class="truncate font-590 text-text-primary">
              {@bootstrap_result.issue.identifier || "Issue"} · {@bootstrap_result.issue.title}
            </span>
          </div>
        </div>

        <.link
          navigate={~p"/issues/#{@bootstrap_result.issue.id}"}
          class="cta-glow mt-5 block w-full rounded-button bg-brand px-4 py-2.5 text-center text-sm font-590 text-on-primary transition-colors hover:bg-accent"
        >
          Open improvement
        </.link>
      </div>
      
<!-- Navigation buttons -->
      <div :if={@onboarding_path == :start} class="flex items-center justify-between">
        <button
          :if={@current_step > 0 && @current_step < 4}
          type="button"
          phx-click="prev_step"
          class="text-sm text-text-tertiary hover:text-text-secondary transition-colors px-3 py-2 min-h-[44px]"
        >
          Back
        </button>
        <button
          :if={@current_step == 0 && @current_company}
          type="button"
          phx-click="change_onboarding_path"
          class="min-h-[44px] px-3 py-2 text-sm text-text-tertiary transition-colors hover:text-text-secondary"
        >
          Back to choices
        </button>
        <button
          :if={@current_step == 0 && @current_company}
          type="button"
          phx-click="skip"
          class="text-sm text-text-quaternary hover:text-text-tertiary transition-colors px-3 py-2 min-h-[44px]"
        >
          Skip setup
        </button>
        <div class="flex items-center gap-3 ml-auto">
          <button
            :if={@current_step < 3}
            type="button"
            phx-click="next_step"
            class="cta-glow bg-brand hover:bg-accent text-on-primary font-510 text-sm px-5 py-2.5 rounded-button transition-colors min-h-[44px]"
          >
            Continue
          </button>
        </div>
      </div>
    </div>
  </div>
</div>
