<% blueprint = selected_blueprint(@blueprints, @company_form)
crew = crew(blueprint, @company_form)
start? = @onboarding_path == :start
step = Enum.at(@steps, @current_step)
short_name = blueprint_short_name(blueprint.name)
adapter = sanitize_adapter(@company_form["adapter"])
prefix = @company_form["issue_prefix"]

heading =
  cond do
    start? -> step.title
    @onboarding_path == :improve and @bootstrap_result -> "Improvement ready"
    @onboarding_path == :improve -> "Improve #{@current_company.name}"
    true -> "Get started"
  end %>
<%!-- Onboarding draws its own chrome (the root layout's shell is bare): the setup bar,
     the step list, then one Next step pair per step (build-spec §9). --%>
<div class="ob" data-page="onboarding" data-ui-complex-page>
  <div class="ob-bar">
    <span class="ob-brand"><span class="tile-co" aria-hidden="true">Cy</span>Cympho</span>
    <span :if={start?} class="ob-step">
      <span class="ob-sep" aria-hidden="true">/</span><span>Step {@current_step + 1} of {length(@steps)}</span>
    </span>
    <span class="ob-sp"></span>
    <a class="ob-help" href="/docs"><.r3_icon name="i-question" />Help</a>
    <details class="ob-acct">
      <summary>
        <span class="av" aria-hidden="true">{user_initials(@current_user)}</span>
        <span class="sr">{@current_user.name || @current_user.email}, account</span>
      </summary>
      <div class="menu">
        <a href="/docs">Help</a>
        <.link href={~p"/logout"} method="delete">Sign out</.link>
      </div>
    </details>
  </div>

  <div class="frame">
    <header :if={start?} class="ctx ob-h">
      <nav class="so" aria-label="Setup steps">
        <p class="so-m">
          Step {@current_step + 1} of {length(@steps)}<span aria-hidden="true"> · </span>{step.label}
        </p>
        <ol>
          <li
            :for={{s, index} <- Enum.with_index(@steps)}
            class={
              case step_state(index, @current_step) do
                :done -> "dn"
                :current -> "cu"
                :todo -> nil
              end
            }
          >
            <%= case step_state(index, @current_step) do %>
              <% :done -> %>
                <button
                  :if={is_nil(@bootstrap_result)}
                  type="button"
                  phx-click="go_to_step"
                  phx-value-step={index}
                >
                  <.status_glyph kind={:done} big /><span class="sl">{s.label}</span><span class="sr">, done</span>
                </button>
                <span :if={@bootstrap_result}>
                  <.status_glyph kind={:done} big /><span class="sl">{s.label}</span><span class="sr">, done</span>
                </span>
              <% :current -> %>
                <span aria-current="step">
                  <span class="sn mono">{index + 1}</span><span class="sl">{s.label}</span>
                </span>
              <% :todo -> %>
                <span>
                  <span class="sn mono">{index + 1}</span><span class="sl">{s.label}</span>
                </span>
            <% end %>
          </li>
        </ol>
      </nav>
    </header>

    <div class="head">
      <h1 class="h1 big">{heading}</h1>
    </div>

    <div class="tray">
      <%!-- Start or improve: only for owners who already have a company. --%>
      <section :if={is_nil(@onboarding_path)} class="next" aria-labelledby="ob-t">
        <article class="paper">
          <p class="eyebrow">Guided setup</p>
          <h2 class="nt" id="ob-t">What would you like to do?</h2>
          <.ob_error :if={@step_error} message={@step_error} />
          <p class="obj">
            Start another company, or turn one improvement for {@current_company.name} into ready work.
          </p>
          <div class="ob-choices">
            <button
              type="button"
              class="opt"
              phx-click="select_onboarding_path"
              phx-value-path="start"
            >
              <span class="on" aria-hidden="true">1</span><span class="ot2">Start a company<small>Choose a template, name the team and launch its first tasks.</small></span>
            </button>
            <button
              type="button"
              class="opt"
              phx-click="select_onboarding_path"
              phx-value-path="improve"
            >
              <span class="on" aria-hidden="true">2</span><span class="ot2">Improve this company<small>Add one goal and its first task to {@current_company.name}; no new company is created.</small></span>
            </button>
          </div>
          <div class="pf">
            <button type="button" class="ul" phx-click="skip">Skip setup</button>
          </div>
        </article>
      </section>

      <%!-- Improve: one goal and one CEO task in the current company. --%>
      <section
        :if={@onboarding_path == :improve and is_nil(@bootstrap_result)}
        class="next"
        aria-labelledby="ob-t"
      >
        <article class="paper">
          <p class="eyebrow">Improvement</p>
          <h2 class="nt" id="ob-t">Turn one outcome into ready work</h2>
          <.ob_error :if={@step_error} message={@step_error} />
          <p class="obj">
            Cympho adds a goal and one task for the CEO to {@current_company.name}. No new company is created.
          </p>
          <form id="improve-company-form" phx-change="update_company_form" class="flds">
            <.ob_field
              id="ob-improve-goal"
              class="full"
              label="What should improve?"
              name="company[goal_title]"
              value={@company_form["goal_title"]}
              maxlength="255"
              placeholder="Improve activation for new customers"
            />
            <div class="fld full">
              <label for="ob-improve-details">Helpful context (optional)</label>
              <textarea
                id="ob-improve-details"
                name="company[improvement_details]"
                rows="4"
                maxlength="2000"
                aria-describedby="ob-improve-help"
              >{@company_form["improvement_details"]}</textarea>
              <p class="help" id="ob-improve-help">
                The customer problem, the outcome you want and how to check it. Never paste credentials or secrets.
              </p>
            </div>
          </form>
        </article>
        <article class="ink" aria-labelledby="ob-i">
          <h3 class="ink-h" id="ob-i">After you create it</h3>
          <.consequences rows={[
            {:done, "A goal and its first task are added to #{@current_company.name}."},
            {:idle, "The CEO turns it into scoped work."}
          ]} />
          <.ink_foot verb="create">
            <:secondary>
              <.ghost_pill phx-click="change_onboarding_path">Back to choices</.ghost_pill>
            </:secondary>
            <:primary>
              <.primary_pill phx-click="create_improvement" phx-disable-with="Creating…">
                Create improvement
              </.primary_pill>
            </:primary>
          </.ink_foot>
        </article>
      </section>

      <section
        :if={@onboarding_path == :improve and @bootstrap_result}
        class="next"
        aria-labelledby="ob-t"
      >
        <article class="paper">
          <p class="eyebrow">Ready</p>
          <h2 class="nt" id="ob-t">{@bootstrap_result.goal.title}</h2>
          <p class="obj">
            The goal and its first task were added to {@bootstrap_result.company.name}. No new company was created.
          </p>
          <.kv_list>
            <:item term="Goal">{@bootstrap_result.goal.title}</:item>
            <:item term="First task">
              <span class="mono">{@bootstrap_result.issue.identifier || "Task"}</span>
              · {@bootstrap_result.issue.title}
            </:item>
          </.kv_list>
        </article>
        <article class="ink" aria-labelledby="ob-i">
          <h3 class="ink-h" id="ob-i">Next</h3>
          <.consequences rows={[{:idle, "The CEO plans it on its task."}]} />
          <.ink_foot verb="open it">
            <:primary>
              <.primary_pill navigate={~p"/issues/#{@bootstrap_result.issue.id}"}>
                Open improvement
              </.primary_pill>
            </:primary>
          </.ink_foot>
        </article>
      </section>

      <%!-- Step 1 · Template --%>
      <section :if={start? and @current_step == 0} class="next" aria-labelledby="ob-t">
        <% shown =
          visible_templates(@filtered_blueprints, @company_form, @all_templates, @blueprint_query) %>
        <article class="paper">
          <p class="eyebrow">Template</p>
          <h2 class="nt" id="ob-t">Choose a company template</h2>
          <.ob_error :if={@step_error} message={@step_error} />
          <form
            id="blueprint-search-form"
            phx-change="filter_blueprints"
            phx-submit="filter_blueprints"
          >
            <.search_capsule
              label="Search templates"
              placeholder="Search templates"
              name="blueprint_query"
              value={@blueprint_query}
            />
          </form>
          <form id="blueprint-form" phx-change="update_company_form">
            <fieldset class="opts">
              <legend class="sr">Company template</legend>
              <div class="tpl">
                <.paper_opt
                  :for={{bp, n} <- Enum.with_index(shown, 1)}
                  id={"ob-tpl-#{bp.key}"}
                  n={n}
                  name="company[blueprint]"
                  value={bp.key}
                  checked={@company_form["blueprint"] == bp.key}
                >
                  {blueprint_short_name(bp.name)}<span class="mono">{bp.default_agent_count} agents</span>
                  <:line>{bp.role_summary}</:line>
                </.paper_opt>
              </div>
            </fieldset>
          </form>
          <p :if={shown == []} class="obj">No template matches that search.</p>
          <div class="pf">
            <span>{length(shown)} of {length(@blueprints)} templates</span>
            <button
              :if={length(shown) < length(@filtered_blueprints)}
              type="button"
              class="ul"
              phx-click="show_all_templates"
            >
              Show all {length(@blueprints)}
            </button>
          </div>
        </article>
        <article class="ink" aria-labelledby="ob-i">
          <h3 class="ink-h" id="ob-i">{short_name}</h3>
          <.crew_tiles people={crew_roles(blueprint, @company_form)} />
          <p class="ink-note">Creates {blueprint.seed_issue_count} first tasks.</p>
          <.ink_note>Next you name it and set a spending limit.</.ink_note>
          <.ink_foot verb="continue">
            <:primary>
              <.primary_pill phx-click="next_step">Continue</.primary_pill>
            </:primary>
          </.ink_foot>
        </article>
      </section>

      <%!-- Step 2 · Company --%>
      <form
        :if={start? and @current_step == 1}
        id="company-step-form"
        class="next"
        phx-change="update_company_form"
        phx-submit="next_step"
        aria-labelledby="ob-t"
      >
        <article class="paper">
          <p class="eyebrow">Company</p>
          <h2 class="nt" id="ob-t">Name your company</h2>
          <.ob_error :if={@step_error && is_nil(@error_field)} message={@step_error} />
          <div class="flds">
            <.ob_field
              id="ob-name"
              class="full"
              label="Company name"
              name="company[name]"
              value={@company_form["name"]}
              error={@error_field == :name && @step_error}
            />
            <.ob_field
              id="ob-goal"
              class="full"
              label="First goal"
              name="company[goal_title]"
              value={@company_form["goal_title"]}
              error={@error_field == :goal_title && @step_error}
              maxlength="255"
            />
            <div class="fld">
              <label for="ob-limit">Spending limit per 30 days</label>
              <span class="inp">
                <span aria-hidden="true">$</span>
                <input
                  id="ob-limit"
                  name="company[budget_monthly_usd]"
                  type="text"
                  inputmode="numeric"
                  autocomplete="off"
                  value={@company_form["budget_monthly_usd"]}
                  aria-invalid={@error_field == :budget_monthly_usd && "true"}
                  aria-describedby={
                    if @error_field == :budget_monthly_usd,
                      do: "ob-limit-h ob-limit-e",
                      else: "ob-limit-h"
                  }
                />
              </span>
              <p :if={@error_field == :budget_monthly_usd} class="err" id="ob-limit-e">
                <.r3_icon name="i-alert" />{@step_error}
              </p>
            </div>
            <p class="help full" id="ob-limit-h">
              Agents stop when the last 30 days of spend reaches this.
            </p>
            <%!-- Project and task-ID prefix follow the company name (Advanced); a field
                 that blocks the step comes back into view so Simple never dead-ends. --%>
            <.ob_field
              id="ob-project"
              class={["full", @error_field != :project_name && "ui-advanced-only"]}
              label="First project"
              name="company[project_name]"
              value={@company_form["project_name"]}
              error={@error_field == :project_name && @step_error}
              maxlength="255"
            />
            <.ob_field
              id="onboarding-issue-prefix"
              class={@error_field != :issue_prefix && "ui-advanced-only"}
              label="Task ID prefix"
              name="company[issue_prefix]"
              value={@company_form["issue_prefix"]}
              error={@error_field == :issue_prefix && @step_error}
              maxlength="7"
            />
          </div>
        </article>
        <article class="ink" aria-labelledby="ob-i">
          <h3 class="ink-h" id="ob-i">{short_name}</h3>
          <.crew_tiles people={crew_roles(blueprint, @company_form)} />
          <.ink_note>Next you choose the team and how it runs.</.ink_note>
          <.ink_foot verb="continue">
            <:secondary>
              <.ghost_pill phx-click="prev_step">Back</.ghost_pill>
            </:secondary>
            <:primary>
              <.primary_pill phx-click="next_step">Continue</.primary_pill>
            </:primary>
          </.ink_foot>
        </article>
      </form>

      <%!-- Step 3 · Team & AI: the choices, the provider's readiness and the crew, one form. --%>
      <form
        :if={start? and @current_step == 2}
        id="team-step-form"
        class="next"
        phx-change="update_company_form"
        phx-submit="next_step"
        aria-labelledby="ob-t"
      >
        <% ready = ready?(@company_form)
        rd = readiness_view(@company_form, @checking)
        price_error = price_error(@company_form)

        show_price_error =
          price_error &&
            (@error_field == :price or
               Enum.any?(["price_input", "price_output"], &present(@company_form[&1]))) %>
        <article class="paper">
          <p class="eyebrow">Team</p>
          <h2 class="nt" id="ob-t">{length(crew)} agents to start</h2>
          <.ob_error :if={@step_error && @error_field != :price} message={@step_error} />
          <p class="obj">
            The {short_name} template gives {@company_form["name"]} this team. Names are suggestions; you can rename anyone later.
          </p>
          <div class="ob-sec">
            <ul class="lead">
              <li :for={person <- Enum.filter(crew, &(&1.key in ["ceo", "cto"]))}>
                <span class="tile-ag" aria-hidden="true">{initials(person.name)}</span><span class="who2">{person.name}<small>{person.role}</small></span>
              </li>
            </ul>
            <div class="ob-also">
              <p :if={also_on_team(crew) != ""} class="also">
                Also on the team: {also_on_team(crew)}.
              </p>
              <details class="ob-ren">
                <summary>Rename the leaders</summary>
                <div class="flds">
                  <.ob_field
                    :for={
                      {key, label} <- [
                        {"ceo", "CEO"},
                        {"cto", "CTO"},
                        {"product_manager", "Product Manager"},
                        {"designer", "Designer"}
                      ]
                    }
                    id={"ob-lead-#{key}"}
                    label={"#{label} name"}
                    name={"company[leader_names][#{key}]"}
                    value={get_in(@company_form, ["leader_names", key])}
                    placeholder={leader_name(%{}, key)}
                    maxlength="120"
                  />
                </div>
              </details>
            </div>
            <div :if={engineer_count(@company_form) > 0} class="flds">
              <.ob_field
                :for={index <- 1..engineer_count(@company_form)}
                id={"company-engineer-name-#{index}"}
                label={"Engineer #{index} name"}
                name="company[engineer_names][]"
                value={engineer_name_value(@company_form, index)}
                maxlength="120"
              />
            </div>
            <div class="fld ui-advanced-only ob-count">
              <label for="company-engineer-count">Engineers</label>
              <input
                id="company-engineer-count"
                type="number"
                min="0"
                max="8"
                name="company[engineer_count]"
                value={@company_form["engineer_count"]}
              />
            </div>
          </div>
          <div class="ruler" aria-hidden="true"></div>
          <fieldset class="opts">
            <legend>AI provider</legend>
            <p class="help">
              Every agent runs on this to start. You can change it per agent later.
            </p>
            <.paper_opt
              id="ob-prov-1"
              n={1}
              name="company[adapter]"
              value="claude_code"
              checked={adapter == "claude_code"}
            >
              Claude Code<:line>Reports its own cost</:line>
            </.paper_opt>
            <.paper_opt
              id="ob-prov-2"
              n={2}
              name="company[adapter]"
              value="codex"
              checked={adapter == "codex"}
            >
              Codex (OpenAI)<:line>Reports tokens; you enter its prices</:line>
            </.paper_opt>
          </fieldset>
          <div :if={adapter == "codex"} class="flds">
            <.ob_field
              id="ob-codex-model"
              class="full"
              input_class="mono"
              label="Model"
              name="company[runtime_model]"
              value={@company_form["runtime_model"]}
              placeholder={Cympho.Adapters.CodexAdapter.default_model()}
              list="model-suggestions-codex"
            />
            <div
              :for={{key, label} <- [{"price_input", "Input"}, {"price_output", "Output"}]}
              class="fld"
            >
              <label for={"ob-#{key}"}>{label}, per 1M tokens</label>
              <span class="inp">
                <span aria-hidden="true">$</span>
                <input
                  id={"ob-#{key}"}
                  name={"company[#{key}]"}
                  type="text"
                  inputmode="decimal"
                  autocomplete="off"
                  value={@company_form[key]}
                  aria-invalid={show_price_error && is_nil(present(@company_form[key])) && "true"}
                  aria-describedby={show_price_error && "ob-price-e"}
                />
              </span>
            </div>
            <p :if={show_price_error} class="err full" id="ob-price-e">
              <.r3_icon name="i-alert" />{price_error}
            </p>
            <p class="help full">These prices are saved on all {length(crew)} agents.</p>
          </div>
          <section class="rd" aria-labelledby="ob-rd">
            <h3 class="rd-h" id="ob-rd">{rd.heading}</h3>
            <ul>
              <li :for={row <- rd.rows} class={row.kind == :stopped && "bad"}>
                <.status_glyph kind={row.kind} big /><b>{row.label}</b><span>{row.text}</span>
              </li>
            </ul>
            <div :if={rd.action} class="rd-a">
              <.pill phx-click="check_readiness" disabled={@checking}>{rd.action}</.pill>
              <a :if={rd.fix?} class="ul" href="/docs/ai-agents/cli-harnesses">How to fix this</a>
            </div>
          </section>
          <div data-testid="onboarding-ai-advanced-fields" class="ui-advanced-only flds">
            <.ob_field
              :if={adapter != "codex"}
              id="ob-model"
              label="Model"
              name="company[runtime_model]"
              value={@company_form["runtime_model"]}
              placeholder={model_placeholder(adapter)}
              list={"model-suggestions-#{adapter}"}
            />
            <.ob_field
              id="ob-command"
              label="Command (optional)"
              name="company[runtime_command]"
              value={@company_form["runtime_command"]}
              placeholder={command_placeholder(adapter)}
            />
            <p class="help full">Used by every agent. Leave blank to use the defaults.</p>
          </div>
          <div class="ui-advanced-only ob-roles">
            <button type="button" class="ul" phx-click="toggle_role_overrides">
              {if @company_form["role_overrides"],
                do: "Use the same AI for everyone",
                else: "Choose a different AI per role"}
            </button>
            <div :if={@company_form["role_overrides"]} class="ob-role-list">
              <div
                :for={
                  {role, label} <- [{"ceo", "CEO"}, {"cto", "CTO"}, {"engineer", "Engineers"}]
                }
                class="ob-role"
              >
                <span class="ob-role-n">{label}</span>
                <select
                  name={"company[role_runtimes][#{role}][adapter]"}
                  aria-label={"#{label} provider"}
                >
                  {Phoenix.HTML.Form.options_for_select(
                    [{"Same as above", ""} | adapter_options()],
                    role_runtime_value(@company_form, role, "adapter")
                  )}
                </select>
                <input
                  name={"company[role_runtimes][#{role}][model]"}
                  value={role_runtime_value(@company_form, role, "model")}
                  placeholder={model_placeholder(role_runtime_adapter(@company_form, role))}
                  list={"model-suggestions-#{role_runtime_adapter(@company_form, role)}"}
                  aria-label={"#{label} model"}
                />
                <input
                  name={"company[role_runtimes][#{role}][command]"}
                  value={role_runtime_value(@company_form, role, "command")}
                  placeholder="command (optional)"
                  aria-label={"#{label} command"}
                />
              </div>
              <p class="help">Blank fields fall back to the shared choice above.</p>
            </div>
          </div>
          <datalist
            :for={{value, models} <- model_suggestion_lists()}
            id={"model-suggestions-#{value}"}
          >
            <option :for={model <- models} value={model}></option>
          </datalist>
        </article>
        <article class="ink" aria-labelledby="ob-i">
          <h3 class="ink-h" id="ob-i">Your crew</h3>
          <.crew_tiles people={crew} />
          <dl class="ikv">
            <dt>Runs on</dt>
            <dd>
              <%= if adapter == "codex" do %>
                Codex <span class="mono">{agent_runtime(@company_form)["model"]}</span>, all {length(
                  crew
                )}
              <% else %>
                Claude Code, all {length(crew)}
              <% end %>
            </dd>
            <dt>Limit</dt>
            <dd><span class="mono">${@company_form["budget_monthly_usd"]}</span> per 30 days</dd>
            <dt>Task IDs</dt>
            <dd><span class="mono">{prefix}-1, {prefix}-2</span> …</dd>
          </dl>
          <.ink_note>
            {if ready,
              do: "Next you check everything before launch.",
              else: "Continue unlocks when every check passes."}
          </.ink_note>
          <.ink_foot verb="continue">
            <:secondary>
              <.ghost_pill phx-click="prev_step">Back</.ghost_pill>
            </:secondary>
            <:primary>
              <.primary_pill phx-click="next_step" disabled={not ready}>
                Continue to review
              </.primary_pill>
            </:primary>
          </.ink_foot>
        </article>
      </form>

      <%!-- Step 4 · Review & launch --%>
      <section :if={start? and @current_step == 3} class="next" aria-labelledby="ob-t">
        <% owner = first_task_owner(blueprint, crew) %>
        <article class="paper">
          <p class="eyebrow">Review</p>
          <h2 class="nt" id="ob-t">{@company_form["name"]} is ready to launch</h2>
          <.ob_error :if={@step_error} message={@step_error} />
          <.kv_list class="wide">
            <:item term="Template">{short_name}</:item>
            <:item term="Team">{team_line(crew)}</:item>
            <:item term="Goal">{@company_form["goal_title"]}</:item>
            <:item term="Project">
              {@company_form["project_name"]} · task IDs <span class="mono">{prefix}-1</span> …
            </:item>
            <:item term="AI">
              {if adapter == "codex",
                do: "Codex #{agent_runtime(@company_form)["model"]}",
                else: "Claude Code"} · {if ready?(@company_form),
                do: "installed, signed in, priced",
                else: "checks needed on the Team & AI step"}
            </:item>
            <:item term="Spending limit">
              <span class="mono">${@company_form["budget_monthly_usd"]}</span>
              per 30 days. Agents stop at the limit.
            </:item>
            <:item
              :for={{role, label} <- [{"ceo", "CEO"}, {"cto", "CTO"}, {"engineer", "Engineers"}]}
              :if={
                @company_form["role_overrides"] and role_runtime_customized?(@company_form, role)
              }
              term={"#{label} AI"}
            >
              {runtime_summary(
                role_runtime_adapter(@company_form, role),
                role_runtime_value(@company_form, role, "model")
              )}
            </:item>
          </.kv_list>
        </article>
        <article class="ink" aria-labelledby="ob-i">
          <h3 class="ink-h" id="ob-i">After you launch</h3>
          <.consequences rows={[
            {:done,
             "Cympho creates #{length(crew)} agents and #{blueprint.seed_issue_count} first tasks."},
            {:idle, "#{prefix}-1 starts with #{owner.name} (#{owner.role})."}
          ]} />
          <.ink_foot verb="launch">
            <:secondary>
              <.ghost_pill phx-click="prev_step">Back</.ghost_pill>
            </:secondary>
            <:primary>
              <.primary_pill phx-click="start_autonomous_company" phx-disable-with="Launching…">
                Launch {@company_form["name"]}
              </.primary_pill>
            </:primary>
          </.ink_foot>
        </article>
      </section>

      <%!-- Step 5 · Ready: what was created, and the way into Home. --%>
      <section
        :if={start? and @current_step == 4 and @bootstrap_result}
        class="next"
        aria-labelledby="ob-t"
      >
        <% result = @bootstrap_result
        first = List.first(result.seed_issues)
        last = List.last(result.seed_issues)
        lead = first && Enum.find(result.agents, &(&1.id == first.assignee_id)) %>
        <article class="paper">
          <p class="eyebrow">Ready</p>
          <h2 class="nt" id="ob-t">{result.company.name} is set up</h2>
          <ul class="launch">
            <li>
              <.status_glyph kind={:done} big color={false} />Company, goal and project created
            </li>
            <li>
              <.status_glyph kind={:done} big color={false} />{length(result.agents)} agents hired
            </li>
            <li :if={first}>
              <.status_glyph kind={:done} big color={false} />
              <span>
                {length(result.seed_issues)} first tasks,
                <span class="mono">{first.identifier}</span>
                to <span class="mono">{last.identifier}</span>
              </span>
            </li>
          </ul>
        </article>
        <article class="ink" aria-labelledby="ob-i">
          <h3 class="ink-h" id="ob-i">First result</h3>
          <.consequences
            :if={first && lead}
            rows={[
              if(@dispatcher_on,
                do:
                  {:working,
                   "#{lead.name} (#{role_label(lead.role)}) is starting #{first.identifier}: #{first.title}."},
                else:
                  {:idle,
                   "#{first.identifier} waits for #{lead.name} (#{role_label(lead.role)}): #{first.title}."}
              )
            ]}
          />
          <.ink_note :if={not @dispatcher_on}>
            Agents are switched off on this server. You can still plan and answer.
          </.ink_note>
          <.ink_foot verb="open Home">
            <:primary>
              <.primary_pill href={"/switch-company/#{result.company.id}?return_to=/"}>
                Open Home
              </.primary_pill>
            </:primary>
          </.ink_foot>
        </article>
      </section>

      <%!-- Five keys for an app the reader has not opened yet: Advanced only. --%>
      <.band_card
        :if={start? and @current_step == 4 and @bootstrap_result}
        id="ob-keys"
        title="Keys that make Cympho faster"
        class="ui-advanced-only"
      >
        <.kv_list class="ob-keys">
          <:item term="Command palette"><kbd>⌘</kbd> <kbd>K</kbd></:item>
          <:item term="New task"><kbd>C</kbd></:item>
          <:item term="Go to Tasks"><kbd>G</kbd> <kbd>I</kbd></:item>
          <:item term="Go to Board"><kbd>G</kbd> <kbd>K</kbd></:item>
          <:item term="All shortcuts"><kbd>?</kbd></:item>
        </.kv_list>
      </.band_card>
    </div>
  </div>
</div>
