<.page_frame
  page="plugin"
  kind={:deep}
  parent={{"/plugins", "Plugins"}}
  current={@page_title}
  tray_class="split"
  data-ui-complex-page
>
  <:head>
    <section class="head" aria-labelledby="pg-h">
      <h1 class="h1 big" id="pg-h">{@page_title}</h1>
      <p :if={@plugin.description not in [nil, ""]} class="sub">{@plugin.description}</p>
      <div class="chips">
        <span :if={plugin_error?(@plugin)} class="chip">
          <.status_word kind={:stopped} word="Failing" />
        </span>
        <span :if={!@plugin.enabled} class="tag">Off</span>
        <span :if={@can_manage_plugins} class="ui-advanced-only">
          <.pill
            phx-click="toggle_plugin"
            data-confirm={"#{toggle_label(@plugin)} #{@plugin.name}?"}
          >
            {toggle_label(@plugin)}
          </.pill>
        </span>
        <span :if={@can_manage_plugins} class="ui-advanced-only">
          <.pill navigate={~p"/plugins/#{@plugin.id}/edit"}>
            <.r3_icon name="i-pencil" />Edit
          </.pill>
        </span>
      </div>
    </section>
  </:head>

  <.flash_line flash={@flash} />

  <.band_card
    id="pg-over-t"
    title="Overview"
    class="ui-simple-only"
    data-testid="plugin-simple-overview"
  >
    <.kv_list class="wide">
      <:item term="Scope">{scope_label(@plugin)}</:item>
      <:item term="Permissions">{permissions_sentence(@plugin)}</:item>
    </.kv_list>
  </.band_card>

  <section class="card ui-advanced-only" data-testid="plugin-advanced-detail">
    <details
      id="plugin-manifest"
      class="tech"
      open={@live_action == :settings}
      data-open={to_string(@live_action == :settings)}
      phx-hook="ServerOpen"
      phx-mounted={JS.ignore_attributes("open")}
    >
      <summary>
        <span class="h2">{if @live_action == :settings, do: "Settings", else: "Manifest"}</span>
        <.r3_icon name="i-chev-down" />
      </summary>
      <pre class="mono sk-pre"><%= Jason.encode!(if(@live_action == :settings, do: @plugin.settings || %{}, else: @plugin.manifest || %{}), pretty: true) %></pre>
    </details>
  </section>

  <.band_card id="pg-perm-t" title="Permissions" class="ui-advanced-only">
    <div class="gl-sec">
      <p class="gl-sub">{permissions_sentence(@plugin)}</p>
      <p :if={(@plugin.capabilities || []) != []} class="sk-caps">
        <span :for={capability <- @plugin.capabilities || []} class="tag mono">{capability}</span>
      </p>
    </div>
  </.band_card>

  <.band_card id="pg-det-t" title="Details" class="aside ui-advanced-only">
    <.kv_list>
      <:item term="Identifier"><span class="mono hr-wrap">{@plugin.identifier}</span></:item>
      <:item term="Version"><span class="mono">v{@plugin.version}</span></:item>
      <:item term="Status">{status_label(@plugin.status)}</:item>
      <:item :if={@plugin.author} term="Author">{@plugin.author}</:item>
      <:item term="Scope">{scope_label(@plugin)}</:item>
    </.kv_list>
  </.band_card>

  <section :if={@can_manage_plugins} class="card ui-advanced-only" aria-label="Delete this plugin">
    <ul class="rows">
      <.list_row id="pg-delete" title="Delete this plugin">
        <:meta>Its worker stops and agents lose its tools.</:meta>
        <:actions>
          <button
            type="button"
            class="pl warn"
            phx-click="delete"
            data-confirm="Delete this plugin?"
          >
            Delete
          </button>
        </:actions>
      </.list_row>
    </ul>
  </section>
</.page_frame>
