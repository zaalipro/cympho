<.page size="wide">
  <.header title={@page_title} subtitle="Update plugin metadata, manifest, and runtime settings.">
    <:actions>
      <.app_link
        navigate={~p"/plugins/#{@plugin.id}"}
        class="rounded-lg border border-border bg-button px-4 py-2 text-sm font-510 text-text-secondary transition-colors hover:bg-button-hover hover:text-text-primary"
      >
        Back
      </.app_link>
    </:actions>
  </.header>

  <.form
    for={@form}
    phx-change="validate"
    phx-submit="save"
    class="grid gap-5 lg:grid-cols-[minmax(0,1fr)_320px] lg:items-start"
  >
    <.panel class="overflow-hidden">
      <div class="border-b border-border px-5 py-4">
        <p class="text-[11px] font-590 uppercase tracking-[0.14em] text-text-quaternary">
          Plugin capability plan
        </p>
        <h2 class="mt-1 text-lg font-590 text-text-primary">Keep the extension prompt-ready</h2>
        <p class="mt-1 max-w-3xl text-sm leading-6 text-text-tertiary">
          Update the runtime entrypoint, capability scope, and settings before agents rely on this
          plugin in autonomous work.
        </p>
      </div>

      <div class="space-y-6 p-5">
        <section class="space-y-4">
          <div>
            <p class="text-xs font-590 uppercase tracking-[0.1em] text-text-quaternary">
              Extension brief
            </p>
            <p class="mt-1 text-sm text-text-tertiary">
              Keep operator-facing metadata aligned with what the plugin actually does.
            </p>
          </div>

          <div class="grid gap-5 sm:grid-cols-2">
            <.input field={@form[:name]} label="Name" required />
            <.input field={@form[:identifier]} label="Identifier" required />
          </div>

          <.input
            type="textarea"
            field={@form[:description]}
            label="Operator brief"
            rows={4}
            placeholder="What the plugin can do, what evidence it returns, and when agents should use it."
          />
        </section>

        <section class="space-y-4 rounded-lg border border-border bg-surface/70 px-4 py-4">
          <div>
            <p class="text-xs font-590 uppercase tracking-[0.1em] text-text-quaternary">
              Runtime manifest
            </p>
            <p class="mt-1 text-sm text-text-tertiary">
              Capabilities should stay specific enough for health checks and prompt routing.
            </p>
          </div>

          <div class="grid gap-5 md:grid-cols-2">
            <.input
              name="plugin[entrypoint]"
              label="Entrypoint"
              value={CymphoWeb.PluginLive.FormHelpers.manifest_entrypoint(@form[:manifest].value)}
              placeholder="Cympho.Plugins.CustomPlugin"
              required
            />
            <.input
              name="plugin[capabilities]"
              label="Capabilities"
              value={
                CymphoWeb.PluginLive.FormHelpers.capabilities_value(@form[:capabilities].value)
              }
              placeholder="tool_access, issue_write"
            />
            <.input
              type="select"
              field={@form[:status]}
              label="Status"
              options={[
                {"Installed", "installed"},
                {"Active", "active"},
                {"Disabled", "disabled"},
                {"Error", "error"}
              ]}
            />
            <.input
              type="select"
              field={@form[:enabled]}
              label="Availability"
              value={to_string(@form[:enabled].value)}
              options={[{"Enabled", "true"}, {"Disabled", "false"}]}
            />
          </div>

          <details class="group rounded-lg border border-border bg-panel/70 px-4 py-3">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-3 [&::-webkit-details-marker]:hidden">
              <span>
                <span class="block text-xs font-510 text-text-secondary">
                  Advanced manifest JSON
                </span>
                <span class="mt-0.5 block text-sm leading-5 text-text-tertiary">
                  Keep custom host service metadata here.
                </span>
              </span>
              <span class="hero-chevron-down-mini h-4 w-4 shrink-0 text-text-tertiary transition-transform group-open:rotate-180">
              </span>
            </summary>
            <div class="mt-4 border-t border-border pt-4">
              <.input
                type="textarea"
                name="plugin[manifest_json]"
                label="Manifest JSON"
                value={CymphoWeb.PluginLive.FormHelpers.json_value(@form[:manifest].value)}
                rows={7}
                spellcheck="false"
                required
              />
            </div>
          </details>
        </section>

        <section class="space-y-4">
          <div>
            <p class="text-xs font-590 uppercase tracking-[0.1em] text-text-quaternary">
              Scope and settings
            </p>
            <p class="mt-1 text-sm text-text-tertiary">
              Scope plugins before assigning them to agents so extension access stays auditable.
            </p>
          </div>

          <div class="grid gap-5 sm:grid-cols-2">
            <.input field={@form[:version]} label="Version" required />
            <.input field={@form[:author]} label="Author" placeholder="Cympho Labs" />
            <.input
              type="select"
              field={@form[:project_id]}
              label="Project scope"
              value={@form[:project_id].value || ""}
              options={@project_options}
            />
          </div>

          <details class="group rounded-lg border border-border bg-surface/80 px-4 py-3">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-3 [&::-webkit-details-marker]:hidden">
              <span>
                <span class="block text-xs font-510 text-text-secondary">
                  Runtime settings JSON
                </span>
                <span class="mt-0.5 block text-sm leading-5 text-text-tertiary">
                  Optional per-plugin settings saved with the installation.
                </span>
              </span>
              <span class="hero-chevron-down-mini h-4 w-4 shrink-0 text-text-tertiary transition-transform group-open:rotate-180">
              </span>
            </summary>
            <div class="mt-4 border-t border-border pt-4">
              <.input
                type="textarea"
                name="plugin[settings_json]"
                label="Settings JSON"
                value={CymphoWeb.PluginLive.FormHelpers.json_value(@form[:settings].value)}
                rows={5}
                spellcheck="false"
              />
            </div>
          </details>
        </section>
      </div>
    </.panel>

    <aside class="space-y-4">
      <section
        data-testid="plugin-setup-checklist"
        class="rounded-xl border border-border bg-panel p-4 shadow-card"
      >
        <p class="text-[11px] font-590 uppercase tracking-[0.14em] text-text-quaternary">
          Maintenance checklist
        </p>
        <div class="mt-4 space-y-3">
          <div class="flex gap-3">
            <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full border border-success/30 bg-success/10 text-xs font-590 text-success">
              1
            </span>
            <div>
              <p class="text-sm font-590 text-text-primary">Keep identity stable</p>
              <p class="mt-1 text-xs leading-5 text-text-tertiary">
                Identifier changes can break existing agent assignments.
              </p>
            </div>
          </div>
          <div class="flex gap-3">
            <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full border border-brand/30 bg-brand/10 text-xs font-590 text-brand">
              2
            </span>
            <div>
              <p class="text-sm font-590 text-text-primary">Refresh capabilities</p>
              <p class="mt-1 text-xs leading-5 text-text-tertiary">
                Match capabilities to the host services this plugin really uses.
              </p>
            </div>
          </div>
          <div class="flex gap-3">
            <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full border border-amber-500/30 bg-amber-500/10 text-xs font-590 text-amber-200">
              3
            </span>
            <div>
              <p class="text-sm font-590 text-text-primary">Review assigned agents</p>
              <p class="mt-1 text-xs leading-5 text-text-tertiary">
                After changing a plugin, confirm each assigned agent still has the right prompt fit.
              </p>
            </div>
          </div>
        </div>
      </section>

      <section class="rounded-xl border border-brand/25 bg-brand/10 p-4">
        <p class="text-[11px] font-590 uppercase tracking-[0.14em] text-brand">
          Save behavior
        </p>
        <p class="mt-2 text-sm font-590 text-text-primary">Scope is company-checked</p>
        <p class="mt-1 text-xs leading-5 text-text-tertiary">
          Project scope changes are accepted only when the project belongs to the current company.
        </p>
      </section>
    </aside>

    <div class="flex flex-col-reverse gap-2 border-t border-border pt-4 sm:flex-row sm:items-center sm:justify-end lg:col-span-2">
      <.app_link
        navigate={~p"/plugins/#{@plugin.id}"}
        class="inline-flex min-h-[40px] items-center justify-center rounded-lg border border-border bg-button px-4 py-2 text-sm font-510 text-text-secondary transition-colors hover:bg-button-hover hover:text-text-primary"
      >
        Cancel
      </.app_link>
      <.button type="submit" variant="primary" class="min-h-[40px] w-full sm:w-auto">
        Save Changes
      </.button>
    </div>
  </.form>
</.page>
