<.page_frame
  page="plugin-form"
  kind={:deep}
  parent={{"/plugins", "Plugins"}}
  current="Edit plugin"
  data-ui-complex-page
>
  <:head>
    <section class="head" aria-labelledby="pf-h">
      <h1 class="h1 big" id="pf-h">{@page_title}</h1>
    </section>
  </:head>

  <.flash_line flash={@flash} />

  <CymphoWeb.PluginLive.FormHelpers.plugin_form
    form={@form}
    project_options={@project_options}
    heading="After you save"
    effect={[{:done, "If its worker is running, it restarts with the new settings."}]}
    submit="Save plugin"
    cancel={~p"/plugins/#{@plugin.id}"}
  />
</.page_frame>
