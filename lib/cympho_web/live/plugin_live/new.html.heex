<.page_frame
  page="plugin-form"
  kind={:deep}
  parent={{"/plugins", "Plugins"}}
  current="New plugin"
  data-ui-complex-page
>
  <:head>
    <section class="head" aria-labelledby="pf-h">
      <h1 class="h1 big" id="pf-h">New plugin</h1>
      <p class="sub">Register a company or project plugin for agent runtime.</p>
    </section>
  </:head>

  <.flash_line flash={@flash} />

  <CymphoWeb.PluginLive.FormHelpers.plugin_form
    form={@form}
    project_options={@project_options}
    heading="After you create it"
    effect={[
      {:done, "It is registered for this company only."},
      {:idle, "Agents use it once you assign it to them."}
    ]}
    submit="Create plugin"
    cancel={~p"/plugins"}
  />
</.page_frame>
