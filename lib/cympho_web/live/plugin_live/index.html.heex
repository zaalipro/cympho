<.settings_layout active={:plugins}>
  <.flash_line flash={@flash} />

  <.band_card id="pl-list-t" title="Plugins">
    <:header_end>
      <span class="hr-end">
        <.filter_menu
          id="plugin-filter"
          active={
            plugin_filter_count(@selected_company_id, @selected_status, @default_company_id)
          }
        >
          <form id="plugin-filter-form" phx-change="filter" phx-submit="filter" class="pl-flt">
            <.input
              type="select"
              id="plugin-filter-company"
              name="company_id"
              label="Company"
              value={@selected_company_id || @default_company_id || ""}
              options={Enum.map(@companies, &{&1.name, &1.id})}
            />
            <.input
              type="select"
              id="plugin-filter-status"
              name="status"
              label="Status"
              value={@selected_status || ""}
              options={[
                {"All statuses", ""},
                {"Installed", "installed"},
                {"Active", "active"},
                {"Disabled", "disabled"},
                {"Error", "error"}
              ]}
            />
          </form>
          <.text_link
            :if={
              plugin_filters_active?(@selected_company_id, @selected_status, @default_company_id)
            }
            navigate={~p"/plugins"}
            arrow={false}
          >
            Clear filters
          </.text_link>
        </.filter_menu>
        <.pill navigate={~p"/plugins/marketplace"}>Catalog</.pill>
        <.pill :if={@can_manage_plugins} navigate={~p"/plugins/new"}>
          <.r3_icon name="i-plus" />New plugin
        </.pill>
      </span>
    </:header_end>

    <.infinite_scroll
      id="plugins"
      has_more={@infinite_scroll[:plugins][:has_more?] || false}
      container_class="rows"
    >
      <:empty>
        <.quiet_empty
          title={plugin_empty_title(@selected_company_id, @selected_status, @default_company_id)}
          data-testid="plugins-empty"
        >
          {plugin_empty_detail(@selected_company_id, @selected_status, @default_company_id)}
          <:action>
            <span class="pl-acts">
              <.pill
                :if={
                  plugin_filters_active?(
                    @selected_company_id,
                    @selected_status,
                    @default_company_id
                  )
                }
                navigate={~p"/plugins"}
              >
                Clear filters
              </.pill>
              <.pill navigate={~p"/plugins/marketplace"}>Browse marketplace</.pill>
              <.pill :if={@can_manage_plugins} navigate={~p"/plugins/new"}>New plugin</.pill>
            </span>
          </:action>
        </.quiet_empty>
      </:empty>

      <.list_row
        :for={{dom_id, plugin} <- @streams.plugins}
        tag="div"
        id={dom_id}
        title={plugin.name}
        navigate={~p"/plugins/#{plugin.id}"}
        icon="i-term"
        status={plugin_error?(plugin) && {:stopped, "Failing"}}
      >
        <:meta>
          <span class="mono">{plugin.identifier}</span><span aria-hidden="true"> · </span><span class="mono">v{plugin.version}</span><span aria-hidden="true"> · </span>{capability_label(
            plugin.capabilities
          )}
        </:meta>
        <:trail :if={!plugin.enabled}><span class="tag">Off</span></:trail>
        <:actions>
          <.pill
            :if={can_manage_plugin?(@current_user, @current_company, plugin)}
            phx-click="toggle_plugin"
            phx-value-id={plugin.id}
            data-confirm={"#{toggle_label(plugin)} #{plugin.name}?"}
          >
            {toggle_label(plugin)}
          </.pill>
          <.overflow_menu id={"plugin-menu-#{plugin.id}"} label={"More for #{plugin.name}"}>
            <.menu_item navigate={~p"/plugins/#{plugin.id}/settings"}>Settings</.menu_item>
            <.menu_item
              :if={can_manage_plugin?(@current_user, @current_company, plugin)}
              navigate={~p"/plugins/#{plugin.id}/edit"}
            >
              Edit
            </.menu_item>
            <.menu_item
              :if={can_manage_plugin?(@current_user, @current_company, plugin)}
              danger
              phx-click="delete"
              phx-value-id={plugin.id}
              data-confirm="Delete this plugin?"
            >
              Delete
            </.menu_item>
          </.overflow_menu>
        </:actions>
        <:below :if={capability_count(plugin.capabilities) > 0}>
          <details
            id={"plugin-capabilities-#{plugin.id}"}
            class="earlier"
            phx-mounted={JS.ignore_attributes("open")}
          >
            <summary>What this plugin can do<.r3_icon name="i-chev-down" /></summary>
            <p class="gl-sub pl-can">
              This plugin can: {humanized_capabilities(plugin.capabilities)}.
            </p>
          </details>
        </:below>
      </.list_row>
    </.infinite_scroll>
  </.band_card>

  <CymphoWeb.SkillLive.HealthBand.health_band
    :if={@plugin_health.metrics.total_plugins > 0}
    id="pl-health-t"
    title="Plugin health"
    data-testid="plugin-health"
    health={@plugin_health}
    cells={[
      {"Enabled", @plugin_health.metrics.enabled_plugins},
      {"Errors",
       @plugin_health.metrics.status_error_plugins + @plugin_health.metrics.manifest_error_plugins},
      {"Capability gaps", @plugin_health.metrics.capabilityless_enabled_plugins},
      {"Failing webhooks", @plugin_health.metrics.failing_webhooks}
    ]}
    next_path={plugin_next_action_path(@plugin_health.next_action)}
    next_testid="plugin-next-action"
  >
    Recent error logs: <span class="mono">{@plugin_health.metrics.recent_error_logs}</span>
  </CymphoWeb.SkillLive.HealthBand.health_band>
</.settings_layout>
