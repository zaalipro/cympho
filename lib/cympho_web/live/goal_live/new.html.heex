<.page_frame
  page="goal-form"
  kind={:deep}
  parent={{"/goals", "Goals"}}
  current="New goal"
  data-ui-complex-page
>
  <:head>
    <section class="head" aria-labelledby="gf-h">
      <h1 class="h1 big" id="gf-h">New goal</h1>
      <p class="sub">An outcome the company works toward. Tasks link back to it.</p>
    </section>
  </:head>

  <.flash_line flash={@flash} />

  <.goal_form
    form={@form}
    goal_type_options={@goal_type_options}
    parent_goal_options={@parent_goal_options}
    project_options={@project_options}
    submit="Create goal"
    cancel={~p"/goals"}
  />
</.page_frame>
