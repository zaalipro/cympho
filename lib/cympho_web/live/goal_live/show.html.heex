<.page_frame
  page="goal"
  kind={:deep}
  parent={{"/goals", "Goals"}}
  current={@goal.title}
  tray_class="split"
  data-ui-complex-page
>
  <:head>
    <section class="head" aria-labelledby="g-h">
      <h1 class="h1 big" id="g-h">{@goal.title}</h1>
      <p :if={@goal.description not in [nil, ""]} class="sub gl-desc">{@goal.description}</p>
      <div class="chips">
        <span :if={@goal.status != "active"} class="tag">{String.capitalize(@goal.status)}</span>
        <CymphoWeb.IssueLive.Tasks.priority priority={priority_atom(@goal.priority)} />
        <.pill navigate={~p"/goals/#{@goal.id}/edit"}><.r3_icon name="i-pencil" />Edit</.pill>
      </div>
    </section>
  </:head>

  <.flash_line flash={@flash} />

  <% summary = goal_summary(@status_counts) %>
  <% {recent, earlier} = Enum.split_with(@issues, &recent_issue?/1) %>

  <.band_card :if={summary.total > 0} id="goal-progress-t" title="Progress">
    <:header_end>
      <span class="meta">{summary.percent}% complete</span>
    </:header_end>
    <div class="strip s4">
      <div class="cell">
        <span class="v mono">{summary.done}</span><span class="l">Done</span>
      </div>
      <div class="cell">
        <span class="v mono">{summary.open}</span><span class="l">Open</span>
      </div>
      <div class="cell">
        <span class="v mono">{summary.in_review}</span><span class="l">In review</span>
      </div>
      <div class="cell">
        <span class="v mono">{summary.blocked}</span><span class="l">Blocked</span>
      </div>
    </div>
  </.band_card>

  <.band_card id="goal-work-t" title="Linked work">
    <:header_end :if={@issues != []}>
      <span class="meta"><span class="mono">{length(@issues)}</span> shown</span>
    </:header_end>
    <.quiet_empty :if={@issues == []} title="Nothing linked yet">
      Link a task to this goal and its progress shows here.
    </.quiet_empty>
    <p :if={recent != []} class="gh gl-gh">Moved this week</p>
    <ul :if={recent != []} class="rows">
      <.goal_issue_row :for={issue <- recent} issue={issue} />
    </ul>
    <p :if={earlier != []} class="gh gl-gh">Earlier</p>
    <ul :if={earlier != []} class="rows">
      <.goal_issue_row :for={issue <- earlier} issue={issue} />
    </ul>
  </.band_card>

  <.band_card id="goal-details-t" title="Details" class="aside">
    <.kv_list class="wide">
      <:item term="Type">{goal_type_label(@goal.goal_type)}</:item>
      <:item term="Target">
        <span :if={@goal.target_date}>
          {Calendar.strftime(@goal.target_date, "%a %-d %b %Y")}
        </span>
        <span :if={!@goal.target_date}>No target date</span>
      </:item>
      <:item term="Created">
        {Calendar.strftime(@goal.inserted_at, "%a %-d %b")}
        <span class="mono">{Calendar.strftime(@goal.inserted_at, "%H:%M")}</span>
      </:item>
    </.kv_list>
  </.band_card>
</.page_frame>
