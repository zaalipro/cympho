<.page_frame page="goals" title="Goals" data-ui-complex-page data-density={@digest_density}>
  <:header_end>
    <.pill navigate={~p"/goals/new"}><.r3_icon name="i-plus" />New goal</.pill>
  </:header_end>

  <.flash_line flash={@flash} />

  <.band_card id="goals-list-t" title="Goals">
    <:header_end>
      <span class="ui-advanced-only">
        <.density_switch
          density={@digest_density}
          compact_patch={goal_index_url("compact")}
          detailed_patch={goal_index_url("detailed")}
        />
      </span>
    </:header_end>
    <.infinite_scroll
      id="goals"
      has_more={@infinite_scroll[:goals][:has_more?] || false}
      container_class="rows"
    >
      <:empty>
        <.quiet_empty title="No goals yet">
          Set the outcome the team works toward; tasks link back to it.
          <:action>
            <.pill navigate={~p"/goals/new"}>New goal</.pill>
          </:action>
        </.quiet_empty>
      </:empty>

      <%= for {dom_id, goal} <- @streams.goals do %>
        <% health = goal_health(@goal_work_health, goal.id) %>
        <.list_row
          tag="div"
          id={dom_id}
          title={goal.title}
          navigate={~p"/goals/#{goal.id}"}
          status={goal_status(goal, health)}
        >
          <:meta>
            {goal_type_label(goal.goal_type)}<span :if={@project_names[goal.project_id]}><span aria-hidden="true"> · </span>{@project_names[goal.project_id]}</span>
            <span :if={goal.target_date}>
              <span aria-hidden="true"> · </span>Target {Calendar.strftime(
                goal.target_date,
                "%a %-d %b"
              )}
            </span>
            <span aria-hidden="true"> · </span><span
              :if={health.total > 0}
              class="mono"
            >{health.done}/{health.total} tasks</span><span :if={health.total == 0}>No tasks linked yet</span>
          </:meta>
          <:trail>
            <span :if={goal.status != "active"} class="tag">
              {String.capitalize(goal.status)}
            </span>
            <span :if={health.total > 0} class="mono">{health.progress_percent}%</span>
          </:trail>
          <:actions>
            <.overflow_menu id={"goal-menu-#{goal.id}"} label={"Actions for #{goal.title}"}>
              <.menu_item navigate={~p"/goals/#{goal.id}/edit"}>Edit</.menu_item>
              <.menu_item
                danger
                phx-click="delete_goal"
                phx-value-id={goal.id}
                data-confirm="Delete this goal?"
              >
                Delete
              </.menu_item>
            </.overflow_menu>
          </:actions>
        </.list_row>
      <% end %>
    </.infinite_scroll>
  </.band_card>

  <.band_card
    id="goal-overview-t"
    title="Goals overview"
    class="ui-advanced-only"
    data-testid="goal-command"
  >
    <:header_end><span class="meta">{@goal_command.badge}</span></:header_end>
    <div class="gl-sec">
      <p class="gl-big">{@goal_command.heading}</p>
      <p class="gl-sub">{@goal_command.detail}</p>
      <p :if={@goal_command.focus_label} class="gl-sub">
        {@goal_command.focus_label}<span :if={@goal_command.focus_detail}><span aria-hidden="true"> · </span>{@goal_command.focus_detail}</span>
      </p>
      <.text_link navigate={@goal_command.action_path}>{@goal_command.action_label}</.text_link>
    </div>
    <div class="strip s4">
      <div class="cell">
        <span class="v mono">{@goal_command.floating_count}</span><span class="l">Needs link</span>
      </div>
      <div class="cell">
        <span class="v mono">{@goal_command.idle_count}</span><span class="l">Idle goals</span>
      </div>
      <div class="cell">
        <span class="v mono">{@goal_command.blocked_goal_count}</span><span class="l">Blocked goals</span>
      </div>
      <div class="cell">
        <span class="v mono">{@goal_command.review_goal_count}</span><span class="l">Review goals</span>
      </div>
    </div>
  </.band_card>

  <.band_card
    :if={@digest_density == "detailed"}
    id="goal-alignment-t"
    title="Mission alignment"
    class="ui-advanced-only"
  >
    <div class="gl-sec">
      <p class="gl-big">{@alignment_summary.aligned_percent}% of open work is goal-linked</p>
      <p class="gl-sub">{alignment_status_detail(@alignment_summary.status)}</p>
    </div>
    <div class="strip s3">
      <div class="cell">
        <span class="v mono">{@alignment_summary.active_missions}</span><span class="l">Missions</span>
      </div>
      <div class="cell">
        <span class="v mono">{@alignment_summary.active_goals}</span><span class="l">Active goals</span>
      </div>
      <div class="cell">
        <span class="v mono">{@alignment_summary.floating}</span><span class="l">Floating</span>
      </div>
    </div>
  </.band_card>

  <.band_card
    :if={@digest_density == "detailed"}
    id="goal-risk-t"
    title="Highest-risk floating work"
    class="ui-advanced-only"
  >
    <.quiet_empty
      :if={@alignment_summary.risk_issues == []}
      title="No open unlinked tasks in this company."
    />
    <ul :if={@alignment_summary.risk_issues != []} class="rows">
      <.list_row
        :for={issue <- @alignment_summary.risk_issues}
        id={"goal-risk-#{issue.id}"}
        title={issue.title}
        navigate={~p"/issues/#{issue.id}"}
        icon="i-alert"
        kind={:problem}
      >
        <:meta>
          {issue.project_name || "No project"}<span aria-hidden="true"> · </span>{issue.assignee_name ||
            "Unassigned"}<span aria-hidden="true"> · </span>{String.capitalize(
            to_string(issue.priority)
          )}
        </:meta>
        <:below>
          <form :if={@goal_link_targets != []} phx-submit="link_issue_to_goal" class="gl-link">
            <input type="hidden" name="issue_id" value={issue.id} />
            <.input
              type="select"
              id={"goal-link-#{issue.id}"}
              name="goal_id"
              label="Link to goal"
              value={hd(@goal_link_targets).id}
              options={Enum.map(@goal_link_targets, &{&1.label, &1.id})}
            />
            <.pill type="submit">Attach</.pill>
          </form>
          <p :if={@goal_link_targets == []} class="help">
            Create an active goal before linking this work.
          </p>
        </:below>
      </.list_row>
    </ul>
  </.band_card>
</.page_frame>
