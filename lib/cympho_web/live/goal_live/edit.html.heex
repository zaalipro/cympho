<.page_frame
  page="goal-form"
  kind={:deep}
  parent={{"/goals", "Goals"}}
  current="Edit goal"
  data-ui-complex-page
>
  <:head>
    <section class="head" aria-labelledby="gf-h">
      <h1 class="h1 big" id="gf-h">Edit {@goal.title}</h1>
    </section>
  </:head>

  <.flash_line flash={@flash} />

  <.goal_form
    form={@form}
    goal_type_options={@goal_type_options}
    parent_goal_options={@parent_goal_options}
    project_options={@project_options}
    submit="Save goal"
    cancel={~p"/goals/#{@goal.id}"}
  />
</.page_frame>
