<.page_frame
  page="policy-form"
  kind={:deep}
  parent={{~p"/settings/policies", "Review steps"}}
  current="Edit review step"
  data-ui-complex-page
>
  <:head>
    <section class="head" aria-labelledby="pf-h">
      <h1 class="h1 big" id="pf-h">Edit {@execution_policy.name}</h1>
    </section>
  </:head>

  <.flash_line flash={@flash} />

  <FormHelpers.policy_form
    form={@form}
    stage_configs_text={@stage_configs_text}
    effect="Tasks that use it follow the new stages from their next hand-off."
    cancel={~p"/settings/policies/#{@execution_policy.id}"}
  />
</.page_frame>
