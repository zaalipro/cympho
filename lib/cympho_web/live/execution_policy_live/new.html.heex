<.settings_layout active={:policies}>
  <div class="space-y-5">
    <.header>
      <span class="ember-eyebrow">New guardrail</span>
      <h1 class="ember-ink mt-4 font-serif text-[clamp(30px,4.5vw,44px)] font-510 leading-[1.08] tracking-[-0.02em]">
        {@page_title}
      </h1>
      <p class="mt-2 max-w-2xl text-[15px] leading-6 text-text-tertiary">
        Create a reusable execution guardrail for autonomous issues.
      </p>
      <:actions>
        <.app_link
          navigate={~p"/settings/policies"}
          class="rounded-lg border border-border bg-button px-4 py-2 text-sm font-510 text-text-secondary transition-colors hover:bg-button-hover hover:text-text-primary"
        >
          Cancel
        </.app_link>
      </:actions>
    </.header>

    <hr class="ember-rule" />

    <.form
      id="execution-policy-form"
      for={@form}
      phx-change="validate"
      phx-submit="save"
      class="grid gap-5 2xl:grid-cols-[minmax(0,1fr)_320px] 2xl:items-start"
    >
      <input type="hidden" name="execution_policy[stage_input_mode]" value="builder" />

      <.panel class="overflow-hidden">
        <div class="border-b border-border px-5 py-4">
          <p class="font-serif text-[13px] font-510 italic tracking-[0.02em] text-brand/90">
            Governance stage plan
          </p>
          <h2 class="mt-1 font-serif text-[19px] font-510 leading-snug text-text-primary">
            Build executor, reviewer, and approver handoffs
          </h2>
          <p class="mt-1 max-w-3xl text-sm leading-6 text-text-tertiary">
            Start from a staged policy that gives every autonomous run a worker, a reviewer, and a
            final approval path before work can be considered complete.
          </p>
        </div>

        <div class="space-y-6 p-5">
          <section class="space-y-4">
            <div>
              <p class="font-serif text-[13px] font-510 italic tracking-[0.02em] text-brand/90">
                Policy identity
              </p>
              <p class="mt-1 text-sm text-text-tertiary">
                Name this for the kind of work it should govern.
              </p>
            </div>

            <.input
              field={@form[:name]}
              label="Policy Name"
              type="text"
              value={Phoenix.HTML.Form.input_value(@form, :name) || "Default staged execution"}
              required
            />
          </section>

          <section class="space-y-4 rounded-lg border border-border bg-surface/70 px-4 py-4">
            <div>
              <p class="font-serif text-[13px] font-510 italic tracking-[0.02em] text-brand/90">
                Stage builder
              </p>
              <p class="mt-1 text-sm text-text-tertiary">
                Participants can be role handles like engineer, cto, and ceo, or stable agent IDs.
              </p>
            </div>

            <div class="space-y-4">
              <div
                :for={index <- CymphoWeb.ExecutionPolicyLive.FormHelpers.stage_indexes()}
                class="rounded-lg border border-border bg-panel/80 p-4"
              >
                <div class="flex flex-col gap-3 lg:flex-row lg:items-start lg:justify-between">
                  <div class="min-w-0">
                    <p class="text-sm font-590 text-text-primary">
                      {index}. {CymphoWeb.ExecutionPolicyLive.FormHelpers.stage_title(index)}
                    </p>
                    <p class="mt-1 text-xs leading-5 text-text-tertiary">
                      {CymphoWeb.ExecutionPolicyLive.FormHelpers.stage_hint(index)}
                    </p>
                  </div>
                  <span class="w-fit rounded-full border border-border bg-surface px-2 py-1 text-[11px] font-510 uppercase tracking-[0.1em] text-text-quaternary">
                    Stage {index}
                  </span>
                </div>

                <div class="mt-4 grid gap-4 md:grid-cols-[180px_minmax(0,1fr)]">
                  <.input
                    id={"execution_policy_stage_#{index}_type"}
                    name={"execution_policy[stage_#{index}_type]"}
                    type="select"
                    label="Stage type"
                    value={
                      CymphoWeb.ExecutionPolicyLive.FormHelpers.stage_value(@form, index, "type")
                    }
                    options={CymphoWeb.ExecutionPolicyLive.FormHelpers.stage_type_options()}
                  />
                  <.input
                    id={"execution_policy_stage_#{index}_participant_id"}
                    name={"execution_policy[stage_#{index}_participant_id]"}
                    label="Participant"
                    value={
                      CymphoWeb.ExecutionPolicyLive.FormHelpers.stage_value(
                        @form,
                        index,
                        "participant_id"
                      )
                    }
                    placeholder="engineer, cto, ceo, or agent UUID"
                  />
                </div>

                <div class="mt-4 grid gap-3 md:grid-cols-3">
                  <label class="flex min-h-[68px] items-start gap-3 rounded-lg border border-border bg-surface/80 px-3 py-3">
                    <input
                      type="hidden"
                      name={"execution_policy[stage_#{index}_require_different_actor]"}
                      value="false"
                    />
                    <input
                      id={"execution_policy_stage_#{index}_require_different_actor"}
                      type="checkbox"
                      name={"execution_policy[stage_#{index}_require_different_actor]"}
                      value="true"
                      checked={
                        CymphoWeb.ExecutionPolicyLive.FormHelpers.stage_checked?(
                          @form,
                          index,
                          "require_different_actor"
                        )
                      }
                      class="mt-0.5 h-4 w-4 rounded border-border bg-subtle text-brand focus:ring-brand/30"
                    />
                    <span>
                      <span class="block text-xs font-510 text-text-secondary">
                        Different actor
                      </span>
                      <span class="mt-1 block text-xs leading-5 text-text-tertiary">
                        Reviewer cannot be the executor.
                      </span>
                    </span>
                  </label>

                  <label class="flex min-h-[68px] items-start gap-3 rounded-lg border border-border bg-surface/80 px-3 py-3">
                    <input
                      type="hidden"
                      name={"execution_policy[stage_#{index}_require_human]"}
                      value="false"
                    />
                    <input
                      id={"execution_policy_stage_#{index}_require_human"}
                      type="checkbox"
                      name={"execution_policy[stage_#{index}_require_human]"}
                      value="true"
                      checked={
                        CymphoWeb.ExecutionPolicyLive.FormHelpers.stage_checked?(
                          @form,
                          index,
                          "require_human"
                        )
                      }
                      class="mt-0.5 h-4 w-4 rounded border-border bg-subtle text-brand focus:ring-brand/30"
                    />
                    <span>
                      <span class="block text-xs font-510 text-text-secondary">
                        Human approval
                      </span>
                      <span class="mt-1 block text-xs leading-5 text-text-tertiary">
                        Requires an explicit human gate.
                      </span>
                    </span>
                  </label>

                  <label class="flex min-h-[68px] items-start gap-3 rounded-lg border border-border bg-surface/80 px-3 py-3">
                    <input
                      type="hidden"
                      name={"execution_policy[stage_#{index}_auto_advance]"}
                      value="false"
                    />
                    <input
                      id={"execution_policy_stage_#{index}_auto_advance"}
                      type="checkbox"
                      name={"execution_policy[stage_#{index}_auto_advance]"}
                      value="true"
                      checked={
                        CymphoWeb.ExecutionPolicyLive.FormHelpers.stage_checked?(
                          @form,
                          index,
                          "auto_advance"
                        )
                      }
                      class="mt-0.5 h-4 w-4 rounded border-border bg-subtle text-brand focus:ring-brand/30"
                    />
                    <span>
                      <span class="block text-xs font-510 text-text-secondary">
                        Auto-advance
                      </span>
                      <span class="mt-1 block text-xs leading-5 text-text-tertiary">
                        Continue when the stage passes.
                      </span>
                    </span>
                  </label>
                </div>
              </div>
            </div>
          </section>

          <section class="space-y-4">
            <div>
              <p class="font-serif text-[13px] font-510 italic tracking-[0.02em] text-brand/90">
                Stage payload
              </p>
              <p class="mt-1 text-sm text-text-tertiary">
                The JSON payload mirrors the stage builder for audit and API compatibility.
              </p>
            </div>

            <details class="group rounded-lg border border-border bg-surface/80 px-4 py-3">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-3 [&::-webkit-details-marker]:hidden">
                <span>
                  <span class="block text-xs font-510 text-text-secondary">
                    Advanced JSON preview
                  </span>
                  <span class="mt-0.5 block text-sm leading-5 text-text-tertiary">
                    Direct JSON submissions are still validated before saving.
                  </span>
                </span>
                <span class="hero-chevron-down-mini h-4 w-4 shrink-0 text-text-tertiary transition-transform group-open:rotate-180">
                </span>
              </summary>
              <div class="mt-4 border-t border-border pt-4">
                <.input
                  field={@form[:stage_configs]}
                  label="Stage Configs (JSON array)"
                  type="textarea"
                  rows={9}
                  value={
                    @stage_configs_text ||
                      CymphoWeb.ExecutionPolicyLive.FormHelpers.stage_configs_text(@form)
                  }
                  spellcheck="false"
                  required
                />
              </div>
            </details>
          </section>
        </div>
      </.panel>

      <aside class="space-y-4">
        <section
          data-testid="execution-policy-setup-checklist"
          class="card-lift rounded-xl border border-border bg-panel p-4 shadow-card"
        >
          <p class="font-serif text-[13px] font-510 italic tracking-[0.02em] text-brand/90">
            Setup checklist
          </p>
          <div class="mt-4 space-y-3">
            <div class="flex gap-3">
              <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full border border-success/30 bg-success/10 text-xs font-590 text-success">
                1
              </span>
              <div>
                <p class="text-sm font-590 text-text-primary">Assign an executor</p>
                <p class="mt-1 text-xs leading-5 text-text-tertiary">
                  Every run needs a clear owner for the work stage.
                </p>
              </div>
            </div>
            <div class="flex gap-3">
              <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full border border-brand/30 bg-brand/10 text-xs font-590 text-brand">
                2
              </span>
              <div>
                <p class="text-sm font-590 text-text-primary">Keep review independent</p>
                <p class="mt-1 text-xs leading-5 text-text-tertiary">
                  Different-actor review prevents self-approval loops.
                </p>
              </div>
            </div>
            <div class="flex gap-3">
              <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full border border-amber-500/30 bg-amber-500/10 text-xs font-590 text-amber-200">
                3
              </span>
              <div>
                <p class="text-sm font-590 text-text-primary">Gate final approval</p>
                <p class="mt-1 text-xs leading-5 text-text-tertiary">
                  Human approval is safest for high-impact autonomous changes.
                </p>
              </div>
            </div>
          </div>
        </section>

        <section class="card-lift rounded-xl border border-brand/25 bg-brand/10 p-4">
          <p class="font-serif text-[13px] font-510 italic tracking-[0.02em] text-brand">
            Default governance flow
          </p>
          <p class="mt-2 font-serif text-base font-510 text-text-primary">
            Executor to reviewer to approver
          </p>
          <p class="mt-1 text-xs leading-5 text-text-tertiary">
            The default policy starts with engineer execution, CTO review, and CEO approval.
          </p>
        </section>
      </aside>

      <div class="flex flex-col-reverse gap-2 border-t border-border pt-4 sm:flex-row sm:items-center sm:justify-end 2xl:col-span-2">
        <.app_link
          navigate={~p"/settings/policies"}
          class="inline-flex min-h-[40px] items-center justify-center rounded-lg border border-border bg-button px-4 py-2 text-sm font-510 text-text-secondary transition-colors hover:bg-button-hover hover:text-text-primary"
        >
          Cancel
        </.app_link>
        <.button type="submit" variant="primary" class="min-h-[40px] w-full sm:w-auto">
          Save Execution Policy
        </.button>
      </div>
    </.form>
  </div>
</.settings_layout>
