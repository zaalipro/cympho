<.page_frame
  page="policy-form"
  kind={:deep}
  parent={{~p"/settings/policies", "Review steps"}}
  current="New review step"
  data-ui-complex-page
>
  <:head>
    <section class="head" aria-labelledby="pf-h">
      <h1 class="h1 big" id="pf-h">New review step</h1>
      <p class="sub">Decide who does the work, who checks it and who approves it.</p>
    </section>
  </:head>

  <.flash_line flash={@flash} />

  <FormHelpers.policy_form
    form={@form}
    stage_configs_text={@stage_configs_text}
    name_value={Phoenix.HTML.Form.input_value(@form, :name) || "Default staged execution"}
    effect="Every task that uses it gets a worker, a reviewer and a final approval."
    cancel={~p"/settings/policies"}
  />
</.page_frame>
