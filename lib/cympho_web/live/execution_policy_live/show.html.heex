<.page_frame
  page="policy"
  kind={:deep}
  parent={{~p"/settings/policies", "Review steps"}}
  current={@execution_policy.name}
  data-ui-complex-page
>
  <:head>
    <section class="head" aria-labelledby="po-h">
      <h1 class="h1 big" id="po-h">{@execution_policy.name}</h1>
      <div class="chips">
        <span class="chip">{stage_count_label(@execution_policy.stage_configs)}</span>
        <.pill navigate={~p"/settings/policies/#{@execution_policy.id}/edit"}>
          <.r3_icon name="i-pencil" />Edit
        </.pill>
      </div>
    </section>
  </:head>

  <.flash_line flash={@flash} />

  <.band_card id="st-t" title="Stages">
    <ol :if={@execution_policy.stage_configs != []} class="steps">
      <li :for={{stage, idx} <- Enum.with_index(@execution_policy.stage_configs, 1)} class="step">
        <span class="chk mono">{idx}</span>
        <span class="step-t">
          {stage_type_label(stage)}
          <%= if participant(stage) do %>
            <span class="mono">{participant(stage)}</span>
          <% else %>
            <span class="nop">No participant</span>
          <% end %>
        </span>
        <span class="step-g">
          <span :if={truthy_flag(stage, "require_different_actor")} class="tag">
            Different actor
          </span>
          <span :if={truthy_flag(stage, "require_human")} class="tag">Human approval</span>
          <span :if={truthy_flag(stage, "auto_advance")} class="tag">Auto-advance</span>
        </span>
      </li>
    </ol>
    <.quiet_empty :if={@execution_policy.stage_configs == []} title="No stages yet">
      Add executor, reviewer, and approver stages before assigning this policy to work.
      <:action>
        <.pill navigate={~p"/settings/policies/#{@execution_policy.id}/edit"}>Edit</.pill>
      </:action>
    </.quiet_empty>
  </.band_card>
</.page_frame>
