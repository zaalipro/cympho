<.settings_layout active={:policies}>
  <.flash_line flash={@flash} />

  <.band_card id="po-t" title="Review steps">
    <:header_end>
      <%!-- While the list is empty its quiet line carries the one Add control. --%>
      <.pill :if={policy_metric_total(@policy_command) > 0} navigate={~p"/settings/policies/new"}>
        <.r3_icon name="i-plus" />Add a review step
      </.pill>
    </:header_end>

    <.infinite_scroll
      id="execution_policies"
      has_more={@infinite_scroll[:execution_policies][:has_more?] || false}
      container_class="rows"
    >
      <:empty>
        <.quiet_empty title="No review steps yet">
          Add one to have an agent or you check work before it is done.
          <:action>
            <.pill navigate={~p"/settings/policies/new"}>Add a review step</.pill>
          </:action>
        </.quiet_empty>
      </:empty>

      <.list_row
        :for={{dom_id, policy} <- @streams.execution_policies}
        tag="div"
        id={dom_id}
        title={policy.name}
        navigate={~p"/settings/policies/#{policy.id}"}
        status={policy_status(policy_summary(policy).status)}
      >
        <:meta>
          <%= for {part, i} <- Enum.with_index(policy_meta(policy_summary(policy))) do %>
            <span
              :if={i > 0}
              aria-hidden="true"
            > · </span>{part}
          <% end %>
        </:meta>
        <:actions>
          <.pill navigate={~p"/settings/policies/#{policy.id}/edit"}>Edit</.pill>
          <button
            type="button"
            class="pl warn"
            phx-click="delete_execution_policy"
            phx-value-id={policy.id}
            data-confirm={"Delete #{policy.name}? New issues will no longer be able to use this staged execution guardrail."}
          >
            Delete
          </button>
        </:actions>
      </.list_row>
    </.infinite_scroll>
  </.band_card>

  <div class="ui-advanced-only">
    <.band_card id="pc-t" title="Coverage" data-testid="policy-command">
      <:header_end><span class="tag">{@policy_command.badge}</span></:header_end>
      <div class="cmd">
        <p class="gl-big">{@policy_command.heading}</p>
        <p class="gl-sub">{@policy_command.detail}</p>
        <p :if={@policy_command.focus_label} class="cmd-f">
          <span class="tag">{@policy_command.focus_label}</span>
          <span :if={@policy_command.focus_detail} class="tag">
            {@policy_command.focus_detail}
          </span>
        </p>
        <.text_link navigate={@policy_command.action_path}>
          {@policy_command.action_label}
        </.text_link>
      </div>
      <div :if={policy_metric_total(@policy_command) > 0} class="strip s4">
        <div :for={metric <- @policy_command.metrics} class="cell">
          <p class="v mono">{metric.value}</p>
          <p class="l">{metric.label}</p>
        </div>
      </div>
    </.band_card>
  </div>
</.settings_layout>
