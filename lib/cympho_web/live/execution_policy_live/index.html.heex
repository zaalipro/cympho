<.settings_layout active={:policies}>
  <.header>
    <span class="ember-eyebrow">
      Rules · {policy_metric_total(@policy_command)} on file
    </span>
    <h1 class="ember-ink mt-4 font-serif text-[clamp(30px,4.5vw,44px)] font-510 leading-[1.08] tracking-[-0.02em]">
      {@page_title}
    </h1>
    <p class="ui-advanced-only mt-2 max-w-2xl text-[15px] leading-6 text-text-tertiary">
      Governance rules that decide who executes, reviews, approves, and auto-advances agent work.
    </p>
    <:actions>
      <.app_link
        navigate={~p"/settings/policies/new"}
        class="cta-glow inline-flex items-center gap-2 rounded-lg bg-primary px-4 py-2 text-sm font-510 text-white transition-colors hover:bg-primary-hover"
      >
        <.icon name="hero-plus-mini" class="h-4 w-4" /> New policy
      </.app_link>
    </:actions>
  </.header>

  <hr class="ember-rule mb-5" />

  <section data-testid="policy-command" class="ember-glass ui-advanced-only mb-5 overflow-hidden">
    <div class="grid gap-4 p-4 lg:grid-cols-[minmax(0,1fr)_auto] lg:items-start">
      <div class="min-w-0">
        <div class="flex flex-wrap items-center gap-2">
          <p class="font-serif text-[13px] font-510 italic tracking-[0.02em] text-brand/90">
            Policy command
          </p>
          <span class={"rounded-full border px-2.5 py-1 text-[11px] font-510 #{policy_command_badge_class(@policy_command.tone)}"}>
            {@policy_command.badge}
          </span>
        </div>

        <h2 class="mt-2 font-serif text-[19px] font-510 leading-snug text-text-primary">
          {@policy_command.heading}
        </h2>
        <p class="mt-1 max-w-3xl text-sm leading-6 text-text-tertiary">
          {@policy_command.detail}
        </p>

        <div
          :if={@policy_command.focus_label}
          class="mt-3 flex min-w-0 flex-wrap items-center gap-2 text-xs"
        >
          <span class="max-w-full truncate rounded-full border border-border bg-surface px-2.5 py-1 font-510 text-text-secondary">
            {@policy_command.focus_label}
          </span>
          <span
            :if={@policy_command.focus_detail}
            class="rounded-full border border-border bg-surface px-2.5 py-1 text-text-tertiary"
          >
            {@policy_command.focus_detail}
          </span>
        </div>
      </div>

      <.app_link
        navigate={@policy_command.action_path}
        class={"inline-flex shrink-0 items-center justify-center gap-2 rounded-lg border px-3 py-2 text-sm font-590 transition-colors #{policy_command_action_class(@policy_command.tone)}"}
      >
        <.icon name="hero-arrow-right-mini" class="h-4 w-4" />
        {@policy_command.action_label}
      </.app_link>
    </div>

    <%!-- Seven zeroes under a card that already says the library is empty. --%>
    <div
      :if={policy_metric_total(@policy_command) > 0}
      class="grid grid-cols-2 border-t border-hairline sm:grid-cols-4 lg:grid-cols-7"
    >
      <div
        :for={metric <- @policy_command.metrics}
        class="ember-stat border-r border-hairline px-4 py-3 last:border-r-0"
      >
        <p class="text-[10px] font-590 uppercase tracking-[0.14em] text-text-quaternary">
          {metric.label}
        </p>
        <p class={[
          "mt-1 font-serif text-2xl font-590 tabular-nums",
          policy_metric_value_class(metric.tone)
        ]}>
          {metric.value}
        </p>
      </div>
    </div>
  </section>

  <section class="overflow-hidden rounded-xl border border-border bg-panel shadow-card">
    <div class="border-b border-border px-4 py-3">
      <p class="font-serif text-[13px] font-510 italic tracking-[0.02em] text-brand/90">
        Policy library
      </p>
      <p class="ui-advanced-only mt-1 text-xs leading-5 text-text-tertiary">
        Policies are reusable templates. Assign them to issues when a run needs staged review.
      </p>
    </div>

    <.infinite_scroll
      id="execution_policies"
      has_more={@infinite_scroll[:execution_policies][:has_more?] || false}
      container_class="divide-y divide-border"
    >
      <:empty>
        <div class="flex flex-col items-center justify-center px-6 py-16 text-center">
          <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-2xl border border-brand/20 bg-brand/10 text-brand shadow-[0_0_24px_rgba(217,119,87,0.12)]">
            <.icon name="hero-shield-check-mini" class="h-6 w-6" />
          </div>
          <p class="font-serif text-base font-510 text-text-primary">
            No governance policies configured yet.
          </p>
          <%!-- The "New policy" button already sits in the page header and in
               the command card directly above; a third copy here is noise. --%>
          <p class="mt-1 max-w-sm text-xs leading-5 text-text-tertiary">
            Create one so every run has an owner, a reviewer, and an approver.
          </p>
        </div>
      </:empty>

      <div
        :for={{dom_id, policy} <- @streams.execution_policies}
        id={dom_id}
        class="border-l-2 border-transparent p-4 transition-colors hover:border-border-hover hover:bg-subtle hover:shadow-[inset_2px_0_0_0_var(--color-primary)]"
      >
        <% summary = policy_summary(policy) %>

        <div class="flex flex-col gap-4 lg:flex-row lg:items-start lg:justify-between">
          <div class="min-w-0">
            <div class="flex flex-wrap items-center gap-2">
              <h3 class="font-serif text-base font-510 tracking-[-0.01em] text-text-primary">
                {policy.name}
              </h3>
              <span class={"rounded-full border px-2 py-0.5 text-[11px] font-510 #{policy_status_badge_class(summary.status)}"}>
                {policy_status_label(summary.status)}
              </span>
            </div>

            <p class="ui-advanced-only mt-1 max-w-2xl text-sm leading-5 text-text-tertiary">
              {policy_status_detail(summary.status)}
            </p>

            <div class="ui-advanced-only mt-3 flex flex-wrap items-center gap-2 text-xs">
              <span class="rounded-full border border-border bg-surface px-2 py-1 font-510 text-text-secondary">
                {summary.stage_count} stages
              </span>
              <span
                :for={type <- summary.stage_types}
                class="rounded-full border border-border bg-surface px-2 py-1 text-text-tertiary"
              >
                {String.capitalize(type)}
              </span>
              <span
                :if={summary.has_different_actor_gate?}
                class="rounded-full border border-brand/25 bg-brand/10 px-2 py-1 text-brand"
              >
                Different actor
              </span>
              <span
                :if={summary.has_human_gate?}
                class="rounded-full border border-cyan-500/25 bg-cyan-500/10 px-2 py-1 text-cyan-300"
              >
                Human required
              </span>
              <span
                :if={summary.auto_advance_count > 0}
                class="rounded-full border border-amber-500/25 bg-amber-500/10 px-2 py-1 text-amber-300"
              >
                {summary.auto_advance_count} auto
              </span>
              <span
                :if={summary.missing_participant_count > 0}
                class="rounded-full border border-red-500/25 bg-red-500/10 px-2 py-1 text-red-300"
              >
                {summary.missing_participant_count} missing
              </span>
            </div>
          </div>

          <div class="flex shrink-0 flex-wrap items-center gap-2">
            <.app_link
              navigate={~p"/settings/policies/#{policy.id}"}
              class="inline-flex items-center gap-1.5 rounded-lg border border-border bg-surface px-3 py-2 text-sm font-510 text-text-secondary transition-colors hover:bg-surface-hover hover:text-text-primary"
            >
              <.icon name="hero-eye-mini" class="h-4 w-4" /> View
            </.app_link>
            <.app_link
              navigate={~p"/settings/policies/#{policy.id}/edit"}
              class="inline-flex items-center gap-1.5 rounded-lg border border-border bg-surface px-3 py-2 text-sm font-510 text-text-secondary transition-colors hover:bg-surface-hover hover:text-text-primary"
            >
              <.icon name="hero-pencil-square-mini" class="h-4 w-4" /> Edit
            </.app_link>
            <button
              type="button"
              class="inline-flex items-center gap-1.5 rounded-lg border border-red-500/25 bg-red-500/10 px-3 py-2 text-sm font-510 text-red-200 transition-colors hover:bg-red-500/15"
              phx-click="delete_execution_policy"
              phx-value-id={policy.id}
              data-confirm={"Delete #{policy.name}? New issues will no longer be able to use this staged execution guardrail."}
            >
              <.icon name="hero-trash-mini" class="h-4 w-4" /> Delete
            </button>
          </div>
        </div>
      </div>
    </.infinite_scroll>
  </section>
</.settings_layout>
