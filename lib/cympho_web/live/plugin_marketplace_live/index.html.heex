<.page_frame
  page="marketplace"
  kind={:deep}
  parent={{"/plugins", "Plugins"}}
  current="Plugin catalog"
  data-ui-complex-page
>
  <:head>
    <section class="head" aria-labelledby="mk-h">
      <h1 class="h1 big" id="mk-h">Plugin catalog</h1>
      <p class="sub">
        {length(@available_plugins)} catalog entries<span aria-hidden="true"> · </span>{Enum.count(
          @available_plugins,
          & &1.installable?
        )} installable<span aria-hidden="true"> · </span>{map_size(@installed_plugins)} installed
      </p>
    </section>
  </:head>

  <.flash_line flash={@flash} />

  <form id="mk-search" phx-change="search" class="tbar">
    <div class="tbar-f">
      <.search_capsule
        label="Search plugins"
        name="query"
        value={@search_query}
        placeholder="Search plugins"
      />
    </div>
  </form>

  <div
    :if={filtered_plugins(@available_plugins, @search_query, @installed_plugins) != []}
    class="mk-grid"
  >
    <article
      :for={plugin <- filtered_plugins(@available_plugins, @search_query, @installed_plugins)}
      class="card mk-card"
      data-testid="plugin-catalog-entry"
      data-plugin-identifier={plugin.identifier}
      aria-labelledby={"mk-#{plugin.identifier}"}
    >
      <div class="mk-h">
        <h2 class="h2" id={"mk-#{plugin.identifier}"}>{plugin.name}</h2>
        <span class="tag" data-testid="plugin-catalog-source">{plugin.source_label}</span>
      </div>
      <p class="rm">
        by {plugin.author} <span aria-hidden="true">·</span>
        <span class="mono">v{plugin.version}</span>
      </p>
      <p class="gl-sub">{plugin.description}</p>
      <p class="sk-caps">
        <span :for={cap <- plugin.capabilities} class="tag">
          {CymphoWeb.PluginLive.Index.humanize_capability(cap)}
        </span>
      </p>
      <p class="mono mk-mod hr-wrap">{inspect(plugin.source_module)}</p>
      <div class="mk-act">
        <%= cond do %>
          <% plugin.is_installed -> %>
            <span class="hr-st"><.status_word kind={:done} word="Installed" /></span>
            <button
              :if={@can_manage_plugins}
              type="button"
              class="pl warn"
              phx-click="uninstall"
              phx-value-id={plugin.installed_id}
              data-confirm={"Remove #{plugin.name}?"}
            >
              Remove
            </button>
          <% plugin.installable? && @can_manage_plugins -> %>
            <.pill phx-click="install" phx-value-identifier={plugin.identifier}>Install</.pill>
          <% plugin.installable? -> %>
            <p class="gl-sub" data-testid="plugin-marketplace-read-only">Read-only</p>
          <% true -> %>
            <p class="gl-sub" data-testid="plugin-catalog-not-installable">
              Source reference only
            </p>
        <% end %>
      </div>
    </article>
  </div>

  <section
    :if={filtered_plugins(@available_plugins, @search_query, @installed_plugins) == []}
    class="card"
  >
    <.quiet_empty title={"No plugins match “#{@search_query}”"}>
      Try another word.
      <:action>
        <.pill phx-click="search" phx-value-query="">Clear search</.pill>
      </:action>
    </.quiet_empty>
  </section>
</.page_frame>
