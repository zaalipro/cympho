<.page_frame
  page="companies"
  kind={:deep}
  parent={{~p"/settings/company", "Settings"}}
  current="Companies"
  data-ui-complex-page
>
  <:head>
    <section class="head" aria-labelledby="co-h">
      <h1 class="h1 big" id="co-h">Companies</h1>
      <div class="chips">
        <.pill :if={@live_action != :new} patch={~p"/companies/new"}>
          <.r3_icon name="i-plus" />New company
        </.pill>
        <.pill navigate={~p"/companies/import"}>Import</.pill>
        <span class="ui-advanced-only">
          <.pill navigate={~p"/onboarding"}>Start company setup</.pill>
        </span>
      </div>
    </section>
  </:head>

  <.flash_line flash={@flash} />

  <.live_component
    :if={@live_action in [:new, :edit]}
    module={CymphoWeb.CompanyLive.FormComponent}
    id={@company.id || :new}
    action={@live_action}
    company={@company}
    current_user={@current_user}
    patch={~p"/companies"}
  />

  <.band_card id="companies-list-t" title="Your companies" data-testid="company-fleet">
    <:header_end>
      <span class="meta mono">{@launch_summary.total_companies}</span>
    </:header_end>
    <.infinite_scroll
      id="companies"
      has_more={@infinite_scroll[:companies][:has_more?] || false}
      container_class="rows"
    >
      <:empty>
        <.quiet_empty title="No companies yet">
          Launch one from a blueprint to create a working autonomous org.
          <:action>
            <.pill patch={~p"/companies/new"}>New company</.pill>
          </:action>
        </.quiet_empty>
      </:empty>

      <.list_row
        :for={{dom_id, company} <- @streams.companies}
        tag="div"
        id={dom_id}
        title={company.name}
        navigate={~p"/companies/#{company}"}
      >
        <:meta>
          <span class="mono">{company.slug}</span><span :if={role_label(@roles[company.id])}><span aria-hidden="true"> · </span>{role_label(@roles[company.id])}</span><span :if={
            members_label(@member_counts[company.id])
          }><span aria-hidden="true"> · </span>{members_label(@member_counts[company.id])}</span>
        </:meta>
        <:trail :if={company.status == "paused"}><span class="tag">Paused</span></:trail>
        <:actions :if={
          can_manage_company?(@current_user, company) or
            can_delete_company?(@current_user, company)
        }>
          <.overflow_menu id={"company-menu-#{company.id}"} label={"Actions for #{company.name}"}>
            <.menu_item
              :if={can_manage_company?(@current_user, company)}
              navigate={~p"/companies/#{company}/export"}
            >
              Export
            </.menu_item>
            <.menu_item
              :if={can_manage_company?(@current_user, company)}
              navigate={~p"/companies/#{company}/edit"}
            >
              Edit
            </.menu_item>
            <.menu_item
              :if={can_delete_company?(@current_user, company)}
              danger
              phx-click="delete_company"
              phx-value-id={company.id}
              aria-label={"Delete #{company.name}"}
              data-confirm={"Delete #{company.name}? This removes the company workspace from the fleet and cannot be undone."}
            >
              Delete
            </.menu_item>
          </.overflow_menu>
        </:actions>
      </.list_row>
    </.infinite_scroll>
  </.band_card>

  <%!-- Advanced: the blueprint launch console and catalog, in one band. --%>
  <.band_card
    id="co-launch-t"
    title="Launch from a blueprint"
    class="ui-advanced-only"
    data-testid="company-launch-command"
  >
    <:header_end>
      <span class="meta co-st">
        <.status_word
          kind={posture_status(@launch_summary.launch_posture.tone)}
          word={@launch_summary.launch_posture.label}
        />
      </span>
    </:header_end>
    <div class="gl-sec">
      <p class="gl-big">Launch autonomous companies from working blueprints</p>
      <p class="gl-sub">{@launch_summary.launch_posture.detail}</p>
    </div>
    <div class="strip s4">
      <div class="cell">
        <span class="v mono">{@launch_summary.total_companies}</span><span class="l">Companies</span>
      </div>
      <div class="cell">
        <span class="v mono">{@launch_summary.blueprint_count}</span><span class="l">Blueprints</span>
      </div>
      <div class="cell">
        <span class="v mono">{@launch_summary.default_agent_count}</span><span class="l">Default agents</span>
      </div>
      <div class="cell">
        <span class="v mono">{@launch_summary.capability_count}</span><span class="l">Capabilities</span>
      </div>
    </div>
    <p class="gh co-gh">Blueprint catalog</p>
    <ul class="rows" data-testid="company-blueprint-strip">
      <.list_row
        :for={blueprint <- @featured_blueprints}
        id={"blueprint-#{blueprint.key}"}
        title={blueprint.name}
        navigate={~p"/onboarding"}
      >
        <:meta>
          {blueprint.default_agent_count} agents<span aria-hidden="true"> · </span>{blueprint.seed_issue_count} starting tasks
        </:meta>
      </.list_row>
    </ul>
    <div class="cf">
      <.text_link navigate={~p"/onboarding"}>Build from blueprint</.text_link>
      <.text_link navigate={~p"/companies/import"}>Import company</.text_link>
      <.text_link navigate={~p"/onboarding"}>
        View all {@launch_summary.blueprint_count}
      </.text_link>
    </div>
  </.band_card>
</.page_frame>
