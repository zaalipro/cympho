<div id="company-form-panel">
  <.form_pair
    id="company-form"
    for={@form}
    phx-target={@myself}
    phx-change="validate"
    phx-submit="save"
    heading={if @action == :new, do: "After you create it", else: "After you save"}
    verb={if @action == :new, do: "create", else: "save"}
  >
    <.band_card id="cf-t" title={if @action == :new, do: "New company", else: "Company details"}>
      <div class="flds">
        <.input field={@form[:name]} type="text" label="Name" placeholder="Acme Corp" required />
        <.input
          field={@form[:slug]}
          type="text"
          label="Slug"
          placeholder="acme-corp"
          help="Lowercase letters, numbers and hyphens only."
          required
        />
      </div>
    </.band_card>

    <:effect>
      <.consequences
        :if={@action == :new}
        rows={[{:done, "You become its owner, and Cympho switches you to it."}]}
      />
      <.consequences
        :if={@action != :new}
        rows={[{:done, "The new name and slug show everywhere in Cympho."}]}
      />
    </:effect>
    <:secondary>
      <.ghost_pill navigate={@patch || ~p"/companies"}>Cancel</.ghost_pill>
    </:secondary>
    <:primary>
      <.primary_pill type="submit" phx-disable-with="Saving…">
        {if @action == :new, do: "Create company", else: "Save changes"}
      </.primary_pill>
    </:primary>
  </.form_pair>
</div>
