<div class="ember-glass mt-2 p-5 sm:p-6" id="company-form-panel">
  <div class="flex items-start justify-between gap-3">
    <div class="min-w-0">
      <p class="font-serif text-[13px] font-510 italic tracking-[0.02em] text-brand/90">
        Company setup
      </p>
      <h2 class="mt-1 font-serif text-lg font-510 text-text-primary">{@title}</h2>
    </div>
    <.link
      patch={@patch || ~p"/companies"}
      class="shrink-0 rounded-lg px-3 py-2 text-sm font-510 text-text-tertiary transition-colors hover:bg-surface-hover hover:text-text-primary"
    >
      Cancel
    </.link>
  </div>

  <.simple_form
    for={@form}
    id="company-form"
    phx-target={@myself}
    phx-change="validate"
    phx-submit="save"
    class="mt-5 space-y-4"
  >
    <.input
      field={@form[:name]}
      type="text"
      label="Company Name"
      placeholder="Acme Corp"
      required
    />

    <.input
      field={@form[:slug]}
      type="text"
      label="Slug"
      placeholder="acme-corp"
      required
    />

    <div class="text-xs text-text-tertiary">
      Slug must contain only lowercase letters, numbers, and hyphens.
    </div>

    <:actions>
      <.button variant="primary" class="cta-glow">Save Company</.button>
    </:actions>
  </.simple_form>
</div>
