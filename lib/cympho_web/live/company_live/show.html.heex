<% paused? = @company.status == "paused" %>
<% editing? = @can_manage? && @live_action == :edit %>
<.page_frame
  page="company"
  kind={:deep}
  parent={{~p"/companies", "Companies"}}
  current={@company.name}
  data-ui-complex-page
>
  <:head>
    <section class="head" aria-labelledby="cs-h">
      <h1 class="h1 big" id="cs-h">{@company.name}</h1>
      <p class="sub">
        <span class="mono">{@company.slug}</span><span aria-hidden="true"> · </span><span class="nw">Created {format_inserted_at(@company)}</span>
      </p>
      <div class="chips">
        <span :if={paused?} class="chip"><.status_word kind={:stopped} word="Paused" /></span>
        <span :if={@company.status == "archived"} class="tag">Archived</span>
        <.pill :if={@can_manage?} navigate={~p"/companies/#{@company}/export"}>Export</.pill>
        <.pill :if={@can_manage? && !editing?} navigate={~p"/companies/#{@company}/edit"}>
          <.r3_icon name="i-pencil" />Edit
        </.pill>
        <span :if={@can_manage?} class="ui-advanced-only">
          <.pill navigate={~p"/companies/import"}>Import</.pill>
        </span>
      </div>
    </section>
  </:head>

  <.flash_line flash={@flash} />

  <%!-- While editing, the edit pair is the page's only pair (v7 §2.6). --%>
  <.live_component
    :if={editing?}
    module={CymphoWeb.CompanyLive.FormComponent}
    id={@company.id}
    action={@live_action}
    company={@company}
    current_user={@current_user}
    patch={~p"/companies/#{@company.id}"}
  />

  <%!-- Everyone who can open the company sees why it is paused; only managers get Resume
       (the lone card is the approval page's pattern for someone who cannot decide). --%>
  <.next_step :if={paused? && !editing?} id="cs-ns-">
    <:problem>
      <.problem_card title={"Resume #{@company.name}"} title_id="cs-ns-t">
        <:eyebrow>Next step<span aria-hidden="true"> · </span>Company paused</:eyebrow>
        <p class="obj">{@company.paused_reason || "Agents are paused for this company."}</p>
        <p :if={!@can_manage?} class="obj">
          Only owners, admins and board members can resume it.
        </p>
      </.problem_card>
    </:problem>
    <:resolution :if={@can_manage?}>
      <.ink_card heading="After you resume it" heading_id="cs-ns-i">
        <.consequences rows={[{:done, "Agents pick up work again and new runs can start."}]} />
        <.ink_foot verb="resume">
          <:primary>
            <.primary_pill phx-click="show_resume_modal">Resume</.primary_pill>
          </:primary>
        </.ink_foot>
      </.ink_card>
    </:resolution>
  </.next_step>

  <.band_card id="cs-members-t" title="Members">
    <:header_end><span class="meta mono">{Enum.count(@memberships)}</span></:header_end>
    <div :if={@memberships != []} class="tbl-w">
      <table class="tbl">
        <thead>
          <tr>
            <th scope="col">Name</th>
            <th scope="col" class="m-hide">Email</th>
            <th scope="col">Role</th>
            <th :if={@can_manage?} scope="col"><span class="sr">Actions</span></th>
          </tr>
        </thead>
        <tbody>
          <tr :for={membership <- @memberships}>
            <th scope="row">{membership.user.name}</th>
            <td class="m-hide cs-email">{membership.user.email}</td>
            <td>
              {role_label(membership.role)}<span
                :if={membership.is_board_member}
                class="tag cs-board"
              >Board</span>
            </td>
            <td :if={@can_manage?} class="cs-act">
              <button
                type="button"
                class="pl warn"
                phx-click="delete_membership"
                phx-value-id={membership.id}
                aria-label={"Remove #{membership.user.email}"}
                data-confirm={"Remove #{membership.user.email} from #{@company.name}? They will lose access to this company."}
              >
                Remove
              </button>
            </td>
          </tr>
        </tbody>
      </table>
    </div>
    <.quiet_empty :if={@memberships == []} title="No members yet">
      Add users to this company from Settings.
    </.quiet_empty>
  </.band_card>

  <section
    :if={@can_manage? && @company.status == "active" && !editing?}
    class="card"
    aria-label="Pause"
  >
    <ul class="rows">
      <.list_row id="company-pause-row" title={"Pause #{@company.name}"} icon="i-pause">
        <:meta>Stops agent dispatch and new runs until you resume it.</:meta>
        <:actions>
          <button type="button" class="pl warn" phx-click="show_pause_modal">Pause</button>
        </:actions>
      </.list_row>
    </ul>
  </section>

  <.modal
    :if={@show_pause_modal}
    id="pause-company-modal"
    show
    title={"Pause #{@company.name}"}
    on_cancel={JS.push("hide_pause_modal")}
  >
    <p class="gl-sub">Pause all agents and stop dispatching.</p>
    <form id="pause-company-reason" phx-change="update_pause_reason">
      <.input
        type="textarea"
        id="pause-company-reason-input"
        name="pause_reason"
        value={@pause_reason}
        label="Reason"
        placeholder="Why are you pausing it?"
        rows={3}
      />
    </form>
    <:footer>
      <button type="button" class="pl" phx-click="hide_pause_modal">Cancel</button>
      <button
        type="button"
        class="pl stop"
        phx-click="pause_company"
        data-confirm={"Pause #{@company.name}? This stops agent dispatch and new runtime launches until the company is resumed."}
      >
        Pause
      </button>
    </:footer>
  </.modal>

  <.modal
    :if={@show_resume_modal}
    id="resume-company-modal"
    show
    title={"Resume #{@company.name}"}
    on_cancel={JS.push("hide_resume_modal")}
  >
    <p class="gl-sub">Resume agents and re-enable dispatching.</p>
    <:footer>
      <button type="button" class="pl" phx-click="hide_resume_modal">Cancel</button>
      <button
        type="button"
        class="pl"
        phx-click="resume_company"
        data-confirm={"Resume #{@company.name}? This re-enables agent dispatch for this company."}
      >
        Resume
      </button>
    </:footer>
  </.modal>
</.page_frame>
