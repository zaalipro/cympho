<div class="ember-aurora p-6 lg:p-8">
  <div class="relative z-[1] mx-auto max-w-6xl">
    <.header>
      <div class="min-w-0">
        <span class="ember-eyebrow">Company dossier</span>
        <h1 class="ember-ink mt-4 font-serif text-[clamp(30px,4.5vw,44px)] font-510 leading-[1.08] tracking-[-0.02em]">
          {@company.name}
        </h1>
        <p class="mt-2 flex flex-wrap items-center gap-2 text-sm text-text-tertiary">
          <code class="rounded bg-black/20 px-2 py-0.5 text-text-secondary">{@company.slug}</code>
          <span class="text-text-quaternary">·</span>
          <span>Created {format_inserted_at(@company)}</span>
        </p>
      </div>
      <:actions>
        <button
          :if={@company.status == "active"}
          phx-click="show_pause_modal"
          class="inline-flex items-center gap-2 rounded-lg border border-amber-500/25 bg-amber-500/10 px-4 py-2 text-sm font-510 text-amber-200 transition-colors hover:bg-amber-500/15"
        >
          <.icon name="hero-pause-mini" class="h-4 w-4" /> Pause Company
        </button>
        <button
          :if={@company.status == "paused"}
          phx-click="show_resume_modal"
          class="inline-flex items-center gap-2 rounded-lg border border-emerald-500/25 bg-emerald-500/10 px-4 py-2 text-sm font-510 text-emerald-300 transition-colors hover:bg-emerald-500/15"
        >
          <.icon name="hero-play-mini" class="h-4 w-4" /> Resume Company
        </button>

        <.app_link
          navigate={~p"/companies/#{@company}/export"}
          class="inline-flex items-center gap-2 cta-glow rounded-button bg-brand px-4 py-2 text-sm font-510 text-on-primary transition-colors hover:bg-accent"
        >
          <.icon name="hero-arrow-down-tray-mini" class="h-4 w-4" /> Export
        </.app_link>

        <.app_link
          navigate={~p"/companies/import"}
          class="inline-flex items-center gap-2 rounded-lg border border-border bg-surface px-4 py-2 text-sm font-510 text-text-primary transition-colors hover:border-brand/40 hover:text-brand"
        >
          <.icon name="hero-arrow-up-tray-mini" class="h-4 w-4" /> Import
        </.app_link>

        <.app_link
          navigate={~p"/companies/#{@company}/edit"}
          class="inline-flex items-center gap-2 rounded-lg border border-border bg-surface px-4 py-2 text-sm font-510 text-text-primary transition-colors hover:border-brand/40 hover:text-brand"
        >
          <.icon name="hero-pencil-square-mini" class="h-4 w-4" /> Edit Company
        </.app_link>

        <.app_link
          navigate={~p"/companies"}
          class="inline-flex items-center px-2 py-2 text-sm text-text-secondary transition-colors hover:text-text-primary"
        >
          Back to Companies
        </.app_link>
      </:actions>
    </.header>

    <div
      :if={@flash && @flash[:info]}
      class="mb-6 bg-success/10 border border-success/20 text-success text-sm px-4 py-3 rounded-lg"
    >
      {@flash[:info]}
    </div>

    <div
      :if={@flash && @flash[:error]}
      class="mb-6 bg-red-500/10 border border-red-500/20 text-red-400 text-sm px-4 py-3 rounded-lg"
    >
      {@flash[:error]}
    </div>

    <div class="stagger-children grid grid-cols-1 lg:grid-cols-4 gap-6 mb-8 mt-2">
      <div class="ember-stat card-lift bg-surface border border-border rounded-xl p-6">
        <div class="text-xs font-510 text-text-secondary uppercase tracking-wider mb-2">
          Company Slug
        </div>
        <div class="font-serif text-2xl font-510 text-text-primary">
          <code class="bg-black/20 px-2 py-1 rounded">{@company.slug}</code>
        </div>
      </div>

      <div class="ember-stat card-lift bg-surface border border-border rounded-xl p-6">
        <div class="text-xs font-510 text-text-secondary uppercase tracking-wider mb-2">
          Status
        </div>
        <div class="font-serif text-2xl font-510">
          <span :if={@company.status == "active"} class="text-green-400">Active</span><span
            :if={@company.status == "paused"}
            class="text-yellow-400"
          >Paused</span>
        </div>
        <div :if={@company.paused_reason} class="text-xs text-text-secondary mt-1">
          {@company.paused_reason}
        </div>
      </div>

      <div class="ember-stat card-lift bg-surface border border-border rounded-xl p-6">
        <div class="text-xs font-510 text-text-secondary uppercase tracking-wider mb-2">
          Members
        </div>
        <div class="font-serif text-2xl font-510 text-text-primary">
          {Enum.count(@memberships)}
        </div>
      </div>

      <div class="ember-stat card-lift bg-surface border border-border rounded-xl p-6">
        <div class="text-xs font-510 text-text-secondary uppercase tracking-wider mb-2">
          Created
        </div>
        <div class="font-serif text-2xl font-510 text-text-primary">
          {format_inserted_at(@company)}
        </div>
      </div>
    </div>

    <div class="ember-glass overflow-hidden">
      <div class="px-6 py-4 border-b border-white/10">
        <p class="font-serif text-[13px] font-510 italic tracking-[0.02em] text-brand/90">Team</p>
        <h2 class="mt-1 font-serif text-lg font-510 text-text-primary">Company Members</h2>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full">
          <thead class="bg-subtle border-b border-border">
            <tr>
              <th class="text-left text-xs font-510 text-text-secondary uppercase tracking-wider px-6 py-3">
                User
              </th>
              <th class="text-left text-xs font-510 text-text-secondary uppercase tracking-wider px-6 py-3">
                Email
              </th>
              <th class="text-left text-xs font-510 text-text-secondary uppercase tracking-wider px-6 py-3">
                Role
              </th>
              <th class="text-right text-xs font-510 text-text-secondary uppercase tracking-wider px-6 py-3">
                Actions
              </th>
            </tr>
          </thead>
          <tbody class="divide-y divide-border">
            <%= for membership <- @memberships do %>
              <tr class="transition-colors hover:bg-subtle hover:shadow-[inset_2px_0_0_0_var(--color-primary)]">
                <td class="px-6 py-4 text-text-primary">
                  {membership.user.name}
                </td>
                <td class="px-6 py-4 text-text-secondary text-sm">
                  {membership.user.email}
                </td>
                <td class="px-6 py-4">
                  <span class="inline-flex items-center px-2 py-1 rounded text-xs font-510 bg-brand/10 text-brand">
                    {role_label(membership.role)}
                  </span>
                </td>
                <td class="px-6 py-4 text-right">
                  <button
                    phx-click="delete_membership"
                    phx-value-id={membership.id}
                    class="text-red-400 hover:text-red-300 text-sm"
                    data-confirm={"Remove #{membership.user.email} from #{@company.name}? They will lose access to this company."}
                  >
                    Remove
                  </button>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <div :if={Enum.empty?(@memberships)} class="text-center py-12">
        <div class="text-text-tertiary text-sm">No members yet. Add users to this company!</div>
      </div>
    </div>

    <div :if={@show_pause_modal} class="fixed inset-0 z-50 flex items-center justify-center">
      <div class="fixed inset-0 bg-black/60" phx-click="hide_pause_modal"></div>
      <div class="relative bg-surface border border-border rounded-xl p-6 max-w-md w-full mx-4">
        <h3 class="text-lg font-510 text-text-primary mb-2">Pause Company</h3>
        <p class="text-sm text-text-secondary mb-4">Pause all agents and stop dispatching.</p>
        <input
          type="text"
          phx-change="update_pause_reason"
          value={@pause_reason}
          name="pause_reason"
          class="w-full bg-black/20 border border-border rounded-lg px-3 py-2 text-sm mb-4"
          placeholder="Reason"
        />
        <div class="flex justify-end gap-3">
          <button
            phx-click="hide_pause_modal"
            class="px-4 py-2 text-sm border border-border rounded-lg"
          >
            Cancel
          </button>
          <button
            phx-click="pause_company"
            data-confirm={"Pause #{@company.name}? This stops agent dispatch and new runtime launches until the company is resumed."}
            class="px-4 py-2 text-sm font-510 bg-yellow-600 text-white rounded-lg"
          >
            Pause
          </button>
        </div>
      </div>
    </div>
    <div :if={@show_resume_modal} class="fixed inset-0 z-50 flex items-center justify-center">
      <div class="fixed inset-0 bg-black/60" phx-click="hide_resume_modal"></div>
      <div class="relative bg-surface border border-border rounded-xl p-6 max-w-md w-full mx-4">
        <h3 class="text-lg font-510 text-text-primary mb-2">Resume Company</h3>
        <p class="text-sm text-text-secondary mb-4">Resume agents and re-enable dispatching.</p>
        <div class="flex justify-end gap-3">
          <button
            phx-click="hide_resume_modal"
            class="px-4 py-2 text-sm border border-border rounded-lg"
          >
            Cancel
          </button>
          <button
            phx-click="resume_company"
            data-confirm={"Resume #{@company.name}? This re-enables agent dispatch for this company."}
            class="px-4 py-2 text-sm font-510 bg-green-600 text-white rounded-lg"
          >
            Resume
          </button>
        </div>
      </div>
    </div>
    <.live_component
      :if={@live_action in [:edit]}
      module={CymphoWeb.CompanyLive.FormComponent}
      id={@company.id}
      title={@page_title}
      action={@live_action}
      company={@company}
      patch={true}
    />
  </div>
</div>
