<.page_frame page="health" title="Health" data-ui-complex-page data-density={@digest_density}>
  <:header_end>
    <.pill phx-click="refresh">Refresh</.pill>
  </:header_end>

  <.flash_line flash={@flash} />

  <%!-- Tier S (v7 O1): the one fix, the state, what to do, what went wrong. --%>
  <% action = List.first(@next_actions) %>
  <% next_path = action && next_step_path(Map.get(action, :target_path)) %>
  <.next_step :if={action} id="op-ns-">
    <:problem>
      <.problem_card title={simple_operations_title(action.title)} title_id="op-ns-t">
        <:eyebrow>Next step<span aria-hidden="true"> · </span>Health</:eyebrow>
        <p class="obj">{simple_operations_body(action.title, action.body)}</p>
      </.problem_card>
    </:problem>
    <:resolution :if={next_path}>
      <.ink_card heading="Do this next" heading_id="op-ns-i">
        <.ink_foot>
          <:primary>
            <.primary_pill :if={anchor_path?(next_path)} href={next_path}>
              {simple_operations_target_label(action.target_label)}
            </.primary_pill>
            <.primary_pill :if={not anchor_path?(next_path)} navigate={next_path}>
              {simple_operations_target_label(action.target_label)}
            </.primary_pill>
          </:primary>
        </.ink_foot>
      </.ink_card>
    </:resolution>
  </.next_step>

  <%!-- The density switch lives here: the page is Advanced-only, so a header
       control wrapped ui-advanced-only would hide nothing (v7 §1.1). --%>
  <.band_card id="op-now-t" title="Right now" section_id="operations-simple-state">
    <:header_end>
      <.density_switch
        density={@digest_density}
        compact_patch={operations_url("compact", @delegated_parent_issue_id)}
        detailed_patch={operations_url("detailed", @delegated_parent_issue_id)}
      />
    </:header_end>
    <div class="op-sec">
      <.now_capsule state={capsule_state(@runtime_mode.status)}>
        <span class="ui-simple-only">{simple_runtime_mode_label(@runtime_mode)}</span>
        <span class="ui-advanced-only">{@runtime_mode.label}</span>
        <:sub>
          {@capacity.running_runs} working · {now_waiting_count(@wake_queue, @review_nudges)} waiting<span class="ui-advanced-only"> · {now_stale_count(@capacity, @wake_queue)} stale</span>
        </:sub>
      </.now_capsule>
      <p
        :if={recent_capacity_denial?(@capacity, @launch_preview, @wake_queue, @review_nudges)}
        data-testid="runtime-admission-simple-reason"
        class="ui-simple-only gl-sub"
      >
        {simple_admission_message(@capacity.admission)}
      </p>
      <p class="ui-advanced-only gl-sub">{@runtime_mode.summary}</p>
      <p class="ui-advanced-only help">
        {@runtime_mode.disabled_services} disabled · {@runtime_mode.not_running_services} not running ·
        <a href="#runtime-capacity" class="ul">capacity details</a>
      </p>
    </div>
  </.band_card>

  <% simple_rows =
    simple_action_queue(
      @delegated_work,
      @owner_signoffs,
      @ceo_outcomes,
      @runtime_enablement,
      @launch_plan
    ) %>
  <.band_card
    id="op-todo-t"
    title={simple_action_queue_title(simple_rows)}
    section_id="operations-simple-action-queue"
    class="ui-simple-only"
    data-testid="operations-simple-action-queue"
  >
    <ul class="rows">
      <.list_row
        :for={row <- simple_rows}
        id={"op-todo-#{row.key}"}
        title={row.title}
        icon={row.icon}
        kind={row_kind(row.tone)}
        data-testid={"operations-simple-action-#{row.key}"}
      >
        <:meta>{row.detail}</:meta>
        <:actions>
          <.pill
            :if={row.action_event}
            phx-click={row.action_event}
            data-testid={"operations-simple-action-button-#{row.key}"}
          >
            {row.action_label}
          </.pill>
          <a
            :if={row.action_path && anchor_path?(row.action_path)}
            class="pl"
            href={row.action_path}
            data-testid={"operations-simple-action-link-#{row.key}"}
          >
            {row.action_label}
          </a>
          <.pill
            :if={row.action_path && not anchor_path?(row.action_path)}
            navigate={row.action_path}
            data-testid={"operations-simple-action-link-#{row.key}"}
          >
            {row.action_label}
          </.pill>
        </:actions>
      </.list_row>
    </ul>
  </.band_card>

  <%!-- Stays visible in simple mode: the "Something went wrong" card on Home
       links straight here, so hiding it would dead-end that flow. --%>
  <.band_card id="op-fail-t" title="Recent failures" section_id="runtime-failures">
    <:header_end :if={@recent_failures != []}>
      <span class="meta mono">{length(@recent_failures)}</span>
    </:header_end>
    <.quiet_empty :if={@recent_failures == []} title="Nothing has failed.">
      Failed runs from the last few days show up here.
    </.quiet_empty>
    <ul :if={@recent_failures != []} class="rows">
      <.list_row
        :for={failure <- @recent_failures}
        id={"op-fail-#{failure.id}"}
        title={failure.title}
        navigate={failure.target_path}
        icon="i-stop"
        kind={:problem}
      >
        <:meta>
          <span class="mono">{failure.category}</span><span :if={failure.agent}><span aria-hidden="true"> · </span>{failure.agent.name}</span><span :if={
            failure.issue
          }><span aria-hidden="true"> · </span><span class="mono">{failure.issue.identifier || short_id(failure.issue.id)}</span></span><span aria-hidden="true"> · </span>{format_relative(
            failure.completed_at || failure.inserted_at
          )}
        </:meta>
        <:below :if={failure.hint || failure.focused_command}>
          <p :if={failure.hint} class="gl-sub op-hint">{failure.hint}</p>
          <details
            :if={failure.focused_command}
            id={"recent-failure-relaunch-#{failure.id}"}
            class="ui-advanced-only earlier op-more"
            phx-mounted={JS.ignore_attributes("open")}
          >
            <summary>Focused relaunch <.r3_icon name="i-chev-down" class="ico s14" /></summary>
            <div
              :if={failure.focused_command}
              id={"recent-failure-focused-command-#{failure.id}"}
              phx-hook="CopyToClipboard"
              class="ui-advanced-only op-cmd"
            >
              <div class="op-cmd-h">
                <span class="gh">Focused relaunch command</span>
                <button
                  type="button"
                  class="pl"
                  data-copy-text={failure.focused_command}
                  data-copy-label="Copy command"
                  data-copy-success-label="Copied"
                >
                  Copy command
                </button>
              </div>
              <code class="op-code mono">{failure.focused_command}</code>
            </div>
          </details>
        </:below>
      </.list_row>
    </ul>
  </.band_card>

  <%!-- Tier A: the operator console, every section in its old order. --%>
  <.band_card
    id="op-launch-t"
    title="Runtime launch checklist"
    section_id="runtime-launch-checklist"
    class="ui-advanced-only"
  >
    <:header_end>
      <span class="op-end">
        <span class="st-w">
          <.status_word
            kind={enablement_kind(@runtime_enablement.status)}
            word={@runtime_enablement.label}
          />
        </span>
        <.text_link
          :if={
            @runtime_enablement.status == :blocked and @runtime_enablement.cleanup_count > 0 and
              @launch_plan.target_path != "#runtime-capacity"
          }
          href="#runtime-capacity"
        >
          Review capacity
        </.text_link>
      </span>
    </:header_end>
    <div class="op-sec">
      <p class="gl-sub">{@runtime_enablement.summary}</p>

      <div
        id="runtime-next-launch-step"
        data-testid="runtime-next-launch-step"
        class={["op-well", well_tone(launch_plan_kind(@launch_plan.tone))]}
      >
        <div class="op-well-h">
          <span class="gh">Next launch step</span>
          <span class="st-w">
            <.status_word kind={launch_plan_kind(@launch_plan.tone)} word={@launch_plan.label} />
          </span>
          <.text_link
            :if={@launch_plan.target_path && anchor_path?(@launch_plan.target_path)}
            href={@launch_plan.target_path}
          >
            {@launch_plan.target_label}
          </.text_link>
          <.text_link
            :if={@launch_plan.target_path && not anchor_path?(@launch_plan.target_path)}
            navigate={@launch_plan.target_path}
          >
            {@launch_plan.target_label}
          </.text_link>
        </div>
        <p class="gl-sub">{@launch_plan.summary}</p>

        <div :if={@launch_plan.issue} class="op-item">
          <.link navigate={@launch_plan.issue.target_path} class="ul op-wrap">
            {@launch_plan.issue.identifier} · {@launch_plan.issue.title}
          </.link>
          <span class="op-tags">
            <span class="tag">{@launch_plan.issue.status_label}</span>
            <span class="st-w">
              <.status_word
                kind={preflight_kind(@launch_plan.issue.preflight_status)}
                word={@launch_plan.issue.preflight_label}
              />
            </span>
          </span>
        </div>

        <div
          :if={Map.get(@launch_plan, :repair_scaffold)}
          id="runtime-next-brief-repair-scaffold"
          phx-hook="CopyToClipboard"
          class="op-cmd"
        >
          <div class="op-cmd-h">
            <span class="gh">Brief repair scaffold</span>
            <button
              type="button"
              class="pl"
              data-copy-text={Map.get(@launch_plan, :repair_scaffold)}
              data-copy-label="Copy repair scaffold"
              data-copy-success-label="Copied"
              data-copy-error-label="Open preview"
            >
              Copy repair scaffold
            </button>
          </div>
          <p class="help">
            Paste this into the issue description, replace placeholders, then refresh this
            checklist.
          </p>
          <%!-- The scaffold is a copy payload, not reading material: the button
               beside it is the interface. --%>
          <details
            id="launch-plan-scaffold-preview"
            class="earlier op-more"
            phx-mounted={JS.ignore_attributes("open")}
          >
            <summary aria-label="Preview the repair scaffold">
              Preview <.r3_icon name="i-chev-down" class="ico s14" />
            </summary>
            <pre class="op-code mono op-pre"><%= Map.get(@launch_plan, :repair_scaffold) %></pre>
          </details>
        </div>

        <%!-- Only render a command here when it is not the broad launch command
             the checklist already prints a few rows below. --%>
        <div
          :if={@launch_plan.command && @launch_plan.command != @runtime_enablement.command}
          id="runtime-next-launch-command"
          phx-hook="CopyToClipboard"
          class="op-cmd"
        >
          <div class="op-cmd-h">
            <span class="gh">{@launch_plan.command_label}</span>
            <button
              type="button"
              class="pl"
              data-copy-text={@launch_plan.command}
              data-copy-label="Copy command"
              data-copy-success-label="Copied"
            >
              Copy command
            </button>
          </div>
          <code class="op-code mono">{@launch_plan.command}</code>
        </div>

        <ol class="op-steps">
          <li :for={step <- @launch_plan.steps} class={step.state == :active && "op-cur"}>
            <span class="op-step-l">{step.label}</span>
            <span class="op-step-d">{step.detail}</span>
          </li>
        </ol>
      </div>

      <div
        :if={@runtime_enablement.command}
        id="runtime-broad-launch-command"
        phx-hook="CopyToClipboard"
        class="op-cmd"
      >
        <div class="op-cmd-h">
          <span class="gh">Broad restart command</span>
          <button
            type="button"
            class="pl"
            data-copy-text={@runtime_enablement.command}
            data-copy-label="Copy command"
            data-copy-success-label="Copied"
          >
            Copy command
          </button>
        </div>
        <code class="op-code mono">{@runtime_enablement.command}</code>
      </div>

      <%!-- The env vars this command sets are the same switches Runtime
           services already lists one by one; link there instead of
           reprinting them. --%>
      <p class="help">
        Every switch this command flips is described in
        <a href="#runtime-services" class="ul">Runtime services</a>
        below.
      </p>
    </div>
  </.band_card>

  <.band_card
    id="op-ceo-flow-t"
    title="CEO flow verification"
    section_id="ceo-flow-verifier"
    class="ui-advanced-only"
    data-testid="ceo-flow-verifier"
  >
    <:header_end>
      <span class="st-w">
        <.status_word kind={ceo_flow_kind(@ceo_flow.stage)} word={@ceo_flow.label} />
      </span>
    </:header_end>
    <div class="op-sec">
      <p class="gl-sub">{@ceo_flow.summary}</p>
      <p class="op-acts">
        <.pill navigate={@ceo_flow.next_action.path}>{@ceo_flow.next_action.label}</.pill>
        <.pill :if={@ceo_flow.ceo_count > 0} phx-click="create_ceo_flow_smoke_issue">
          Create CEO to CTO smoke
        </.pill>
      </p>
    </div>
    <div class="strip op-s4">
      <div :for={step <- @ceo_flow.steps} class="cell">
        <span class="v mono">{step.value}</span>
        <span class="l op-cell-l">
          <.status_glyph kind={ceo_step_kind(step.state)} />{step.label}
        </span>
        <span class="op-cell-d">{step.detail}</span>
      </div>
    </div>

    <div :if={@ceo_flow.primary_candidate} class="op-sec">
      <% candidate = @ceo_flow.primary_candidate %>
      <div class="op-well">
        <div class="op-well-h">
          <span class="gh">Next CEO candidate</span>
          <span class="st-w">
            <.status_word
              kind={preflight_kind(candidate.preflight_status)}
              word={candidate.status_label}
            />
          </span>
        </div>
        <.link navigate={candidate.target_path} class="ul op-wrap">
          {candidate.identifier} · {candidate.title}
        </.link>
        <p class="gl-sub">{candidate.preflight_label} · {candidate.preflight_summary}</p>
        <p :if={candidate.brief_readiness_label} class="op-tags">
          <span class="st-w">
            <.status_word
              kind={brief_kind(candidate.brief_readiness_status)}
              word={"Owner brief #{candidate.brief_readiness_score}"}
            />
          </span>
          <span class="help">
            {candidate.brief_readiness_label} · {candidate.brief_readiness_next}
          </span>
        </p>
        <div
          :if={candidate.brief_repair_scaffold}
          id="ceo-flow-brief-repair-scaffold"
          phx-hook="CopyToClipboard"
          class="op-cmd"
        >
          <div class="op-cmd-h">
            <span class="gh">Brief repair scaffold</span>
            <button
              type="button"
              class="pl"
              data-copy-text={candidate.brief_repair_scaffold}
              data-copy-label="Copy repair scaffold"
              data-copy-success-label="Copied"
              data-copy-error-label="Open preview"
            >
              Copy repair scaffold
            </button>
          </div>
          <details
            id="ceo-flow-scaffold-preview"
            class="earlier op-more"
            phx-mounted={JS.ignore_attributes("open")}
          >
            <summary aria-label="Preview the repair scaffold">
              Preview <.r3_icon name="i-chev-down" class="ico s14" />
            </summary>
            <pre class="op-code mono op-pre"><%= candidate.brief_repair_scaffold %></pre>
          </details>
        </div>
        <div
          :if={candidate.brief}
          id="ceo-flow-candidate-brief"
          data-testid="ceo-flow-candidate-brief"
          phx-hook="CopyToClipboard"
          class="op-cmd"
        >
          <div class="op-cmd-h">
            <span class="gh">Candidate proof packet</span>
            <span class="op-acts">
              <button
                type="button"
                class="pl"
                data-copy-text={candidate.brief}
                data-copy-label="Copy proof packet"
                data-copy-success-label="Copied"
              >
                Copy proof packet
              </button>
              <button
                type="button"
                class="pl"
                data-copy-text={candidate.focused_command}
                data-copy-label="Copy command"
                data-copy-success-label="Copied"
              >
                Copy command
              </button>
            </span>
          </div>
          <p class="help">{candidate.first_turn}</p>
          <code class="op-code mono">{candidate.focused_command}</code>
        </div>
      </div>
    </div>
  </.band_card>

  <.band_card id="op-preview-t" title="Launch preview" class="ui-advanced-only">
    <:header_end>
      <span class="op-end">
        <button
          :if={@launch_preview.focused_count > 0}
          id="runtime-clear-focused-queue"
          type="button"
          class="pl"
          phx-click="clear_all_dispatch_focus"
          data-confirm={
            "Clear focused dispatch from #{@launch_preview.focused_count} #{plural_noun(@launch_preview.focused_count, "issue")}?"
          }
        >
          Clear focused queue
        </button>
        <span class="meta">
          {@launch_preview.total_candidates} {plural_noun(
            @launch_preview.total_candidates,
            "candidate"
          )}
        </span>
      </span>
    </:header_end>
    <div class="op-sec">
      <p class="gl-sub">{launch_preview_summary(@runtime_mode, @launch_preview)}</p>
      <p :if={@launch_preview.total_candidates > 0} class="op-tags">
        <span :if={@launch_preview.focused_count > 0} class="tag">
          {@launch_preview.focused_count} focused
        </span>
        <span class="st-w">
          <.status_word kind={:done} word={"#{@launch_preview.preflight_counts.ready} ready"} />
        </span>
        <span :if={@launch_preview.preflight_counts.route_first > 0} class="st-w">
          <.status_word
            kind={:waiting}
            word={"#{@launch_preview.preflight_counts.route_first} route first"}
          />
        </span>
        <span :if={@launch_preview.preflight_counts.attention > 0} class="st-w">
          <.status_word
            kind={:waiting}
            word={"#{@launch_preview.preflight_counts.attention} config checks"}
          />
        </span>
        <span :if={@launch_preview.preflight_counts.blocked > 0} class="st-w">
          <.status_word
            kind={:stopped}
            word={"#{@launch_preview.preflight_counts.blocked} blocked"}
          />
        </span>
        <span :if={@launch_preview.preflight_counts.review_mode > 0} class="st-w">
          <.status_word
            kind={:idle}
            word={"#{@launch_preview.preflight_counts.review_mode} review mode"}
          />
        </span>
      </p>
      <p :if={@launch_preview.candidates == []} class="gl-sub">
        No runnable issue candidates are waiting. Create or assign a To Do/In Review issue
        before enabling dispatch.
      </p>
      <% shared_blocker = shared_preflight_blocker(@launch_preview.candidates) %>
      <p :if={shared_blocker} class="help">
        <b>Every candidate is waiting on the same fix:</b>
        {shared_blocker}
      </p>
    </div>

    <ul :if={@launch_preview.candidates != []} class="rows op-scroll">
      <.list_row
        :for={candidate <- @launch_preview.candidates}
        id={"op-candidate-#{candidate.id}"}
        title={"#{candidate.identifier} · #{candidate.title}"}
        navigate={~p"/issues/#{candidate.id}"}
        status={{preflight_kind(candidate.preflight.status), candidate.preflight.label}}
      >
        <:meta>
          {candidate.project_name} · {candidate.assignee_name} · {candidate.role_label}
        </:meta>
        <:trail>
          <span class="op-tags">
            <span class="tag mono">#{candidate.dispatch_order} · {candidate.dispatch_label}</span>
            <span class="tag">{candidate.status_label}</span>
            <.pri priority={candidate.priority} label={candidate.priority_label} />
          </span>
        </:trail>
        <:below>
          <%!-- The row's status already says the preflight result, so this box
               keeps only the detail. "Agent preflight" stays as the group's
               accessible name. --%>
          <div
            role="group"
            aria-label="Agent preflight"
            title={candidate.preflight.summary}
            class="op-well"
          >
            <%!-- When one fix unblocks the whole queue, the line above says
                 so once. The row keeps its fix link: that target is the
                 candidate's own agent. --%>
            <p :if={is_nil(shared_blocker)} class="help">{candidate.preflight.summary}</p>
            <p :if={candidate.preflight.first_action} class="help">
              <span :if={is_nil(shared_blocker)}>
                <b>{candidate.preflight.first_action.label}:</b>
                {candidate.preflight.first_action.detail}
              </span>
              <.link
                :if={preflight_action_target_path(candidate.preflight.first_action)}
                navigate={preflight_action_target_path(candidate.preflight.first_action)}
                class="ul"
              >
                {preflight_action_target_label(candidate.preflight.first_action)}
              </.link>
            </p>
            <details
              id={"runtime-preflight-checks-#{candidate.id}"}
              class="earlier op-more"
              phx-mounted={JS.ignore_attributes("open")}
            >
              <summary title="View preflight checks" aria-label="View preflight checks">
                Checks <.r3_icon name="i-chev-down" class="ico s14" />
              </summary>
              <ul class="op-checks">
                <li :for={item <- candidate.preflight.items}>
                  <.status_glyph kind={readiness_kind(item.status)} />
                  <span class="op-check-l">{item.label}</span>
                  <span class="op-check-d" title={item.detail}>{item.detail}</span>
                </li>
              </ul>
            </details>
          </div>
          <div
            :if={candidate.ceo_launch_brief}
            id={"runtime-ceo-launch-brief-#{candidate.id}"}
            phx-hook="CopyToClipboard"
            class="op-cmd"
          >
            <div class="op-cmd-h">
              <span class="gh">CEO launch brief</span>
              <button
                type="button"
                class="pl"
                data-copy-text={candidate.ceo_launch_brief}
                data-copy-label="Copy CEO brief"
                data-copy-success-label="Copied"
              >
                Copy CEO brief
              </button>
            </div>
            <%!-- Both paragraphs below are static template text, identical for
                 every CEO candidate in the queue; collapsed, the row keeps its
                 label and copy button. --%>
            <details
              id={"runtime-ceo-brief-asks-#{candidate.id}"}
              class="earlier op-more"
              phx-mounted={JS.ignore_attributes("open")}
            >
              <summary title="What this brief asks the CEO to do">
                What it asks <.r3_icon name="i-chev-down" class="ico s14" />
              </summary>
              <p class="help">
                First turn: Return `[owner_update]`, `[handoff]`, or `[blocked]`; when
                execution is needed, create 2-5 scoped child issues with acceptance criteria
                and block the parent as waiting on delegated sub-work.
              </p>
              <p class="help">
                No provider call. This brief only reads routing, preflight, and issue state.
              </p>
            </details>
            <div :if={candidate.brief_repair_scaffold} class="op-cmd-h op-cmd-end">
              <button
                type="button"
                class="pl"
                data-copy-text={candidate.brief_repair_scaffold}
                data-copy-label="Copy repair scaffold"
                data-copy-success-label="Copied"
                data-copy-error-label="Open preview"
              >
                Copy repair scaffold
              </button>
            </div>
            <details
              :if={candidate.brief_repair_scaffold}
              id={"runtime-ceo-brief-scaffold-#{candidate.id}"}
              class="earlier op-more"
              phx-mounted={JS.ignore_attributes("open")}
            >
              <summary aria-label="Preview the repair scaffold">
                Preview <.r3_icon name="i-chev-down" class="ico s14" />
              </summary>
              <pre class="op-code mono op-pre"><%= candidate.brief_repair_scaffold %></pre>
            </details>
          </div>
          <details
            id={"runtime-launch-focus-#{candidate.id}"}
            class="earlier op-more"
            phx-mounted={JS.ignore_attributes("open")}
          >
            <summary title="Focus this issue" aria-label="Focus this issue">
              Focused command <.r3_icon name="i-chev-down" class="ico s14" />
            </summary>
            <div
              id={"runtime-focused-launch-command-#{candidate.id}"}
              phx-hook="CopyToClipboard"
              class="op-cmd"
            >
              <div class="op-cmd-h">
                <span class="gh">Focused restart command</span>
                <button
                  type="button"
                  class="pl"
                  data-copy-text={candidate.focused_command}
                  data-copy-label="Copy command"
                  data-copy-success-label="Copied"
                >
                  Copy command
                </button>
              </div>
              <code class="op-code mono">{candidate.focused_command}</code>
            </div>
          </details>
        </:below>
        <:actions>
          <button
            :if={!candidate.dispatch_pinned?}
            id={"runtime-queue-dispatch-focus-#{candidate.id}"}
            type="button"
            class="pl"
            phx-click="prioritize_dispatch"
            phx-value-issue-id={candidate.id}
          >
            Run this one first
          </button>
          <button
            :if={candidate.dispatch_pinned?}
            id={"runtime-clear-dispatch-focus-#{candidate.id}"}
            type="button"
            class="pl"
            phx-click="clear_dispatch_focus"
            phx-value-issue-id={candidate.id}
          >
            Clear dispatch focus
          </button>
        </:actions>
      </.list_row>
    </ul>
    <p :if={launch_preview_footer(@launch_preview)} class="op-foot">
      {launch_preview_footer(@launch_preview)}
    </p>
  </.band_card>

  <p class="gh ui-advanced-only">Queue</p>

  <.band_card
    id="op-signoff-t"
    title="Owner signoff queue"
    section_id="owner-signoff-queue"
    class="ui-advanced-only"
  >
    <:header_end>
      <span class="st-w">
        <.status_word
          kind={if @owner_signoffs.count > 0, do: :waiting, else: :idle}
          word={"#{@owner_signoffs.count} waiting"}
        />
      </span>
    </:header_end>
    <div class="op-sec">
      <p class="gl-sub">{@owner_signoffs.summary}</p>
      <p :if={@owner_signoffs.entries == []} class="help">
        Completed CEO work that needs owner acceptance will appear here.
      </p>
    </div>
    <ul :if={@owner_signoffs.entries != []} class="rows">
      <.list_row
        :for={signoff <- @owner_signoffs.entries}
        id={"op-signoff-#{signoff.issue_id}"}
        title={"#{signoff.issue_identifier} · #{signoff.issue_title}"}
        navigate={signoff.target_path}
        icon="i-question"
        kind={:question}
        data-testid="owner-signoff-row"
      >
        <:meta>
          {signoff.assignee_name} · {signoff.project_name} · {signoff.issue_status_label} · {signoff.issue_priority_label} · {format_relative(
            signoff.inserted_at
          )}
        </:meta>
        <:actions>
          <button
            type="button"
            class="pl"
            phx-click="accept_owner_verification"
            phx-value-issue-id={signoff.issue_id}
            data-confirm="Accept this CEO owner update and close the issue?"
          >
            Accept and close
          </button>
          <button
            type="button"
            class="pl"
            phx-click="request_owner_revision"
            phx-value-issue-id={signoff.issue_id}
            data-confirm="Request a CEO revision, reopen this issue to To Do, and queue focused dispatch?"
          >
            Request revision
          </button>
        </:actions>
        <:below>
          <p class="help">
            <span class="tag">Owner decision</span>
            {signoff.owner_update || signoff.blocker ||
              "CEO requested owner acceptance for this issue."}
          </p>
        </:below>
      </.list_row>
    </ul>
    <p :if={@owner_signoffs.scanned > @owner_signoffs.shown} class="op-foot">
      Showing first {@owner_signoffs.shown} of {@owner_signoffs.scanned} owner signoffs.
    </p>
  </.band_card>

  <%!-- Both consoles below are advanced-only: simple mode already shows the
       same work as plain rows in #operations-simple-action-queue. --%>
  <.band_card
    id="op-delegated-t"
    title="Delegated work queue"
    section_id="delegated-work-queue"
    class="ui-advanced-only"
  >
    <:header_end>
      <span class="op-end">
        <span class="meta mono">{@delegated_work.count} open</span>
        <button
          :if={@delegated_work.count > 0}
          type="button"
          class="pl"
          phx-click="prioritize_delegated_work"
          disabled={@delegated_work.queueable_count == 0}
        >
          <span class="ui-simple-only">Focus queue</span>
          <span class="ui-advanced-only">Queue runnable work</span>
        </button>
        <.text_link :if={@delegated_work.count > 0} href="#runtime-launch-checklist">
          Open launch preview
        </.text_link>
      </span>
    </:header_end>
    <div class="op-sec">
      <p class="gl-sub">{@delegated_work.summary}</p>
      <p :if={@delegated_work.count > 0} class="op-tags">
        <span class="st-w">
          <.status_word kind={:done} word={"#{@delegated_work.queueable_count} runnable"} />
        </span>
        <span :if={@delegated_work.pinned_count > 0} class="tag">
          {@delegated_work.pinned_count} focused
        </span>
        <span :if={@delegated_work.setup_blocked_count > 0} class="st-w">
          <.status_word
            kind={:stopped}
            word={"#{@delegated_work.setup_blocked_count} setup blocked"}
          />
        </span>
        <span :if={@delegated_work.dependency_blocked_count > 0} class="st-w">
          <.status_word
            kind={:waiting}
            word={"#{@delegated_work.dependency_blocked_count} dependency blocked"}
          />
        </span>
        <span :if={@delegated_work.attention_count > 0} class="st-w">
          <.status_word kind={:waiting} word={"#{@delegated_work.attention_count} review setup"} />
        </span>
      </p>
      <p :if={@delegated_work.filtered?} class="op-tags">
        <span class="tag">Filtered to {@delegated_work.parent_identifier}</span>
        <.link :if={@delegated_work.parent_path} navigate={@delegated_work.parent_path} class="ul">
          {@delegated_work.parent_title}
        </.link>
        <.text_link navigate="/operations#delegated-work-queue">
          Show all delegated work
        </.text_link>
      </p>
      <p :if={@delegated_work.entries == []} class="help">{@delegated_work.empty_hint}</p>
    </div>

    <div
      :if={show_operations_swarm_log?(@delegated_work, @swarm_event_rows)}
      data-testid="operations-swarm-log"
      class="op-sec op-swarm"
    >
      <div class="op-well-h">
        <span class="gh">Live swarm log</span>
        <span class="tag">Latest first</span>
        <span class="tag mono">{length(@swarm_event_rows)} events</span>
      </div>
      <p class="help">Workers feed CTO synthesis, then the CEO gets the handoff.</p>
      <p :if={@swarm_event_rows == []} class="help">Waiting for the first swarm event.</p>
      <ol :if={@swarm_event_rows != []} class="op-log">
        <li :for={event <- @swarm_event_rows}>
          <span class="op-log-t mono">
            <.status_glyph kind={swarm_kind(event.status)} />{event.time}
          </span>
          <span class="op-log-m">
            <b>{event.type_label}</b><span aria-hidden="true"> · </span>{event.message}
            <span :if={event.chips != []} class="op-tags">
              <span :for={chip <- event.chips} class="tag">{chip}</span>
            </span>
          </span>
        </li>
      </ol>
    </div>

    <ul :if={@delegated_work.entries != []} class="rows">
      <.list_row
        :for={work <- @delegated_work.entries}
        id={"op-delegated-#{work.issue_id}"}
        title={"#{work.issue_identifier} · #{work.issue_title}"}
        navigate={work.target_path}
        status={{preflight_kind(work.preflight.status), work.preflight.label}}
        data-testid="delegated-work-row"
      >
        <:meta>
          {work.assignee_name} · {work.role_label} · {work.project_name}
        </:meta>
        <:trail>
          <span class="op-tags">
            <span class="tag">{work.work_kind_label}</span>
            <span class="tag mono">#{work.dispatch_order} · {work.dispatch_label}</span>
            <span class="tag">{work.issue_status_label}</span>
            <.pri priority={work.issue_priority} label={work.issue_priority_label} />
          </span>
        </:trail>
        <:below>
          <p class="help">
            From
            <.link :if={work.parent_path} navigate={work.parent_path} class="ul">
              {work.parent_identifier} · {work.parent_title}
            </.link>
            <span :if={!work.parent_path}>{work.parent_identifier} · {work.parent_title}</span>
            · delegated by {work.created_by_name} · {format_relative(work.inserted_at)}
          </p>
          <p :if={work.blocked?} class="op-well w help">
            Blocked by {work.blocker_count} upstream {plural_noun(work.blocker_count, "issue")};
            clear the blocker before runtime can execute it.
          </p>
          <div class="op-well">
            <div class="op-well-h">
              <span class="gh">Owner preflight</span>
            </div>
            <p class="help">{work.preflight.summary}</p>
            <p :if={work.preflight.first_action} class="help">
              <b>{work.preflight.first_action.label}:</b>
              {work.preflight.first_action.detail}
              <.link
                :if={preflight_action_target_path(work.preflight.first_action)}
                navigate={preflight_action_target_path(work.preflight.first_action)}
                class="ul"
              >
                {preflight_action_target_label(work.preflight.first_action)}
              </.link>
            </p>
          </div>
          <div
            id={"delegated-work-focused-command-#{work.issue_id}"}
            phx-hook="CopyToClipboard"
            class="op-cmd"
          >
            <div class="op-cmd-h">
              <span class="gh">Focused restart command</span>
              <button
                type="button"
                class="pl"
                data-copy-text={work.focused_command}
                data-copy-label="Copy command"
                data-copy-success-label="Copied"
              >
                Copy command
              </button>
            </div>
            <code class="op-code mono">{work.focused_command}</code>
          </div>
        </:below>
        <:actions>
          <button
            :if={work.queueable?}
            id={"delegated-work-queue-dispatch-focus-#{work.issue_id}"}
            type="button"
            class="pl"
            phx-click="prioritize_dispatch"
            phx-value-issue-id={work.issue_id}
          >
            <span class="ui-simple-only">Focus CTO</span>
            <span class="ui-advanced-only">Run this one first</span>
          </button>
          <button
            :if={work.dispatch_pinned?}
            id={"delegated-work-clear-dispatch-focus-#{work.issue_id}"}
            type="button"
            class="pl"
            phx-click="clear_dispatch_focus"
            phx-value-issue-id={work.issue_id}
          >
            Clear dispatch focus
          </button>
          <.pill
            :if={delegated_work_setup_action?(work)}
            id={"delegated-work-fix-setup-#{work.issue_id}"}
            navigate={preflight_action_target_path(work.preflight.first_action)}
          >
            {delegated_work_setup_action_label(work)}
          </.pill>
          <span
            :if={
              !work.queueable? && !work.dispatch_pinned? && !work.setup_blocked? &&
                !work.preflight_attention? && !work.blocked?
            }
            class="tag"
          >
            Review setup first
          </span>
        </:actions>
      </.list_row>
    </ul>
    <p :if={@delegated_work.scanned > @delegated_work.shown} class="op-foot">
      Showing first {@delegated_work.shown} of {@delegated_work.scanned} delegated work items.
    </p>
  </.band_card>

  <.band_card
    id="op-nudges-t"
    title="Review nudges"
    section_id="review-nudges"
    class="ui-advanced-only"
  >
    <div class="op-sec">
      <p class="gl-sub">
        Evidence, review, and owner-update requests waiting across the company.
      </p>
    </div>
    <div :if={@review_nudges.counts.total > 0} class="strip op-s4">
      <div class="cell">
        <span class="v mono">{@review_nudges.counts.active}</span><span class="l">Active</span>
      </div>
      <div class="cell">
        <span class="v mono">{@review_nudges.counts.stale}</span><span class="l">Stale</span>
      </div>
      <div class="cell">
        <span class="v mono">{@review_nudges.counts.running}</span><span class="l">Running</span>
      </div>
      <div class="cell">
        <span class="v mono">{@review_nudges.counts.cleared}</span><span class="l">Cleared</span>
      </div>
    </div>
    <.quiet_empty
      :if={@review_nudges.counts.total == 0}
      title="No review nudges have been queued yet."
    />

    <div :if={@review_nudges.counts.total > 0} class="op-grid">
      <div class="op-sec">
        <p class="op-gh">
          <span class="gh">By agent</span><span class="meta">{@review_nudges.counts.active} active</span>
        </p>
        <p :if={@review_nudges.by_agent == []} class="help">No active agent nudges.</p>
        <ul :if={@review_nudges.by_agent != []} class="op-groups">
          <li :for={group <- @review_nudges.by_agent}>
            <span class="op-group-n">{group.label}</span>
            <span class="mono">{group.count}</span>
            <span class="help">{group.stale} stale · {group.running} running</span>
          </li>
        </ul>
      </div>
      <div class="op-sec">
        <p class="op-gh">
          <span class="gh">By blocker</span><span class="meta">Top wait states</span>
        </p>
        <p :if={@review_nudges.by_blocker == []} class="help">No active blocker groups.</p>
        <ul :if={@review_nudges.by_blocker != []} class="op-groups">
          <li :for={group <- @review_nudges.by_blocker}>
            <span class="op-group-n">{group.label}</span>
            <span class="mono">{group.count}</span>
            <span class="help">{group.stale} stale · {group.running} running</span>
          </li>
        </ul>
      </div>
    </div>

    <p :if={@review_nudges.active != []} class="gh op-sub-h">Active queue</p>
    <ul :if={@review_nudges.active != []} class="rows">
      <.list_row
        :for={nudge <- @review_nudges.active}
        id={"op-nudge-#{nudge.id}"}
        title={"#{nudge.issue_identifier || short_id(nudge.issue_id)} · #{nudge.issue_title}"}
        status={{nudge_kind(nudge.lifecycle), nudge.status_label}}
      >
        <:meta>
          Waiting {format_duration(nudge.age_seconds)} · {Enum.join(nudge.blocker_labels, ", ")} · Owner: {nudge.agent_name}
        </:meta>
        <:below>
          <p class="help">{nudge.summary}</p>
        </:below>
        <:actions>
          <.pill :if={nudge.issue} navigate={~p"/issues/#{nudge.issue.id}"}>Open issue</.pill>
          <.pill :if={nudge.next_action} navigate={nudge.next_action.path}>
            {nudge.next_action.label}
          </.pill>
          <.pill :if={nudge.agent} navigate={~p"/agents/#{nudge.agent.id}?tab=inbox"}>
            Open agent
          </.pill>
          <.pill phx-click="clear_review_nudge" phx-value-id={nudge.id}>Mark handled</.pill>
        </:actions>
      </.list_row>
    </ul>

    <p :if={@review_nudges.cleared != []} class="gh op-sub-h">Recently cleared</p>
    <ul :if={@review_nudges.cleared != []} class="rows">
      <.list_row
        :for={nudge <- @review_nudges.cleared}
        id={"op-nudge-#{nudge.id}"}
        title={"#{nudge.issue_identifier || short_id(nudge.issue_id)} · #{nudge.issue_title}"}
        status={{nudge_kind(nudge.lifecycle), nudge.status_label}}
      >
        <:meta>{Enum.join(nudge.blocker_labels, ", ")} · {nudge.agent_name}</:meta>
      </.list_row>
    </ul>
  </.band_card>

  <.band_card
    id="op-wakes-t"
    title="Pending tasks"
    section_id="wake-backlog"
    class="ui-advanced-only"
  >
    <:header_end>
      <button
        :if={@wake_queue.counts.stale_comments > 0}
        type="button"
        class="pl"
        phx-click="clear_stale_comment_wakes"
      >
        Clear stale wakes
      </button>
    </:header_end>
    <div class="op-sec">
      <p class="gl-sub">
        Stale comment wakes that still occupy agent queue room. Clearing them leaves issue comments intact.
      </p>
      <p class="help">
        {@wake_queue.summary} Stale threshold: {@wake_queue.stale_after_minutes} minutes
      </p>
    </div>
    <div
      :if={@wake_queue.counts.pending_comments > 0 or @wake_queue.counts.stale_comments > 0}
      class="strip"
    >
      <div class="cell">
        <span class="v mono">{@wake_queue.counts.pending_comments}</span><span class="l">Pending</span>
      </div>
      <div class="cell">
        <span class="v mono">{@wake_queue.counts.stale_comments}</span><span class="l">Stale</span>
      </div>
    </div>
    <.quiet_empty
      :if={@wake_queue.counts.stale_comments == 0}
      title="No stale comment wakes are holding queue slots."
    />
    <div :if={@wake_queue.counts.stale_comments > 0} class="op-grid">
      <div class="op-sec">
        <p class="op-gh">
          <span class="gh">By agent</span><span class="meta">{@wake_queue.counts.stale_comments} stale</span>
        </p>
        <p :if={@wake_queue.by_agent == []} class="help">No stale agent groups.</p>
        <ul :if={@wake_queue.by_agent != []} class="op-groups">
          <li :for={group <- @wake_queue.by_agent}>
            <span class="op-group-n">{group.label}</span>
            <span class="mono">{group.count}</span>
            <span class="help">Oldest waiting {format_duration(group.oldest_seconds)}</span>
          </li>
        </ul>
      </div>
      <div class="op-sec">
        <p class="op-gh"><span class="gh">Oldest stale wakes</span></p>
        <ul class="rows">
          <.list_row
            :for={wake <- @wake_queue.entries}
            id={"op-wake-#{wake.id}"}
            title={"#{wake.issue_identifier || short_id(wake.issue_id)} · #{wake.issue_title || "Untitled issue"}"}
            status={{:waiting, wake.reason_label}}
          >
            <:meta>Waiting {format_duration(wake.age_seconds)} · Owner: {wake.agent_name}</:meta>
            <:actions>
              <.pill :if={wake.issue} navigate={~p"/issues/#{wake.issue.id}"}>Open issue</.pill>
              <.pill :if={wake.agent} navigate={~p"/agents/#{wake.agent.id}?tab=inbox"}>
                Open agent
              </.pill>
            </:actions>
          </.list_row>
        </ul>
      </div>
    </div>
  </.band_card>

  <p class="gh ui-advanced-only">Ledger</p>

  <.band_card
    id="op-ceo-t"
    title="CEO outcome monitor"
    section_id="ceo-outcome-monitor"
    class="ui-advanced-only"
  >
    <:header_end><span class="meta mono">{@ceo_outcomes.counts.recent} recent</span></:header_end>
    <div data-testid="ceo-outcome-header" class="op-sec">
      <p class="gl-sub">{@ceo_outcomes.summary}</p>
      <div data-testid="ceo-outcome-health-strip" class="strip op-s3">
        <div class="cell">
          <span class="v mono">{ceo_outcome_signal_count(@ceo_outcomes.counts)}</span><span class="l">Signal</span>
        </div>
        <div class="cell">
          <span class="v mono">
            {"#{@ceo_outcomes.counts.receipt_complete}/#{@ceo_outcomes.counts.receipt_checked}"}
          </span>
          <span class="l">Receipts</span>
        </div>
        <div class="cell">
          <span class="v mono">{@ceo_outcomes.counts.attention}</span>
          <span class="l op-cell-l">
            <.status_glyph :if={@ceo_outcomes.counts.attention > 0} kind={:waiting} />Attention
          </span>
        </div>
      </div>
      <dl data-testid="ceo-outcome-metrics" class="op-metrics">
        <div :for={metric <- ceo_outcome_metric_cards(@ceo_outcomes.counts)}>
          <dt>{metric.label}</dt>
          <dd class="mono">{metric.value}</dd>
          <dd class="help" title={metric.detail}>{metric.detail}</dd>
        </div>
      </dl>
    </div>
    <p :if={@ceo_outcomes.entries == []} class="op-sec help">
      No CEO action outcomes are available yet. Run a focused CEO issue, then refresh this
      page to inspect the first-turn result.
    </p>
    <ul :if={@ceo_outcomes.entries != []} class="rows">
      <.list_row
        :for={outcome <- @ceo_outcomes.entries}
        id={"op-ceo-#{outcome.id}"}
        title={"#{outcome.issue_identifier} · #{outcome.issue_title}"}
        navigate={outcome.target_path}
        status={{ceo_outcome_kind(outcome.outcome), outcome.outcome_label}}
        data-testid="ceo-outcome-row"
      >
        <:meta>
          {outcome.agent_name} · {outcome.project_name} · {outcome.issue_status_label}
        </:meta>
        <:trail>
          <span class="op-tags">
            <span :if={Map.get(outcome, :occurrences, 1) > 1} class="tag">
              {outcome.occurrences} {plural_noun(outcome.occurrences, "attempt")}
            </span>
            <span class="tag">{outcome.action_label}</span>
            <span class="tag">{format_relative(outcome.inserted_at)}</span>
          </span>
        </:trail>
        <:below>
          <p class="help">{outcome.detail}</p>
          <p :if={outcome.receipt} class="op-tags">
            <span class="st-w">
              <.status_word
                kind={receipt_kind(outcome.receipt.status)}
                word={outcome.receipt.status_label}
              />
            </span>
            <span class="help">{outcome.receipt.summary}</span>
          </p>
          <details
            :if={repairable_ceo_outcome?(outcome)}
            id={"ceo-outcome-repair-#{outcome.id}"}
            class="earlier op-more"
            phx-mounted={JS.ignore_attributes("open")}
          >
            <summary>
              {ceo_outcome_repair_label(outcome)} <.r3_icon name="i-chev-down" class="ico s14" />
            </summary>
            <div
              id={"ceo-outcome-focused-command-#{outcome.id}"}
              phx-hook="CopyToClipboard"
              class="op-cmd"
            >
              <div class="op-cmd-h">
                <span class="gh">Focused relaunch command</span>
                <button
                  type="button"
                  class="pl"
                  data-copy-text={outcome.focused_command}
                  data-copy-label="Copy command"
                  data-copy-success-label="Copied"
                >
                  Copy command
                </button>
              </div>
              <p class="help">{ceo_outcome_repair_detail(outcome)}</p>
              <code class="op-code mono">{outcome.focused_command}</code>
            </div>
          </details>
        </:below>
      </.list_row>
    </ul>
    <p :if={@ceo_outcomes.scanned > @ceo_outcomes.shown} class="op-foot">
      Showing first {@ceo_outcomes.shown} of {@ceo_outcomes.groups} grouped CEO outcomes from {@ceo_outcomes.scanned} recent actions.
      <span :if={@ceo_outcomes.collapsed > 0}>
        {@ceo_outcomes.collapsed} duplicate {plural_noun(@ceo_outcomes.collapsed, "row")} collapsed.
      </span>
    </p>
  </.band_card>

  <.band_card
    id="op-doctor-t"
    title="Operations doctor"
    section_id="operations-doctor"
    class="ui-advanced-only"
  >
    <:header_end>
      <span class="st-w">
        <.status_word kind={doctor_kind(@doctor.level)} word={@doctor.label} />
      </span>
    </:header_end>
    <div class="op-sec">
      <p class="gl-sub">{@doctor.summary}</p>
      <details
        id="doctor-help"
        class="earlier op-more"
        phx-mounted={JS.ignore_attributes("open")}
      >
        <summary aria-label="How Operations Doctor works">
          How this is diagnosed <.r3_icon name="i-chev-down" class="ico s14" />
        </summary>
        <p class="help">
          Doctor combines company-visible service gates, staffing gaps, adapter health,
          recent runtime failures, review nudges, and configured capacity into one
          operator checklist.
        </p>
      </details>
    </div>
    <div class="strip op-s3">
      <div class="cell">
        <span class="v mono">{@doctor.counts.critical}</span>
        <span class="l op-cell-l">
          <.status_glyph :if={@doctor.counts.critical > 0} kind={:stopped} />Fix
        </span>
      </div>
      <div class="cell">
        <span class="v mono">{@doctor.counts.warning}</span>
        <span class="l op-cell-l">
          <.status_glyph :if={@doctor.counts.warning > 0} kind={:waiting} />Watch
        </span>
      </div>
      <div class="cell">
        <span class="v mono">{@doctor.counts.ok}</span><span class="l">Clear</span>
      </div>
    </div>

    <div
      :for={finding <- Enum.take(@doctor.findings, 1)}
      data-testid="operations-doctor-next-fix"
      class="ui-simple-only op-sec"
    >
      <p class="op-well-h">
        <span class="st-w">
          <.status_word kind={doctor_kind(finding.severity)} word="Next fix" />
        </span>
        <b>{finding.title}</b>
      </p>
      <p class="help">{finding.fix}</p>
    </div>

    <ul class="rows">
      <.list_row
        :for={finding <- @doctor.findings}
        id={"op-finding-#{String.replace(finding.title, ~r/\s+/, "-")}"}
        title={finding.title}
        icon={if finding.severity == :critical, do: "i-alert", else: "i-shield"}
        kind={if finding.severity == :critical, do: :problem, else: :neutral}
        status={{doctor_kind(finding.severity), finding.label}}
      >
        <:meta>{finding.body}</:meta>
        <:below>
          <details
            id={"doctor-finding-help-#{String.replace(finding.title, ~r/\s+/, "-")}"}
            class="earlier op-more"
            phx-mounted={JS.ignore_attributes("open")}
          >
            <summary aria-label={"Why #{finding.title}?"}>
              Why this matters <.r3_icon name="i-chev-down" class="ico s14" />
            </summary>
            <p class="help">{finding.why}</p>
            <p class="help"><b>Recommended fix</b> {finding.fix}</p>
          </details>
          <p
            :if={Map.get(finding, :target_path) || Map.get(finding, :command)}
            class="op-acts"
          >
            <.text_link
              :if={Map.get(finding, :target_path) && anchor_path?(finding.target_path)}
              href={finding.target_path}
            >
              {finding.target_label}
            </.text_link>
            <.text_link
              :if={Map.get(finding, :target_path) && not anchor_path?(finding.target_path)}
              navigate={finding.target_path}
            >
              {finding.target_label}
            </.text_link>
            <.text_link
              :if={
                Map.get(finding, :secondary_target_path) &&
                  anchor_path?(finding.secondary_target_path)
              }
              href={finding.secondary_target_path}
            >
              {finding.secondary_target_label}
            </.text_link>
            <.text_link
              :if={
                Map.get(finding, :secondary_target_path) &&
                  not anchor_path?(finding.secondary_target_path)
              }
              navigate={finding.secondary_target_path}
            >
              {finding.secondary_target_label}
            </.text_link>
            <%!-- The broad launch command is printed once, in the Runtime
                 launch checklist; findings that just need it link there. --%>
            <.text_link
              :if={Map.get(finding, :command) && finding.command == @runtime_enablement.command}
              href="#runtime-launch-checklist"
            >
              Launch command
            </.text_link>
            <code
              :if={Map.get(finding, :command) && finding.command != @runtime_enablement.command}
              class="op-code mono op-inline"
            >
              {finding.command}
            </code>
          </p>
        </:below>
      </.list_row>
    </ul>
  </.band_card>

  <.band_card
    id="op-radar-t"
    title="Prompt drift radar"
    section_id="prompt-drift-radar"
    class="ui-advanced-only"
  >
    <:header_end>
      <span class="st-w">
        <.status_word
          kind={if @prompt_radar.counts.watchlist == 0, do: :done, else: :waiting}
          word={"#{@prompt_radar.counts.watchlist} need review"}
        />
      </span>
    </:header_end>
    <div class="op-sec">
      <p class="gl-sub">{@prompt_radar.summary}</p>
      <details
        id="prompt-radar-help"
        class="earlier op-more"
        phx-mounted={JS.ignore_attributes("open")}
      >
        <summary aria-label="How Prompt Drift Radar works">
          How this is diagnosed <.r3_icon name="i-chev-down" class="ico s14" />
        </summary>
        <p class="help">
          Radar analyzes every active agent's Instruction Studio score, prompt
          eval fixture coverage, and latest saved revision delta. It catches weak
          custom instructions, guardrail conflicts, and score regressions before
          they create noisy tickets.
        </p>
      </details>
      <p :if={@prompt_radar.watchlist != []} class="op-acts">
        <.pill phx-click="preview_prompt_plan" phx-value-scope="watchlist">
          Preview all safe patches
        </.pill>
        <span class="help">
          Additive only. Preview exact text before writing a rollback revision.
        </span>
      </p>
    </div>
    <dl class="op-metrics">
      <div>
        <dt>Agents</dt>
        <dd class="mono">{@prompt_radar.counts.total}</dd>
      </div>
      <div>
        <dt>Ready</dt>
        <dd class="mono">{@prompt_radar.counts.ready}</dd>
      </div>
      <div>
        <dt>Tuning</dt>
        <dd class="mono">{@prompt_radar.counts.needs_tuning}</dd>
      </div>
      <div>
        <dt>Risk</dt>
        <dd class="mono">{@prompt_radar.counts.guardrail_risk}</dd>
      </div>
      <div>
        <dt>Eval</dt>
        <dd class="mono">{@prompt_radar.counts.eval_gap}</dd>
      </div>
      <div>
        <dt>Drift</dt>
        <dd class="mono">{@prompt_radar.counts.regressed}</dd>
      </div>
    </dl>
    <.quiet_empty :if={@prompt_radar.counts.total == 0} title="No agents configured yet." />

    <div :if={@prompt_tuning_receipt} data-testid="prompt-tuning-receipt" class="op-sec">
      <div class="op-well">
        <div class="op-well-h">
          <span class="gh">Prompt tuning receipt</span>
          <span class="tag mono">
            {@prompt_tuning_receipt.patch_count} {plural_noun(
              @prompt_tuning_receipt.patch_count,
              "patch",
              "patches"
            )}
          </span>
          <.pill phx-click="close_prompt_receipt">Dismiss</.pill>
        </div>
        <p class="help">
          Recorded a rollback revision for {@prompt_tuning_receipt.agent_count} {plural_noun(
            @prompt_tuning_receipt.agent_count,
            "agent"
          )}. Use this receipt to compare the next run against the intended behavior.
        </p>
        <ul class="op-receipts">
          <li :for={agent <- @prompt_tuning_receipt.agents}>
            <p class="op-well-h">
              <b>{agent.agent_name}</b>
              <span class="help">v{agent.revision} rollback point recorded</span>
              <span class="mono op-score">{agent.from_score}/100 -> {agent.to_score}/100</span>
            </p>
            <p class="help">{agent.expected_effect}</p>
            <div :if={agent.validation_checks != []}>
              <span class="gh">Next-run validation</span>
              <ul class="op-bullets">
                <li :for={check <- agent.validation_checks}>{check}</li>
              </ul>
            </div>
            <p class="help">Patches: {Enum.join(agent.patch_titles, ", ")}</p>
            <p class="help">Rollback: {agent.rollback}</p>
          </li>
        </ul>
      </div>
    </div>

    <div :if={@prompt_radar.counts.total > 0 and @prompt_radar.watchlist == []} class="op-sec">
      <p class="op-well-h">
        <span class="st-w">
          <.status_word kind={:done} word="All agent prompts are inside guardrails." />
        </span>
      </p>
      <p class="help">
        Keep using the Instruction Studio after major role, adapter, or PR-contract changes.
      </p>
    </div>

    <ul :if={@prompt_radar.watchlist != []} class="rows">
      <.list_row
        :for={agent <- @prompt_radar.watchlist}
        id={"op-radar-#{agent.id}"}
        title={agent.name}
        status={{prompt_kind(agent.status), agent.status_label}}
      >
        <:meta>
          {role_label(agent.role)} · {adapter_label(agent.adapter)} ·
          <span class="mono">{agent.score}/100</span>
          · Eval {agent.eval_passed}/{agent.eval_total}<span :if={agent.latest_revision}> · latest v{agent.latest_revision.version}</span>
        </:meta>
        <:below>
          <p class="help">{agent.summary}</p>
          <div :if={agent.tuning.patch_count > 0} class="op-well">
            <div class="op-well-h">
              <span class="gh">Guided fixes</span>
              <span class="mono op-score">
                {agent.score}/100 → {agent.tuning.projected_score}/100
              </span>
            </div>
            <p class="op-tags">
              <span :for={patch <- agent.tuning.patches} class="tag" title={patch.reason}>
                {patch.title}
              </span>
            </p>
          </div>
          <p :if={agent.regressed} class="op-well w help">
            Score regression: {agent.regression.from_score}/100 → {agent.regression.to_score}/100
            across saved revisions v{agent.regression.from_version} to v{agent.regression.to_version}.
          </p>
          <p :if={agent.top_gaps != []} class="op-tags">
            <span :for={gap <- agent.top_gaps} class="tag">{gap.label}</span>
          </p>
        </:below>
        <:actions>
          <.pill navigate={~p"/agents/#{agent.id}?tab=instructions"}>Open Studio</.pill>
          <.pill
            :if={agent.tuning.changed and agent.tuning.projected_score > agent.score}
            phx-click="preview_prompt_plan"
            phx-value-agent-id={agent.id}
          >
            Preview patches
          </.pill>
          <.pill
            :if={agent.last_good_revision}
            navigate={~p"/agents/#{agent.id}?tab=instructions"}
          >
            Review last good v{agent.last_good_revision.version}
          </.pill>
        </:actions>
      </.list_row>
    </ul>
  </.band_card>

  <.band_card
    id="op-contract-t"
    title="Prompt contract health"
    section_id="prompt-contract-health"
    class="ui-advanced-only"
  >
    <:header_end>
      <span class="meta mono">{@contract_failures.counts.entries} gaps</span>
    </:header_end>
    <div class="op-sec">
      <p class="gl-sub">
        Contract and memory failures by agent, based on delivery, review, owner-update,
        and issue-memory fields shown on issue pages.
      </p>
    </div>
    <div class="strip op-s4">
      <div class="cell">
        <span class="v mono">{@contract_failures.counts.issues}</span><span class="l">Issues</span>
      </div>
      <div class="cell">
        <span class="v mono">{@contract_failures.counts.agents}</span><span class="l">Agents</span>
      </div>
      <div class="cell">
        <span class="v mono">{@contract_failures.counts.missing}</span>
        <span class="l op-cell-l">
          <.status_glyph :if={@contract_failures.counts.missing > 0} kind={:stopped} />Missing
        </span>
      </div>
      <div class="cell">
        <span class="v mono">{@contract_failures.counts.attention}</span>
        <span class="l op-cell-l">
          <.status_glyph :if={@contract_failures.counts.attention > 0} kind={:waiting} />Weak
        </span>
      </div>
    </div>
    <.quiet_empty
      :if={@contract_failures.counts.entries == 0}
      title="No prompt contract gaps found in open work."
    />

    <div :if={@contract_failures.counts.entries > 0} class="op-sec">
      <p class="op-gh">
        <span class="gh">Repair queue</span>
        <span class="meta">
          Top repairs: {min(length(@contract_failures.entries), 3)} of {@contract_failures.counts.entries}
        </span>
      </p>
      <p class="help">
        Start here. These are the highest-priority contract gaps blocking owner-ready
        issue memory.
      </p>
      <ol class="op-repairs">
        <li :for={{entry, index} <- Enum.with_index(Enum.take(@contract_failures.entries, 3), 1)}>
          <p class="op-well-h">
            <span class="mono help">{String.pad_leading(Integer.to_string(index), 2, "0")}</span>
            <span class="st-w">
              <.status_word kind={contract_kind(entry.status)} word={entry.status_label} />
            </span>
          </p>
          <p class="op-repair-t">{entry.issue_identifier} · {entry.issue_title}</p>
          <p class="help">{entry.contract_label} · {entry.agent_name}</p>
          <p class="help op-clamp">{entry.recommendation}</p>
          <p class="op-acts">
            <button
              type="button"
              class="pl"
              phx-click="queue_contract_nudge"
              phx-value-issue-id={entry.issue_id}
              phx-value-contract={entry.contract_key}
              disabled={!entry.nudge_enabled? || entry.nudge_queued?}
            >
              {if entry.nudge_queued?, do: "Queued", else: "Queue nudge"}
            </button>
            <.pill navigate={~p"/issues/#{entry.issue_id}"}>Open issue</.pill>
          </p>
        </li>
      </ol>
    </div>

    <div :if={@contract_failures.counts.entries > 0} class="op-grid">
      <div class="op-sec">
        <p class="op-gh">
          <span class="gh">By agent</span><span class="meta">{@contract_failures.summary}</span>
        </p>
        <ul class="rows op-scroll op-scroll-s">
          <.list_row
            :for={{group, index} <- Enum.with_index(@contract_failures.by_agent)}
            id={"op-contract-agent-#{index}"}
            title={group.agent_name}
          >
            <:meta>
              {role_label(group.agent_role)} · <span class="mono">{group.count}</span>
              gaps<span :if={group.missing > 0}> · {group.missing} missing</span>
              <span :if={group.attention > 0}>
                · {group.attention} weak
              </span>
            </:meta>
            <:below>
              <p :if={group.fields != []} class="op-tags">
                <span :for={field <- group.fields} class="tag">{field}</span>
              </p>
              <p class="op-acts">
                <.text_link
                  :if={group.agent_id}
                  navigate={~p"/agents/#{group.agent_id}?tab=configuration"}
                >
                  Open agent
                </.text_link>
                <.text_link
                  :if={group.latest_issue}
                  navigate={~p"/issues/#{group.latest_issue.issue_id}"}
                >
                  Open latest issue
                </.text_link>
              </p>
            </:below>
          </.list_row>
        </ul>
      </div>
      <div class="op-sec">
        <p class="op-gh">
          <span class="gh">Active gaps</span><span class="meta">Newest open work first</span>
        </p>
        <ul class="rows op-scroll op-scroll-s">
          <.list_row
            :for={{entry, index} <- Enum.with_index(@contract_failures.entries)}
            id={"op-contract-gap-#{index}"}
            title={"#{entry.issue_identifier} · #{entry.issue_title}"}
            status={{contract_kind(entry.status), entry.status_label}}
          >
            <:meta>
              {entry.contract_label} · Owner: {entry.agent_name}<span :if={entry.project_name}>{" · #{entry.project_name}"}</span>
            </:meta>
            <:below>
              <p class="help">{entry.summary}</p>
              <p :if={entry.missing_fields != []} class="op-tags">
                <span :for={field <- entry.missing_fields} class="tag mono">{field}</span>
              </p>
              <p class="help op-quote">{entry.recommendation}</p>
              <p class="op-acts">
                <button
                  type="button"
                  class="pl"
                  phx-click="queue_contract_nudge"
                  phx-value-issue-id={entry.issue_id}
                  phx-value-contract={entry.contract_key}
                  disabled={!entry.nudge_enabled? || entry.nudge_queued?}
                >
                  {entry.nudge_button_label}
                </button>
                <.pill navigate={~p"/issues/#{entry.issue_id}"}>Open issue</.pill>
              </p>
            </:below>
          </.list_row>
        </ul>
      </div>
    </div>
  </.band_card>

  <.band_card
    id="op-services-t"
    title="Runtime services"
    section_id="runtime-services"
    class="ui-advanced-only"
  >
    <%!-- Said once here instead of once per row: every card used to repeat
         "Set CYMPHO_X=1 and restart the server." --%>
    <div class="op-sec">
      <p class="gl-sub">
        These switches decide whether Cympho only reviews work or actively runs the company.
        To turn one on, set its variable to 1 and restart the server.
      </p>
    </div>
    <div :for={group <- service_groups(@services)} class="op-svc">
      <p class="op-gh">
        <span class="gh">{group.label}</span><span class="meta">{group.hint}</span>
      </p>
      <ul class="rows">
        <.list_row
          :for={service <- group.services}
          id={"op-svc-#{service.env_var}"}
          title={service.name}
          status={service.status != :disabled && {service_kind(service.status), service.label}}
        >
          <:meta>{service.description}</:meta>
          <:below>
            <code class="op-code mono op-inline">{service.env_var}=1</code>
            <p :if={service.status not in [:disabled, :running]} class="help">{service.fix}</p>
          </:below>
        </.list_row>
      </ul>
    </div>
  </.band_card>

  <.band_card
    id="op-capacity-t"
    title="Runtime capacity"
    section_id="runtime-capacity"
    class="ui-advanced-only"
  >
    <:header_end>
      <span class="op-end">
        <button
          :if={Map.get(@capacity, :cleanup_available?)}
          type="button"
          class="pl"
          phx-click="recover_stale_runs"
          data-confirm="Mark stale/orphaned running runs as failed, cancel old pending runs, and clear stale checkout locks for this company? This does not start any agents or change issue assignees."
        >
          Recover stale runtime state
        </button>
        <span class="st-w">
          <.status_word kind={capacity_kind(@capacity.level)} word={@capacity.label} />
        </span>
      </span>
    </:header_end>
    <div class="op-sec">
      <p class="gl-big">{@capacity.summary}</p>
      <p class="gl-sub">{@capacity.hint}</p>
    </div>
    <div class="strip op-s4">
      <div class="cell">
        <span class="v mono">{@capacity.total_agents}</span><span class="l">Agents</span>
      </div>
      <div class="cell">
        <span class="v mono">{@capacity.total_slots}</span><span class="l">Configured slots</span>
        <span class="op-cell-d">{configured_slots_detail(@capacity)}</span>
      </div>
      <div class="cell">
        <span class="v op-v-word">{admission_status_label(@capacity.admission)}</span>
        <span class="l">Node admission</span>
        <span class="op-cell-d">shared node capacity</span>
      </div>
      <div class="cell">
        <span class="v mono">{@capacity.running_runs}</span><span class="l">Held slots</span>
        <span class="op-cell-d mono">
          {@capacity.active_runs} runs · {@capacity.checked_out_issues} checkouts
        </span>
      </div>
    </div>
    <div class="op-sec">
      <p
        :if={recent_capacity_denial?(@capacity, @launch_preview, @wake_queue, @review_nudges)}
        data-testid="runtime-admission-shared-status"
        class="op-well w help"
      >
        Shared runtime capacity recently delayed work. It will retry when safe capacity is available.
      </p>
      <div
        :if={Map.get(@capacity, :repo_delivery)}
        data-testid="repo-delivery-capacity"
        class={["op-well", well_tone(repo_delivery_kind(@capacity.repo_delivery.status))]}
      >
        <div class="op-well-h">
          <span class="gh">Repo delivery lane</span>
          <span class="st-w">
            <.status_word
              kind={repo_delivery_kind(@capacity.repo_delivery.status)}
              word={@capacity.repo_delivery.label}
            />
          </span>
        </div>
        <p class="op-repair-t">{@capacity.repo_delivery.summary}</p>
        <p class="help">{@capacity.repo_delivery.hint}</p>
        <p class="op-tags">
          <span class="tag mono">
            {@capacity.repo_delivery.repo_capable_slots} repo-capable slots
          </span>
          <span class="tag mono">{@capacity.repo_delivery.text_only_slots} text-only slots</span>
        </p>
        <p class="op-acts">
          <.pill
            :if={@capacity.repo_delivery.target_path}
            navigate={@capacity.repo_delivery.target_path}
          >
            {@capacity.repo_delivery.target_label}
          </.pill>
          <.pill
            :if={@capacity.repo_delivery.hire_target_path}
            navigate={@capacity.repo_delivery.hire_target_path}
          >
            {@capacity.repo_delivery.hire_target_label}
          </.pill>
        </p>
      </div>
      <div
        :if={@org_health.role_demand_gaps != []}
        id="runtime-staffing-gaps"
        data-testid="runtime-staffing-gaps"
        class="op-well w"
      >
        <div class="op-well-h">
          <span class="gh">Staffing gaps</span>
          <span class="st-w">
            <.status_word
              kind={:waiting}
              word={"#{@org_health.metrics.unstaffed_role_issues} open #{plural_noun(@org_health.metrics.unstaffed_role_issues, "issue")}"}
            />
          </span>
          <.pill navigate={
            ~p"/agents/new?#{new_agent_query_for_gap(List.first(@org_health.role_demand_gaps))}"
          }>
            {first_staffing_gap_label(@org_health)}
          </.pill>
        </div>
        <p class="help">
          Delegated work includes roles with no active agent. Hire or reassign coverage before broad dispatch, otherwise the CEO/CTO split will stall after decomposition.
        </p>
        <ul class="rows">
          <.list_row
            :for={gap <- @org_health.role_demand_gaps}
            id={"op-gap-#{gap.role}"}
            title={gap.label}
          >
            <:meta>
              {gap.open_issues} open {plural_noun(gap.open_issues, "issue")}<span :if={
                gap.suggested_parent
              }> · Reports to {gap.suggested_parent.name}</span>
            </:meta>
            <:below :if={gap.examples != []}>
              <p class="op-tags">
                <.link
                  :for={example <- gap.examples}
                  navigate={~p"/issues/#{example.id}"}
                  class="ul op-ex"
                  title={issue_example_label(example)}
                >
                  {issue_example_label(example)}
                </.link>
              </p>
            </:below>
            <:actions>
              <.pill navigate={~p"/agents/new?#{new_agent_query_for_gap(gap)}"}>
                Hire {gap.label}
              </.pill>
            </:actions>
          </.list_row>
        </ul>
      </div>
      <div :if={@capacity.stale_checked_out_issues > 0} class="op-well w">
        <div class="op-well-h">
          <span class="gh">Stale checked-out work</span>
          <span class="tag">Recovery available</span>
        </div>
        <p class="help">
          {@capacity.stale_checked_out_issues} issue{if @capacity.stale_checked_out_issues ==
                                                          1, do: "", else: "s"} still count against agent capacity after the recovery threshold.
        </p>
        <ul class="rows">
          <.list_row
            :for={issue <- Enum.take(@capacity.stale_checkouts, 4)}
            id={"op-stale-#{issue.id}"}
            title={"#{issue.identifier} · #{issue.title}"}
            navigate={~p"/issues/#{issue.id}"}
          >
            <:meta>
              {issue.assignee_name} · checked out {format_relative(issue.checked_out_at)}
            </:meta>
          </.list_row>
        </ul>
      </div>
    </div>
  </.band_card>

  <% shared_slots = shared_slot_label(@pressure_agents) %>
  <.band_card id="op-pressure-t" title="Highest pressure agents" class="ui-advanced-only">
    <div class="op-sec">
      <p class="gl-sub">
        Local CLI adapters consume real OS memory; BEAM processes stay lightweight.<span :if={
          shared_slots
        }> Every agent has {shared_slots}.</span>
      </p>
    </div>
    <.quiet_empty :if={@pressure_agents == []} title="No agents configured yet." />
    <ul :if={@pressure_agents != []} class="rows">
      <%!-- Safe is the resting state of every row; only flag the rest. --%>
      <.list_row
        :for={item <- @pressure_agents}
        id={"op-pressure-#{item.id}"}
        title={item.name}
        navigate={~p"/agents/#{item.id}?tab=configuration"}
        status={
          item.pressure.level != :safe &&
            {capacity_kind(item.pressure.level), item.pressure.label}
        }
      >
        <:meta>{role_label(item.role)}</:meta>
        <:trail :if={is_nil(shared_slots)}>
          <span class="mono">{item.pressure.slot_label}</span>
        </:trail>
      </.list_row>
    </ul>
  </.band_card>

  <.band_card id="op-next-t" title="Next actions" class="ui-advanced-only">
    <:header_end><span class="meta mono">{length(@next_actions)}</span></:header_end>
    <ul class="rows">
      <.list_row
        :for={{action, index} <- Enum.with_index(@next_actions)}
        id={"op-next-#{index}"}
        title={action.title}
        icon={if action.tone == :danger, do: "i-alert", else: "i-arrow-right"}
        kind={row_kind(action.tone)}
      >
        <:meta>{action.body}</:meta>
        <:below :if={Map.get(action, :target_path) || Map.get(action, :command)}>
          <p class="op-acts">
            <.text_link
              :if={Map.get(action, :target_path) && anchor_path?(action.target_path)}
              href={action.target_path}
            >
              {action.target_label}
            </.text_link>
            <.text_link
              :if={Map.get(action, :target_path) && not anchor_path?(action.target_path)}
              navigate={action.target_path}
            >
              {action.target_label}
            </.text_link>
            <.text_link
              :if={
                Map.get(action, :secondary_target_path) &&
                  anchor_path?(action.secondary_target_path)
              }
              href={action.secondary_target_path}
            >
              {action.secondary_target_label}
            </.text_link>
            <.text_link
              :if={
                Map.get(action, :secondary_target_path) &&
                  not anchor_path?(action.secondary_target_path)
              }
              navigate={action.secondary_target_path}
            >
              {action.secondary_target_label}
            </.text_link>
            <.text_link
              :if={Map.get(action, :command) && action.command == @runtime_enablement.command}
              href="#runtime-launch-checklist"
            >
              Launch command
            </.text_link>
            <code
              :if={Map.get(action, :command) && action.command != @runtime_enablement.command}
              class="op-code mono op-inline"
            >
              {action.command}
            </code>
          </p>
        </:below>
      </.list_row>
    </ul>
  </.band_card>

  <.band_card
    id="op-adapters-t"
    title="Adapter health"
    section_id="adapter-health"
    class="ui-advanced-only"
  >
    <.quiet_empty :if={@health == []} title="No adapters assigned to agents yet." />
    <ul :if={@health != []} class="rows">
      <.list_row
        :for={adapter <- @health}
        id={"op-adapter-#{adapter.label}"}
        title={adapter.label}
        icon="i-term"
      >
        <:meta>
          <span class="mono">{adapter.total} agents</span>
          · {adapter.healthy} healthy · {adapter.degraded} warn · {adapter.unavailable} down
        </:meta>
        <:below :if={adapter.launch_ready_warnings > 0 or adapter.problem_agents != []}>
          <p :if={adapter.launch_ready_warnings > 0} class="help">
            {adapter.launch_ready_warnings} warning {if adapter.launch_ready_warnings == 1,
              do: "agent",
              else: "agents"} pass launch preflight; health will refresh after the next checker/run signal.
          </p>
          <div :if={adapter.problem_agents != []}>
            <span class="gh">Needs attention</span>
            <ul class="op-agents">
              <li :for={agent <- adapter.problem_agents}>
                <.link navigate={~p"/agents/#{agent.id}?tab=configuration"} class="ul">
                  {agent.name}
                </.link>
                <span class="help">{role_label(agent.role)}</span>
                <span class="st-w">
                  <.status_word
                    kind={health_kind(agent.status)}
                    word={health_status_label(agent.status)}
                  />
                </span>
              </li>
            </ul>
          </div>
        </:below>
      </.list_row>
    </ul>
  </.band_card>

  <.modal
    :if={@prompt_plan_preview}
    id="prompt-plan-preview"
    show
    title="Prompt patch preview"
    on_cancel={JS.push("close_prompt_preview")}
  >
    <p class="op-tags">
      <span class="tag mono">
        {@prompt_plan_preview.agent_count} {plural_noun(@prompt_plan_preview.agent_count, "agent")}
      </span>
      <span class="tag mono">
        {@prompt_plan_preview.patch_count} {plural_noun(
          @prompt_plan_preview.patch_count,
          "patch",
          "patches"
        )}
      </span>
    </p>
    <p class="help">
      Review the exact additive text Cympho will append. Existing instructions stay intact,
      and every apply records an agent config revision for rollback.
    </p>
    <p :if={@prompt_plan_preview.empty?} class="op-well">
      No safe additive patches are currently available for this selection.
    </p>
    <ul :if={!@prompt_plan_preview.empty?} class="op-preview">
      <li :for={agent <- @prompt_plan_preview.agents} class="op-well">
        <div class="op-well-h">
          <b>{agent.name}</b>
          <span class="help">{role_label(agent.role)} · {adapter_label(agent.adapter)}</span>
          <span class="mono op-score">
            {agent.current_score}/100 → {agent.projected_score}/100
          </span>
        </div>
        <p class="help">{agent.current_status_label} → {agent.projected_status_label}</p>
        <div :for={patch <- agent.patches} class="op-patch">
          <p class="op-tags">
            <span class="tag">{patch.title}</span><span class="help">{patch.reason}</span>
          </p>
          <pre class="op-code mono op-pre">{patch.body}</pre>
        </div>
        <div :if={agent.validation_checks != []}>
          <span class="gh">Next-run validation</span>
          <ul class="op-bullets">
            <li :for={check <- agent.validation_checks}>{check}</li>
          </ul>
        </div>
      </li>
    </ul>
    <p class="help">
      These are generated from Instruction Studio guardrails, not free-form rewrites.
    </p>
    <:footer>
      <.pill phx-click="close_prompt_preview">Cancel</.pill>
      <.pill
        :if={@prompt_plan_preview.scope == :watchlist and @prompt_plan_preview.agent_count > 0}
        phx-click="apply_prompt_plan"
        phx-value-scope="watchlist"
        data-confirm="Apply these additive Studio patches to every agent in the preview?"
      >
        Apply all patches
      </.pill>
      <.pill
        :if={@prompt_plan_preview.scope == :agent and @prompt_plan_preview.agent_count > 0}
        phx-click="apply_prompt_plan"
        phx-value-agent-id={hd(@prompt_plan_preview.agents).id}
        data-confirm="Apply these additive Studio patches to this agent?"
      >
        Apply patches
      </.pill>
    </:footer>
  </.modal>
</.page_frame>
