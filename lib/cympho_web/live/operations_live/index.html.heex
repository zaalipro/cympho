<.page size="full" data-ui-complex-page data-density={@digest_density}>
  <header class="mb-5 flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
    <div class="min-w-0">
      <div class="ui-advanced-only flex flex-wrap items-center gap-2">
        <span class="ember-eyebrow">
          Runtime mode ·
          <span class={mode_text_class(@runtime_mode.status)}>{@runtime_mode.label}</span>
        </span>
        <span
          class={[
            "cympho-pulse-dot hidden h-1.5 w-1.5 rounded-full",
            mode_dot_class(@runtime_mode.status)
          ]}
          style={"--cympho-pulse-color: #{mode_pulse_color(@runtime_mode.status)};"}
        >
        </span>
      </div>
      <h1 class="ember-ink mt-3 font-serif text-[clamp(28px,4vw,40px)] font-510 leading-[1.08] tracking-[-0.02em]">
        Operations
      </h1>
      <p class="ui-advanced-only mt-2 max-w-2xl text-sm leading-5 text-text-tertiary">
        The engine room — services, health, and capacity for your agents.
      </p>
    </div>

    <div class="flex flex-wrap items-center gap-2 sm:flex-nowrap sm:justify-end">
      <.density_switch
        density={@digest_density}
        compact_patch={operations_url("compact", @delegated_parent_issue_id)}
        detailed_patch={operations_url("detailed", @delegated_parent_issue_id)}
      />
      <.icon_action
        phx-click="refresh"
        icon="hero-arrow-path-mini"
        label="Refresh operations"
      />
    </div>
  </header>

  <div
    :if={@flash["info"]}
    class="mb-4 rounded-lg border border-brand/25 bg-brand/10 px-3 py-2 text-sm text-brand"
  >
    {@flash["info"]}
  </div>
  <div
    :if={@flash["error"]}
    class="mb-4 rounded-lg border border-red-500/25 bg-red-500/10 px-3 py-2 text-sm text-red-300"
  >
    {@flash["error"]}
  </div>

  <section
    id="operations-simple-state"
    class="ui-simple-only mb-4 rounded-lg border border-border bg-panel px-4 py-4"
  >
    <div class="flex items-center gap-3">
      <span class="ui-simple-icon">
        <span class="hero-bolt-mini h-4 w-4"></span>
      </span>
      <div class="min-w-0 flex-1">
        <%!-- No "System state" eyebrow and no jump-link to the delegated-work
             console: simple mode shows the same work as plain rows below. --%>
        <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
          <h2 class={["text-base font-590", mode_text_class(@runtime_mode.status)]}>
            {simple_runtime_mode_label(@runtime_mode)}
          </h2>
          <span class="text-xs text-text-tertiary">
            {@capacity.running_runs} working · {now_waiting_count(@wake_queue, @review_nudges)} waiting
          </span>
        </div>
      </div>
    </div>
  </section>

  <section
    :if={@next_actions != []}
    id="operations-simple-next-fix"
    class="ui-simple-only mb-4 rounded-lg border border-border bg-panel px-4 py-4"
  >
    <% action = List.first(@next_actions) %>
    <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
      <div class="min-w-0">
        <div class="flex flex-wrap items-center gap-2">
          <span class={"rounded-full border px-2 py-0.5 text-[10px] font-590 uppercase #{action_badge_class(action.tone)}"}>
            Next
          </span>
          <h2 class="text-sm font-590 text-text-primary">
            {simple_operations_title(action.title)}
          </h2>
        </div>
        <p class="mt-1 text-xs leading-5 text-text-tertiary">
          {simple_operations_body(action.title, action.body)}
        </p>
      </div>
      <a
        :if={Map.get(action, :target_path) && anchor_path?(action.target_path)}
        href={action.target_path}
        class="inline-flex shrink-0 items-center gap-1.5 rounded-md border border-border bg-surface px-2.5 py-1.5 text-xs font-510 text-text-secondary transition hover:border-border-hover hover:bg-surface-hover hover:text-text-primary"
      >
        <span class="hero-arrow-down-mini h-3.5 w-3.5"></span>
        {simple_operations_target_label(action.target_label)}
      </a>
      <.app_link
        :if={Map.get(action, :target_path) && not anchor_path?(action.target_path)}
        navigate={action.target_path}
        class="inline-flex shrink-0 items-center gap-1.5 rounded-md border border-border bg-surface px-2.5 py-1.5 text-xs font-510 text-text-secondary transition hover:border-border-hover hover:bg-surface-hover hover:text-text-primary"
      >
        <span class="hero-wrench-screwdriver-mini h-3.5 w-3.5"></span>
        {simple_operations_target_label(action.target_label)}
      </.app_link>
    </div>
  </section>

  <section
    id="operations-simple-action-queue"
    data-testid="operations-simple-action-queue"
    class="ui-simple-only mb-4 rounded-lg border border-border bg-panel px-4 py-4"
  >
    <% simple_rows =
      simple_action_queue(
        @delegated_work,
        @owner_signoffs,
        @ceo_outcomes,
        @runtime_enablement,
        @launch_plan
      ) %>
    <div class="flex items-center justify-between gap-3">
      <div class="min-w-0">
        <h2 class="text-base font-590 text-text-primary">
          {simple_action_queue_title(simple_rows)}
        </h2>
      </div>
    </div>

    <div class="stagger-children mt-3 grid gap-2 lg:grid-cols-2">
      <div
        :for={row <- simple_rows}
        data-testid={"operations-simple-action-#{row.key}"}
        class={"min-w-0 rounded-md border px-3 py-3 #{simple_action_row_class(row.tone)}"}
      >
        <div class="flex min-w-0 items-start gap-3">
          <span class="inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-md border border-white/10 bg-white/10 text-white">
            <span class={[row.icon, "h-4 w-4 text-white"]}></span>
          </span>
          <div class="min-w-0 flex-1">
            <%!-- The row icon already carries the category the eyebrow spelled
                 out in caps; only the count survives next to the title. --%>
            <div class="flex min-w-0 flex-wrap items-center gap-2">
              <p class="min-w-0 truncate text-sm font-590 text-text-primary">{row.title}</p>
              <span
                :if={row.count_label}
                class="rounded-full border border-white/10 bg-white/5 px-1.5 py-0.5 font-mono text-[10px] text-text-secondary"
              >
                {row.count_label}
              </span>
            </div>
          </div>
          <button
            :if={row.action_event}
            type="button"
            phx-click={row.action_event}
            data-testid={"operations-simple-action-button-#{row.key}"}
            class="inline-flex shrink-0 items-center justify-center gap-1.5 rounded-md border border-white/10 bg-white/10 px-2.5 py-1.5 text-xs font-510 text-text-primary transition hover:border-white/20 hover:bg-white/15"
          >
            <span class="hero-bolt-mini h-3.5 w-3.5 text-white"></span>
            {row.action_label}
          </button>
          <a
            :if={row.action_path && anchor_path?(row.action_path)}
            href={row.action_path}
            data-testid={"operations-simple-action-link-#{row.key}"}
            class="inline-flex shrink-0 items-center justify-center gap-1.5 rounded-md border border-white/10 bg-white/10 px-2.5 py-1.5 text-xs font-510 text-text-primary transition hover:border-white/20 hover:bg-white/15"
          >
            <span class="hero-arrow-right-mini h-3.5 w-3.5 text-white"></span>
            {row.action_label}
          </a>
          <.app_link
            :if={row.action_path && not anchor_path?(row.action_path)}
            navigate={row.action_path}
            data-testid={"operations-simple-action-link-#{row.key}"}
            class="inline-flex shrink-0 items-center justify-center gap-1.5 rounded-md border border-white/10 bg-white/10 px-2.5 py-1.5 text-xs font-510 text-text-primary transition hover:border-white/20 hover:bg-white/15"
          >
            <span class="hero-arrow-right-mini h-3.5 w-3.5 text-white"></span>
            {row.action_label}
          </.app_link>
        </div>
      </div>
    </div>
  </section>

  <div class="grid min-w-0 gap-4 2xl:grid-cols-[minmax(0,1fr)_360px]">
    <div class="min-w-0 space-y-4">
      <.chapter_heading
        label="Now"
        hint="what's running this second"
        class="ui-advanced-only"
      />
      <section class="ui-advanced-only ember-glass">
        <div class="flex flex-col gap-4 px-5 py-4 sm:flex-row sm:items-center sm:justify-between">
          <div class="min-w-0">
            <p class="font-serif text-[13px] font-510 italic tracking-[0.02em] text-brand/90">
              Runtime mode
            </p>
            <div class="mt-1.5 flex flex-wrap items-baseline gap-2">
              <h2 class={[
                "text-lg font-590",
                mode_text_class(@runtime_mode.status)
              ]}>
                {@runtime_mode.label}
              </h2>
            </div>
            <p class="mt-1.5 max-w-xl text-sm leading-5 text-text-tertiary">
              {@runtime_mode.summary}
            </p>
          </div>
          <div class="flex shrink-0 flex-col items-stretch gap-1.5 sm:items-end">
            <div class="stagger-children flex items-stretch gap-px overflow-hidden rounded-md border border-border bg-border">
              <.pulse_stat label="Running" value={@capacity.running_runs} tone={:running} />
              <.pulse_stat
                label="Waiting"
                value={now_waiting_count(@wake_queue, @review_nudges)}
                tone={:waiting}
              />
              <.pulse_stat
                label="Stale"
                value={now_stale_count(@capacity, @wake_queue)}
                tone={:stale}
              />
            </div>
            <p class="text-[11px] leading-4 text-text-quaternary">
              {@runtime_mode.disabled_services} disabled · {@runtime_mode.not_running_services} not running ·
              <a
                href="#runtime-capacity"
                class="text-text-tertiary transition hover:text-text-primary"
              >
                capacity details
              </a>
            </p>
          </div>
        </div>
        <div id="runtime-launch-checklist" class="scroll-mt-6 border-t border-border px-5 py-4">
          <div class="flex flex-wrap items-start justify-between gap-3">
            <div class="min-w-0">
              <div class="flex flex-wrap items-center gap-2">
                <p class="font-serif text-[13px] font-510 italic tracking-[0.02em] text-brand/90">
                  Runtime launch checklist
                </p>
                <span class={"rounded-full border px-2 py-0.5 text-[11px] font-510 #{enablement_badge_class(@runtime_enablement.status)}"}>
                  {@runtime_enablement.label}
                </span>
              </div>
              <p class="mt-1.5 max-w-2xl text-sm leading-5 text-text-tertiary">
                {@runtime_enablement.summary}
              </p>
            </div>
            <.app_link
              :if={
                @runtime_enablement.status == :blocked and @runtime_enablement.cleanup_count > 0
              }
              navigate="#runtime-capacity"
              class="ui-advanced-only rounded-md border border-amber-500/30 bg-amber-500/10 px-2.5 py-1.5 text-xs font-510 text-amber-100 transition-colors hover:bg-amber-500/15"
            >
              Review capacity
            </.app_link>
          </div>

          <div
            id="runtime-next-launch-step"
            data-testid="runtime-next-launch-step"
            class={"mt-3 rounded-md border p-3 #{launch_plan_card_class(@launch_plan.tone)}"}
          >
            <div class="flex flex-col gap-3 lg:flex-row lg:items-start lg:justify-between">
              <div class="min-w-0">
                <div class="flex flex-wrap items-center gap-2">
                  <p class="text-[10px] font-590 uppercase tracking-[0.14em] text-text-quaternary">
                    Next launch step
                  </p>
                  <span class={"rounded-full border px-2 py-0.5 text-[11px] font-510 #{launch_plan_badge_class(@launch_plan.tone)}"}>
                    {@launch_plan.label}
                  </span>
                </div>
                <p class="mt-1.5 max-w-3xl text-sm leading-5 text-text-tertiary">
                  {@launch_plan.summary}
                </p>
              </div>
              <.app_link
                :if={@launch_plan.target_path}
                navigate={@launch_plan.target_path}
                class={"inline-flex shrink-0 items-center justify-center rounded-md border px-2.5 py-1.5 text-xs font-510 transition #{ceo_flow_action_class(@launch_plan.tone)}"}
              >
                {@launch_plan.target_label}
              </.app_link>
            </div>

            <div
              :if={@launch_plan.issue}
              class="mt-3 rounded-md border border-border bg-canvas/70 px-2.5 py-2"
            >
              <div class="flex min-w-0 flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
                <.app_link
                  navigate={@launch_plan.issue.target_path}
                  class="min-w-0 break-words text-sm font-590 leading-5 text-text-primary hover:text-brand"
                >
                  {@launch_plan.issue.identifier} · {@launch_plan.issue.title}
                </.app_link>
                <div class="flex shrink-0 flex-wrap gap-1.5">
                  <span class="rounded-full border border-border bg-panel px-2 py-0.5 text-[10px] font-510 text-text-tertiary">
                    {@launch_plan.issue.status_label}
                  </span>
                  <span class={"rounded-full border px-2 py-0.5 text-[10px] font-510 #{preflight_badge_class(@launch_plan.issue.preflight_status)}"}>
                    {@launch_plan.issue.preflight_label}
                  </span>
                </div>
              </div>
            </div>

            <div
              :if={Map.get(@launch_plan, :repair_scaffold)}
              id="runtime-next-brief-repair-scaffold"
              phx-hook="CopyToClipboard"
              class="mt-3 rounded-md border border-amber-500/20 bg-amber-500/[0.06] px-3 py-2.5"
            >
              <div class="flex flex-wrap items-center justify-between gap-2">
                <div>
                  <p class="text-[10px] font-590 uppercase tracking-[0.14em] text-amber-300">
                    Brief repair scaffold
                  </p>
                  <p class="mt-1 text-[11px] leading-4 text-text-tertiary">
                    Paste this into the issue description, replace placeholders, then refresh this
                    checklist.
                  </p>
                </div>
                <button
                  type="button"
                  data-copy-text={Map.get(@launch_plan, :repair_scaffold)}
                  data-copy-label="Copy repair scaffold"
                  data-copy-success-label="Copied"
                  data-copy-error-label="Open preview"
                  class="rounded-md border border-amber-500/25 bg-panel px-2 py-1 text-[11px] font-510 text-text-secondary transition hover:border-amber-500/50 hover:bg-surface-hover hover:text-text-primary"
                >
                  Copy repair scaffold
                </button>
              </div>
              <%!-- The scaffold is a copy payload, not reading material: the button
                   beside it is the interface. Printing all six placeholder lines
                   inline cost more page than every other panel here combined. --%>
              <details class="group mt-2">
                <summary
                  title="Preview the repair scaffold"
                  aria-label="Preview the repair scaffold"
                  class="inline-flex cursor-pointer list-none items-center gap-1.5 text-[11px] font-510 text-text-tertiary hover:text-text-primary [&::-webkit-details-marker]:hidden"
                >
                  Preview
                  <span class="hero-chevron-down-mini h-3.5 w-3.5 transition-transform group-open:rotate-180">
                  </span>
                </summary>
                <pre class="mt-2 max-h-48 overflow-y-auto whitespace-pre-wrap break-words font-mono text-[11px] leading-5 text-text-tertiary"><%= Map.get(@launch_plan, :repair_scaffold) %></pre>
              </details>
            </div>

            <%!-- Only render a command here when it is not the broad launch command
                 the checklist already prints a few rows below. --%>
            <div
              :if={@launch_plan.command && @launch_plan.command != @runtime_enablement.command}
              id="runtime-next-launch-command"
              phx-hook="CopyToClipboard"
              class="ui-advanced-only mt-3 rounded-md border border-border bg-canvas p-2.5"
            >
              <div class="flex flex-wrap items-center justify-between gap-2">
                <p class="text-[10px] font-590 uppercase tracking-[0.14em] text-text-quaternary">
                  {@launch_plan.command_label}
                </p>
                <button
                  type="button"
                  data-copy-text={@launch_plan.command}
                  data-copy-label="Copy command"
                  data-copy-success-label="Copied"
                  class="rounded-md border border-border bg-panel px-2 py-1 text-[11px] font-510 text-text-secondary transition hover:border-border-hover hover:bg-surface-hover hover:text-text-primary"
                >
                  Copy command
                </button>
              </div>
              <code class="mt-1.5 block overflow-x-auto font-mono text-[11px] leading-5 text-text-secondary">
                {@launch_plan.command}
              </code>
            </div>

            <div class="ui-advanced-only mt-3 grid gap-2 md:grid-cols-3">
              <div
                :for={step <- @launch_plan.steps}
                class={"min-w-0 rounded-md border px-2.5 py-2 #{launch_plan_step_class(step.state)}"}
              >
                <p class="truncate text-[10px] font-590 uppercase tracking-[0.12em] text-text-quaternary">
                  {step.label}
                </p>
                <p class="mt-1 text-[11px] leading-4 text-text-secondary">
                  {step.detail}
                </p>
              </div>
            </div>
          </div>

          <div
            :if={@runtime_enablement.command}
            id="runtime-broad-launch-command"
            phx-hook="CopyToClipboard"
            class="ui-advanced-only mt-3 rounded-md border border-border bg-canvas p-3"
          >
            <div class="flex flex-wrap items-center justify-between gap-2">
              <p class="text-[10px] font-590 uppercase tracking-[0.14em] text-text-quaternary">
                Broad restart command
              </p>
              <button
                type="button"
                data-copy-text={@runtime_enablement.command}
                data-copy-label="Copy command"
                data-copy-success-label="Copied"
                class="rounded-md border border-border bg-panel px-2 py-1 text-[11px] font-510 text-text-secondary transition hover:border-border-hover hover:bg-surface-hover hover:text-text-primary"
              >
                Copy command
              </button>
            </div>
            <code class="mt-1.5 block overflow-x-auto font-mono text-[11px] leading-5 text-text-secondary">
              {@runtime_enablement.command}
            </code>
          </div>

          <%!-- The env vars this command sets are the same switches Runtime
               Services already lists one by one; link there instead of
               reprinting them. --%>
          <p class="ui-advanced-only mt-2 text-[11px] leading-4 text-text-quaternary">
            Every switch this command flips is described in
            <a href="#runtime-services" class="font-510 text-brand hover:text-brand/80">
              Runtime Services
            </a>
            below.
          </p>

          <div
            id="ceo-flow-verifier"
            data-testid="ceo-flow-verifier"
            class="mt-4 rounded-md border border-border bg-surface/50 p-3"
          >
            <div class="flex flex-col gap-3 lg:flex-row lg:items-start lg:justify-between">
              <div class="min-w-0">
                <div class="flex flex-wrap items-center gap-2">
                  <p class="font-serif text-[13px] font-510 italic tracking-[0.02em] text-brand/90">
                    CEO flow verification
                  </p>
                  <span class={"rounded-full border px-2 py-0.5 text-[11px] font-510 #{ceo_flow_badge_class(@ceo_flow.stage)}"}>
                    {@ceo_flow.label}
                  </span>
                </div>
                <p class="mt-1.5 max-w-3xl text-sm leading-5 text-text-tertiary">
                  {@ceo_flow.summary}
                </p>
              </div>
              <div class="flex shrink-0 flex-wrap gap-2">
                <.app_link
                  navigate={@ceo_flow.next_action.path}
                  class={"inline-flex items-center justify-center rounded-md border px-2.5 py-1.5 text-xs font-510 transition #{ceo_flow_action_class(@ceo_flow.next_action.tone)}"}
                >
                  {@ceo_flow.next_action.label}
                </.app_link>
                <button
                  :if={@ceo_flow.ceo_count > 0}
                  type="button"
                  phx-click="create_ceo_flow_smoke_issue"
                  class="inline-flex items-center justify-center rounded-md border border-emerald-500/25 bg-emerald-500/10 px-2.5 py-1.5 text-xs font-510 text-emerald-200 transition hover:bg-emerald-500/15"
                >
                  Create CEO to CTO smoke
                </button>
              </div>
            </div>

            <div class="stagger-children mt-3 grid grid-cols-2 gap-2 lg:grid-cols-4">
              <div
                :for={step <- @ceo_flow.steps}
                class={"ember-stat min-w-0 rounded-md border px-3 py-2.5 #{ceo_flow_step_class(step.state)}"}
              >
                <div class="flex items-start justify-between gap-2">
                  <p class="truncate text-[10px] font-590 uppercase tracking-[0.12em] text-text-quaternary">
                    {step.label}
                  </p>
                  <p class={[
                    "font-serif text-[20px] font-510 leading-none tabular-nums",
                    ceo_flow_step_value_class(step.state)
                  ]}>
                    {step.value}
                  </p>
                </div>
                <p class="mt-1 truncate text-[11px] leading-4 text-text-tertiary">
                  {step.detail}
                </p>
              </div>
            </div>

            <div
              :if={@ceo_flow.primary_candidate}
              class="mt-3 rounded-md border border-border bg-canvas/70 p-3"
            >
              <div class="flex flex-col gap-2 sm:flex-row sm:items-start sm:justify-between">
                <div class="min-w-0">
                  <p class="text-[10px] font-590 uppercase tracking-[0.14em] text-text-quaternary">
                    Next CEO candidate
                  </p>
                  <.app_link
                    navigate={@ceo_flow.primary_candidate.target_path}
                    class="mt-1 block truncate text-sm font-590 text-text-primary hover:text-brand"
                  >
                    {@ceo_flow.primary_candidate.identifier} · {@ceo_flow.primary_candidate.title}
                  </.app_link>
                  <p class="mt-1 text-xs leading-4 text-text-tertiary">
                    {@ceo_flow.primary_candidate.preflight_label} · {@ceo_flow.primary_candidate.preflight_summary}
                  </p>
                  <div
                    :if={@ceo_flow.primary_candidate.brief_readiness_label}
                    class="mt-2 flex flex-wrap items-center gap-2"
                  >
                    <span class={"rounded-full border px-2 py-0.5 text-[10px] font-510 #{owner_brief_readiness_badge_class(@ceo_flow.primary_candidate.brief_readiness_status)}"}>
                      Owner brief {@ceo_flow.primary_candidate.brief_readiness_score}
                    </span>
                    <span class="text-[11px] leading-4 text-text-tertiary">
                      {@ceo_flow.primary_candidate.brief_readiness_label} · {@ceo_flow.primary_candidate.brief_readiness_next}
                    </span>
                  </div>
                  <div
                    :if={@ceo_flow.primary_candidate.brief_repair_scaffold}
                    id="ceo-flow-brief-repair-scaffold"
                    phx-hook="CopyToClipboard"
                    class="mt-2 rounded-md border border-amber-500/20 bg-amber-500/[0.06] px-3 py-2.5"
                  >
                    <div class="flex flex-wrap items-center justify-between gap-2">
                      <p class="text-[10px] font-590 uppercase tracking-[0.14em] text-amber-300">
                        Brief repair scaffold
                      </p>
                      <button
                        type="button"
                        data-copy-text={@ceo_flow.primary_candidate.brief_repair_scaffold}
                        data-copy-label="Copy repair scaffold"
                        data-copy-success-label="Copied"
                        data-copy-error-label="Open preview"
                        class="rounded-md border border-amber-500/25 bg-panel px-2 py-1 text-[11px] font-510 text-text-secondary transition hover:border-amber-500/50 hover:bg-surface-hover hover:text-text-primary"
                      >
                        Copy repair scaffold
                      </button>
                    </div>
                    <details class="group mt-2">
                      <summary
                        title="Preview the repair scaffold"
                        aria-label="Preview the repair scaffold"
                        class="inline-flex cursor-pointer list-none items-center gap-1.5 text-[11px] font-510 text-text-tertiary hover:text-text-primary [&::-webkit-details-marker]:hidden"
                      >
                        Preview
                        <span class="hero-chevron-down-mini h-3.5 w-3.5 transition-transform group-open:rotate-180">
                        </span>
                      </summary>
                      <pre class="mt-2 whitespace-pre-wrap break-words font-mono text-[11px] leading-5 text-text-tertiary"><%= @ceo_flow.primary_candidate.brief_repair_scaffold %></pre>
                    </details>
                  </div>
                </div>
                <span class={"shrink-0 rounded-full border px-2 py-0.5 text-[10px] font-510 #{preflight_badge_class(@ceo_flow.primary_candidate.preflight_status)}"}>
                  {@ceo_flow.primary_candidate.status_label}
                </span>
              </div>

              <div
                :if={@ceo_flow.primary_candidate.brief}
                id="ceo-flow-candidate-brief"
                data-testid="ceo-flow-candidate-brief"
                phx-hook="CopyToClipboard"
                class="ui-advanced-only mt-3 rounded-md border border-sky-500/20 bg-sky-500/[0.06] px-3 py-2.5"
              >
                <div class="flex flex-wrap items-center justify-between gap-2">
                  <p class="text-[10px] font-590 uppercase tracking-[0.14em] text-sky-300">
                    Candidate proof packet
                  </p>
                  <div class="flex flex-wrap gap-2">
                    <button
                      type="button"
                      data-copy-text={@ceo_flow.primary_candidate.brief}
                      data-copy-label="Copy proof packet"
                      data-copy-success-label="Copied"
                      class="rounded-md border border-sky-500/25 bg-panel px-2 py-1 text-[11px] font-510 text-text-secondary transition hover:border-sky-500/50 hover:bg-surface-hover hover:text-text-primary"
                    >
                      Copy proof packet
                    </button>
                    <button
                      type="button"
                      data-copy-text={@ceo_flow.primary_candidate.focused_command}
                      data-copy-label="Copy command"
                      data-copy-success-label="Copied"
                      class="rounded-md border border-sky-500/25 bg-panel px-2 py-1 text-[11px] font-510 text-text-secondary transition hover:border-sky-500/50 hover:bg-surface-hover hover:text-text-primary"
                    >
                      Copy command
                    </button>
                  </div>
                </div>
                <p class="mt-1 text-[11px] leading-4 text-text-secondary">
                  {@ceo_flow.primary_candidate.first_turn}
                </p>
                <code class="mt-2 block overflow-x-auto whitespace-pre-wrap font-mono text-[11px] leading-5 text-text-tertiary">
                  {@ceo_flow.primary_candidate.focused_command}
                </code>
              </div>
            </div>
          </div>

          <div class="ui-advanced-only mt-4 rounded-md border border-border bg-surface/50">
            <div class="flex flex-wrap items-start justify-between gap-3 border-b border-border px-3 py-3">
              <div>
                <p class="font-serif text-[13px] font-510 italic tracking-[0.02em] text-brand/90">
                  Launch preview
                </p>
                <p class="mt-1 text-xs leading-5 text-text-tertiary">
                  {launch_preview_summary(@runtime_mode, @launch_preview)}
                </p>
              </div>
              <div class="flex shrink-0 flex-wrap items-center justify-end gap-2">
                <button
                  :if={@launch_preview.focused_count > 0}
                  id="runtime-clear-focused-queue"
                  type="button"
                  phx-click="clear_all_dispatch_focus"
                  data-confirm={
                    "Clear focused dispatch from #{@launch_preview.focused_count} #{plural_noun(@launch_preview.focused_count, "issue")}?"
                  }
                  class="inline-flex items-center justify-center rounded-md border border-border bg-panel px-2.5 py-1.5 text-xs font-510 text-text-secondary transition hover:border-border-hover hover:bg-surface-hover hover:text-text-primary"
                >
                  Clear focused queue
                </button>
                <span class="rounded-full border border-border bg-panel px-2 py-0.5 text-[11px] font-510 text-text-tertiary">
                  {@launch_preview.total_candidates} {plural_noun(
                    @launch_preview.total_candidates,
                    "candidate"
                  )}
                </span>
              </div>
            </div>
            <div
              :if={@launch_preview.total_candidates > 0}
              class="flex flex-wrap gap-1.5 border-b border-border px-3 py-2"
            >
              <span
                :if={@launch_preview.focused_count > 0}
                class={"rounded-full border px-2 py-0.5 text-[10px] font-510 #{launch_order_class(:operator_focus)}"}
              >
                {@launch_preview.focused_count} focused
              </span>
              <span class={"rounded-full border px-2 py-0.5 text-[10px] font-510 #{preflight_badge_class(:ready)}"}>
                {@launch_preview.preflight_counts.ready} ready
              </span>
              <span
                :if={@launch_preview.preflight_counts.route_first > 0}
                class={"rounded-full border px-2 py-0.5 text-[10px] font-510 #{preflight_badge_class(:attention)}"}
              >
                {@launch_preview.preflight_counts.route_first} route first
              </span>
              <span
                :if={@launch_preview.preflight_counts.attention > 0}
                class={"rounded-full border px-2 py-0.5 text-[10px] font-510 #{preflight_badge_class(:attention)}"}
              >
                {@launch_preview.preflight_counts.attention} config checks
              </span>
              <span
                :if={@launch_preview.preflight_counts.blocked > 0}
                class={"rounded-full border px-2 py-0.5 text-[10px] font-510 #{preflight_badge_class(:blocked)}"}
              >
                {@launch_preview.preflight_counts.blocked} blocked
              </span>
              <span
                :if={@launch_preview.preflight_counts.review_mode > 0}
                class={"rounded-full border px-2 py-0.5 text-[10px] font-510 #{preflight_badge_class(:review_mode)}"}
              >
                {@launch_preview.preflight_counts.review_mode} review mode
              </span>
            </div>

            <div :if={@launch_preview.candidates == []} class="px-3 py-4">
              <p class="text-xs leading-5 text-text-tertiary">
                No runnable issue candidates are waiting. Create or assign a To Do/In Review issue
                before enabling dispatch.
              </p>
            </div>

            <% shared_blocker = shared_preflight_blocker(@launch_preview.candidates) %>
            <p
              :if={shared_blocker}
              class="border-b border-border px-3 py-2 text-[11px] leading-4 text-text-tertiary"
            >
              <span class="font-590 text-text-secondary">
                Every candidate is waiting on the same fix:
              </span>
              {shared_blocker}
            </p>

            <div
              :if={@launch_preview.candidates != []}
              class="max-h-[760px] divide-y divide-border overflow-y-auto"
            >
              <div :for={candidate <- @launch_preview.candidates} class="min-w-0 px-3 py-3">
                <div class="flex min-w-0 flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
                  <div class="min-w-0 sm:flex-1">
                    <.app_link
                      navigate={~p"/issues/#{candidate.id}"}
                      class="break-words text-sm font-590 leading-5 text-text-primary hover:text-brand"
                    >
                      {candidate.identifier} · {candidate.title}
                    </.app_link>
                    <p class="mt-1 break-words text-xs leading-4 text-text-quaternary">
                      {candidate.project_name} · {candidate.assignee_name} · {candidate.role_label}
                    </p>
                  </div>
                  <div class="flex min-w-0 flex-wrap gap-1.5 sm:shrink-0 sm:justify-end">
                    <span class={"rounded-full border px-2 py-0.5 text-[10px] font-510 #{launch_order_class(candidate.dispatch_group)}"}>
                      #{candidate.dispatch_order} · {candidate.dispatch_label}
                    </span>
                    <span class="rounded-full border border-border bg-panel px-2 py-0.5 text-[10px] font-510 text-text-tertiary">
                      {candidate.status_label}
                    </span>
                    <span class={"rounded-full border px-2 py-0.5 text-[10px] font-510 #{launch_priority_class(candidate.priority)}"}>
                      {candidate.priority_label}
                    </span>
                    <span class={"rounded-full border px-2 py-0.5 text-[10px] font-510 #{preflight_badge_class(candidate.preflight.status)}"}>
                      {candidate.preflight.label}
                    </span>
                  </div>
                </div>
                <%!-- The row header above already carries the preflight pill, so
                     this box keeps only the detail. "Agent preflight" stays as the
                     group's accessible name. --%>
                <div
                  role="group"
                  aria-label="Agent preflight"
                  title={candidate.preflight.summary}
                  class="mt-2 rounded-md border border-border bg-canvas px-2.5 py-2"
                >
                  <%!-- When one fix unblocks the whole queue, the banner above says
                       so once. The row keeps its fix link — that target is the
                       candidate's own agent — and its summary moves to the title,
                       since the row header already names the role it varies by. --%>
                  <p :if={is_nil(shared_blocker)} class="text-[11px] leading-4 text-text-tertiary">
                    {candidate.preflight.summary}
                  </p>
                  <p
                    :if={candidate.preflight.first_action}
                    class="mt-1 text-[11px] leading-4 text-text-quaternary"
                  >
                    <span :if={is_nil(shared_blocker)} class="font-590 text-text-secondary">
                      {candidate.preflight.first_action.label}:
                    </span>
                    <span :if={is_nil(shared_blocker)}>
                      {candidate.preflight.first_action.detail}
                    </span>
                    <.app_link
                      :if={preflight_action_target_path(candidate.preflight.first_action)}
                      navigate={preflight_action_target_path(candidate.preflight.first_action)}
                      class="ml-1 inline-flex font-510 text-brand hover:text-brand/80"
                    >
                      {preflight_action_target_label(candidate.preflight.first_action)}
                    </.app_link>
                  </p>
                  <details class="group mt-2">
                    <summary
                      title="View preflight checks"
                      aria-label="View preflight checks"
                      class="inline-flex cursor-pointer list-none items-center gap-1.5 text-[11px] font-510 text-text-secondary hover:text-text-primary [&::-webkit-details-marker]:hidden"
                    >
                      Checks
                      <span class="hero-chevron-down-mini h-3.5 w-3.5 transition-transform group-open:rotate-180">
                      </span>
                    </summary>
                    <div class="mt-2 grid min-w-0 gap-1.5 sm:grid-cols-2">
                      <div
                        :for={item <- candidate.preflight.items}
                        class="min-w-0 rounded-md border border-border bg-panel px-2 py-1.5"
                      >
                        <div class="flex items-center gap-1.5">
                          <span class={readiness_dot_class(item.status)}></span>
                          <span class="text-[10px] font-590 uppercase tracking-[0.1em] text-text-quaternary">
                            {item.label}
                          </span>
                        </div>
                        <p
                          class="mt-0.5 truncate text-[11px] text-text-secondary"
                          title={item.detail}
                        >
                          {item.detail}
                        </p>
                      </div>
                    </div>
                  </details>
                </div>
                <div
                  :if={candidate.ceo_launch_brief}
                  id={"runtime-ceo-launch-brief-#{candidate.id}"}
                  phx-hook="CopyToClipboard"
                  class="mt-2 rounded-md border border-brand/25 bg-brand/10 px-2.5 py-2"
                >
                  <div class="flex flex-wrap items-center justify-between gap-2">
                    <p class="text-[10px] font-590 uppercase tracking-[0.14em] text-brand">
                      CEO launch brief
                    </p>
                    <button
                      type="button"
                      data-copy-text={candidate.ceo_launch_brief}
                      data-copy-label="Copy CEO brief"
                      data-copy-success-label="Copied"
                      class="rounded-md border border-brand/30 bg-panel px-2 py-1 text-[11px] font-510 text-text-secondary transition hover:border-brand/50 hover:bg-surface-hover hover:text-text-primary"
                    >
                      Copy CEO brief
                    </button>
                  </div>
                  <%!-- Both paragraphs below are static template text, identical for
                       every CEO candidate in the queue. Six rows printed them six
                       times; collapsed, the row keeps its label and copy button. --%>
                  <details class="group mt-1">
                    <summary
                      title="What this brief asks the CEO to do"
                      aria-label="What this brief asks the CEO to do"
                      class="inline-flex cursor-pointer list-none items-center gap-1.5 text-[11px] font-510 text-text-secondary hover:text-text-primary [&::-webkit-details-marker]:hidden"
                    >
                      What it asks
                      <span class="hero-chevron-down-mini h-3.5 w-3.5 transition-transform group-open:rotate-180">
                      </span>
                    </summary>
                    <p class="mt-1 text-[11px] leading-4 text-text-secondary">
                      First turn: Return `[owner_update]`, `[handoff]`, or `[blocked]`; when
                      execution is needed, create 2-5 scoped child issues with acceptance criteria
                      and block the parent as waiting on delegated sub-work.
                    </p>
                    <p class="mt-1 text-[11px] leading-4 text-text-quaternary">
                      No provider call. This brief only reads routing, preflight, and issue state.
                    </p>
                  </details>
                  <div
                    :if={candidate.brief_repair_scaffold}
                    class="mt-2 rounded-md border border-amber-500/20 bg-amber-500/[0.06] px-2.5 py-2"
                  >
                    <%!-- No eyebrow here: unlike the two standalone panels above,
                         this box sits inside a candidate row where the copy button
                         beside it already reads "Copy repair scaffold". --%>
                    <div class="flex flex-wrap items-center justify-end gap-2">
                      <button
                        type="button"
                        data-copy-text={candidate.brief_repair_scaffold}
                        data-copy-label="Copy repair scaffold"
                        data-copy-success-label="Copied"
                        data-copy-error-label="Open preview"
                        class="rounded-md border border-amber-500/25 bg-panel px-2 py-1 text-[11px] font-510 text-text-secondary transition hover:border-amber-500/50 hover:bg-surface-hover hover:text-text-primary"
                      >
                        Copy repair scaffold
                      </button>
                    </div>
                    <details class="group mt-2">
                      <summary
                        title="Preview the repair scaffold"
                        aria-label="Preview the repair scaffold"
                        class="inline-flex cursor-pointer list-none items-center gap-1.5 text-[11px] font-510 text-text-tertiary hover:text-text-primary [&::-webkit-details-marker]:hidden"
                      >
                        Preview
                        <span class="hero-chevron-down-mini h-3.5 w-3.5 transition-transform group-open:rotate-180">
                        </span>
                      </summary>
                      <pre class="mt-2 whitespace-pre-wrap break-words font-mono text-[11px] leading-5 text-text-tertiary"><%= candidate.brief_repair_scaffold %></pre>
                    </details>
                  </div>
                </div>
                <details class="group mt-2">
                  <%!-- The chevron alone was a 14x14 target, ~1/10th of the 44px
                       the rest of the app standardises on. Padding grows the hit
                       area without changing where the glyph sits. --%>
                  <summary
                    title="Focus this issue"
                    aria-label="Focus this issue"
                    class="-m-2.5 inline-flex min-h-[44px] min-w-[44px] cursor-pointer list-none items-center justify-center gap-1.5 p-2.5 text-[11px] font-510 text-brand hover:text-brand/80 [&::-webkit-details-marker]:hidden"
                  >
                    <span class="hero-chevron-down-mini h-3.5 w-3.5 transition-transform group-open:rotate-180">
                    </span>
                  </summary>
                  <div
                    id={"runtime-focused-launch-command-#{candidate.id}"}
                    phx-hook="CopyToClipboard"
                    class="mt-2 rounded-md border border-border bg-canvas p-2.5"
                  >
                    <div class="flex flex-wrap items-center justify-between gap-2">
                      <p class="text-[10px] font-590 uppercase tracking-[0.14em] text-text-quaternary">
                        Focused restart command
                      </p>
                      <button
                        type="button"
                        data-copy-text={candidate.focused_command}
                        data-copy-label="Copy command"
                        data-copy-success-label="Copied"
                        class="rounded-md border border-border bg-panel px-2 py-1 text-[11px] font-510 text-text-secondary transition hover:border-border-hover hover:bg-surface-hover hover:text-text-primary"
                      >
                        Copy command
                      </button>
                    </div>
                    <code class="mt-1.5 block overflow-x-auto font-mono text-[11px] leading-5 text-text-secondary">
                      {candidate.focused_command}
                    </code>
                  </div>
                </details>
                <button
                  :if={!candidate.dispatch_pinned?}
                  id={"runtime-queue-dispatch-focus-#{candidate.id}"}
                  type="button"
                  phx-click="prioritize_dispatch"
                  phx-value-issue-id={candidate.id}
                  class="mt-2 rounded-md border border-amber-500/25 bg-amber-500/10 px-2.5 py-1.5 text-[11px] font-510 text-amber-200 transition hover:bg-amber-500/15"
                >
                  Run this one first
                </button>
                <button
                  :if={candidate.dispatch_pinned?}
                  id={"runtime-clear-dispatch-focus-#{candidate.id}"}
                  type="button"
                  phx-click="clear_dispatch_focus"
                  phx-value-issue-id={candidate.id}
                  class="mt-2 rounded-md border border-border bg-panel px-2.5 py-1.5 text-[11px] font-510 text-text-secondary transition hover:border-border-hover hover:bg-surface-hover hover:text-text-primary"
                >
                  Clear dispatch focus
                </button>
              </div>
            </div>

            <p
              :if={launch_preview_footer(@launch_preview)}
              class="border-t border-border px-3 py-2 text-[11px] text-text-quaternary"
            >
              {launch_preview_footer(@launch_preview)}
            </p>
          </div>
        </div>
      </section>

      <.chapter_heading
        label="Queue"
        hint="what's waiting, and on whom"
        class="ui-advanced-only pt-3"
      />

      <section
        id="owner-signoff-queue"
        class="ui-advanced-only scroll-mt-20 rounded-lg border border-border bg-panel md:scroll-mt-6"
      >
        <div class="border-b border-border px-5 py-4">
          <div class="flex flex-col gap-3 lg:flex-row lg:items-start lg:justify-between">
            <div class="min-w-0">
              <div class="flex flex-wrap items-center gap-2">
                <h2 class="text-sm font-590 text-text-primary">Owner Signoff Queue</h2>
                <span class="shrink-0 rounded-full border border-amber-500/25 bg-amber-500/10 px-2 py-0.5 text-[11px] font-510 text-amber-200">
                  {@owner_signoffs.count} waiting
                </span>
              </div>
              <p class="mt-1 max-w-2xl text-sm leading-5 text-text-tertiary">
                {@owner_signoffs.summary}
              </p>
              <hr class="ember-rule mt-3" />
            </div>
          </div>
        </div>

        <div :if={@owner_signoffs.entries == []} class="px-5 py-4">
          <p class="text-sm leading-5 text-text-tertiary">
            Completed CEO work that needs owner acceptance will appear here.
          </p>
        </div>

        <div :if={@owner_signoffs.entries != []} class="divide-y divide-border">
          <div
            :for={signoff <- @owner_signoffs.entries}
            data-testid="owner-signoff-row"
            class="px-5 py-4"
          >
            <div class="grid min-w-0 gap-3 lg:grid-cols-[minmax(0,1fr)_auto]">
              <div class="min-w-0">
                <div class="flex flex-wrap items-center gap-2">
                  <span class="rounded-full border border-amber-500/25 bg-amber-500/10 px-2 py-0.5 text-[11px] font-510 text-amber-200">
                    Owner decision
                  </span>
                  <.app_link
                    navigate={signoff.target_path}
                    class="min-w-0 break-words text-sm font-590 leading-5 text-text-primary hover:text-brand"
                  >
                    {signoff.issue_identifier} · {signoff.issue_title}
                  </.app_link>
                </div>
                <p class="mt-1 max-w-3xl text-xs leading-5 text-text-tertiary">
                  {signoff.owner_update || signoff.blocker ||
                    "CEO requested owner acceptance for this issue."}
                </p>
                <p class="mt-1 text-[11px] leading-4 text-text-quaternary">
                  {signoff.assignee_name} · {signoff.project_name} · {signoff.issue_status_label}
                </p>
              </div>

              <div class="flex min-w-0 flex-wrap items-center gap-1.5 lg:max-w-[300px] lg:justify-end">
                <span class="rounded-full border border-border bg-surface px-2 py-0.5 text-[10px] font-510 text-text-quaternary">
                  {signoff.issue_priority_label}
                </span>
                <span class="rounded-full border border-border bg-surface px-2 py-0.5 text-[10px] font-510 text-text-quaternary">
                  {format_relative(signoff.inserted_at)}
                </span>
                <button
                  type="button"
                  phx-click="accept_owner_verification"
                  phx-value-issue-id={signoff.issue_id}
                  data-confirm="Accept this CEO owner update and close the issue?"
                  class="inline-flex items-center justify-center rounded-md border border-emerald-500/30 bg-emerald-500/10 px-2.5 py-1.5 text-xs font-510 text-emerald-200 transition hover:bg-emerald-500/15"
                >
                  Accept and close
                </button>
                <button
                  type="button"
                  phx-click="request_owner_revision"
                  phx-value-issue-id={signoff.issue_id}
                  data-confirm="Request a CEO revision, reopen this issue to To Do, and queue focused dispatch?"
                  class="inline-flex items-center justify-center rounded-md border border-border bg-panel px-2.5 py-1.5 text-xs font-510 text-text-secondary transition hover:border-border-hover hover:bg-surface-hover hover:text-text-primary"
                >
                  Request revision
                </button>
              </div>
            </div>
          </div>
        </div>

        <p
          :if={@owner_signoffs.scanned > @owner_signoffs.shown}
          class="border-t border-border px-5 py-2 text-[11px] text-text-quaternary"
        >
          Showing first {@owner_signoffs.shown} of {@owner_signoffs.scanned} owner signoffs.
        </p>
      </section>

      <%!-- Both consoles below are advanced-only: simple mode already shows the
           same work as plain rows in #operations-simple-action-queue. --%>
      <section
        id="delegated-work-queue"
        class="ui-advanced-only ember-glass scroll-mt-20 md:scroll-mt-6"
      >
        <div class="border-b border-border px-5 py-4">
          <div class="flex flex-col gap-3 lg:flex-row lg:items-start lg:justify-between">
            <div class="min-w-0">
              <div class="flex flex-wrap items-center gap-2">
                <h2 class="text-sm font-590 text-text-primary">Delegated Work Queue</h2>
                <span class="shrink-0 rounded-full border border-sky-500/25 bg-sky-500/10 px-2 py-0.5 text-[11px] font-510 text-sky-200">
                  {@delegated_work.count} open
                </span>
              </div>
              <hr class="ember-rule mt-3" />
              <p class="mt-1 max-w-2xl text-sm leading-5 text-text-tertiary">
                {@delegated_work.summary}
              </p>
              <div
                :if={@delegated_work.count > 0}
                class="mt-2 flex flex-wrap items-center gap-1.5 text-[10px] font-510"
              >
                <span class="rounded-full border border-emerald-500/25 bg-emerald-500/10 px-2 py-0.5 text-emerald-300">
                  {@delegated_work.queueable_count} runnable
                </span>
                <span
                  :if={@delegated_work.pinned_count > 0}
                  class="rounded-full border border-amber-500/25 bg-amber-500/10 px-2 py-0.5 text-amber-200"
                >
                  {@delegated_work.pinned_count} focused
                </span>
                <span
                  :if={@delegated_work.setup_blocked_count > 0}
                  class="rounded-full border border-brand/25 bg-brand/10 px-2 py-0.5 text-brand"
                >
                  {@delegated_work.setup_blocked_count} setup blocked
                </span>
                <span
                  :if={@delegated_work.dependency_blocked_count > 0}
                  class="rounded-full border border-amber-500/25 bg-amber-500/10 px-2 py-0.5 text-amber-200"
                >
                  {@delegated_work.dependency_blocked_count} dependency blocked
                </span>
                <span
                  :if={@delegated_work.attention_count > 0}
                  class="rounded-full border border-amber-500/25 bg-amber-500/10 px-2 py-0.5 text-amber-300"
                >
                  {@delegated_work.attention_count} review setup
                </span>
              </div>
              <div
                :if={@delegated_work.filtered?}
                class="mt-2 flex flex-wrap items-center gap-2 text-xs text-text-tertiary"
              >
                <span class="rounded-full border border-border bg-surface px-2 py-0.5 font-510 text-text-secondary">
                  Filtered to {@delegated_work.parent_identifier}
                </span>
                <.app_link
                  :if={@delegated_work.parent_path}
                  navigate={@delegated_work.parent_path}
                  class="font-510 text-brand hover:underline"
                >
                  {@delegated_work.parent_title}
                </.app_link>
                <.app_link
                  navigate="/operations#delegated-work-queue"
                  class="font-510 text-text-quaternary hover:text-text-secondary"
                >
                  Show all delegated work
                </.app_link>
              </div>
            </div>
            <div
              :if={@delegated_work.count > 0}
              class="flex shrink-0 flex-wrap items-center gap-2"
            >
              <button
                type="button"
                phx-click="prioritize_delegated_work"
                disabled={@delegated_work.queueable_count == 0}
                class={[
                  "inline-flex items-center justify-center gap-1.5 rounded-md border border-amber-500/25 bg-amber-500/10 px-2.5 py-1.5 text-xs font-510 text-amber-200 transition hover:bg-amber-500/15",
                  @delegated_work.queueable_count == 0 &&
                    "cursor-not-allowed opacity-60 hover:bg-amber-500/10"
                ]}
              >
                <span class="hero-bolt-mini h-3.5 w-3.5"></span>
                <span class="ui-simple-only">Focus queue</span>
                <span class="ui-advanced-only">Queue runnable work</span>
              </button>
              <.app_link
                navigate="#runtime-launch-checklist"
                class="ui-advanced-only inline-flex items-center justify-center rounded-md border border-border bg-surface px-2.5 py-1.5 text-xs font-510 text-text-secondary transition hover:border-border-hover hover:bg-surface-hover hover:text-text-primary"
              >
                Open launch preview
              </.app_link>
            </div>
          </div>
        </div>

        <div :if={@delegated_work.entries == []} class="px-5 py-4">
          <p class="text-sm leading-5 text-text-tertiary">
            {@delegated_work.empty_hint}
          </p>
        </div>

        <div
          :if={show_operations_swarm_log?(@delegated_work, @swarm_event_rows)}
          data-testid="operations-swarm-log"
          class="border-b border-border bg-canvas/35 px-5 py-4"
        >
          <div class="flex flex-wrap items-center justify-between gap-3">
            <div class="flex min-w-0 items-center gap-2">
              <span class="inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-md border border-teal-500/20 bg-teal-500/10 text-teal-300">
                <span class="hero-signal-mini h-4 w-4"></span>
              </span>
              <div class="min-w-0">
                <h3 class="text-xs font-590 text-text-primary">Live swarm log</h3>
                <p class="text-[11px] leading-4 text-text-tertiary">
                  Workers feed CTO synthesis, then the CEO gets the handoff.
                </p>
              </div>
            </div>
            <div class="flex shrink-0 items-center gap-1.5">
              <span class="rounded-full border border-border bg-surface px-2 py-0.5 text-[10px] font-590 uppercase text-text-tertiary">
                Latest first
              </span>
              <span class="rounded-full border border-border bg-surface px-2 py-0.5 text-[10px] font-590 uppercase text-text-tertiary">
                {length(@swarm_event_rows)} events
              </span>
            </div>
          </div>

          <div
            :if={@swarm_event_rows == []}
            class="mt-3 text-xs leading-5 text-text-tertiary"
          >
            Waiting for the first swarm event.
          </div>

          <ol
            :if={@swarm_event_rows != []}
            class="mt-3 max-h-56 divide-y divide-border overflow-y-auto border-t border-border"
          >
            <li
              :for={event <- @swarm_event_rows}
              class="grid gap-2 py-2.5 sm:grid-cols-[6.5rem_minmax(0,1fr)]"
            >
              <div class="flex items-center gap-2 text-[11px] text-text-tertiary">
                <span class={swarm_event_dot_class(event.status)}></span>
                <span class="font-mono">{event.time}</span>
              </div>
              <div class="min-w-0">
                <div class="flex flex-wrap items-center gap-2">
                  <span class={swarm_event_badge_class(event.status)}>
                    {event.type_label}
                  </span>
                  <p class="min-w-0 flex-1 text-xs leading-5 text-text-primary">
                    {event.message}
                  </p>
                </div>
                <div :if={event.chips != []} class="mt-1 flex flex-wrap gap-1.5">
                  <span
                    :for={chip <- event.chips}
                    class="max-w-full truncate rounded-full border border-border bg-surface px-2 py-0.5 text-[10px] text-text-tertiary"
                  >
                    {chip}
                  </span>
                </div>
              </div>
            </li>
          </ol>
        </div>

        <div :if={@delegated_work.entries != []} class="divide-y divide-border">
          <div
            :for={work <- @delegated_work.entries}
            data-testid="delegated-work-row"
            class="px-5 py-4"
          >
            <div class="grid min-w-0 gap-3 xl:grid-cols-[minmax(0,1fr)_minmax(280px,360px)]">
              <div class="min-w-0">
                <div class="flex flex-wrap items-center gap-2">
                  <span class="rounded-full border border-sky-500/25 bg-sky-500/10 px-2 py-0.5 text-[11px] font-510 text-sky-200">
                    {work.work_kind_label}
                  </span>
                  <span class={"rounded-full border px-2 py-0.5 text-[10px] font-510 #{launch_order_class(work.dispatch_group)}"}>
                    #{work.dispatch_order} · {work.dispatch_label}
                  </span>
                  <span class="rounded-full border border-border bg-surface px-2 py-0.5 text-[10px] font-510 text-text-quaternary">
                    {work.issue_status_label}
                  </span>
                  <span class={"ui-advanced-only rounded-full border px-2 py-0.5 text-[10px] font-510 #{launch_priority_class(work.issue_priority)}"}>
                    {work.issue_priority_label}
                  </span>
                  <span class={"ui-advanced-only rounded-full border px-2 py-0.5 text-[10px] font-510 #{preflight_badge_class(work.preflight.status)}"}>
                    {work.preflight.label}
                  </span>
                  <span
                    title={work.preflight.label}
                    aria-label={work.preflight.label}
                    class="ui-simple-only inline-flex h-6 w-6 items-center justify-center rounded-full border border-white/15 bg-white/10 text-white"
                  >
                    <span class={[preflight_icon_class(work.preflight.status), "h-3.5 w-3.5"]}>
                    </span>
                  </span>
                </div>

                <.app_link
                  navigate={work.target_path}
                  class="mt-2 block break-words text-sm font-590 leading-5 text-text-primary hover:text-brand"
                >
                  {work.issue_identifier} · {work.issue_title}
                </.app_link>

                <p class="mt-1 text-xs leading-5 text-text-tertiary">
                  {work.assignee_name} · {work.role_label} · {work.project_name}
                </p>
                <p class="mt-0.5 text-[11px] leading-4 text-text-quaternary">
                  From
                  <.app_link
                    :if={work.parent_path}
                    navigate={work.parent_path}
                    class="font-510 text-text-secondary hover:text-brand"
                  >
                    {work.parent_identifier} · {work.parent_title}
                  </.app_link>
                  <span :if={!work.parent_path}>
                    {work.parent_identifier} · {work.parent_title}
                  </span>
                  · delegated by {work.created_by_name} · {format_relative(work.inserted_at)}
                </p>

                <p
                  :if={work.blocked?}
                  class="mt-2 rounded-md border border-amber-500/25 bg-amber-500/10 px-2.5 py-2 text-xs leading-5 text-amber-100"
                >
                  Blocked by {work.blocker_count} upstream {plural_noun(
                    work.blocker_count,
                    "issue"
                  )};
                  clear the blocker before runtime can execute it.
                </p>

                <div class="ui-advanced-only mt-2 rounded-md border border-border bg-canvas px-2.5 py-2">
                  <div class="flex flex-wrap items-center justify-between gap-2">
                    <p class="text-[10px] font-590 uppercase tracking-[0.14em] text-text-quaternary">
                      Owner preflight
                    </p>
                    <span class={"rounded-full border px-2 py-0.5 text-[10px] font-510 #{preflight_badge_class(work.preflight.status)}"}>
                      {work.preflight.label}
                    </span>
                  </div>
                  <p class="mt-1 text-[11px] leading-4 text-text-tertiary">
                    {work.preflight.summary}
                  </p>
                  <p
                    :if={work.preflight.first_action}
                    class="mt-1 text-[11px] leading-4 text-text-quaternary"
                  >
                    <span class="font-590 text-text-secondary">
                      {work.preflight.first_action.label}:
                    </span>
                    {work.preflight.first_action.detail}
                    <.app_link
                      :if={preflight_action_target_path(work.preflight.first_action)}
                      navigate={preflight_action_target_path(work.preflight.first_action)}
                      class="ml-1 inline-flex font-510 text-brand hover:text-brand/80"
                    >
                      {preflight_action_target_label(work.preflight.first_action)}
                    </.app_link>
                  </p>
                </div>
              </div>

              <div class="min-w-0">
                <div
                  id={"delegated-work-focused-command-#{work.issue_id}"}
                  phx-hook="CopyToClipboard"
                  class="ui-advanced-only rounded-md border border-border bg-canvas p-2.5"
                >
                  <div class="flex flex-wrap items-center justify-between gap-2">
                    <p class="text-[10px] font-590 uppercase tracking-[0.14em] text-text-quaternary">
                      Focused restart command
                    </p>
                    <button
                      type="button"
                      data-copy-text={work.focused_command}
                      data-copy-label="Copy command"
                      data-copy-success-label="Copied"
                      class="rounded-md border border-border bg-panel px-2 py-1 text-[11px] font-510 text-text-secondary transition hover:border-border-hover hover:bg-surface-hover hover:text-text-primary"
                    >
                      Copy command
                    </button>
                  </div>
                  <code class="mt-1.5 block overflow-x-auto font-mono text-[11px] leading-5 text-text-secondary">
                    {work.focused_command}
                  </code>
                </div>

                <div class="mt-2 flex flex-wrap gap-1.5">
                  <button
                    :if={work.queueable?}
                    id={"delegated-work-queue-dispatch-focus-#{work.issue_id}"}
                    type="button"
                    phx-click="prioritize_dispatch"
                    phx-value-issue-id={work.issue_id}
                    class="rounded-md border border-amber-500/25 bg-amber-500/10 px-2.5 py-1.5 text-[11px] font-510 text-amber-200 transition hover:bg-amber-500/15"
                  >
                    <span class="ui-simple-only">Focus CTO</span>
                    <span class="ui-advanced-only">Run this one first</span>
                  </button>
                  <button
                    :if={work.dispatch_pinned?}
                    id={"delegated-work-clear-dispatch-focus-#{work.issue_id}"}
                    type="button"
                    phx-click="clear_dispatch_focus"
                    phx-value-issue-id={work.issue_id}
                    class="rounded-md border border-border bg-panel px-2.5 py-1.5 text-[11px] font-510 text-text-secondary transition hover:border-border-hover hover:bg-surface-hover hover:text-text-primary"
                  >
                    Clear dispatch focus
                  </button>
                  <.app_link
                    :if={delegated_work_setup_action?(work)}
                    id={"delegated-work-fix-setup-#{work.issue_id}"}
                    navigate={preflight_action_target_path(work.preflight.first_action)}
                    class={delegated_work_setup_action_class(work)}
                  >
                    {delegated_work_setup_action_label(work)}
                  </.app_link>
                  <span
                    :if={
                      !work.queueable? && !work.dispatch_pinned? && !work.setup_blocked? &&
                        !work.preflight_attention? && !work.blocked?
                    }
                    class="rounded-md border border-border bg-surface px-2.5 py-1.5 text-[11px] font-510 text-text-quaternary"
                  >
                    Review setup first
                  </span>
                </div>
              </div>
            </div>
          </div>
        </div>

        <p
          :if={@delegated_work.scanned > @delegated_work.shown}
          class="border-t border-border px-5 py-2 text-[11px] text-text-quaternary"
        >
          Showing first {@delegated_work.shown} of {@delegated_work.scanned} delegated work items.
        </p>
      </section>

      <section
        id="review-nudges"
        class="ui-advanced-only rounded-lg border border-border bg-panel scroll-mt-6"
      >
        <div class="border-b border-border px-5 py-4">
          <div class="flex flex-col gap-3 lg:flex-row lg:items-start lg:justify-between">
            <div>
              <h2 class="text-sm font-590 text-text-primary">Review Nudges</h2>
              <p class="mt-1 text-xs text-text-quaternary">
                Evidence, review, and owner-update requests waiting across the company.
              </p>
              <hr class="ember-rule mt-3" />
            </div>
            <div class="stagger-children flex shrink-0 items-stretch gap-px overflow-hidden rounded-md border border-border bg-border">
              <div class="min-w-[64px] bg-panel px-3 py-2 text-center">
                <p class="font-mono text-[16px] font-590 leading-none tabular-nums text-text-primary">
                  {@review_nudges.counts.active}
                </p>
                <p class="mt-1.5 text-[10px] font-590 uppercase tracking-[0.14em] text-text-quaternary">
                  Active
                </p>
              </div>
              <div class="min-w-[64px] bg-panel px-3 py-2 text-center">
                <p class="font-mono text-[16px] font-590 leading-none tabular-nums text-brand">
                  {@review_nudges.counts.stale}
                </p>
                <p class="mt-1.5 text-[10px] font-590 uppercase tracking-[0.14em] text-text-quaternary">
                  Stale
                </p>
              </div>
              <div class="min-w-[64px] bg-panel px-3 py-2 text-center">
                <p class="font-mono text-[16px] font-590 leading-none tabular-nums text-blue-300">
                  {@review_nudges.counts.running}
                </p>
                <p class="mt-1.5 text-[10px] font-590 uppercase tracking-[0.14em] text-text-quaternary">
                  Running
                </p>
              </div>
              <div class="min-w-[64px] bg-panel px-3 py-2 text-center">
                <p class="font-mono text-[16px] font-590 leading-none tabular-nums text-emerald-300">
                  {@review_nudges.counts.cleared}
                </p>
                <p class="mt-1.5 text-[10px] font-590 uppercase tracking-[0.14em] text-text-quaternary">
                  Cleared
                </p>
              </div>
            </div>
          </div>
        </div>

        <div
          :if={@review_nudges.counts.total == 0}
          class="px-5 py-10 text-center text-sm text-text-tertiary"
        >
          No review nudges have been queued yet.
        </div>

        <div
          :if={@review_nudges.counts.total > 0}
          class="grid min-w-0 gap-px bg-border lg:grid-cols-2"
        >
          <div class="min-w-0 bg-panel p-5">
            <div class="flex items-center justify-between gap-3">
              <h3 class="text-xs font-590 uppercase tracking-[0.08em] text-text-quaternary">
                By agent
              </h3>
              <span class="text-xs text-text-quaternary">
                {@review_nudges.counts.active} active
              </span>
            </div>
            <div :if={@review_nudges.by_agent == []} class="mt-4 text-sm text-text-tertiary">
              No active agent nudges.
            </div>
            <div :if={@review_nudges.by_agent != []} class="mt-4 space-y-2">
              <div
                :for={group <- @review_nudges.by_agent}
                class="rounded-lg border border-border bg-surface px-3 py-2"
              >
                <div class="flex items-center justify-between gap-3">
                  <p class="truncate text-sm font-510 text-text-primary">{group.label}</p>
                  <span class="font-mono text-xs tabular-nums text-text-quaternary">
                    {group.count}
                  </span>
                </div>
                <p class="mt-1 text-xs text-text-quaternary">
                  {group.stale} stale · {group.running} running
                </p>
              </div>
            </div>
          </div>

          <div class="min-w-0 bg-panel p-5">
            <div class="flex items-center justify-between gap-3">
              <h3 class="text-xs font-590 uppercase tracking-[0.08em] text-text-quaternary">
                By blocker
              </h3>
              <span class="text-xs text-text-quaternary">Top wait states</span>
            </div>
            <div :if={@review_nudges.by_blocker == []} class="mt-4 text-sm text-text-tertiary">
              No active blocker groups.
            </div>
            <div :if={@review_nudges.by_blocker != []} class="mt-4 space-y-2">
              <div
                :for={group <- @review_nudges.by_blocker}
                class="rounded-lg border border-border bg-surface px-3 py-2"
              >
                <div class="flex items-center justify-between gap-3">
                  <p class="truncate text-sm font-510 text-text-primary">{group.label}</p>
                  <span class="font-mono text-xs tabular-nums text-text-quaternary">
                    {group.count}
                  </span>
                </div>
                <p class="mt-1 text-xs text-text-quaternary">
                  {group.stale} stale · {group.running} running
                </p>
              </div>
            </div>
          </div>
        </div>

        <div :if={@review_nudges.active != []} class="border-t border-border">
          <div class="border-b border-border px-5 py-3">
            <h3 class="text-xs font-590 uppercase tracking-[0.08em] text-text-quaternary">
              Active queue
            </h3>
          </div>
          <div class="divide-y divide-border">
            <div :for={nudge <- @review_nudges.active} class="px-5 py-4">
              <div class="flex flex-col gap-3 xl:flex-row xl:items-start xl:justify-between">
                <div class="min-w-0">
                  <div class="flex flex-wrap items-center gap-2">
                    <span class={"rounded-full border px-2 py-0.5 text-[11px] font-510 #{nudge_badge_class(nudge.lifecycle)}"}>
                      {nudge.status_label}
                    </span>
                    <span class="text-xs text-text-quaternary">
                      Waiting {format_duration(nudge.age_seconds)}
                    </span>
                    <span class="text-xs text-text-quaternary">·</span>
                    <span class="text-xs text-text-quaternary">
                      {Enum.join(nudge.blocker_labels, ", ")}
                    </span>
                  </div>
                  <p class="mt-2 truncate text-sm font-590 text-text-primary">
                    {nudge.issue_identifier || short_id(nudge.issue_id)} · {nudge.issue_title}
                  </p>
                  <p class="mt-1 text-xs leading-5 text-text-tertiary">{nudge.summary}</p>
                  <p class="mt-1 text-xs text-text-quaternary">Owner: {nudge.agent_name}</p>
                </div>

                <div class="flex shrink-0 flex-wrap gap-2 xl:justify-end">
                  <.app_link
                    :if={nudge.issue}
                    navigate={~p"/issues/#{nudge.issue.id}"}
                    class="rounded-md border border-border bg-surface px-2.5 py-1.5 text-xs font-510 text-text-secondary hover:bg-surface-hover hover:text-text-primary"
                  >
                    Open issue
                  </.app_link>
                  <.app_link
                    :if={nudge.next_action}
                    navigate={nudge.next_action.path}
                    class="rounded-md border border-brand/30 bg-brand/10 px-2.5 py-1.5 text-xs font-510 text-brand hover:bg-brand/15"
                  >
                    {nudge.next_action.label}
                  </.app_link>
                  <.app_link
                    :if={nudge.agent}
                    navigate={~p"/agents/#{nudge.agent.id}?tab=inbox"}
                    class="rounded-md border border-border bg-surface px-2.5 py-1.5 text-xs font-510 text-text-secondary hover:bg-surface-hover hover:text-text-primary"
                  >
                    Open agent
                  </.app_link>
                  <button
                    type="button"
                    phx-click="clear_review_nudge"
                    phx-value-id={nudge.id}
                    class="rounded-md border border-emerald-500/25 bg-emerald-500/10 px-2.5 py-1.5 text-xs font-510 text-emerald-300 hover:bg-emerald-500/15"
                  >
                    Mark handled
                  </button>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div :if={@review_nudges.cleared != []} class="border-t border-border">
          <div class="border-b border-border px-5 py-3">
            <h3 class="text-xs font-590 uppercase tracking-[0.08em] text-text-quaternary">
              Recently cleared
            </h3>
          </div>
          <div class="divide-y divide-border">
            <div
              :for={nudge <- @review_nudges.cleared}
              class="flex flex-wrap items-center justify-between gap-3 px-5 py-3"
            >
              <div class="min-w-0">
                <p class="truncate text-sm font-510 text-text-primary">
                  {nudge.issue_identifier || short_id(nudge.issue_id)} · {nudge.issue_title}
                </p>
                <p class="mt-0.5 text-xs text-text-quaternary">
                  {Enum.join(nudge.blocker_labels, ", ")} · {nudge.agent_name}
                </p>
              </div>
              <span class={"rounded-full border px-2 py-0.5 text-[11px] font-510 #{nudge_badge_class(nudge.lifecycle)}"}>
                {nudge.status_label}
              </span>
            </div>
          </div>
        </div>
      </section>

      <section
        id="wake-backlog"
        class="ui-advanced-only rounded-lg border border-border bg-panel scroll-mt-6"
      >
        <div class="border-b border-border px-5 py-4">
          <div class="flex flex-col gap-3 xl:flex-row xl:items-start xl:justify-between">
            <div class="min-w-0">
              <h2 class="text-sm font-590 text-text-primary">Wake Backlog</h2>
              <p class="mt-1 text-xs leading-5 text-text-quaternary">
                Stale comment wakes that still occupy agent queue room. Clearing them leaves issue comments intact.
              </p>
              <hr class="ember-rule mt-3" />
            </div>
            <div class="flex shrink-0 flex-wrap items-stretch gap-2">
              <div class="stagger-children flex overflow-hidden rounded-md border border-border bg-border">
                <div class="min-w-[84px] bg-panel px-3 py-2 text-center">
                  <p class="font-mono text-[16px] font-590 leading-none tabular-nums text-text-primary">
                    {@wake_queue.counts.pending_comments}
                  </p>
                  <p class="mt-1.5 text-[10px] font-590 uppercase tracking-[0.14em] text-text-quaternary">
                    Pending
                  </p>
                </div>
                <div class="min-w-[84px] bg-panel px-3 py-2 text-center">
                  <p class="font-mono text-[16px] font-590 leading-none tabular-nums text-amber-300">
                    {@wake_queue.counts.stale_comments}
                  </p>
                  <p class="mt-1.5 text-[10px] font-590 uppercase tracking-[0.14em] text-text-quaternary">
                    Stale
                  </p>
                </div>
              </div>
              <button
                :if={@wake_queue.counts.stale_comments > 0}
                type="button"
                phx-click="clear_stale_comment_wakes"
                class="inline-flex items-center justify-center rounded-md border border-amber-500/25 bg-amber-500/10 px-3 py-2 text-xs font-590 text-amber-200 transition hover:bg-amber-500/15"
              >
                Clear stale wakes
              </button>
            </div>
          </div>
        </div>

        <div class="px-5 py-4">
          <div class="rounded-md border border-border bg-surface px-3 py-2.5">
            <p class="text-sm leading-5 text-text-tertiary">{@wake_queue.summary}</p>
            <p class="mt-1 text-xs text-text-quaternary">
              Stale threshold: {@wake_queue.stale_after_minutes} minutes
            </p>
          </div>
        </div>

        <div
          :if={@wake_queue.counts.stale_comments == 0}
          class="border-t border-border px-5 py-8 text-center text-sm text-text-tertiary"
        >
          No stale comment wakes are holding queue slots.
        </div>

        <div
          :if={@wake_queue.counts.stale_comments > 0}
          class="grid min-w-0 gap-px border-t border-border bg-border lg:grid-cols-[280px_minmax(0,1fr)]"
        >
          <div class="min-w-0 bg-panel p-5">
            <div class="flex items-center justify-between gap-3">
              <h3 class="text-xs font-590 uppercase tracking-[0.08em] text-text-quaternary">
                By agent
              </h3>
              <span class="text-xs text-text-quaternary">
                {@wake_queue.counts.stale_comments} stale
              </span>
            </div>
            <div :if={@wake_queue.by_agent == []} class="mt-4 text-sm text-text-tertiary">
              No stale agent groups.
            </div>
            <div :if={@wake_queue.by_agent != []} class="mt-4 space-y-2">
              <div
                :for={group <- @wake_queue.by_agent}
                class="rounded-lg border border-border bg-surface px-3 py-2"
              >
                <div class="flex items-center justify-between gap-3">
                  <p class="truncate text-sm font-510 text-text-primary">{group.label}</p>
                  <span class="font-mono text-xs tabular-nums text-text-quaternary">
                    {group.count}
                  </span>
                </div>
                <p class="mt-1 text-xs text-text-quaternary">
                  Oldest waiting {format_duration(group.oldest_seconds)}
                </p>
              </div>
            </div>
          </div>

          <div class="min-w-0 divide-y divide-border bg-panel">
            <div class="px-5 py-3">
              <h3 class="text-xs font-590 uppercase tracking-[0.08em] text-text-quaternary">
                Oldest stale wakes
              </h3>
            </div>
            <div :for={wake <- @wake_queue.entries} class="px-5 py-4">
              <div class="flex flex-col gap-3 xl:flex-row xl:items-start xl:justify-between">
                <div class="min-w-0">
                  <div class="flex flex-wrap items-center gap-2">
                    <span class="rounded-full border border-amber-500/25 bg-amber-500/10 px-2 py-0.5 text-[11px] font-510 text-amber-300">
                      {wake.reason_label}
                    </span>
                    <span class="text-xs text-text-quaternary">
                      Waiting {format_duration(wake.age_seconds)}
                    </span>
                  </div>
                  <p class="mt-2 truncate text-sm font-590 text-text-primary">
                    {wake.issue_identifier || short_id(wake.issue_id)} · {wake.issue_title ||
                      "Untitled issue"}
                  </p>
                  <p class="mt-1 text-xs text-text-quaternary">
                    Owner: {wake.agent_name}
                  </p>
                </div>

                <div class="flex shrink-0 flex-wrap gap-2 xl:justify-end">
                  <.app_link
                    :if={wake.issue}
                    navigate={~p"/issues/#{wake.issue.id}"}
                    class="rounded-md border border-border bg-surface px-2.5 py-1.5 text-xs font-510 text-text-secondary hover:bg-surface-hover hover:text-text-primary"
                  >
                    Open issue
                  </.app_link>
                  <.app_link
                    :if={wake.agent}
                    navigate={~p"/agents/#{wake.agent.id}?tab=inbox"}
                    class="rounded-md border border-border bg-surface px-2.5 py-1.5 text-xs font-510 text-text-secondary hover:bg-surface-hover hover:text-text-primary"
                  >
                    Open agent
                  </.app_link>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <.chapter_heading
        label="Ledger"
        hint="history and telemetry — read when curious"
        class="ui-advanced-only pt-3"
      />

      <section
        id="ceo-outcome-monitor"
        class="ui-advanced-only scroll-mt-20 rounded-lg border border-border bg-panel md:scroll-mt-6"
      >
        <div
          data-testid="ceo-outcome-header"
          class="space-y-4 border-b border-border px-5 py-4"
        >
          <div class="grid gap-4 xl:grid-cols-[minmax(0,1fr)_minmax(280px,360px)] xl:items-start">
            <div class="min-w-0 max-w-3xl">
              <div class="flex flex-wrap items-center gap-2">
                <h2 class="text-sm font-590 text-text-primary">CEO Outcome Monitor</h2>
                <span class="shrink-0 rounded-full border border-border bg-surface px-2 py-0.5 text-[11px] font-510 text-text-tertiary">
                  {@ceo_outcomes.counts.recent} recent
                </span>
              </div>
              <p class="ui-advanced-only mt-1 max-w-2xl text-sm leading-5 text-text-tertiary">
                {@ceo_outcomes.summary}
              </p>
              <hr class="ember-rule mt-3" />
            </div>

            <div
              data-testid="ceo-outcome-health-strip"
              class="stagger-children grid min-w-0 grid-cols-3 gap-px overflow-hidden rounded-md border border-border bg-border"
            >
              <.quiet_stat
                label="Signal"
                value={ceo_outcome_signal_count(@ceo_outcomes.counts)}
                class="bg-surface/70 px-3 py-2.5"
              />
              <.quiet_stat
                label="Receipts"
                value={"#{@ceo_outcomes.counts.receipt_complete}/#{@ceo_outcomes.counts.receipt_checked}"}
                class="bg-surface/70 px-3 py-2.5"
              />
              <div class="ember-stat min-w-0 bg-surface/70 px-3 py-2.5">
                <p class="text-[10px] font-590 uppercase tracking-[0.14em] text-text-quaternary">
                  Attention
                </p>
                <p class={[
                  "mt-1 font-serif text-[28px] font-510 leading-none tabular-nums",
                  if(@ceo_outcomes.counts.attention > 0,
                    do: "text-amber-300",
                    else: "text-text-quaternary"
                  )
                ]}>
                  {@ceo_outcomes.counts.attention}
                </p>
              </div>
            </div>
          </div>

          <div
            data-testid="ceo-outcome-metrics"
            class="stagger-children grid min-w-0 gap-2 sm:grid-cols-2 lg:grid-cols-4 2xl:grid-cols-7"
          >
            <div
              :for={metric <- ceo_outcome_metric_cards(@ceo_outcomes.counts)}
              class="min-w-0 rounded-md border border-border bg-surface/60 px-3 py-2"
            >
              <div class="flex items-baseline justify-between gap-2">
                <p class="truncate text-[11px] font-510 text-text-quaternary">{metric.label}</p>
                <p class={[
                  "font-mono text-[15px] font-590 leading-none tabular-nums",
                  if(metric.value > 0, do: metric.value_class, else: "text-text-quaternary")
                ]}>
                  {metric.value}
                </p>
              </div>
              <p
                title={metric.detail}
                class="ui-advanced-only mt-1 text-[11px] leading-4 text-text-tertiary"
              >
                {metric.detail}
              </p>
            </div>
          </div>
        </div>

        <div :if={@ceo_outcomes.entries == []} class="px-5 py-4">
          <p class="text-sm leading-5 text-text-tertiary">
            No CEO action outcomes are available yet. Run a focused CEO issue, then refresh this
            page to inspect the first-turn result.
          </p>
        </div>

        <div :if={@ceo_outcomes.entries != []} class="divide-y divide-border">
          <div
            :for={outcome <- @ceo_outcomes.entries}
            data-testid="ceo-outcome-row"
            class="px-5 py-4"
          >
            <div class="grid min-w-0 gap-3 lg:grid-cols-[minmax(0,1fr)_auto]">
              <div class="min-w-0">
                <div class="flex flex-wrap items-center gap-2">
                  <span class={"rounded-full border px-2 py-0.5 text-[11px] font-510 #{ceo_outcome_badge_class(outcome.outcome)}"}>
                    {outcome.outcome_label}
                  </span>
                  <.app_link
                    navigate={outcome.target_path}
                    class="min-w-0 break-words text-sm font-590 leading-5 text-text-primary hover:text-brand"
                  >
                    {outcome.issue_identifier} · {outcome.issue_title}
                  </.app_link>
                </div>
                <p class="mt-1 max-w-3xl text-xs leading-5 text-text-tertiary">
                  {outcome.detail}
                </p>
                <p class="mt-1 text-[11px] leading-4 text-text-quaternary">
                  {outcome.agent_name} · {outcome.project_name} · {outcome.issue_status_label}
                </p>
                <div
                  :if={outcome.receipt}
                  class="mt-2 flex max-w-3xl flex-wrap items-center gap-2"
                >
                  <span class={"rounded-full border px-2 py-0.5 text-[10px] font-510 #{ceo_receipt_badge_class(outcome.receipt.status)}"}>
                    {outcome.receipt.status_label}
                  </span>
                  <span class="text-[11px] leading-4 text-text-tertiary">
                    {outcome.receipt.summary}
                  </span>
                </div>
                <details
                  :if={repairable_ceo_outcome?(outcome)}
                  class="group mt-2"
                >
                  <summary class="inline-flex cursor-pointer list-none items-center gap-1.5 text-[11px] font-510 text-brand hover:text-brand/80 [&::-webkit-details-marker]:hidden">
                    {ceo_outcome_repair_label(outcome)}
                    <span class="hero-chevron-down-mini h-3.5 w-3.5 transition-transform group-open:rotate-180">
                    </span>
                  </summary>
                  <div
                    id={"ceo-outcome-focused-command-#{outcome.id}"}
                    phx-hook="CopyToClipboard"
                    class="mt-2 rounded-md border border-border bg-canvas p-2.5"
                  >
                    <div class="flex flex-wrap items-center justify-between gap-2">
                      <p class="text-[10px] font-590 uppercase tracking-[0.14em] text-text-quaternary">
                        Focused relaunch command
                      </p>
                      <button
                        type="button"
                        data-copy-text={outcome.focused_command}
                        data-copy-label="Copy command"
                        data-copy-success-label="Copied"
                        class="rounded-md border border-border bg-panel px-2 py-1 text-[11px] font-510 text-text-secondary transition hover:border-border-hover hover:bg-surface-hover hover:text-text-primary"
                      >
                        Copy command
                      </button>
                    </div>
                    <p class="mt-1 text-[11px] leading-4 text-text-quaternary">
                      {ceo_outcome_repair_detail(outcome)}
                    </p>
                    <code class="mt-1.5 block overflow-x-auto font-mono text-[11px] leading-5 text-text-secondary">
                      {outcome.focused_command}
                    </code>
                  </div>
                </details>
              </div>
              <div class="flex min-w-0 flex-wrap items-center gap-1.5 lg:max-w-[260px] lg:justify-end">
                <span
                  :if={Map.get(outcome, :occurrences, 1) > 1}
                  class="rounded-full border border-amber-500/25 bg-amber-500/10 px-2 py-0.5 text-[10px] font-510 text-amber-200"
                >
                  {outcome.occurrences} {plural_noun(outcome.occurrences, "attempt")}
                </span>
                <span class="rounded-full border border-border bg-surface px-2 py-0.5 text-[10px] font-510 text-text-quaternary">
                  {outcome.action_label}
                </span>
                <span class="rounded-full border border-border bg-surface px-2 py-0.5 text-[10px] font-510 text-text-quaternary">
                  {format_relative(outcome.inserted_at)}
                </span>
              </div>
            </div>
          </div>
        </div>

        <p
          :if={@ceo_outcomes.scanned > @ceo_outcomes.shown}
          class="border-t border-border px-5 py-2 text-[11px] text-text-quaternary"
        >
          Showing first {@ceo_outcomes.shown} of {@ceo_outcomes.groups} grouped CEO outcomes from {@ceo_outcomes.scanned} recent actions.
          <span :if={@ceo_outcomes.collapsed > 0}>
            {@ceo_outcomes.collapsed} duplicate {plural_noun(@ceo_outcomes.collapsed, "row")} collapsed.
          </span>
        </p>
      </section>

      <section
        id="operations-doctor"
        class="ui-advanced-only rounded-lg border border-border bg-panel scroll-mt-6"
      >
        <div class="border-b border-border px-5 py-4">
          <div class="flex flex-wrap items-start justify-between gap-4">
            <div>
              <div class="flex flex-wrap items-center gap-2">
                <h2 class="text-sm font-590 text-text-primary">Operations Doctor</h2>
                <span class={"rounded-full border px-2 py-0.5 text-[11px] font-510 #{doctor_badge_class(@doctor.level)}"}>
                  {@doctor.label}
                </span>
                <details class="group relative inline-flex">
                  <summary
                    class="flex h-6 w-6 cursor-help list-none items-center justify-center rounded-full border border-border bg-surface text-[11px] font-590 text-text-tertiary hover:border-brand/40 hover:bg-brand/10 hover:text-brand [&::-webkit-details-marker]:hidden"
                    aria-label="How Operations Doctor works"
                  >
                    ?
                  </summary>
                  <div class="absolute right-0 top-full z-40 mt-2 w-80 max-w-[calc(100vw-2rem)] rounded-lg border border-border bg-panel p-3 text-left shadow-dialog sm:left-0 sm:right-auto">
                    <p class="text-xs font-590 text-text-primary">How this is diagnosed</p>
                    <p class="mt-1 text-xs leading-5 text-text-tertiary">
                      Doctor combines service gates, staffing gaps, adapter health, recent runtime
                      failures, review nudges, local concurrency, and BEAM host footprint into one
                      operator checklist.
                    </p>
                  </div>
                </details>
              </div>
              <p class="mt-1 max-w-2xl text-sm leading-6 text-text-tertiary">
                {@doctor.summary}
              </p>
              <hr class="ember-rule mt-3" />
            </div>

            <div class="stagger-children flex shrink-0 items-stretch gap-px overflow-hidden rounded-md border border-border bg-border">
              <div class="ember-stat min-w-[68px] bg-panel px-3 py-2 text-center">
                <p class={[
                  "font-serif text-[28px] font-510 leading-none tabular-nums",
                  if(@doctor.counts.critical > 0, do: "text-brand", else: "text-text-quaternary")
                ]}>
                  {@doctor.counts.critical}
                </p>
                <p class="mt-1.5 text-[10px] font-590 uppercase tracking-[0.14em] text-text-quaternary">
                  Fix
                </p>
              </div>
              <div class="min-w-[68px] bg-panel px-3 py-2 text-center">
                <p class={[
                  "font-mono text-[15px] font-590 leading-none tabular-nums",
                  if(@doctor.counts.warning > 0,
                    do: "text-amber-300",
                    else: "text-text-quaternary"
                  )
                ]}>
                  {@doctor.counts.warning}
                </p>
                <p class="mt-1.5 text-[10px] font-590 uppercase tracking-[0.14em] text-text-quaternary">
                  Watch
                </p>
              </div>
              <div class="min-w-[68px] bg-panel px-3 py-2 text-center">
                <p class="font-mono text-[15px] font-590 leading-none tabular-nums text-text-quaternary">
                  {@doctor.counts.ok}
                </p>
                <p class="mt-1.5 text-[10px] font-590 uppercase tracking-[0.14em] text-text-quaternary">
                  Clear
                </p>
              </div>
            </div>
          </div>

          <div
            :for={finding <- Enum.take(@doctor.findings, 1)}
            data-testid="operations-doctor-next-fix"
            class="ui-simple-only mt-4 rounded-md border border-border bg-surface/55 px-3 py-3"
          >
            <div class="flex flex-col gap-3 lg:flex-row lg:items-center lg:justify-between">
              <div class="min-w-0">
                <div class="flex flex-wrap items-center gap-2">
                  <span class={"rounded-full border px-2 py-0.5 text-[10px] font-590 uppercase #{doctor_badge_class(finding.severity)}"}>
                    Next fix
                  </span>
                  <p class="text-sm font-590 text-text-primary">{finding.title}</p>
                </div>
                <p class="mt-1 text-xs leading-5 text-text-tertiary">{finding.fix}</p>
              </div>
              <div class="flex shrink-0 flex-wrap items-center gap-2">
                <a
                  :if={Map.get(finding, :target_path) && anchor_path?(finding.target_path)}
                  href={finding.target_path}
                  class="inline-flex items-center gap-1.5 rounded-md border border-border bg-panel px-2.5 py-1.5 text-xs font-510 text-text-secondary transition hover:border-border-hover hover:bg-surface-hover hover:text-text-primary"
                >
                  <span class="hero-arrow-down-mini h-3.5 w-3.5"></span>
                  {finding.target_label}
                </a>
                <.app_link
                  :if={Map.get(finding, :target_path) && not anchor_path?(finding.target_path)}
                  navigate={finding.target_path}
                  class="inline-flex items-center gap-1.5 rounded-md border border-border bg-panel px-2.5 py-1.5 text-xs font-510 text-text-secondary transition hover:border-border-hover hover:bg-surface-hover hover:text-text-primary"
                >
                  <span class="hero-wrench-screwdriver-mini h-3.5 w-3.5"></span>
                  {finding.target_label}
                </.app_link>
              </div>
            </div>
          </div>
        </div>

        <div class="ui-advanced-only grid min-w-0 gap-px bg-border md:grid-cols-2">
          <div :for={finding <- @doctor.findings} class="bg-panel p-4">
            <div class={"h-full rounded-lg border px-3 py-3 #{doctor_card_class(finding.severity)}"}>
              <div class="flex items-start justify-between gap-3">
                <div class="min-w-0">
                  <div class="flex flex-wrap items-center gap-2">
                    <span class={"rounded-full border px-2 py-0.5 text-[11px] font-510 #{doctor_badge_class(finding.severity)}"}>
                      {finding.label}
                    </span>
                    <h3 class="text-sm font-590 text-text-primary">{finding.title}</h3>
                  </div>
                  <p class="mt-2 text-xs leading-5 text-text-tertiary">{finding.body}</p>
                </div>

                <details class="group relative shrink-0">
                  <summary
                    class="flex h-6 w-6 cursor-help list-none items-center justify-center rounded-full border border-border bg-surface text-[11px] font-590 text-text-tertiary hover:border-brand/40 hover:bg-brand/10 hover:text-brand [&::-webkit-details-marker]:hidden"
                    aria-label={"Why #{finding.title}?"}
                  >
                    ?
                  </summary>
                  <div class="absolute right-0 top-full z-40 mt-2 w-80 max-w-[calc(100vw-2rem)] rounded-lg border border-border bg-panel p-3 text-left shadow-dialog">
                    <p class="text-xs font-590 text-text-primary">Why this matters</p>
                    <p class="mt-1 text-xs leading-5 text-text-tertiary">{finding.why}</p>
                    <p class="mt-3 text-xs font-590 text-text-primary">Recommended fix</p>
                    <p class="mt-1 text-xs leading-5 text-text-tertiary">{finding.fix}</p>
                  </div>
                </details>
              </div>

              <div
                :if={Map.get(finding, :target_path) || Map.get(finding, :command)}
                class="mt-3 flex flex-wrap items-center gap-2"
              >
                <a
                  :if={Map.get(finding, :target_path) && anchor_path?(finding.target_path)}
                  href={finding.target_path}
                  class="inline-flex items-center gap-1.5 rounded-md border border-border bg-panel px-2.5 py-1.5 text-xs font-510 text-text-secondary transition hover:border-border-hover hover:bg-surface-hover hover:text-text-primary"
                >
                  <span class="hero-arrow-down-mini h-3.5 w-3.5"></span>
                  {finding.target_label}
                </a>
                <.app_link
                  :if={Map.get(finding, :target_path) && not anchor_path?(finding.target_path)}
                  navigate={finding.target_path}
                  class="inline-flex items-center gap-1.5 rounded-md border border-border bg-panel px-2.5 py-1.5 text-xs font-510 text-text-secondary transition hover:border-border-hover hover:bg-surface-hover hover:text-text-primary"
                >
                  <span class="hero-wrench-screwdriver-mini h-3.5 w-3.5"></span>
                  {finding.target_label}
                </.app_link>
                <a
                  :if={
                    Map.get(finding, :secondary_target_path) &&
                      anchor_path?(finding.secondary_target_path)
                  }
                  href={finding.secondary_target_path}
                  class="inline-flex items-center gap-1.5 rounded-md border border-border bg-panel px-2.5 py-1.5 text-xs font-510 text-text-tertiary transition hover:border-border-hover hover:bg-surface-hover hover:text-text-primary"
                >
                  <span class="hero-arrow-down-mini h-3.5 w-3.5"></span>
                  {finding.secondary_target_label}
                </a>
                <.app_link
                  :if={
                    Map.get(finding, :secondary_target_path) &&
                      not anchor_path?(finding.secondary_target_path)
                  }
                  navigate={finding.secondary_target_path}
                  class="inline-flex items-center gap-1.5 rounded-md border border-border bg-panel px-2.5 py-1.5 text-xs font-510 text-text-tertiary transition hover:border-border-hover hover:bg-surface-hover hover:text-text-primary"
                >
                  <span class="hero-wrench-screwdriver-mini h-3.5 w-3.5"></span>
                  {finding.secondary_target_label}
                </.app_link>
                <%!-- The broad launch command is printed once, in the Runtime
                     launch checklist; findings that just need it link there. --%>
                <a
                  :if={
                    Map.get(finding, :command) &&
                      finding.command == @runtime_enablement.command
                  }
                  href="#runtime-launch-checklist"
                  class="inline-flex items-center gap-1.5 rounded-md border border-border bg-panel px-2.5 py-1.5 text-xs font-510 text-text-tertiary transition hover:border-border-hover hover:bg-surface-hover hover:text-text-primary"
                >
                  <span class="hero-arrow-down-mini h-3.5 w-3.5"></span> Launch command
                </a>
                <code
                  :if={
                    Map.get(finding, :command) &&
                      finding.command != @runtime_enablement.command
                  }
                  class="max-w-full overflow-x-auto rounded-md border border-border bg-canvas px-2.5 py-1.5 font-mono text-[11px] text-text-secondary"
                >
                  {finding.command}
                </code>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section
        id="prompt-drift-radar"
        class="ui-advanced-only rounded-lg border border-border bg-panel scroll-mt-6"
      >
        <div class="border-b border-border px-5 py-4">
          <div class="flex flex-col gap-3 xl:flex-row xl:items-start xl:justify-between">
            <div>
              <div class="flex flex-wrap items-center gap-2">
                <h2 class="text-sm font-590 text-text-primary">Prompt Drift Radar</h2>
                <span class={"rounded-full border px-2 py-0.5 text-[11px] font-510 #{prompt_status_badge_class(if(@prompt_radar.counts.watchlist == 0, do: :ready, else: :needs_tuning))}"}>
                  {@prompt_radar.counts.watchlist} need review
                </span>
                <details class="group relative inline-flex">
                  <summary
                    class="flex h-6 w-6 cursor-help list-none items-center justify-center rounded-full border border-border bg-surface text-[11px] font-590 text-text-tertiary hover:border-brand/40 hover:bg-brand/10 hover:text-brand [&::-webkit-details-marker]:hidden"
                    aria-label="How Prompt Drift Radar works"
                  >
                    ?
                  </summary>
                  <div class="absolute right-0 top-full z-40 mt-2 w-80 max-w-[calc(100vw-2rem)] rounded-lg border border-border bg-panel p-3 text-left shadow-dialog sm:left-0 sm:right-auto">
                    <p class="text-xs font-590 text-text-primary">How this is diagnosed</p>
                    <p class="mt-1 text-xs leading-5 text-text-tertiary">
                      Radar analyzes every active agent's Instruction Studio score, prompt
                      eval fixture coverage, and latest saved revision delta. It catches weak
                      custom instructions, guardrail conflicts, and score regressions before
                      they create noisy tickets.
                    </p>
                  </div>
                </details>
              </div>
              <p class="mt-1 max-w-2xl text-xs leading-5 text-text-quaternary">
                {@prompt_radar.summary}
              </p>
              <hr class="ember-rule mt-3" />
              <div :if={@prompt_radar.watchlist != []} class="mt-3 flex flex-wrap gap-2">
                <button
                  type="button"
                  phx-click="preview_prompt_plan"
                  phx-value-scope="watchlist"
                  class="inline-flex items-center gap-1.5 rounded-md border border-brand/30 bg-brand/10 px-2.5 py-1.5 text-xs font-510 text-brand hover:bg-brand/15"
                >
                  <span class="hero-sparkles-mini h-3.5 w-3.5"></span> Preview all safe patches
                </button>
                <p class="text-xs leading-6 text-text-quaternary">
                  Additive only. Preview exact text before writing a rollback revision.
                </p>
              </div>
            </div>

            <div class="stagger-children flex shrink-0 flex-wrap items-stretch gap-px overflow-hidden rounded-md border border-border bg-border">
              <div class="min-w-[64px] bg-panel px-3 py-2 text-center">
                <p class="font-mono text-[16px] font-590 leading-none tabular-nums text-text-primary">
                  {@prompt_radar.counts.total}
                </p>
                <p class="mt-1.5 text-[10px] font-590 uppercase tracking-[0.14em] text-text-quaternary">
                  Agents
                </p>
              </div>
              <div class="min-w-[64px] bg-panel px-3 py-2 text-center">
                <p class="font-mono text-[16px] font-590 leading-none tabular-nums text-emerald-300">
                  {@prompt_radar.counts.ready}
                </p>
                <p class="mt-1.5 text-[10px] font-590 uppercase tracking-[0.14em] text-text-quaternary">
                  Ready
                </p>
              </div>
              <div class="min-w-[64px] bg-panel px-3 py-2 text-center">
                <p class="font-mono text-[16px] font-590 leading-none tabular-nums text-amber-300">
                  {@prompt_radar.counts.needs_tuning}
                </p>
                <p class="mt-1.5 text-[10px] font-590 uppercase tracking-[0.14em] text-text-quaternary">
                  Tuning
                </p>
              </div>
              <div class="min-w-[64px] bg-panel px-3 py-2 text-center">
                <p class="font-mono text-[16px] font-590 leading-none tabular-nums text-brand">
                  {@prompt_radar.counts.guardrail_risk}
                </p>
                <p class="mt-1.5 text-[10px] font-590 uppercase tracking-[0.14em] text-text-quaternary">
                  Risk
                </p>
              </div>
              <div class="min-w-[64px] bg-panel px-3 py-2 text-center">
                <p class="font-mono text-[16px] font-590 leading-none tabular-nums text-brand">
                  {@prompt_radar.counts.eval_gap}
                </p>
                <p class="mt-1.5 text-[10px] font-590 uppercase tracking-[0.14em] text-text-quaternary">
                  Eval
                </p>
              </div>
              <div class="min-w-[64px] bg-panel px-3 py-2 text-center">
                <p class="font-mono text-[16px] font-590 leading-none tabular-nums text-blue-300">
                  {@prompt_radar.counts.regressed}
                </p>
                <p class="mt-1.5 text-[10px] font-590 uppercase tracking-[0.14em] text-text-quaternary">
                  Drift
                </p>
              </div>
            </div>
          </div>
        </div>

        <div
          :if={@prompt_radar.counts.total == 0}
          class="px-5 py-10 text-center text-sm text-text-tertiary"
        >
          No agents configured yet.
        </div>

        <div
          :if={@prompt_tuning_receipt}
          data-testid="prompt-tuning-receipt"
          class="border-b border-border bg-surface/35 px-5 py-4"
        >
          <div class="flex flex-col gap-3 lg:flex-row lg:items-start lg:justify-between">
            <div>
              <div class="flex flex-wrap items-center gap-2">
                <p class="text-xs font-590 uppercase tracking-[0.08em] text-text-quaternary">
                  Prompt tuning receipt
                </p>
                <span class="rounded-full border border-teal-500/25 bg-teal-500/10 px-2 py-0.5 text-[11px] font-510 text-teal-300">
                  {@prompt_tuning_receipt.patch_count} {plural_noun(
                    @prompt_tuning_receipt.patch_count,
                    "patch",
                    "patches"
                  )}
                </span>
              </div>
              <p class="mt-1 text-xs leading-5 text-text-tertiary">
                Recorded a rollback revision for {@prompt_tuning_receipt.agent_count} {plural_noun(
                  @prompt_tuning_receipt.agent_count,
                  "agent"
                )}. Use this receipt to compare the next run against the intended behavior.
              </p>
            </div>
            <button
              type="button"
              phx-click="close_prompt_receipt"
              class="shrink-0 rounded-md border border-border bg-panel px-2.5 py-1.5 text-xs font-510 text-text-secondary hover:bg-surface-hover hover:text-text-primary"
            >
              Dismiss
            </button>
          </div>

          <div class="mt-3 grid gap-2 lg:grid-cols-2">
            <div
              :for={agent <- @prompt_tuning_receipt.agents}
              class="rounded-lg border border-teal-500/20 bg-teal-500/[0.05] px-3 py-3"
            >
              <div class="flex flex-wrap items-start justify-between gap-3">
                <div class="min-w-0">
                  <p class="truncate text-sm font-590 text-text-primary">{agent.agent_name}</p>
                  <p class="mt-0.5 text-[11px] text-text-quaternary">
                    v{agent.revision} rollback point recorded
                  </p>
                </div>
                <p class="font-mono text-sm tabular-nums text-teal-200">
                  {agent.from_score}/100 -> {agent.to_score}/100
                </p>
              </div>
              <p class="mt-2 text-xs leading-5 text-text-tertiary">
                {agent.expected_effect}
              </p>
              <div
                :if={agent.validation_checks != []}
                class="mt-2 rounded-md border border-teal-500/15 bg-canvas/70 px-2.5 py-2"
              >
                <p class="text-[10px] font-590 uppercase tracking-[0.12em] text-teal-300">
                  Next-run validation
                </p>
                <ul class="mt-1.5 space-y-1 text-[11px] leading-4 text-text-tertiary">
                  <li :for={check <- agent.validation_checks} class="flex gap-1.5">
                    <span class="mt-1 h-1 w-1 shrink-0 rounded-full bg-teal-300"></span>
                    <span>{check}</span>
                  </li>
                </ul>
              </div>
              <p class="mt-2 text-[11px] leading-4 text-text-quaternary">
                Patches: {Enum.join(agent.patch_titles, ", ")}
              </p>
              <p class="mt-1 text-[11px] leading-4 text-text-quaternary">
                Rollback: {agent.rollback}
              </p>
            </div>
          </div>
        </div>

        <div
          :if={@prompt_radar.counts.total > 0 and @prompt_radar.watchlist == []}
          class="px-5 py-6"
        >
          <div class="rounded-lg border border-emerald-500/20 bg-emerald-500/[0.06] px-4 py-4">
            <p class="text-sm font-590 text-emerald-200">
              All agent prompts are inside guardrails.
            </p>
            <p class="mt-1 text-xs leading-5 text-text-tertiary">
              Keep using the Instruction Studio after major role, adapter, or PR-contract changes.
            </p>
          </div>
        </div>

        <div
          :if={@prompt_radar.watchlist != []}
          class="grid min-w-0 gap-px bg-border xl:grid-cols-2"
        >
          <div :for={agent <- @prompt_radar.watchlist} class="bg-panel p-4">
            <div class={"h-full rounded-lg border px-3 py-3 #{prompt_card_class(agent.status)}"}>
              <div class="flex items-start justify-between gap-3">
                <div class="min-w-0">
                  <div class="flex flex-wrap items-center gap-2">
                    <span class={"rounded-full border px-2 py-0.5 text-[11px] font-510 #{prompt_status_badge_class(agent.status)}"}>
                      {agent.status_label}
                    </span>
                    <span class="font-mono text-xs tabular-nums text-text-quaternary">
                      {agent.score}/100
                    </span>
                  </div>
                  <p class="mt-2 truncate text-sm font-590 text-text-primary">{agent.name}</p>
                  <p class="mt-0.5 text-xs text-text-quaternary">
                    {role_label(agent.role)} · {adapter_label(agent.adapter)}
                  </p>
                </div>
                <div class="text-right">
                  <p class="text-xs font-590 text-text-primary">
                    Eval {agent.eval_passed}/{agent.eval_total}
                  </p>
                  <p :if={agent.latest_revision} class="mt-0.5 text-[11px] text-text-quaternary">
                    latest v{agent.latest_revision.version}
                  </p>
                </div>
              </div>

              <p class="mt-3 text-xs leading-5 text-text-tertiary">{agent.summary}</p>

              <div
                :if={agent.tuning.patch_count > 0}
                class="mt-3 rounded-md border border-border bg-canvas/60 px-2.5 py-2"
              >
                <div class="flex flex-wrap items-center justify-between gap-2">
                  <p class="text-[11px] font-590 uppercase tracking-[0.08em] text-text-quaternary">
                    Guided fixes
                  </p>
                  <p class="font-mono text-[11px] tabular-nums text-text-tertiary">
                    {agent.score}/100 → {agent.tuning.projected_score}/100
                  </p>
                </div>
                <div class="mt-2 flex flex-wrap gap-1.5">
                  <span
                    :for={patch <- agent.tuning.patches}
                    class={"rounded px-1.5 py-0.5 text-[11px] #{prompt_patch_class(patch.tone)}"}
                    title={patch.reason}
                  >
                    {patch.title}
                  </span>
                </div>
              </div>

              <div
                :if={agent.regressed}
                class="mt-3 rounded-md border border-blue-500/20 bg-blue-500/[0.07] px-2.5 py-2 text-xs text-blue-100"
              >
                Score regression: {agent.regression.from_score}/100 → {agent.regression.to_score}/100
                across saved revisions v{agent.regression.from_version} to v{agent.regression.to_version}.
              </div>

              <div :if={agent.top_gaps != []} class="mt-3 flex flex-wrap gap-1.5">
                <span
                  :for={gap <- agent.top_gaps}
                  class={"rounded px-1.5 py-0.5 text-[11px] #{prompt_gap_class(gap.status)}"}
                >
                  {gap.label}
                </span>
              </div>

              <div class="mt-3 flex flex-wrap gap-2">
                <.app_link
                  navigate={~p"/agents/#{agent.id}?tab=instructions"}
                  class="rounded-md border border-border bg-panel px-2.5 py-1.5 text-xs font-510 text-text-secondary hover:bg-surface-hover hover:text-text-primary"
                >
                  Open Studio
                </.app_link>
                <button
                  :if={agent.tuning.changed and agent.tuning.projected_score > agent.score}
                  type="button"
                  phx-click="preview_prompt_plan"
                  phx-value-agent-id={agent.id}
                  class="rounded-md border border-brand/30 bg-brand/10 px-2.5 py-1.5 text-xs font-510 text-brand hover:bg-brand/15"
                >
                  Preview patches
                </button>
                <.app_link
                  :if={agent.last_good_revision}
                  navigate={~p"/agents/#{agent.id}?tab=instructions"}
                  class="rounded-md border border-border bg-panel px-2.5 py-1.5 text-xs font-510 text-text-secondary hover:bg-surface-hover hover:text-text-primary"
                >
                  Review last good v{agent.last_good_revision.version}
                </.app_link>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section
        id="prompt-contract-health"
        class="ui-advanced-only rounded-lg border border-border bg-panel scroll-mt-6"
      >
        <div class="border-b border-border px-5 py-4">
          <div class="flex flex-col gap-3 lg:flex-row lg:items-start lg:justify-between">
            <div>
              <div class="flex flex-wrap items-center gap-2">
                <h2 class="text-sm font-590 text-text-primary">Prompt Contract Health</h2>
                <span class="rounded-full border border-border bg-surface px-2 py-0.5 text-[11px] font-510 text-text-tertiary">
                  {@contract_failures.counts.entries} gaps
                </span>
              </div>
              <p class="mt-1 text-xs leading-5 text-text-quaternary">
                Contract and memory failures by agent, based on delivery, review, owner-update,
                and issue-memory fields shown on issue pages.
              </p>
              <hr class="ember-rule mt-3" />
            </div>

            <div class="stagger-children flex shrink-0 items-stretch gap-px overflow-hidden rounded-md border border-border bg-border">
              <div class="min-w-[64px] bg-panel px-3 py-2 text-center">
                <p class="font-mono text-[16px] font-590 leading-none tabular-nums text-text-primary">
                  {@contract_failures.counts.issues}
                </p>
                <p class="mt-1.5 text-[10px] font-590 uppercase tracking-[0.14em] text-text-quaternary">
                  Issues
                </p>
              </div>
              <div class="min-w-[64px] bg-panel px-3 py-2 text-center">
                <p class="font-mono text-[16px] font-590 leading-none tabular-nums text-text-primary">
                  {@contract_failures.counts.agents}
                </p>
                <p class="mt-1.5 text-[10px] font-590 uppercase tracking-[0.14em] text-text-quaternary">
                  Agents
                </p>
              </div>
              <div class="min-w-[64px] bg-panel px-3 py-2 text-center">
                <p class="font-mono text-[16px] font-590 leading-none tabular-nums text-brand">
                  {@contract_failures.counts.missing}
                </p>
                <p class="mt-1.5 text-[10px] font-590 uppercase tracking-[0.14em] text-text-quaternary">
                  Missing
                </p>
              </div>
              <div class="min-w-[64px] bg-panel px-3 py-2 text-center">
                <p class="font-mono text-[16px] font-590 leading-none tabular-nums text-amber-300">
                  {@contract_failures.counts.attention}
                </p>
                <p class="mt-1.5 text-[10px] font-590 uppercase tracking-[0.14em] text-text-quaternary">
                  Weak
                </p>
              </div>
            </div>
          </div>
        </div>

        <div
          :if={@contract_failures.counts.entries == 0}
          class="px-5 py-10 text-center text-sm text-text-tertiary"
        >
          No prompt contract gaps found in open work.
        </div>

        <div
          :if={@contract_failures.counts.entries > 0}
          class="border-b border-border bg-panel px-5 py-4"
        >
          <div class="flex flex-col gap-1 sm:flex-row sm:items-end sm:justify-between">
            <div>
              <p class="text-xs font-590 uppercase tracking-[0.08em] text-text-quaternary">
                Repair queue
              </p>
              <p class="mt-1 text-xs leading-5 text-text-tertiary">
                Start here. These are the highest-priority contract gaps blocking owner-ready
                issue memory.
              </p>
            </div>
            <span class="text-xs text-text-quaternary">
              Top repairs: {min(length(@contract_failures.entries), 3)} of {@contract_failures.counts.entries}
            </span>
          </div>

          <div class="mt-3 grid gap-2 lg:grid-cols-3">
            <div
              :for={
                {entry, index} <- Enum.with_index(Enum.take(@contract_failures.entries, 3), 1)
              }
              class={"rounded-lg border px-3 py-3 #{contract_queue_card_class(entry.status)}"}
            >
              <div class="flex items-start justify-between gap-3">
                <div class="min-w-0">
                  <div class="flex flex-wrap items-center gap-2">
                    <span class="font-mono text-[11px] text-text-quaternary">
                      {String.pad_leading(Integer.to_string(index), 2, "0")}
                    </span>
                    <span class={"rounded-full border px-2 py-0.5 text-[10px] font-510 #{contract_badge_class(entry.status)}"}>
                      {entry.status_label}
                    </span>
                  </div>
                  <p class="mt-2 line-clamp-2 text-sm font-510 text-text-primary">
                    {entry.issue_identifier} · {entry.issue_title}
                  </p>
                  <p class="mt-1 truncate text-[11px] text-text-quaternary">
                    {entry.contract_label} · {entry.agent_name}
                  </p>
                </div>
              </div>

              <p class="mt-2 line-clamp-3 text-xs leading-5 text-text-tertiary">
                {entry.recommendation}
              </p>

              <div class="mt-3 flex flex-wrap items-center gap-2">
                <button
                  type="button"
                  phx-click="queue_contract_nudge"
                  phx-value-issue-id={entry.issue_id}
                  phx-value-contract={entry.contract_key}
                  disabled={!entry.nudge_enabled? || entry.nudge_queued?}
                  class={[
                    "rounded-md border px-2 py-1 text-[11px] font-510",
                    entry.nudge_enabled? && !entry.nudge_queued? &&
                      "border-amber-500/25 bg-amber-500/10 text-amber-200 hover:bg-amber-500/15",
                    (!entry.nudge_enabled? || entry.nudge_queued?) &&
                      "cursor-not-allowed border-border bg-panel text-text-quaternary"
                  ]}
                >
                  {if entry.nudge_queued?, do: "Queued", else: "Queue nudge"}
                </button>
                <.app_link
                  navigate={~p"/issues/#{entry.issue_id}"}
                  class="rounded-md border border-border bg-panel px-2 py-1 text-[11px] font-510 text-text-secondary hover:bg-surface-hover hover:text-text-primary"
                >
                  Open issue
                </.app_link>
              </div>
            </div>
          </div>
        </div>

        <div
          :if={@contract_failures.counts.entries > 0}
          class="grid min-w-0 gap-px bg-border lg:grid-cols-2"
        >
          <div class="min-w-0 bg-panel p-5">
            <div class="flex items-center justify-between gap-3">
              <h3 class="text-xs font-590 uppercase tracking-[0.08em] text-text-quaternary">
                By agent
              </h3>
              <span class="text-xs text-text-quaternary">
                {@contract_failures.summary}
              </span>
            </div>
            <div class="mt-3 max-h-[520px] divide-y divide-border overflow-y-auto rounded-md border border-border">
              <div
                :for={group <- @contract_failures.by_agent}
                class="bg-surface/40 px-3 py-2.5"
              >
                <div class="flex items-baseline justify-between gap-3">
                  <div class="min-w-0">
                    <p class="truncate text-sm font-510 text-text-primary">
                      {group.agent_name}
                    </p>
                    <p class="mt-0.5 text-[11px] text-text-quaternary">
                      {role_label(group.agent_role)}
                    </p>
                  </div>
                  <div class="shrink-0 text-right">
                    <span class="font-mono text-[15px] font-590 tabular-nums text-text-primary">
                      {group.count}
                    </span>
                    <span class="ml-1 text-[10px] uppercase tracking-[0.12em] text-text-quaternary">
                      gaps
                    </span>
                  </div>
                </div>

                <div class="mt-2 flex flex-wrap items-center gap-1.5">
                  <span
                    :if={group.missing > 0}
                    class="rounded bg-brand/10 px-1.5 py-0.5 font-mono text-[10px] tabular-nums text-brand"
                  >
                    {group.missing} missing
                  </span>
                  <span
                    :if={group.attention > 0}
                    class="rounded bg-amber-500/10 px-1.5 py-0.5 font-mono text-[10px] tabular-nums text-amber-200"
                  >
                    {group.attention} weak
                  </span>
                  <span
                    :for={field <- group.fields}
                    class="rounded bg-canvas px-1.5 py-0.5 text-[10px] text-text-tertiary"
                  >
                    {field}
                  </span>
                </div>

                <div class="mt-2 flex flex-wrap items-center gap-3 text-[11px]">
                  <.app_link
                    :if={group.agent_id}
                    navigate={~p"/agents/#{group.agent_id}?tab=configuration"}
                    class="font-510 text-text-tertiary hover:text-text-primary"
                  >
                    Open agent →
                  </.app_link>
                  <.app_link
                    :if={group.latest_issue}
                    navigate={~p"/issues/#{group.latest_issue.issue_id}"}
                    class="font-510 text-text-tertiary hover:text-text-primary"
                  >
                    Open latest issue →
                  </.app_link>
                </div>
              </div>
            </div>
          </div>

          <div class="min-w-0 bg-panel p-5">
            <div class="flex items-center justify-between gap-3">
              <h3 class="text-xs font-590 uppercase tracking-[0.08em] text-text-quaternary">
                Active gaps
              </h3>
              <span class="text-xs text-text-quaternary">Newest open work first</span>
            </div>
            <div class="mt-3 max-h-[520px] divide-y divide-border overflow-y-auto rounded-md border border-border">
              <div :for={entry <- @contract_failures.entries} class="bg-surface/40 px-3 py-2.5">
                <div class="flex flex-wrap items-start justify-between gap-2">
                  <div class="min-w-0 flex-1">
                    <div class="flex flex-wrap items-center gap-2">
                      <span class={"rounded-full border px-2 py-0.5 text-[10px] font-510 #{contract_badge_class(entry.status)}"}>
                        {entry.status_label}
                      </span>
                      <span class="text-[11px] font-510 text-text-tertiary">
                        {entry.contract_label}
                      </span>
                    </div>
                    <p class="mt-1.5 truncate text-sm font-510 text-text-primary">
                      {entry.issue_identifier} · {entry.issue_title}
                    </p>
                    <p class="mt-0.5 truncate text-[11px] text-text-quaternary">
                      Owner: {entry.agent_name}<span :if={entry.project_name}>{" · #{entry.project_name}"}</span>
                    </p>
                  </div>
                </div>

                <p class="mt-2 text-xs leading-5 text-text-tertiary">{entry.summary}</p>
                <div :if={entry.missing_fields != []} class="mt-2 flex flex-wrap gap-1.5">
                  <span
                    :for={field <- entry.missing_fields}
                    class="rounded bg-brand/10 px-1.5 py-0.5 font-mono text-[10px] tabular-nums text-brand"
                  >
                    {field}
                  </span>
                </div>
                <p class="mt-2 border-l-2 border-border pl-2 text-[11px] leading-4 text-text-quaternary">
                  {entry.recommendation}
                </p>

                <div class="mt-2.5 flex flex-wrap items-center gap-2">
                  <button
                    type="button"
                    phx-click="queue_contract_nudge"
                    phx-value-issue-id={entry.issue_id}
                    phx-value-contract={entry.contract_key}
                    disabled={!entry.nudge_enabled? || entry.nudge_queued?}
                    class={[
                      "rounded-md border px-2 py-1 text-[11px] font-510",
                      entry.nudge_enabled? && !entry.nudge_queued? &&
                        "border-amber-500/25 bg-amber-500/10 text-amber-200 hover:bg-amber-500/15",
                      (!entry.nudge_enabled? || entry.nudge_queued?) &&
                        "cursor-not-allowed border-border bg-panel text-text-quaternary"
                    ]}
                  >
                    {entry.nudge_button_label}
                  </button>
                  <.app_link
                    navigate={~p"/issues/#{entry.issue_id}"}
                    class="rounded-md border border-border bg-panel px-2 py-1 text-[11px] font-510 text-text-secondary hover:bg-surface-hover hover:text-text-primary"
                  >
                    Open issue
                  </.app_link>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section
        id="runtime-services"
        class="ui-advanced-only scroll-mt-6 rounded-lg border border-border bg-panel"
      >
        <div class="border-b border-border px-5 py-4">
          <h2 class="text-sm font-590 text-text-primary">Runtime Services</h2>
          <%!-- Said once here instead of once per card: every card used to repeat
               "Set CYMPHO_X=1 and restart the server." under an "Operator action"
               eyebrow. --%>
          <p class="mt-1 text-xs leading-5 text-text-quaternary">
            These switches decide whether Cympho only reviews work or actively runs the company.
            To turn one on, set its variable to 1 and restart the server.
          </p>
          <hr class="ember-rule mt-3" />
        </div>
        <div
          :for={group <- service_groups(@services)}
          class="border-b border-border last:border-b-0"
        >
          <div class="flex flex-wrap items-baseline gap-x-2 gap-y-1 px-5 pt-4">
            <h3 class="text-xs font-590 text-text-secondary">{group.label}</h3>
            <p class="text-[11px] leading-4 text-text-quaternary">{group.hint}</p>
          </div>
          <div class="grid divide-y divide-border lg:grid-cols-2 lg:divide-x lg:divide-y-0">
            <div :for={service <- group.services} class="p-4">
              <div class="flex items-start justify-between gap-3">
                <div class="min-w-0">
                  <h4 class="text-sm font-590 text-text-primary">{service.name}</h4>
                  <p class="mt-1 text-xs leading-5 text-text-tertiary">{service.description}</p>
                </div>
                <span
                  :if={service.status != :disabled}
                  class={"shrink-0 rounded-full border px-2 py-0.5 text-[11px] font-510 #{status_badge_class(service.status)}"}
                >
                  {service.label}
                </span>
              </div>
              <code class="mt-3 block overflow-x-auto rounded-md border border-border bg-canvas px-2.5 py-1.5 font-mono text-[11px] text-text-secondary">
                {service.env_var}=1
              </code>
              <p
                :if={service.status not in [:disabled, :running]}
                class="mt-1.5 text-[11px] leading-4 text-text-quaternary"
              >
                {service.fix}
              </p>
            </div>
          </div>
        </div>
      </section>

      <section
        id="runtime-capacity"
        class="ui-advanced-only scroll-mt-6 rounded-lg border border-border bg-panel p-5"
      >
        <div class="flex flex-wrap items-start justify-between gap-3">
          <div>
            <p class="font-serif text-[13px] font-510 italic tracking-[0.02em] text-brand/90">
              Runtime capacity
            </p>
            <h2 class="mt-1.5 text-base font-590 text-text-primary">{@capacity.summary}</h2>
            <p class="mt-1 text-sm leading-5 text-text-tertiary">{@capacity.hint}</p>
            <hr class="ember-rule mt-3" />
          </div>
          <div class="flex flex-wrap items-center gap-2">
            <button
              :if={Map.get(@capacity, :cleanup_available?)}
              type="button"
              phx-click="recover_stale_runs"
              data-confirm="Mark stale/orphaned running runs as failed, cancel old pending runs, and clear stale checkout locks for this company? This does not start any agents or change issue assignees."
              class="rounded-md border border-amber-500/30 bg-amber-500/10 px-2.5 py-1.5 text-xs font-510 text-amber-100 transition-colors hover:bg-amber-500/15"
            >
              Recover stale runtime state
            </button>
            <span class={"rounded-full border px-2.5 py-1 text-xs font-510 #{capacity_badge_class(@capacity.level)}"}>
              {@capacity.label}
            </span>
          </div>
        </div>
        <div class="stagger-children mt-4 grid divide-y divide-border overflow-hidden rounded-md border border-border sm:grid-cols-4 sm:divide-x sm:divide-y-0">
          <.quiet_stat label="Agents" value={@capacity.total_agents} class="px-4 py-3" />
          <.quiet_stat label="Total slots" value={@capacity.total_slots} class="px-4 py-3" />
          <.quiet_stat label="Local CLI slots" value={@capacity.local_slots} class="px-4 py-3" />
          <div class="ember-stat px-4 py-3">
            <p class="text-[10px] font-590 uppercase tracking-[0.14em] text-text-quaternary">
              Held slots
            </p>
            <p class={[
              "mt-1.5 font-serif text-[28px] font-510 leading-none tabular-nums",
              if(@capacity.running_runs > 0,
                do: "text-text-primary",
                else: "text-text-quaternary"
              )
            ]}>
              {@capacity.running_runs}
            </p>
            <p class="mt-2 font-mono text-[11px] tabular-nums text-text-quaternary">
              {@capacity.active_runs} runs · {@capacity.checked_out_issues} checkouts
            </p>
          </div>
        </div>
        <div
          :if={Map.get(@capacity, :repo_delivery)}
          data-testid="repo-delivery-capacity"
          class={[
            "mt-4 rounded-md border px-3 py-3",
            repo_delivery_card_class(@capacity.repo_delivery.status)
          ]}
        >
          <div class="flex flex-col gap-3 lg:flex-row lg:items-start lg:justify-between">
            <div class="min-w-0">
              <div class="flex flex-wrap items-center gap-2">
                <p class="text-[11px] font-590 uppercase tracking-[0.14em] text-text-quaternary">
                  Repo delivery lane
                </p>
                <span class={[
                  "rounded-full border px-2 py-0.5 text-[11px] font-510",
                  repo_delivery_badge_class(@capacity.repo_delivery.status)
                ]}>
                  {@capacity.repo_delivery.label}
                </span>
              </div>
              <p class="mt-1 text-sm leading-5 text-text-primary">
                {@capacity.repo_delivery.summary}
              </p>
              <p class="mt-1 text-xs leading-5 text-text-tertiary">
                {@capacity.repo_delivery.hint}
              </p>
              <div class="mt-2 flex flex-wrap gap-1.5 text-[10px] font-510">
                <span class="rounded-full border border-emerald-500/20 bg-emerald-500/10 px-2 py-0.5 text-emerald-300">
                  {@capacity.repo_delivery.repo_capable_slots} repo-capable slots
                </span>
                <span class="rounded-full border border-border bg-surface px-2 py-0.5 text-text-quaternary">
                  {@capacity.repo_delivery.text_only_slots} text-only slots
                </span>
              </div>
            </div>
            <div class="flex shrink-0 flex-wrap gap-2">
              <.app_link
                :if={@capacity.repo_delivery.target_path}
                navigate={@capacity.repo_delivery.target_path}
                class={"inline-flex items-center justify-center rounded-md border px-2.5 py-1.5 text-xs font-510 transition #{repo_delivery_action_class(@capacity.repo_delivery.status)}"}
              >
                {@capacity.repo_delivery.target_label}
              </.app_link>
              <.app_link
                :if={@capacity.repo_delivery.hire_target_path}
                navigate={@capacity.repo_delivery.hire_target_path}
                class="inline-flex items-center justify-center rounded-md border border-emerald-500/25 bg-emerald-500/10 px-2.5 py-1.5 text-xs font-510 text-emerald-200 transition hover:bg-emerald-500/15"
              >
                {@capacity.repo_delivery.hire_target_label}
              </.app_link>
            </div>
          </div>
        </div>
        <div
          :if={@org_health.role_demand_gaps != []}
          id="runtime-staffing-gaps"
          data-testid="runtime-staffing-gaps"
          class="mt-4 rounded-md border border-amber-500/25 border-l-2 border-l-amber-500/80 bg-amber-500/[0.08] px-3 py-3"
        >
          <div class="flex flex-col gap-3 lg:flex-row lg:items-start lg:justify-between">
            <div class="min-w-0">
              <div class="flex flex-wrap items-center gap-2">
                <p class="text-[11px] font-590 uppercase tracking-[0.14em] text-amber-100">
                  Staffing gaps
                </p>
                <span class="rounded-full border border-amber-500/30 bg-amber-500/10 px-2 py-0.5 text-[11px] font-510 text-amber-100">
                  {@org_health.metrics.unstaffed_role_issues} open {plural_noun(
                    @org_health.metrics.unstaffed_role_issues,
                    "issue"
                  )}
                </span>
              </div>
              <p class="mt-1 text-sm leading-5 text-amber-100/85">
                Delegated work includes roles with no active agent. Hire or reassign coverage before broad dispatch, otherwise the CEO/CTO split will stall after decomposition.
              </p>
            </div>
            <.app_link
              navigate={
                ~p"/agents/new?#{new_agent_query_for_gap(List.first(@org_health.role_demand_gaps))}"
              }
              class="inline-flex shrink-0 items-center justify-center rounded-md border border-amber-500/30 bg-panel px-2.5 py-1.5 text-xs font-510 text-amber-100 transition-colors hover:bg-amber-500/15"
            >
              {first_staffing_gap_label(@org_health)}
            </.app_link>
          </div>

          <div class="mt-3 divide-y divide-amber-500/15 overflow-hidden rounded-md border border-amber-500/20 bg-canvas/50">
            <div
              :for={gap <- @org_health.role_demand_gaps}
              class="flex flex-col gap-3 px-3 py-3 md:flex-row md:items-center md:justify-between"
            >
              <div class="min-w-0">
                <div class="flex flex-wrap items-center gap-2">
                  <p class="text-sm font-590 text-text-primary">{gap.label}</p>
                  <span class="rounded-full border border-amber-500/25 bg-amber-500/10 px-2 py-0.5 text-[10px] font-510 text-amber-200">
                    {gap.open_issues} open {plural_noun(gap.open_issues, "issue")}
                  </span>
                  <span
                    :if={gap.suggested_parent}
                    class="rounded-full border border-border bg-panel px-2 py-0.5 text-[10px] font-510 text-text-tertiary"
                  >
                    Reports to {gap.suggested_parent.name}
                  </span>
                </div>

                <div :if={gap.examples != []} class="mt-2 flex max-w-3xl flex-wrap gap-1.5">
                  <.app_link
                    :for={example <- gap.examples}
                    navigate={~p"/issues/#{example.id}"}
                    class="max-w-full truncate rounded-md border border-border bg-panel px-2 py-1 text-[11px] text-text-tertiary transition hover:border-brand/40 hover:text-brand"
                    title={issue_example_label(example)}
                  >
                    {issue_example_label(example)}
                  </.app_link>
                </div>
              </div>

              <.app_link
                navigate={~p"/agents/new?#{new_agent_query_for_gap(gap)}"}
                class="inline-flex shrink-0 items-center justify-center rounded-md border border-brand/30 bg-brand/10 px-3 py-1.5 text-xs font-590 text-brand transition hover:border-brand/50 hover:bg-brand/15"
              >
                Hire {gap.label}
              </.app_link>
            </div>
          </div>
        </div>
        <div
          :if={@capacity.stale_checked_out_issues > 0}
          class="mt-4 rounded-md border border-amber-500/25 border-l-2 border-l-amber-500/80 bg-amber-500/10 px-3 py-2.5"
        >
          <div class="flex flex-wrap items-start justify-between gap-2">
            <div>
              <p class="text-[11px] font-590 uppercase tracking-[0.14em] text-amber-100">
                Stale checked-out work
              </p>
              <p class="mt-1 text-sm leading-5 text-amber-100/85">
                {@capacity.stale_checked_out_issues} issue{if @capacity.stale_checked_out_issues ==
                                                                1, do: "", else: "s"} still count against agent capacity after the recovery threshold.
              </p>
            </div>
            <span class="rounded-full border border-amber-500/30 bg-amber-500/10 px-2 py-0.5 text-[11px] font-510 text-amber-100">
              Recovery available
            </span>
          </div>
          <div class="mt-3 grid gap-2 md:grid-cols-2">
            <.app_link
              :for={issue <- Enum.take(@capacity.stale_checkouts, 4)}
              navigate={~p"/issues/#{issue.id}"}
              class="rounded-md border border-amber-500/20 bg-canvas/60 px-3 py-2 text-xs text-amber-50 transition-colors hover:bg-amber-500/10"
            >
              <span class="block font-590">{issue.identifier} · {issue.title}</span>
              <span class="mt-1 block text-[11px] text-amber-100/70">
                {issue.assignee_name} · checked out {format_relative(issue.checked_out_at)}
              </span>
            </.app_link>
          </div>
        </div>
      </section>

      <section
        id="host-footprint"
        class="ui-advanced-only scroll-mt-6 rounded-lg border border-border bg-panel p-5"
      >
        <div class="flex flex-wrap items-start justify-between gap-3">
          <div>
            <p class="font-serif text-[13px] font-510 italic tracking-[0.02em] text-brand/90">
              Host footprint
            </p>
            <h2 class="mt-1.5 text-base font-590 text-text-primary">{@host.summary}</h2>
            <p class="mt-1 text-sm leading-5 text-text-tertiary">{@host.hint}</p>
            <hr class="ember-rule mt-3" />
          </div>
          <span class={"rounded-full border px-2.5 py-1 text-xs font-510 #{capacity_badge_class(@host.level)}"}>
            {@host.label}
          </span>
        </div>
        <div class="stagger-children mt-4 grid divide-y divide-border overflow-hidden rounded-md border border-border sm:grid-cols-4 sm:divide-x sm:divide-y-0">
          <.quiet_stat
            label="BEAM memory"
            value={format_memory(@host.memory_bytes)}
            detail={"#{format_memory(@host.process_memory_bytes)} process heap"}
            class="px-4 py-3"
          />
          <.quiet_stat
            label="BEAM processes"
            value={@host.process_count}
            detail={"#{@host.process_usage_percent}% of limit"}
            class="px-4 py-3"
          />
          <.quiet_stat
            label="Schedulers"
            value={@host.schedulers_online}
            detail="Online CPU schedulers"
            class="px-4 py-3"
          />
          <.quiet_stat
            label="Run queue"
            value={@host.run_queue}
            detail="Runnable BEAM work"
            class="px-4 py-3"
          />
        </div>
        <div class="mt-4 rounded-md border border-border border-l-2 border-l-amber-500/70 bg-surface px-3 py-2.5">
          <p class="text-[11px] font-590 uppercase tracking-[0.14em] text-text-tertiary">
            External CLI memory
          </p>
          <p class="mt-1 text-sm leading-5 text-text-tertiary">{@host.cli_note}</p>
        </div>
      </section>

      <% shared_slots = shared_slot_label(@pressure_agents) %>
      <section class="ui-advanced-only rounded-lg border border-border bg-panel">
        <div class="border-b border-border px-5 py-4">
          <h2 class="text-sm font-590 text-text-primary">Highest Pressure Agents</h2>
          <p class="mt-1 text-xs text-text-quaternary">
            Local CLI adapters consume real OS memory; BEAM processes stay lightweight.<span :if={
              shared_slots
            }> Every agent has {shared_slots}.</span>
          </p>
          <hr class="ember-rule mt-3" />
        </div>
        <div
          :if={@pressure_agents == []}
          class="px-5 py-8 text-center text-sm text-text-tertiary"
        >
          No agents configured yet.
        </div>
        <div :if={@pressure_agents != []} class="divide-y divide-border">
          <.app_link
            :for={item <- @pressure_agents}
            navigate={~p"/agents/#{item.id}?tab=configuration"}
            class="block px-5 py-3 hover:bg-surface-hover/60"
          >
            <div class="flex flex-wrap items-center justify-between gap-3">
              <div class="min-w-0">
                <p class="truncate text-sm font-590 text-text-primary">{item.name}</p>
                <p class="mt-0.5 text-xs text-text-quaternary">{role_label(item.role)}</p>
              </div>
              <div class="flex items-center gap-2">
                <%!-- Safe is the resting state of every row; only flag the rest. --%>
                <span
                  :if={item.pressure.level != :safe}
                  class={"rounded-full border px-2 py-0.5 text-[11px] font-510 #{capacity_badge_class(item.pressure.level)}"}
                >
                  {item.pressure.label}
                </span>
                <span :if={is_nil(shared_slots)} class="font-mono text-xs text-text-quaternary">
                  {item.pressure.slot_label}
                </span>
              </div>
            </div>
          </.app_link>
        </div>
      </section>
    </div>

    <%!-- In simple mode the rail's only visible card is "What went wrong"; without
         this it sits alone in the 360px column with the main column empty. --%>
    <aside id="operations-side-rail" data-ui-simple-full-span class="space-y-4">
      <section class="ui-advanced-only rounded-lg border border-border bg-panel">
        <div class="flex items-center justify-between border-b border-border px-4 py-3">
          <h2 class="text-sm font-590 text-text-primary">Next Actions</h2>
          <span class="font-mono text-[10px] tabular-nums text-text-quaternary">
            {length(@next_actions)}
          </span>
        </div>
        <div class="space-y-2 p-3">
          <div
            :for={action <- @next_actions}
            class={[
              "rounded-md border border-l-2 px-3 py-2.5",
              action_class(action.tone),
              action_left_bar(action.tone)
            ]}
          >
            <p class="text-sm font-590 text-text-primary">{action.title}</p>
            <p class="mt-1 text-xs leading-5 text-text-tertiary">{action.body}</p>
            <div
              :if={Map.get(action, :target_path) || Map.get(action, :command)}
              class="mt-2.5 flex flex-wrap items-center gap-1.5"
            >
              <a
                :if={Map.get(action, :target_path) && anchor_path?(action.target_path)}
                href={action.target_path}
                class="inline-flex items-center gap-1.5 rounded-md border border-border bg-panel px-2 py-1 text-xs font-510 text-text-secondary transition hover:border-border-hover hover:bg-surface-hover hover:text-text-primary"
              >
                <span class="hero-arrow-down-mini h-3.5 w-3.5"></span>
                {action.target_label}
              </a>
              <.app_link
                :if={Map.get(action, :target_path) && not anchor_path?(action.target_path)}
                navigate={action.target_path}
                class="inline-flex items-center gap-1.5 rounded-md border border-border bg-panel px-2 py-1 text-xs font-510 text-text-secondary transition hover:border-border-hover hover:bg-surface-hover hover:text-text-primary"
              >
                <span class="hero-wrench-screwdriver-mini h-3.5 w-3.5"></span>
                {action.target_label}
              </.app_link>
              <a
                :if={
                  Map.get(action, :secondary_target_path) &&
                    anchor_path?(action.secondary_target_path)
                }
                href={action.secondary_target_path}
                class="inline-flex items-center gap-1.5 rounded-md border border-border bg-panel px-2 py-1 text-xs font-510 text-text-tertiary transition hover:border-border-hover hover:bg-surface-hover hover:text-text-primary"
              >
                <span class="hero-arrow-down-mini h-3.5 w-3.5"></span>
                {action.secondary_target_label}
              </a>
              <.app_link
                :if={
                  Map.get(action, :secondary_target_path) &&
                    not anchor_path?(action.secondary_target_path)
                }
                navigate={action.secondary_target_path}
                class="inline-flex items-center gap-1.5 rounded-md border border-border bg-panel px-2 py-1 text-xs font-510 text-text-tertiary transition hover:border-border-hover hover:bg-surface-hover hover:text-text-primary"
              >
                <span class="hero-wrench-screwdriver-mini h-3.5 w-3.5"></span>
                {action.secondary_target_label}
              </.app_link>
              <a
                :if={Map.get(action, :command) && action.command == @runtime_enablement.command}
                href="#runtime-launch-checklist"
                class="ui-advanced-only inline-flex items-center gap-1.5 rounded-md border border-border bg-panel px-2 py-1 text-xs font-510 text-text-tertiary transition hover:border-border-hover hover:bg-surface-hover hover:text-text-primary"
              >
                <span class="hero-arrow-down-mini h-3.5 w-3.5"></span> Launch command
              </a>
              <code
                :if={Map.get(action, :command) && action.command != @runtime_enablement.command}
                class="ui-advanced-only max-w-full overflow-x-auto rounded-md border border-border bg-canvas px-2 py-1 font-mono text-[11px] text-text-secondary"
              >
                {action.command}
              </code>
            </div>
          </div>
        </div>
      </section>

      <section
        id="adapter-health"
        class="ui-advanced-only rounded-lg border border-border bg-panel scroll-mt-6"
      >
        <div class="border-b border-border px-4 py-3">
          <h2 class="text-sm font-590 text-text-primary">Adapter Health</h2>
        </div>
        <div :if={@health == []} class="px-4 py-8 text-center text-sm text-text-tertiary">
          No adapters assigned to agents yet.
        </div>
        <div :if={@health != []} class="divide-y divide-border">
          <div :for={adapter <- @health} class="px-4 py-3">
            <div class="flex items-center justify-between gap-3">
              <p class="text-sm font-590 text-text-primary">{adapter.label}</p>
              <p class="font-mono text-[11px] tabular-nums text-text-quaternary">
                {adapter.total} agents
              </p>
            </div>
            <div class="mt-2 flex items-stretch gap-px overflow-hidden rounded border border-border bg-border">
              <div class="flex-1 bg-panel px-2 py-1.5 text-center">
                <p class="font-mono text-[13px] font-590 leading-none tabular-nums text-emerald-300">
                  {adapter.healthy}
                </p>
                <p class="mt-1 text-[10px] font-590 uppercase tracking-[0.12em] text-text-quaternary">
                  Healthy
                </p>
              </div>
              <div class="flex-1 bg-panel px-2 py-1.5 text-center">
                <p class="font-mono text-[13px] font-590 leading-none tabular-nums text-amber-300">
                  {adapter.degraded}
                </p>
                <p class="mt-1 text-[10px] font-590 uppercase tracking-[0.12em] text-text-quaternary">
                  Warn
                </p>
              </div>
              <div class="flex-1 bg-panel px-2 py-1.5 text-center">
                <p class="font-mono text-[13px] font-590 leading-none tabular-nums text-brand">
                  {adapter.unavailable}
                </p>
                <p class="mt-1 text-[10px] font-590 uppercase tracking-[0.12em] text-text-quaternary">
                  Down
                </p>
              </div>
            </div>
            <p
              :if={adapter.launch_ready_warnings > 0}
              class="mt-2 rounded-md border border-emerald-500/20 bg-emerald-500/10 px-2.5 py-2 text-[11px] leading-4 text-emerald-200"
            >
              {adapter.launch_ready_warnings} warning {if adapter.launch_ready_warnings == 1,
                do: "agent",
                else: "agents"} pass launch preflight; health will refresh after the next checker/run signal.
            </p>
            <div :if={adapter.problem_agents != []} class="mt-3 space-y-1.5">
              <p class="text-[10px] font-590 uppercase tracking-[0.08em] text-text-quaternary">
                Needs attention
              </p>
              <.app_link
                :for={agent <- adapter.problem_agents}
                navigate={~p"/agents/#{agent.id}?tab=configuration"}
                class="flex items-center justify-between gap-3 rounded-md border border-border bg-surface px-2.5 py-2 hover:bg-surface-hover"
              >
                <span class="min-w-0">
                  <span class="block truncate text-xs font-510 text-text-primary">
                    {agent.name}
                  </span>
                  <span class="mt-0.5 block text-[11px] text-text-quaternary">
                    {role_label(agent.role)}
                  </span>
                </span>
                <span class={"shrink-0 rounded-full border px-2 py-0.5 text-[10px] font-510 #{health_status_badge_class(agent.status)}"}>
                  {health_status_label(agent.status)}
                </span>
              </.app_link>
            </div>
          </div>
        </div>
      </section>

      <%!-- Stays visible in simple mode: the "Something went wrong" card on Home
           links straight here, so hiding it would dead-end that flow. --%>
      <section
        id="runtime-failures"
        class="rounded-lg border border-border bg-panel scroll-mt-6"
      >
        <div class="border-b border-border px-4 py-3">
          <h2 class="text-sm font-590 text-text-primary">
            <span class="ui-advanced-only">Recent Runtime Failures</span>
            <span class="ui-simple-only">What went wrong</span>
          </h2>
        </div>
        <div
          :if={@recent_failures == []}
          class="px-4 py-8 text-center text-sm text-text-tertiary"
        >
          <span class="ui-advanced-only">No failed runs found.</span>
          <span class="ui-simple-only">Nothing has failed.</span>
        </div>
        <div :if={@recent_failures != []} class="divide-y divide-border">
          <div :for={failure <- @recent_failures} class="px-4 py-3">
            <div class="flex items-center justify-between gap-3">
              <span class="rounded-full border border-brand/25 bg-brand/10 px-2 py-0.5 text-[11px] font-510 text-brand">
                {failure.category}
              </span>
              <span class="text-[11px] text-text-quaternary">
                {format_relative(failure.completed_at || failure.inserted_at)}
              </span>
            </div>
            <p class="mt-2 text-sm font-510 text-text-primary">{failure.title}</p>
            <p :if={failure.hint} class="mt-1 text-xs leading-5 text-text-tertiary">
              {failure.hint}
            </p>
            <div class="mt-2 flex flex-wrap gap-2 text-xs">
              <.app_link
                :if={failure.agent}
                navigate={~p"/agents/#{failure.agent.id}?tab=runs&run_id=#{failure.id}"}
                class="text-brand hover:text-accent-hover"
              >
                {failure.agent.name}
              </.app_link>
              <.app_link
                :if={failure.issue}
                navigate={~p"/issues/#{failure.issue.id}"}
                class="text-text-tertiary hover:text-text-primary"
              >
                {failure.issue.identifier || short_id(failure.issue.id)}
              </.app_link>
            </div>
            <div
              :if={failure.focused_command}
              id={"recent-failure-focused-command-#{failure.id}"}
              phx-hook="CopyToClipboard"
              class="ui-advanced-only mt-3 rounded-md border border-border bg-canvas p-2"
            >
              <div class="flex flex-wrap items-center justify-between gap-2">
                <p class="text-[10px] font-590 uppercase tracking-[0.12em] text-text-quaternary">
                  Focused relaunch
                </p>
                <button
                  type="button"
                  data-copy-text={failure.focused_command}
                  data-copy-label="Copy command"
                  data-copy-success-label="Copied"
                  class="rounded border border-border bg-panel px-2 py-0.5 text-[10px] font-510 text-text-secondary transition hover:border-border-hover hover:bg-surface-hover hover:text-text-primary"
                >
                  Copy command
                </button>
              </div>
              <code class="mt-1.5 block max-w-full overflow-x-auto font-mono text-[10px] leading-4 text-text-secondary">
                {failure.focused_command}
              </code>
            </div>
          </div>
        </div>
      </section>
    </aside>
  </div>

  <div
    :if={@prompt_plan_preview}
    class="fixed inset-0 z-50 flex items-center justify-center bg-black/70 px-4 py-6"
    role="dialog"
    aria-modal="true"
    aria-labelledby="prompt-plan-preview-title"
  >
    <div class="flex max-h-[90vh] w-full max-w-4xl flex-col overflow-hidden rounded-xl border border-border bg-panel shadow-dialog">
      <div class="flex items-start justify-between gap-4 border-b border-border px-5 py-4">
        <div>
          <div class="flex flex-wrap items-center gap-2">
            <h2 id="prompt-plan-preview-title" class="text-base font-590 text-text-primary">
              Prompt Patch Preview
            </h2>
            <span class="rounded-full border border-brand/25 bg-brand/10 px-2 py-0.5 text-[11px] font-510 text-brand">
              {@prompt_plan_preview.agent_count} {plural_noun(
                @prompt_plan_preview.agent_count,
                "agent"
              )}
            </span>
            <span class="rounded-full border border-border bg-surface px-2 py-0.5 text-[11px] font-510 text-text-tertiary">
              {@prompt_plan_preview.patch_count} {plural_noun(
                @prompt_plan_preview.patch_count,
                "patch",
                "patches"
              )}
            </span>
          </div>
          <p class="mt-1 max-w-2xl text-xs leading-5 text-text-tertiary">
            Review the exact additive text Cympho will append. Existing instructions stay intact,
            and every apply records an agent config revision for rollback.
          </p>
        </div>

        <button
          type="button"
          phx-click="close_prompt_preview"
          class="rounded-md border border-border bg-surface px-2.5 py-1.5 text-xs font-510 text-text-secondary hover:bg-surface-hover hover:text-text-primary"
        >
          Close
        </button>
      </div>

      <div class="min-h-0 flex-1 overflow-y-auto px-5 py-4">
        <div
          :if={@prompt_plan_preview.empty?}
          class="rounded-lg border border-emerald-500/20 bg-emerald-500/[0.06] px-4 py-5 text-sm text-emerald-100"
        >
          No safe additive patches are currently available for this selection.
        </div>

        <div :if={!@prompt_plan_preview.empty?} class="space-y-3">
          <div
            :for={agent <- @prompt_plan_preview.agents}
            class="rounded-lg border border-border bg-surface px-3 py-3"
          >
            <div class="flex flex-wrap items-start justify-between gap-3">
              <div class="min-w-0">
                <p class="truncate text-sm font-590 text-text-primary">{agent.name}</p>
                <p class="mt-0.5 text-xs text-text-quaternary">
                  {role_label(agent.role)} · {adapter_label(agent.adapter)}
                </p>
              </div>
              <div class="text-right">
                <p class="font-mono text-sm tabular-nums text-text-primary">
                  {agent.current_score}/100 → {agent.projected_score}/100
                </p>
                <p class="mt-0.5 text-[11px] text-text-quaternary">
                  {agent.current_status_label} → {agent.projected_status_label}
                </p>
              </div>
            </div>

            <div class="mt-3 space-y-2">
              <div
                :for={patch <- agent.patches}
                class="rounded-md border border-border bg-canvas px-3 py-2"
              >
                <div class="flex flex-wrap items-center gap-2">
                  <span class={"rounded px-1.5 py-0.5 text-[11px] #{prompt_patch_class(patch.tone)}"}>
                    {patch.title}
                  </span>
                  <span class="text-[11px] text-text-quaternary">{patch.reason}</span>
                </div>
                <pre class="mt-2 whitespace-pre-wrap rounded border border-border bg-panel px-2.5 py-2 text-[11px] leading-5 text-text-secondary">{patch.body}</pre>
              </div>
            </div>
            <div
              :if={agent.validation_checks != []}
              class="mt-3 rounded-md border border-teal-500/15 bg-teal-500/[0.05] px-3 py-2"
            >
              <p class="text-[10px] font-590 uppercase tracking-[0.12em] text-teal-300">
                Next-run validation
              </p>
              <ul class="mt-1.5 space-y-1 text-[11px] leading-4 text-text-tertiary">
                <li :for={check <- agent.validation_checks} class="flex gap-1.5">
                  <span class="mt-1 h-1 w-1 shrink-0 rounded-full bg-teal-300"></span>
                  <span>{check}</span>
                </li>
              </ul>
            </div>
          </div>
        </div>
      </div>

      <div class="flex flex-wrap items-center justify-between gap-3 border-t border-border px-5 py-4">
        <p class="text-xs text-text-quaternary">
          These are generated from Instruction Studio guardrails, not free-form rewrites.
        </p>
        <div class="flex flex-wrap gap-2">
          <button
            type="button"
            phx-click="close_prompt_preview"
            class="rounded-md border border-border bg-surface px-3 py-2 text-sm font-510 text-text-secondary hover:bg-surface-hover hover:text-text-primary"
          >
            Cancel
          </button>
          <button
            :if={
              @prompt_plan_preview.scope == :watchlist and @prompt_plan_preview.agent_count > 0
            }
            type="button"
            phx-click="apply_prompt_plan"
            phx-value-scope="watchlist"
            data-confirm="Apply these additive Studio patches to every agent in the preview?"
            class="rounded-md border border-brand/30 bg-brand/15 px-3 py-2 text-sm font-510 text-brand hover:bg-brand/20"
          >
            Apply all patches
          </button>
          <button
            :if={@prompt_plan_preview.scope == :agent and @prompt_plan_preview.agent_count > 0}
            type="button"
            phx-click="apply_prompt_plan"
            phx-value-agent-id={hd(@prompt_plan_preview.agents).id}
            data-confirm="Apply these additive Studio patches to this agent?"
            class="rounded-md border border-brand/30 bg-brand/15 px-3 py-2 text-sm font-510 text-brand hover:bg-brand/20"
          >
            Apply patches
          </button>
        </div>
      </div>
    </div>
  </div>
</.page>
