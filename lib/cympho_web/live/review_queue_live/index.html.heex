<.page size="wide">
  <.header
    title={@page_title}
    subtitle="Approve finished work, return weak submissions, and clear CTO spec review."
  >
    <:actions>
      <.app_link
        navigate={~p"/issues?triage=review"}
        class="rounded-lg border border-border bg-panel px-3 py-2 text-sm font-510 text-text-secondary hover:bg-surface-hover hover:text-text-primary"
      >
        Review issues
      </.app_link>
      <.app_link
        navigate={~p"/operations#review-nudges"}
        class="rounded-button bg-brand px-3 py-2 text-sm font-590 text-on-primary hover:bg-accent-hover"
      >
        Review nudges
      </.app_link>
    </:actions>
  </.header>

  <div
    :if={@flash["error"]}
    class="mb-4 rounded-lg border border-red-500/30 bg-red-500/10 px-3 py-2 text-sm text-red-300"
  >
    {@flash["error"]}
  </div>

  <div
    :if={@flash["info"]}
    class="mb-4 rounded-lg border border-brand/30 bg-brand/10 px-3 py-2 text-sm text-brand"
  >
    {@flash["info"]}
  </div>

  <section class="mb-5 grid grid-cols-2 gap-2.5 lg:grid-cols-4">
    <div class="rounded-lg border border-hairline bg-surface-1 px-4 py-3">
      <p class="text-[10px] font-590 uppercase tracking-[0.14em] text-text-quaternary">
        In flight
      </p>
      <p class="mt-1 font-mono text-[30px] font-590 leading-none tabular-nums text-text-primary">
        {@stats.total}
      </p>
      <p class="mt-1 text-xs text-text-tertiary">All active review work</p>
    </div>

    <div class="rounded-lg border border-hairline bg-surface-1 px-4 py-3">
      <p class="text-[10px] font-590 uppercase tracking-[0.14em] text-text-quaternary">
        Decision needed
      </p>
      <p class="mt-1 font-mono text-[30px] font-590 leading-none tabular-nums text-sky-300">
        {length(@awaiting_review)}
      </p>
      <p class="mt-1 text-xs text-text-tertiary">Awaiting approve or changes</p>
    </div>

    <div class="rounded-lg border border-hairline bg-surface-1 px-4 py-3">
      <p class="text-[10px] font-590 uppercase tracking-[0.14em] text-text-quaternary">
        Rework loop
      </p>
      <p class="mt-1 font-mono text-[30px] font-590 leading-none tabular-nums text-amber-300">
        {length(@kicked_back)}
      </p>
      <p class="mt-1 text-xs text-text-tertiary">Returned to delivery</p>
    </div>

    <div class="rounded-lg border border-hairline bg-surface-1 px-4 py-3">
      <p class="text-[10px] font-590 uppercase tracking-[0.14em] text-text-quaternary">
        Oldest age
      </p>
      <p class="mt-1 font-mono text-[30px] font-590 leading-none tabular-nums text-text-primary">
        <%= if @stats.oldest_age_hours do %>
          {@stats.oldest_age_hours}h
        <% else %>
          —
        <% end %>
      </p>
      <p class="mt-1 truncate text-xs text-text-tertiary">
        <%= if Enum.empty?(@stats.by_role) do %>
          No reviewer bottleneck
        <% else %>
          <%= for {role, count} <- @stats.by_role do %>
            {role}: {count}<span class="last:hidden"> · </span>
          <% end %>
        <% end %>
      </p>
    </div>
  </section>

  <div class="grid grid-cols-1 gap-4 xl:grid-cols-[minmax(0,1.45fr)_minmax(360px,0.95fr)]">
    <section class="min-w-0 rounded-2xl border border-hairline bg-surface-1 shadow-card">
      <div class="flex items-start justify-between gap-3 border-b border-hairline px-4 py-3">
        <div>
          <p class="text-[11px] font-590 uppercase tracking-[0.14em] text-text-quaternary">
            Awaiting review
          </p>
          <h2 class="mt-1 text-base font-590 text-text-primary">
            Decision queue
            <span class="ml-2 font-mono text-sm text-text-quaternary">
              {length(@awaiting_review)}
            </span>
          </h2>
        </div>
        <span class="rounded-full border border-sky-500/25 bg-sky-500/10 px-2 py-1 text-xs font-510 text-sky-200">
          Gate checked on close
        </span>
      </div>

      <div
        :if={Enum.empty?(@awaiting_review)}
        class="px-6 py-14 text-center"
      >
        <div class="mx-auto flex h-11 w-11 items-center justify-center rounded-lg border border-border bg-surface">
          <span class="hero-check-circle-mini h-5 w-5 text-text-tertiary"></span>
        </div>
        <p class="mt-4 text-sm font-590 text-text-secondary">No issues awaiting review.</p>
        <p class="mt-1 text-sm text-text-quaternary">
          Finished work will land here for a decision.
        </p>
      </div>

      <div :if={!Enum.empty?(@awaiting_review)} class="divide-y divide-hairline">
        <article
          :for={issue <- @awaiting_review}
          class="px-4 py-4 transition hover:bg-surface-hover/30"
        >
          <div class="grid gap-3 lg:grid-cols-[minmax(0,1fr)_auto]">
            <div class="min-w-0">
              <div class="flex flex-wrap items-center gap-2">
                <span class={"h-2 w-2 rounded-full #{status_color(issue.status)}"}></span>
                <span :if={issue.identifier} class="font-mono text-xs text-text-quaternary">
                  {issue.identifier}
                </span>
                <span class="rounded-full border border-sky-500/25 bg-sky-500/10 px-2 py-0.5 text-[11px] font-510 text-sky-200">
                  Awaiting review
                </span>
                <span class="text-xs text-text-quaternary">{format_age(issue.updated_at)}</span>
              </div>

              <.app_link
                navigate={~p"/issues/#{issue.id}"}
                class="mt-2 block truncate text-base font-590 text-text-primary hover:text-brand"
              >
                {issue.title}
              </.app_link>

              <div class="mt-2 flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-text-quaternary">
                <span :if={issue.assigned_role}>reviewer role: {issue.assigned_role}</span>
                <span :if={issue.assignee}>assigned to {issue.assignee.name}</span>
                <span :if={issue.project}>{issue.project.name}</span>
              </div>
            </div>

            <div class="flex flex-wrap items-center gap-2 lg:justify-end">
              <button
                type="button"
                phx-click="approve_review"
                phx-value-id={issue.id}
                class="rounded-lg border border-emerald-500/25 bg-emerald-500/10 px-3 py-2 text-xs font-510 text-emerald-200 hover:bg-emerald-500/15"
              >
                Approve and close
              </button>
              <button
                type="button"
                phx-click="request_changes"
                phx-value-id={issue.id}
                class="rounded-lg border border-amber-500/25 bg-amber-500/10 px-3 py-2 text-xs font-510 text-amber-200 hover:bg-amber-500/15"
              >
                Request changes
              </button>
              <.app_link
                navigate={~p"/issues/#{issue.id}"}
                class="rounded-lg border border-border bg-surface px-3 py-2 text-xs font-510 text-text-secondary hover:bg-surface-hover hover:text-text-primary"
              >
                Open issue
              </.app_link>
            </div>
          </div>
        </article>
      </div>
    </section>

    <aside class="space-y-4">
      <section class="rounded-2xl border border-hairline bg-surface-1 shadow-card">
        <div class="border-b border-hairline px-4 py-3">
          <p class="text-[11px] font-590 uppercase tracking-[0.14em] text-text-quaternary">
            Kicked back to engineering
          </p>
          <h2 class="mt-1 text-base font-590 text-text-primary">
            Rework lane
            <span class="ml-2 font-mono text-sm text-text-quaternary">
              {length(@kicked_back)}
            </span>
          </h2>
        </div>

        <div
          :if={Enum.empty?(@kicked_back)}
          class="px-5 py-8 text-center"
        >
          <p class="text-sm text-text-secondary">No issues currently kicked back.</p>
        </div>

        <div :if={!Enum.empty?(@kicked_back)} class="divide-y divide-hairline">
          <article :for={issue <- @kicked_back} class="px-4 py-3">
            <div class="flex items-start gap-3">
              <span class={"mt-1.5 h-2 w-2 shrink-0 rounded-full #{status_color(issue.status)}"}>
              </span>
              <div class="min-w-0 flex-1">
                <.app_link
                  navigate={~p"/issues/#{issue.id}"}
                  class="block truncate text-sm font-590 text-text-primary hover:text-brand"
                >
                  {issue.title}
                </.app_link>
                <div class="mt-1 flex flex-wrap gap-x-3 gap-y-1 text-xs text-text-quaternary">
                  <span :if={issue.last_reviewer}>
                    last reviewed by {issue.last_reviewer.name || issue.last_reviewer.id}
                  </span>
                  <span :if={issue.assigned_role}>fix role: {issue.assigned_role}</span>
                  <span :if={issue.project}>{issue.project.name}</span>
                </div>
              </div>
              <span class="shrink-0 text-xs text-text-quaternary">
                {format_age(issue.updated_at)}
              </span>
            </div>
          </article>
        </div>
      </section>

      <section class="rounded-2xl border border-hairline bg-surface-1 shadow-card">
        <div class="border-b border-hairline px-4 py-3">
          <p class="text-[11px] font-590 uppercase tracking-[0.14em] text-text-quaternary">
            Spec review (CTO)
          </p>
          <h2 class="mt-1 text-base font-590 text-text-primary">
            Initiative gate
            <span class="ml-2 font-mono text-sm text-text-quaternary">
              {length(@spec_review)}
            </span>
          </h2>
        </div>

        <div
          :if={Enum.empty?(@spec_review)}
          class="px-5 py-8 text-center"
        >
          <p class="text-sm text-text-secondary">No initiatives awaiting CTO spec review.</p>
        </div>

        <div :if={!Enum.empty?(@spec_review)} class="divide-y divide-hairline">
          <article :for={issue <- @spec_review} class="px-4 py-3">
            <div class="min-w-0">
              <div class="flex flex-wrap items-center gap-2">
                <span :if={issue.identifier} class="font-mono text-xs text-text-quaternary">
                  {issue.identifier}
                </span>
                <span class="text-xs text-text-quaternary">{format_age(issue.inserted_at)}</span>
              </div>
              <.app_link
                navigate={~p"/issues/#{issue.id}"}
                class="mt-1 block truncate text-sm font-590 text-text-primary hover:text-brand"
              >
                {issue.title}
              </.app_link>
              <div class="mt-1 flex flex-wrap gap-x-3 gap-y-1 text-xs text-text-quaternary">
                <span>
                  proposed role: {get_in(issue.monitor_state, ["proposed_role"]) || "—"}
                </span>
                <span :if={issue.project}>{issue.project.name}</span>
              </div>
              <div class="mt-3 flex flex-wrap gap-2">
                <button
                  type="button"
                  phx-click="approve_spec"
                  phx-value-id={issue.id}
                  class="rounded-lg border border-brand/25 bg-brand/10 px-3 py-2 text-xs font-510 text-brand hover:bg-brand/15"
                >
                  Approve spec
                </button>
                <.app_link
                  navigate={~p"/issues/#{issue.id}"}
                  class="rounded-lg border border-border bg-surface px-3 py-2 text-xs font-510 text-text-secondary hover:bg-surface-hover hover:text-text-primary"
                >
                  Open issue
                </.app_link>
              </div>
            </div>
          </article>
        </div>
      </section>
    </aside>
  </div>
</.page>
