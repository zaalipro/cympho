<.page_frame page="reviews" title="Reviews" data-ui-complex-page>
  <.flash_line flash={@flash} />

  <CymphoWeb.Live.ReviewChanges.reason_form review_changes={@review_changes} />

  <.band_card id="reviews-decide-t" title="Waiting for your decision">
    <:header_end>
      <span class="rv-end">
        <span class="meta mono">{length(@awaiting_review)}</span>
        <.text_link navigate={~p"/issues?triage=review"}>Review tasks</.text_link>
        <.text_link navigate={~p"/operations#review-nudges"}>Review nudges</.text_link>
      </span>
    </:header_end>

    <.quiet_empty :if={@awaiting_review_decisions == []} title="Nothing waiting on you">
      No issues awaiting review. Finished work lands here when it needs a decision.
    </.quiet_empty>

    <ul :if={@awaiting_review_decisions != []} class="rows">
      <.list_row
        :for={card <- @awaiting_review_decisions}
        id={"review-#{card.issue.id}"}
        data-testid={"review-decision-card-#{card.issue.id}"}
        icon="i-doc-check"
        title={card.issue.title}
        navigate={~p"/issues/#{card.issue.id}"}
        status={gate_status(card)}
      >
        <:meta>
          <span :if={card.issue.identifier} class="mono">{card.issue.identifier}</span><span
            :if={card.issue.identifier}
            aria-hidden="true"
          > · </span><span :if={card.assignee}>{card.assignee}<span aria-hidden="true"> · </span></span><span class="mono">{card.age}</span>
        </:meta>
        <:actions>
          <span class="rv-acts" data-testid={"review-action-bar-#{card.issue.id}"}>
            <.pill phx-click="approve_review" phx-value-id={card.issue.id}>
              Approve and close
            </.pill>
            <.pill phx-click="request_changes" phx-value-id={card.issue.id}>
              Request changes
            </.pill>
          </span>
        </:actions>
        <:below>
          <div class="rv-gate" data-testid={"review-gate-card-#{card.issue.id}"}>
            <p class="rv-gate-h">{review_gate_heading(card)}</p>
            <p class="rm">{review_gate_detail(card)}</p>
            <p :if={card.blocker_labels != []} class="rv-tags">
              <span :for={label <- Enum.take(card.blocker_labels, 5)} class="tag">{label}</span>
              <span :if={length(card.blocker_labels) > 5} class="tag">
                +{length(card.blocker_labels) - 5} more
              </span>
            </p>
          </div>
          <details
            :if={card.review_packet}
            id={"review-packet-#{card.issue.id}"}
            data-testid={"review-decision-packet-#{card.issue.id}"}
            class="earlier"
            phx-mounted={JS.ignore_attributes("open")}
          >
            <summary>
              <span>
                Review decision packet<span aria-hidden="true"> · </span>{card.review_packet.verdict}
              </span>
              <.r3_icon name="i-chev-down" class="ico s14" />
            </summary>
            <div class="rv-packet">
              <p class="rm">{card.review_packet.summary}</p>
              <div class="ui-advanced-only rv-lists">
                <div>
                  <p class="gl-h">Evidence present</p>
                  <ul>
                    <li :for={line <- card.review_packet.evidence}>{line}</li>
                  </ul>
                </div>
                <div>
                  <p class="gl-h">Risk / asks</p>
                  <ul>
                    <li :for={line <- card.review_packet.risks}>{line}</li>
                  </ul>
                </div>
              </div>
            </div>
          </details>
        </:below>
      </.list_row>
    </ul>
  </.band_card>

  <.band_card id="reviews-rework-t" title="Changes requested">
    <:header_end><span class="meta mono">{length(@kicked_back)}</span></:header_end>

    <.quiet_empty
      :if={@kicked_back == []}
      title="No issues currently have changes requested."
    />

    <ul :if={@kicked_back != []} class="rows">
      <.list_row
        :for={issue <- @kicked_back}
        id={"rework-#{issue.id}"}
        icon="i-pencil"
        title={issue.title}
        navigate={~p"/issues/#{issue.id}"}
      >
        <:meta>
          <span :if={issue.identifier} class="mono">{issue.identifier}</span><span
            :if={issue.identifier}
            aria-hidden="true"
          > · </span><span :if={latest_reviewer_name(issue)}>last reviewed by {latest_reviewer_name(
              issue
            )}</span><span :if={
            issue.assigned_role
          }><span aria-hidden="true"> · </span>fix role: {issue.assigned_role}</span>
        </:meta>
        <:trail><span class="mono">{format_age(issue.updated_at)}</span></:trail>
      </.list_row>
    </ul>
  </.band_card>

  <.band_card id="reviews-spec-t" title="Specs waiting on the CTO">
    <:header_end><span class="meta mono">{length(@spec_review)}</span></:header_end>

    <.quiet_empty :if={@spec_review == []} title="No initiatives awaiting CTO spec review." />

    <ul :if={@spec_review != []} class="rows">
      <.list_row
        :for={issue <- @spec_review}
        id={"spec-#{issue.id}"}
        icon="i-doc-check"
        title={issue.title}
        navigate={~p"/issues/#{issue.id}"}
      >
        <:meta>
          <span :if={issue.identifier} class="mono">{issue.identifier}</span><span
            :if={issue.identifier}
            aria-hidden="true"
          > · </span>proposed role: {get_in(issue.monitor_state, ["proposed_role"]) || "—"}<span :if={
            issue.project
          }><span aria-hidden="true"> · </span>{issue.project.name}</span>
        </:meta>
        <:trail><span class="mono">{format_age(issue.inserted_at)}</span></:trail>
        <:actions>
          <.pill phx-click="approve_spec" phx-value-id={issue.id}>Approve spec</.pill>
        </:actions>
      </.list_row>
    </ul>
  </.band_card>

  <div class="ui-advanced-only">
    <.band_card id="review-command-t" title="Review Overview" data-testid="review-command">
      <:header_end>
        <span class="rv-tone">
          <.status_word
            kind={elem(command_status(@review_command.tone), 0)}
            word={elem(command_status(@review_command.tone), 1)}
          />
        </span>
      </:header_end>
      <div class="gl-sec">
        <p class="gl-big">{@review_command.heading}</p>
        <p class="gl-sub">{@review_command.detail}</p>
        <p :if={@review_command.focus} class="rv-tags">
          <span class="tag">{@review_command.focus.lane}</span>
          <span class="tag">{@review_command.focus.age} waiting</span>
          <span class="tag">role: {@review_command.focus.role}</span>
          <span :if={@review_command.focus.assignee} class="tag">
            {@review_command.focus.assignee}
          </span>
        </p>
        <p :if={@review_command.blocker_labels != []} class="rv-tags">
          <span :for={label <- Enum.take(@review_command.blocker_labels, 4)} class="tag">
            {label}
          </span>
          <span :if={length(@review_command.blocker_labels) > 4} class="tag">
            +{length(@review_command.blocker_labels) - 4} more
          </span>
        </p>
        <.text_link navigate={@review_command.action_path}>
          {@review_command.action_label}
        </.text_link>
      </div>
      <%!-- Same reason as before: four zeroed cells on a clear queue say nothing. --%>
      <div :if={@stats.total > 0} class="strip s4">
        <div class="cell">
          <span class="v mono">{@review_command.ready_count}</span><span class="l">Ready</span>
        </div>
        <div class="cell">
          <span class="v mono">{@review_command.blocked_count}</span><span class="l">Blocked gates</span>
        </div>
        <div class="cell">
          <span class="v mono">{@review_command.rework_count}</span><span class="l">Rework</span>
        </div>
        <div class="cell">
          <span class="v mono">{@review_command.spec_count}</span><span class="l">Spec gates</span>
        </div>
      </div>
      <p :if={@stats.total > 0} class="meta rv-oldest">
        Oldest waiting: <span class="mono">{@review_command.oldest_label}</span>
      </p>
    </.band_card>
  </div>
</.page_frame>
