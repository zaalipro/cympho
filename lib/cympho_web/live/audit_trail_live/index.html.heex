<.settings_layout active={:audit}>
  <.header
    title={@page_title}
    subtitle="Governance-grade event history for policies, approvals, runtime sessions, and agent changes."
  />

  <section
    data-testid="audit-command"
    class="mb-5 overflow-hidden rounded-lg border border-border bg-panel shadow-card"
  >
    <div class="grid gap-4 p-4 lg:grid-cols-[minmax(0,1fr)_auto] lg:items-start">
      <div class="min-w-0">
        <div class="flex flex-wrap items-center gap-2">
          <p class="text-[11px] font-590 uppercase tracking-[0.14em] text-text-quaternary">
            Audit command
          </p>
          <span class={"rounded-full border px-2 py-0.5 text-[11px] font-510 #{audit_command_badge_class(@audit_command.tone)}"}>
            {@audit_command.badge}
          </span>
        </div>

        <h2 class="mt-2 text-lg font-590 text-text-primary">
          {@audit_command.heading}
        </h2>
        <p class="mt-1 max-w-3xl text-sm leading-6 text-text-tertiary">
          {@audit_command.detail}
        </p>

        <div
          :if={@audit_command.focus_label || @audit_command.actor_summary not in [nil, ""]}
          class="mt-3 flex min-w-0 flex-wrap items-center gap-2 text-xs"
        >
          <span
            :if={@audit_command.focus_label}
            class="max-w-full truncate rounded-full border border-border bg-surface px-2 py-1 font-510 text-text-secondary"
          >
            {@audit_command.focus_label}
          </span>
          <span
            :if={@audit_command.focus_detail}
            class="rounded-full border border-border bg-surface px-2 py-1 text-text-tertiary"
          >
            {@audit_command.focus_detail}
          </span>
          <span
            :if={@audit_command.actor_summary not in [nil, ""]}
            class="rounded-full border border-border bg-surface px-2 py-1 text-text-tertiary"
          >
            {@audit_command.actor_summary}
          </span>
        </div>
      </div>

      <.app_link
        navigate={@audit_command.action_path}
        class={"inline-flex shrink-0 items-center justify-center gap-2 rounded-lg border px-3 py-2 text-sm font-590 transition-colors #{audit_command_action_class(@audit_command.tone)}"}
      >
        <.icon name="hero-arrow-right-mini" class="h-4 w-4" />
        {@audit_command.action_label}
      </.app_link>
    </div>

    <div class="ui-advanced-only grid grid-cols-2 border-t border-border sm:grid-cols-3 lg:grid-cols-7">
      <div
        :for={metric <- @audit_command.metrics}
        class="border-r border-border px-4 py-3 last:border-r-0"
      >
        <p class="text-[10px] font-590 uppercase tracking-[0.14em] text-text-quaternary">
          {metric.label}
        </p>
        <p class={[
          "mt-1 font-mono text-xl font-590 tabular-nums",
          audit_metric_value_class(metric.tone)
        ]}>
          {metric.value}
        </p>
      </div>
    </div>
  </section>

  <section class="mb-5 rounded-lg border border-border bg-panel px-4 py-3">
    <div class="flex flex-col gap-3 lg:flex-row lg:items-start lg:justify-between">
      <div class="min-w-0">
        <p class="text-sm font-590 text-text-primary">Audit filters</p>
        <p class="ui-advanced-only mt-1 max-w-2xl text-xs leading-5 text-text-tertiary">
          Scope the trail by event, actor, resource, and date when reconstructing a decision.
        </p>
      </div>

      <div class="flex flex-wrap items-center gap-3">
        <form phx-change="filter" phx-submit="prevent">
          <.select_menu
            name="filter_event_type"
            value={@filter_event_type || ""}
            options={[
              {"All event types", ""} | Enum.map(@event_types, &{format_event_type(&1), &1})
            ]}
          />
        </form>

        <form phx-change="filter" phx-submit="prevent">
          <.select_menu
            name="filter_actor_type"
            value={@filter_actor_type || ""}
            options={[
              {"All actors", ""},
              {"Agent", "agent"},
              {"User", "user"},
              {"System", "system"}
            ]}
          />
        </form>

        <form class="ui-advanced-only" phx-change="filter" phx-submit="prevent">
          <input
            type="text"
            name="filter_actor_id"
            value={@filter_actor_id}
            placeholder="Actor ID"
            class="h-9 w-44 rounded-lg border border-border bg-surface px-3 text-sm text-text-secondary placeholder:text-text-quaternary"
          />
        </form>

        <form class="ui-advanced-only" phx-change="filter" phx-submit="prevent">
          <.select_menu
            name="filter_resource_type"
            value={@filter_resource_type || ""}
            options={[
              {"All resources", ""},
              {"Issue", "issue"},
              {"Agent", "agent"},
              {"Board approval", "board_approval"},
              {"Budget", "budget"},
              {"Decision", "decision"},
              {"Comment", "comment"},
              {"Work product", "work_product"},
              {"Company", "company"},
              {"Project", "project"},
              {"Goal", "goal"}
            ]}
          />
        </form>

        <form class="ui-advanced-only" phx-change="filter" phx-submit="prevent">
          <input
            type="text"
            name="filter_resource_id"
            value={@filter_resource_id}
            placeholder="Resource ID"
            class="h-9 w-44 rounded-lg border border-border bg-surface px-3 text-sm text-text-secondary placeholder:text-text-quaternary"
          />
        </form>

        <form phx-change="filter" phx-submit="prevent">
          <.date_picker
            name="filter_date_from"
            value={@filter_date_from}
            placeholder="From date"
            class="w-40"
          />
        </form>

        <form phx-change="filter" phx-submit="prevent">
          <.date_picker
            name="filter_date_to"
            value={@filter_date_to}
            placeholder="To date"
            class="w-40"
          />
        </form>

        <button
          :if={
            @filter_event_type != "" or @filter_actor_type != "" or @filter_actor_id != "" or
              @filter_resource_type != "" or @filter_resource_id != "" or
              @filter_date_from != "" or @filter_date_to != ""
          }
          type="button"
          phx-click="clear_filters"
          class="rounded-md border border-border px-2.5 py-1.5 text-xs font-510 text-text-tertiary transition-colors hover:bg-surface-hover hover:text-text-primary"
        >
          Clear filters
        </button>
      </div>
    </div>
  </section>

  <section id="audit-events" class="overflow-hidden rounded-lg border border-border bg-panel">
    <div class="border-b border-border px-4 py-3">
      <p class="text-sm font-590 text-text-primary">Audit events</p>
      <p class="mt-1 text-xs text-text-tertiary">
        Newest events appear first. Payloads stay collapsed until inspection.
      </p>
    </div>

    <.infinite_scroll
      id="audit"
      has_more={@infinite_scroll[:events][:has_more?] || false}
      container_class="divide-y divide-border"
    >
      <:empty>
        <div class="flex flex-col items-center justify-center px-6 py-16 text-center">
          <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-full bg-surface">
            <.icon name="hero-clipboard-document-list-mini" class="h-6 w-6 text-text-tertiary" />
          </div>
          <p class="text-sm font-510 text-text-secondary">No audit events found.</p>
          <p class="mt-1 max-w-sm text-xs leading-5 text-text-tertiary">
            Clear filters or create governable work to populate the audit trail.
          </p>
        </div>
      </:empty>

      <div
        :for={{dom_id, event} <- @streams.events}
        id={dom_id}
        class="group flex items-start gap-4 p-4 transition-colors hover:bg-surface-hover"
      >
        <div class={"flex h-9 w-9 shrink-0 items-center justify-center rounded-full #{audit_icon_tone(event.event_type)}"}>
          <.icon name={audit_icon(event.event_type)} class="h-4 w-4" />
        </div>

        <div class="min-w-0 flex-1">
          <div class="flex flex-col gap-2 lg:flex-row lg:items-start lg:justify-between">
            <div class="min-w-0">
              <div class="flex flex-wrap items-center gap-2">
                <span class="rounded-full border border-border bg-surface px-2 py-0.5 text-[11px] font-510 text-text-secondary">
                  {format_event_type(event.event_type)}
                </span>
                <span class="rounded-full border border-border bg-surface px-2 py-0.5 text-[11px] font-510 text-text-tertiary">
                  {format_actor_type(event.actor_type)}
                  <%= if event.actor_id do %>
                    <span class="font-mono text-text-secondary">
                      {String.slice(event.actor_id, 0..7)}
                    </span>
                  <% end %>
                </span>
              </div>

              <div class="mt-2 flex min-w-0 flex-wrap items-center gap-2 text-sm">
                <span class="font-590 text-text-primary">
                  {String.replace(event.resource_type, "_", " ")}
                </span>
                <span :if={event.resource_id} class="font-mono text-xs text-text-tertiary">
                  {String.slice(event.resource_id, 0..7)}
                </span>
              </div>
            </div>

            <p class="shrink-0 text-xs text-text-quaternary">
              {format_timestamp(event.inserted_at)}
            </p>
          </div>

          <details
            :if={event.payload not in [nil, %{}]}
            data-testid={"audit-payload-#{event.id}"}
            class="mt-3"
          >
            <summary
              class="inline-flex max-w-full cursor-pointer flex-wrap items-center gap-1.5 text-xs font-510 text-text-tertiary transition-colors hover:text-text-primary"
              aria-label={payload_summary(event)}
            >
              <span>{payload_summary(event)}</span>
              <.icon name="hero-chevron-down-mini" class="h-3.5 w-3.5" />
            </summary>
            <pre class="mt-2 max-h-64 overflow-auto rounded-md border border-border bg-canvas p-3 text-xs leading-5 text-text-tertiary"><%= format_payload(event.payload) %></pre>
          </details>
        </div>
      </div>
    </.infinite_scroll>
  </section>
</.settings_layout>
