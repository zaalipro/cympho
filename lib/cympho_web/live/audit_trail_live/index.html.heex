<.settings_layout active={:audit}>
  <.flash_line flash={@flash} />

  <.band_card id="au-t" title="Audit log" section_id="audit-events">
    <:header_end>
      <.filter_menu id="audit-filter" active={@filter_count}>
        <%!-- Each filter keeps its own form: a change sends only that field (today's behaviour). --%>
        <div class="flds au-flds">
          <form phx-change="filter" phx-submit="prevent">
            <.input
              id="filter-event-type"
              type="select"
              name="filter_event_type"
              label="Event"
              value={@filter_event_type || ""}
              options={[
                {"All event types", ""} | Enum.map(@event_types, &{format_event_type(&1), &1})
              ]}
            />
          </form>
          <form phx-change="filter" phx-submit="prevent">
            <.input
              id="filter-actor-type"
              type="select"
              name="filter_actor_type"
              label="Actor"
              value={@filter_actor_type || ""}
              options={[
                {"All actors", ""},
                {"Agent", "agent"},
                {"User", "user"},
                {"System", "system"}
              ]}
            />
          </form>
          <form class="ui-advanced-only" phx-change="filter" phx-submit="prevent">
            <.input
              id="filter-actor-id"
              name="filter_actor_id"
              label="Actor ID"
              value={@filter_actor_id}
              placeholder="Actor ID"
              autocomplete="off"
            />
          </form>
          <form class="ui-advanced-only" phx-change="filter" phx-submit="prevent">
            <.input
              id="filter-resource-type"
              type="select"
              name="filter_resource_type"
              label="Resource"
              value={@filter_resource_type || ""}
              options={[
                {"All resources", ""},
                {"Task", "issue"},
                {"Agent", "agent"},
                {"Board approval", "board_approval"},
                {"Budget", "budget"},
                {"Decision", "decision"},
                {"Comment", "comment"},
                {"Work product", "work_product"},
                {"Company", "company"},
                {"Project", "project"},
                {"Goal", "goal"}
              ]}
            />
          </form>
          <form class="ui-advanced-only" phx-change="filter" phx-submit="prevent">
            <.input
              id="filter-resource-id"
              name="filter_resource_id"
              label="Resource ID"
              value={@filter_resource_id}
              placeholder="Resource ID"
              autocomplete="off"
            />
          </form>
          <form phx-change="filter" phx-submit="prevent">
            <.input
              id="filter-date-from"
              type="date"
              name="filter_date_from"
              label="From"
              value={@filter_date_from}
              placeholder="From date"
            />
          </form>
          <form phx-change="filter" phx-submit="prevent">
            <.input
              id="filter-date-to"
              type="date"
              name="filter_date_to"
              label="To"
              value={@filter_date_to}
              placeholder="To date"
            />
          </form>
        </div>
        <.pill :if={@filter_count > 0} phx-click="clear_filters">Clear filters</.pill>
      </.filter_menu>
    </:header_end>

    <.infinite_scroll
      id="audit"
      has_more={@infinite_scroll[:events][:has_more?] || false}
      container_class="rows"
    >
      <:empty>
        <.quiet_empty title={
          if @filter_count > 0, do: "No events match these filters", else: "No audit events yet"
        }>
          Clear filters or create governable work to populate the audit trail.
        </.quiet_empty>
      </:empty>

      <.list_row
        :for={{dom_id, event} <- @streams.events}
        tag="div"
        id={dom_id}
        icon={audit_icon(event.event_type)}
        kind={if problem_event?(event.event_type), do: :problem, else: :neutral}
        title={event_title(event)}
      >
        <:meta>
          {format_actor_type(event.actor_type)}
          <span :if={event.actor_id} class="mono">{String.slice(event.actor_id, 0..7)}</span><span aria-hidden="true"> · </span>{Calendar.strftime(
            event.inserted_at,
            "%a %-d %b"
          )}
          <span class="mono">{Calendar.strftime(event.inserted_at, "%H:%M")}</span><span
            :if={event.resource_id}
            class="ui-advanced-only"
          ><span aria-hidden="true"> · </span>{resource_words(event.resource_type)}
            <span class="mono">{String.slice(event.resource_id, 0..7)}</span></span>
        </:meta>
        <:below :if={event.payload not in [nil, %{}]}>
          <details
            id={"audit-payload-#{event.id}"}
            data-testid={"audit-payload-#{event.id}"}
            class="earlier"
            phx-mounted={JS.ignore_attributes("open")}
          >
            <summary>{payload_summary(event)}<.r3_icon name="i-chev-down" /></summary>
            <pre class="pay mono"><%= format_payload(event.payload) %></pre>
          </details>
        </:below>
      </.list_row>
    </.infinite_scroll>
  </.band_card>

  <div class="ui-advanced-only">
    <.band_card id="ac-t" title="Summary" data-testid="audit-command">
      <:header_end><span class="tag">{@audit_command.badge}</span></:header_end>
      <div class="cmd">
        <p class="gl-big">{@audit_command.heading}</p>
        <p class="gl-sub">{@audit_command.detail}</p>
        <p
          :if={@audit_command.focus_label || @audit_command.actor_summary not in [nil, ""]}
          class="cmd-f"
        >
          <span :if={@audit_command.focus_label} class="tag">{@audit_command.focus_label}</span>
          <span :if={@audit_command.focus_detail} class="tag">{@audit_command.focus_detail}</span>
          <span :if={@audit_command.actor_summary not in [nil, ""]} class="tag">
            {@audit_command.actor_summary}
          </span>
        </p>
        <.text_link navigate={@audit_command.action_path}>
          {@audit_command.action_label}
        </.text_link>
      </div>
      <div :if={audit_metric_total(@audit_command) > 0} class="strip s4">
        <div :for={metric <- @audit_command.metrics} class="cell">
          <p class="v mono">{metric.value}</p>
          <p class="l">{metric.label}</p>
        </div>
      </div>
    </.band_card>
  </div>
</.settings_layout>
