<.page_frame
  page="hire"
  kind={:deep}
  parent={{"/agents", "Team"}}
  current="Hire"
  data-ui-complex-page
>
  <:head>
    <section class="head" aria-labelledby="hr-h">
      <h1 class="h1 big" id="hr-h">Hire</h1>
      <p class="sub">
        <span class="ui-simple-only">
          Choose the agent's role and reporting line. Cympho will apply the working defaults.
        </span>
        <span class="ui-advanced-only">
          Create an autonomous teammate with a role, operating instructions, and runtime adapter.
        </span>
      </p>
    </section>
  </:head>

  <%!-- The board-approval info flash repeats the ink card's note word for word. --%>
  <.flash_line flash={if @pending_approval_id, do: Map.delete(@flash, "info"), else: @flash} />

  <.band_card
    :if={@hire_context}
    id="hr-demand-t"
    title="Work is waiting"
    data-testid="hire-demand-context"
  >
    <:header_end>
      <span class="hr-end">
        <span class="ui-advanced-only tag">Demand-backed hire</span>
        <span class="meta">
          {@hire_context.open_issues} open {plural_noun(@hire_context.open_issues, "task")}
        </span>
      </span>
    </:header_end>
    <div class="gl-sec">
      <p class="gl-sub">
        Queued work needs a {@hire_context.label}. This form is prefilled with the matching
        role, playbook, and reporting line.
      </p>
      <p :if={@hire_context.suggested_parent} class="gl-sub">
        Reports to {@hire_context.suggested_parent.name}
      </p>
      <div :if={@hire_context.examples != []} class="chips hr-ex">
        <.link
          :for={example <- @hire_context.examples}
          navigate={~p"/issues/#{example.id}"}
          class="chip"
          title={issue_example_label(example)}
        >
          <span class="hr-ex-t">{issue_example_label(example)}</span>
        </.link>
      </div>
    </div>
  </.band_card>

  <div id="new-agent-config-fields" phx-hook="AdapterConfigFields">
    <.form_pair
      id="new-agent-form"
      for={@form}
      phx-change="validate"
      phx-submit="save"
      heading="After you hire"
      verb="hire"
    >
      <.band_card id="hr-who-t" title="Who" data-testid="new-agent-identity-section">
        <div class="flds">
          <.input
            field={@form[:name]}
            label="Name"
            required
            placeholder="Elixir Engineer"
            wrapper_class="full"
          />
          <.input
            field={@form[:role]}
            type="select"
            label="Role"
            required
            options={role_options()}
          />
          <.input
            field={@form[:parent_id]}
            type="select"
            label="Reports to"
            options={@reports_to_options}
          />
        </div>
        <p class="hr-role">
          <b>{role_label(role_value(@form))}</b><span aria-hidden="true"> · </span>{role_blurb(
            role_value(@form)
          )}<span class="hr-rt">{role_reports_to_hint(role_value(@form))}</span>
        </p>
      </.band_card>

      <.band_card
        id="hr-defaults-t"
        title="Defaults"
        class="ui-simple-only"
        data-testid="new-agent-defaults-summary"
        data-hire-readiness={@hire_readiness.status}
      >
        <.kv_list class="wide">
          <:item term="Readiness">
            <span class="hr-st" data-testid="new-agent-readiness-label">
              <.status_word
                kind={if @hire_readiness.status == :needs_key, do: :waiting, else: :done}
                word={@hire_readiness.label}
              />
            </span>
          </:item>
          <:item :if={@hire_readiness.status != :needs_key} term="Starts with">
            {@hire_readiness.summary}
          </:item>
          <:item
            :if={@hire_readiness.status == :needs_key and @hire_readiness.setup_path}
            term="Key"
          >
            <.link
              class="ul"
              navigate={@hire_readiness.setup_path}
              data-testid="new-agent-add-key"
            >
              Add key
            </.link>
            <span class="meta">
              Returns here after save · <span class="mono">{@hire_readiness.primary_key}</span>
            </span>
          </:item>
        </.kv_list>
      </.band_card>

      <.band_card id="hr-run-t" title="How it runs">
        <div data-testid="new-agent-runtime-section" class="ui-advanced-only">
          <div data-testid="new-agent-runtime-profile" class="flds">
            <.native_select
              id="new-agent-runtime-profile-select"
              name="agent[runtime_profile_id]"
              label="Runtime profile"
              help="A profile sets the adapter, command, model and endpoint for you. Pick Custom to set them yourself."
            >
              <option
                :for={profile <- @runtime_profiles}
                value={profile.id}
                data-adapter={profile.adapter || ""}
                selected={profile.id == @selected_runtime_profile_id}
              >
                {profile.name}
              </option>
            </.native_select>

            <div class="hr-pcard">
              <p class="hr-tags">
                <span class="tag">{@runtime_profile.posture}</span>
                <span :if={@runtime_profile.adapter} class="tag">
                  {adapter_label(@runtime_profile.adapter)}
                </span>
                <span :if={runtime_profile_concurrency(@runtime_profile)} class="tag">
                  {slot_label(runtime_profile_concurrency(@runtime_profile))}
                </span>
                <span :if={runtime_profile_capability(@runtime_profile)} class="tag">
                  {runtime_profile_capability(@runtime_profile)}
                </span>
              </p>
              <p class="hr-pname">{@runtime_profile.name}</p>
              <p class="gl-sub">{@runtime_profile.description}</p>
              <p class="hr-pfoot">
                <span class="mono hr-wrap">{runtime_profile_summary(@runtime_profile)}</span>
                <.pill
                  :if={runtime_profile_secret_setup_path(@runtime_profile, @hire_form_path)}
                  navigate={runtime_profile_secret_setup_path(@runtime_profile, @hire_form_path)}
                >
                  Add required key
                </.pill>
              </p>
            </div>
          </div>
        </div>

        <div data-testid="new-agent-adapter-section" class="hr-adapter">
          <div class="flds">
            <.input
              field={@form[:adapter]}
              type="select"
              label="Adapter"
              required
              value={@selected_adapter}
              options={adapter_options()}
              help="Claude Code needs a local CLI. OpenAI-compatible needs an endpoint, model, and key."
            />
          </div>

          <%!-- Panels toggle with the hidden attribute and class (AdapterConfigFields), so
               they carry no class that sets display; their field grid is inside. --%>
          <div data-adapter-panel="codex" hidden={@selected_adapter != "codex"}>
            <div class="flds">
              <.native_select
                id="new-agent-codex-model"
                name="agent[model]"
                label="Codex model"
                help="Passed to the Codex CLI as --model; the command is codex. Stored in agent config."
              >
                <option
                  :for={{label, value} <- codex_model_options(@runtime_model)}
                  value={value}
                  selected={value == @runtime_model}
                >
                  {label}
                </option>
              </.native_select>
              <p class="hr-cmd mono">codex --model {@runtime_model}</p>
            </div>
          </div>

          <div data-adapter-panel="cursor" hidden={@selected_adapter != "cursor"}>
            <div class="flds">
              <.input
                id="new-agent-cursor-command"
                name="agent[runtime_command]"
                label="Cursor command"
                value={@runtime_command || "agent"}
                placeholder="agent"
                class="mono"
              />
              <.native_select id="new-agent-cursor-model" name="agent[model]" label="Cursor model">
                <option
                  :for={{label, value} <- cursor_model_options()}
                  value={value}
                  selected={value == @runtime_model}
                >
                  {label}
                </option>
              </.native_select>
            </div>
          </div>

          <div data-adapter-panel="openclaw" hidden={@selected_adapter != "openclaw"}>
            <div class="flds">
              <.native_select
                id="new-agent-openclaw-provider"
                name="agent[provider]"
                label="Model provider"
              >
                <option
                  :for={{label, value} <- openclaw_provider_options()}
                  value={value}
                  selected={value == @runtime_provider}
                >
                  {label}
                </option>
              </.native_select>
              <.native_select
                id="new-agent-openclaw-model"
                name="agent[model]"
                label="Provider model"
              >
                <option
                  :for={{provider, label, value} <- openclaw_provider_model_options()}
                  value={value}
                  data-provider={provider}
                  hidden={provider != @runtime_provider}
                  disabled={provider != @runtime_provider}
                  selected={provider == @runtime_provider and value == @runtime_model}
                >
                  {label}
                </option>
              </.native_select>
              <.input
                id="new-agent-openclaw-endpoint"
                name="agent[openclaw_endpoint]"
                label="Gateway endpoint"
                value={@openclaw_endpoint}
                placeholder="http://localhost:18789"
                class="mono"
                wrapper_class="full"
              />
              <.native_select
                id="new-agent-openclaw-runtime"
                name="agent[openclaw_runtime]"
                label="Runtime"
              >
                <option value="subagent" selected={@openclaw_runtime == "subagent"}>
                  Subagent
                </option>
                <option value="acp" selected={@openclaw_runtime == "acp"}>ACP harness</option>
              </.native_select>
              <.input
                id="new-agent-openclaw-harness"
                name="agent[openclaw_harness_id]"
                label="Harness id"
                value={@openclaw_harness_id}
                placeholder="codex"
                class="mono"
              />
            </div>
          </div>

          <div data-adapter-panel="openai_chat" hidden={@selected_adapter != "openai_chat"}>
            <div class="flds">
              <.input
                id="new-agent-openai-chat-model"
                name="agent[model]"
                label="Chat model"
                value={@runtime_model}
                placeholder="gemini-3.7-flash"
                class="mono"
              />
              <.input
                id="new-agent-openai-chat-endpoint"
                name="agent[openai_chat_endpoint]"
                label="Chat completions URL"
                value={@openai_chat_endpoint}
                placeholder="https://cli.llmotions.com/v1"
                class="mono"
              />
              <p class="help full">
                Calls an OpenAI-compatible chat completions provider. Keep API keys in Secrets.
              </p>
            </div>
          </div>

          <div data-adapter-panel="process" hidden={@selected_adapter != "process"}>
            <div class="flds">
              <.native_select
                id="new-agent-process-preset"
                name="agent[process_preset]"
                label="Process preset"
              >
                <option
                  :for={{label, value} <- process_preset_options()}
                  value={value}
                  selected={value == @process_preset}
                >
                  {label}
                </option>
              </.native_select>
              <.native_select
                id="new-agent-process-provider"
                name="agent[provider]"
                label="Provider family"
              >
                <option
                  :for={{label, value} <- process_provider_options()}
                  value={value}
                  selected={value == @runtime_provider}
                >
                  {label}
                </option>
              </.native_select>
              <.native_select id="new-agent-process-model" name="agent[model]" label="Model">
                <option
                  :for={{provider, label, value} <- process_provider_model_options()}
                  value={value}
                  data-provider={provider}
                  hidden={provider != @runtime_provider}
                  disabled={provider != @runtime_provider}
                  selected={provider == @runtime_provider and value == @runtime_model}
                >
                  {label}
                </option>
              </.native_select>
              <.input
                id="new-agent-process-command"
                name="agent[runtime_command]"
                label="Command"
                value={@runtime_command}
                placeholder="codex"
                class="mono"
              />
            </div>
          </div>
        </div>
      </.band_card>

      <.band_card
        id="hr-guide-t"
        title="Instructions"
        class="ui-advanced-only"
        data-testid="new-agent-guide-section"
      >
        <div class="flds">
          <.input
            field={@form[:instructions]}
            label="Instructions"
            type="textarea"
            rows={16}
            placeholder="Describe the agent's responsibilities, constraints, and working style."
            help="The role already sets the working defaults. Add rules here only if your company needs them."
            wrapper_class="full"
          />
          <.input
            id="new-agent-env-text"
            name="agent[env_text]"
            label="Environment variables"
            type="textarea"
            rows={4}
            value={@env_text}
            placeholder={
              ~s(ANTHROPIC_BASE_URL=https://api.anthropic.com\nANTHROPIC_AUTH_TOKEN=...)
            }
            help="One KEY=VALUE per line, passed to the adapter when it runs. Put API keys in Secrets instead — a secret with the same name wins."
            class="mono"
            wrapper_class="full"
          />
        </div>
      </.band_card>

      <:effect>
        <%= cond do %>
          <% @pending_approval_id -> %>
            <.ink_note>
              Agent hire requires board approval. A request has been submitted and is pending review.
            </.ink_note>
          <% @hire_readiness.status == :needs_key -> %>
            <div data-testid="new-agent-hire-gate">
              <.ink_note>{@hire_readiness.summary}</.ink_note>
            </div>
          <% true -> %>
            <.consequences rows={[{:done, hire_help(@hire_readiness)}]} />
        <% end %>
      </:effect>
      <:secondary>
        <%= cond do %>
          <% @pending_approval_id -> %>
            <.ghost_pill navigate={~p"/board-approvals/#{@pending_approval_id}"}>
              View approval request
            </.ghost_pill>
          <% @hire_readiness.status == :needs_key and @hire_readiness.setup_path -> %>
            <.ghost_pill navigate={@hire_readiness.setup_path}>
              Add {@hire_readiness.primary_key}
            </.ghost_pill>
          <% @hire_readiness.status == :needs_key -> %>
          <% true -> %>
            <.ghost_pill navigate={~p"/agents"}>Cancel</.ghost_pill>
        <% end %>
      </:secondary>
      <:primary>
        <.primary_pill
          type="submit"
          title={hire_help(@hire_readiness)}
          disabled={not @hire_readiness.can_hire}
          phx-disable-with="Hiring…"
          data-testid="new-agent-hire-button"
        >
          Hire {role_label(role_value(@form))}<span class="sr"> — {hire_help(@hire_readiness)}</span>
        </.primary_pill>
      </:primary>
    </.form_pair>
  </div>
</.page_frame>
