<.page_frame
  page="remote"
  kind={:deep}
  parent={{"/agents", "Team"}}
  current="Remote agents"
  data-ui-complex-page
>
  <:head>
    <section class="head" aria-labelledby="rm-h">
      <h1 class="h1 big" id="rm-h">Remote agents</h1>
      <p class="sub">Browse Agrenting marketplace agents and connect them as Cympho operators.</p>
      <div class="chips">
        <.pill phx-click="refresh">Refresh</.pill>
      </div>
    </section>
  </:head>

  <.flash_line flash={@flash} />

  <section :if={@integration_status == :not_configured} class="card">
    <.quiet_empty title="Connect Agrenting first">
      Agrenting is not connected. Connect it in company integrations, then marketplace agents
      will appear here.
      <:action>
        <.pill navigate={~p"/settings/integrations"}>Open Integrations</.pill>
      </:action>
    </.quiet_empty>
  </section>

  <p :if={@integration_status == :error} class="err" role="alert">
    <.r3_icon name="i-alert" />{@error_message}
  </p>

  <form
    :if={@integration_status in [:ready, :checking]}
    id="remote-search"
    phx-change="search"
    class="tbar"
  >
    <div class="tbar-f">
      <.search_capsule
        label="Search remote agents"
        name="filters[query]"
        value={@query}
        placeholder="Search agents, agent IDs, models, capabilities"
      />
    </div>
    <.select_menu
      id="remote-capability"
      name="filters[capability]"
      value={@capability}
      options={@capability_options}
      placeholder="All capabilities"
      label="Capability"
      class="rm-cap"
    />
  </form>

  <.band_card
    :if={@integration_status in [:ready, :checking]}
    id="rm-list-t"
    title="Marketplace agents"
  >
    <:header_end>
      <span :if={!@loading? and @remote_agents != []} class="meta mono">
        {length(@remote_agents)}
      </span>
    </:header_end>
    <p :if={@loading?} class="gl-sub rm-line" role="status">Loading…</p>

    <.quiet_empty
      :if={!@loading? and @remote_agents == []}
      title="No remote agents match"
    >
      Nothing is wrong — try a broader search or switch the capability filter.
    </.quiet_empty>

    <ul :if={!@loading? and @remote_agents != []} class="rows">
      <.list_row
        :for={agent <- @remote_agents}
        id={"remote-agent-#{agent["did"]}"}
        title={agent["name"] || agent["did"]}
        icon="i-team"
        status={remote_status(@hired_remote_dids, agent)}
      >
        <:meta>
          <%= for {part, n} <- Enum.with_index(remote_meta_parts(agent)) do %>
            <span :if={n > 0} aria-hidden="true"> · </span>{part}
          <% end %>
        </:meta>
        <:below :if={!hired_remote_agent?(@hired_remote_dids, agent)}>
          <details
            id={"remote-hire-#{agent["did"]}"}
            class="earlier"
            phx-mounted={JS.ignore_attributes("open")}
          >
            <summary>
              Hire<span class="sr"> {agent["name"] || agent["did"]}</span><.r3_icon name="i-chev-down" />
            </summary>
            <form
              id={"remote-hire-form-#{agent["did"]}"}
              phx-submit="hire_agent"
              class="rm-hire"
            >
              <input type="hidden" name="agent_did" value={agent["did"]} />
              <p class="gl-sub">
                Agent ID <span class="mono hr-wrap">{agent["did"]}</span>. Hiring uses sensible
                defaults — change these only to override them.
              </p>
              <div class="flds">
                <.input
                  type="select"
                  id={"remote-hire-#{agent["did"]}-capability"}
                  name="capability"
                  label="Capability"
                  options={capability_select_options(agent)}
                />
                <.input
                  type="select"
                  id={"remote-hire-#{agent["did"]}-role"}
                  name="role"
                  label="Cympho role"
                  options={role_options()}
                />
                <.input
                  id={"remote-hire-#{agent["did"]}-max-price"}
                  name="max_price"
                  label="Max price"
                  value={agent["base_price"] || ""}
                />
                <.input
                  type="select"
                  id={"remote-hire-#{agent["did"]}-delivery"}
                  name="delivery_mode"
                  label="Delivery"
                  options={delivery_options()}
                />
              </div>
              <div class="rm-go">
                <.pill type="submit">Hire in Cympho</.pill>
              </div>
            </form>
          </details>
        </:below>
      </.list_row>
    </ul>
  </.band_card>
</.page_frame>
