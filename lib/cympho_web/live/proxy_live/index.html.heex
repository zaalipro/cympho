<.settings_layout active={:proxies}>
  <.flash_line flash={@flash} />
  <p :if={@proxy_action_error} class="err" role="alert" data-testid="proxy-action-error">
    <.r3_icon name="i-alert" />{@proxy_action_error}
  </p>

  <%!-- Chrome treats any text input preceding a password as the username of a
       login form, so every text field ahead of the password below opts out. --%>
  <.form_pair
    :if={@show_form and @can_manage_proxies}
    id="proxy-profile-form"
    for={@form}
    phx-submit="save"
    heading={if @form_mode == :edit, do: "After you save", else: "After you add it"}
    verb={if @form_mode == :edit, do: "save", else: "add"}
    data-testid="proxy-profile-form"
  >
    <.band_card
      id="pf-t"
      title={if @form_mode == :edit, do: "Edit #{@selected_proxy.name}", else: "New proxy"}
    >
      <div class="flds">
        <.input
          field={@form[:name]}
          label="Profile name"
          placeholder="managed-egress-a"
          autocomplete="off"
        />
        <.input
          field={@form[:proxy_type]}
          type="select"
          label="Type"
          options={proxy_type_options()}
        />
        <.input
          field={@form[:proxy_url]}
          label="Proxy URL"
          placeholder="socks5://user:password@proxy.example.com:1080"
          autocomplete="off"
          wrapper_class="full"
        />
        <.input
          field={@form[:host]}
          label="Host"
          placeholder="proxy.example.com"
          autocomplete="off"
        />
        <.input field={@form[:port]} type="number" label="Port" placeholder="1080" />
        <.input
          field={@form[:username]}
          label="Username"
          placeholder="optional"
          autocomplete="off"
        />
        <.input
          field={@form[:password]}
          type="password"
          label="Password"
          autocomplete="new-password"
          placeholder={
            if @selected_proxy && has_password?(@selected_proxy),
              do: "Leave blank to keep current password",
              else: "optional"
          }
        />
        <.input
          field={@form[:description]}
          type="textarea"
          rows={2}
          label="Description"
          placeholder="Region, provider, or expected use."
          wrapper_class="full"
        />
      </div>
    </.band_card>
    <:effect>
      <.ink_note>
        {if @form_mode == :edit,
          do: "Updates the profile; a blank password keeps the current one.",
          else:
            "Saves it for this company. Nothing connects until you test it or pick it for a swarm."}
      </.ink_note>
    </:effect>
    <:secondary>
      <.ghost_pill phx-click="hide_form">Cancel</.ghost_pill>
    </:secondary>
    <:primary>
      <.primary_pill type="submit" phx-disable-with="Saving…">
        {if @form_mode == :edit, do: "Save proxy", else: "Create proxy"}
      </.primary_pill>
    </:primary>
  </.form_pair>

  <% stats = profile_stats(@proxy_profiles) %>
  <.band_card id="px-t" title="Network proxies">
    <:header_end>
      <span :if={stats.total > 0} class="meta">
        {stats.total} {if stats.total == 1, do: "profile", else: "profiles"}<span :if={
          stats.online > 0
        }><span aria-hidden="true"> · </span>{stats.online} online</span>
      </span>
      <%!-- While the list is empty its quiet line carries the one Add control. --%>
      <.pill
        :if={@can_manage_proxies and !@show_form and stats.total > 0}
        phx-click="show_create_form"
      >
        <.r3_icon name="i-plus" />Add proxy
      </.pill>
    </:header_end>

    <ul :if={@proxy_profiles != []} class="rows">
      <.list_row
        :for={proxy <- @proxy_profiles}
        id={"proxy-#{proxy.id}"}
        data-testid={"proxy-profile-#{proxy.id}"}
        icon="i-external"
        kind={if proxy.last_status == "offline", do: :problem, else: :neutral}
        title={proxy.name}
        status={proxy_status(proxy.last_status)}
      >
        <:meta>
          <span class="mono">{proxy.proxy_type}://{proxy.host}:{proxy.port}</span><span :if={
            ping_label(proxy)
          }><span aria-hidden="true"> · </span><span class="mono">{ping_label(proxy)}</span></span><span :if={
            proxy.last_checked_at
          }><span aria-hidden="true"> · </span>checked {checked_label(proxy)}</span><span :if={
            proxy.username || has_password?(proxy)
          }><span aria-hidden="true"> · </span>Has credentials</span>
        </:meta>
        <:actions :if={@can_manage_proxies}>
          <.pill phx-click="test" phx-value-id={proxy.id}>Test</.pill>
          <.pill phx-click="show_edit_form" phx-value-id={proxy.id}>Edit</.pill>
          <button
            type="button"
            class="pl warn"
            phx-click="delete"
            phx-value-id={proxy.id}
            data-confirm="Remove this proxy profile?"
          >
            Remove
          </button>
        </:actions>
        <:below :if={proxy.description || proxy.last_error}>
          <p :if={proxy.description} class="rm">{proxy.description}</p>
          <p :if={proxy.last_error} class="err">
            <.r3_icon name="i-alert" />{proxy.last_error}
          </p>
        </:below>
      </.list_row>
    </ul>

    <.quiet_empty :if={@proxy_profiles == []} title="No proxy profiles yet">
      <span class="ui-advanced-only">
        Add HTTP, HTTPS, SOCKS4, or SOCKS5 profiles here, then choose random or selected proxies from the swarm panel.
      </span>
      <span class="ui-simple-only">
        Most teams never need one. Add one if agent traffic has to leave through a specific network.
      </span>
      <:action>
        <.pill :if={@can_manage_proxies and !@show_form} phx-click="show_create_form">
          <.r3_icon name="i-plus" />Add proxy
        </.pill>
      </:action>
    </.quiet_empty>

    <p :if={!@can_manage_proxies} class="cfoot" data-testid="proxy-profiles-read-only">
      <span>
        Proxy profiles can contain private routing credentials. Ask a company admin or board member to manage them.
      </span>
    </p>
  </.band_card>
</.settings_layout>
