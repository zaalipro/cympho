<.page_frame
  page="task-new"
  kind={:deep}
  parent={{"/issues", "Tasks"}}
  current="New task"
  data-ui-complex-page
>
  <:head>
    <section class="head" aria-labelledby="tn-h">
      <h1 class="h1 big" id="tn-h">New task</h1>
      <p class="sub">What should the team do?</p>
    </section>
  </:head>

  <.flash_line flash={@flash} />

  <% queue_focus_disabled? =
    queue_focus_disabled?(@brief_readiness) or swarm_enabled?(@swarm_config) %>
  <% queue_focus_checked? = queue_focus_checked?(@brief_readiness, @queue_dispatch_focus?) %>
  <% ceo_missing? = @intake_route && @intake_route[:missing?] %>

  <.form_pair
    id="issue-form"
    for={@form}
    phx-change="validate"
    phx-submit="save"
    heading="After you create it"
    verb="create"
  >
    <.band_card id="tn-task-t" title="Task">
      <div class="flds">
        <.input
          field={@form[:title]}
          label="Title"
          required
          placeholder="The outcome, in one sentence"
          wrapper_class="full"
        />
        <.input
          field={@form[:description]}
          label="Details"
          type="textarea"
          rows={8}
          placeholder={@description_placeholder}
          wrapper_class="full"
        />
        <p class="ui-advanced-only help full" data-testid="issue-brief-readiness">
          {@brief_readiness.label}<span aria-hidden="true"> · </span>
          <span class="mono">
            {@brief_readiness.passed_count}/{@brief_readiness.total}
          </span>
          <span :if={@brief_readiness.status != :ready}>
            <span aria-hidden="true"> · </span>{@brief_readiness.next_prompt}
          </span>
        </p>
        <span :if={@brief_readiness.status != :ready} class="ui-advanced-only full tn-tpl">
          <.pill phx-click="use_launch_scaffold">Use a structured template</.pill>
        </span>
      </div>
      <div class="tn-mode" data-testid="issue-work-mode">
        <.option_rows
          name={@form[:work_mode].name}
          legend="How should the team begin?"
          own={false}
          checked={to_string(@form[:work_mode].value || :standard)}
          items={work_mode_items()}
        />
        <%!-- The full contract stays with screen readers in Advanced instead of
             printing legalese under every option. --%>
        <ul class="ui-advanced-only sr">
          <li :for={{label, _value, _help, contract} <- work_mode_options()}>
            {label}: {contract}
          </li>
        </ul>
      </div>
    </.band_card>

    <details id="issue-new-more" class="card tech" phx-mounted={JS.ignore_attributes("open")}>
      <summary>
        <span class="h2">Options</span> <.r3_icon name="i-chev-down" />
      </summary>
      <div class="flds">
        <.input
          :if={!Enum.empty?(@goals)}
          field={@form[:goal_id]}
          type="select"
          label="Goal"
          options={goal_options(@goals)}
        />
        <.input
          :if={!Enum.empty?(@projects)}
          field={@form[:project_id]}
          type="select"
          label="Project"
          required
          options={project_options(@projects)}
        />
        <.input field={@form[:due_on]} type="date" label="Due date" />
        <div class="ui-advanced-only">
          <.input
            field={@form[:status]}
            type="select"
            label="Status"
            required
            options={status_options()}
          />
        </div>
        <div class="ui-advanced-only">
          <.input
            field={@form[:priority]}
            type="select"
            label="Priority"
            required
            options={priority_options()}
          />
        </div>
        <div :if={@swarm_admin?} data-testid="issue-swarm-controls" class="ui-advanced-only full">
          <label class="fld-ck" for="issue-swarm-enabled">
            <input
              id="issue-swarm-enabled"
              type="checkbox"
              name="swarm[enabled]"
              value="true"
              checked={swarm_enabled?(@swarm_config)}
            />
            <span>Use swarm</span>
            <span class="help mono">{swarm_count(@swarm_config)} workers</span>
          </label>

          <.swarm_configuration
            :if={swarm_enabled?(@swarm_config)}
            id="issue-swarm-advanced-panel"
            title="Swarm setup"
            description="Choose the worker mix."
            swarm_params={@swarm_params}
            swarm_config={@swarm_config}
            proxy_profiles={@proxy_profiles}
            compact={true}
            class="mt-4"
          />
        </div>
      </div>
    </details>

    <:effect>
      <.ink_note :if={ceo_missing?}>Add a CEO agent before this task can run.</.ink_note>
      <.consequences
        :if={!ceo_missing?}
        rows={[
          {:done,
           "Cympho gives it to an agent with the right role, or keeps it in Later if nobody is free."}
        ]}
      />
      <%!-- What pressing the primary does depends on this box, so it sits on the
           resolution card beside it. --%>
      <div :if={!ceo_missing? && !swarm_enabled?(@swarm_config)} class="fld">
        <label class="fld-ck" for="queue-dispatch-focus">
          <input type="hidden" name="queue_dispatch_focus" value="false" />
          <input
            id="queue-dispatch-focus"
            type="checkbox"
            name="queue_dispatch_focus"
            value="true"
            checked={queue_focus_checked?}
            disabled={queue_focus_disabled?}
            aria-describedby={queue_focus_disabled? && "queue-dispatch-focus-help"}
          />
          <span>
            <span class="ui-advanced-only">Queue after creating</span><span class="ui-simple-only">Start right away</span>
          </span>
        </label>
        <p :if={queue_focus_disabled?} class="help" id="queue-dispatch-focus-help">
          <span class="ui-advanced-only">Add enough detail to make the brief ready.</span>
          <%!-- Simple mode hides the readiness line that names the missing
               signal, so say it here instead of only "write more". --%>
          <span class="ui-simple-only">
            Write a bit more first.
            <span :if={@brief_readiness.status != :ready}>{@brief_readiness.next_prompt}</span>
          </span>
        </p>
      </div>
    </:effect>
    <:secondary>
      <.ghost_pill :if={ceo_missing?} navigate={~p"/agents/new"}>Add CEO agent</.ghost_pill>
      <.ghost_pill :if={!ceo_missing?} navigate={~p"/issues"}>Cancel</.ghost_pill>
    </:secondary>
    <:primary>
      <.primary_pill type="submit" phx-disable-with="Creating…">
        {submit_label(@brief_readiness, @queue_dispatch_focus?, @intake_route, @swarm_config)}
      </.primary_pill>
    </:primary>
  </.form_pair>
</.page_frame>
