<% issue_preflight = issue_preflight(@issue, @orchestrator_enabled?) %>
<% gate_resolution = review_gate_resolution(assigns) %>
<% v = Task.view(assigns, gate_resolution.actions) %>
<% reply_id = "reply-#{@reply_n}" %>

<.page_frame
  page="task"
  kind={:deep}
  parent={{~p"/issues", "Tasks"}}
  current={@issue.identifier || "##{@issue.issue_number}"}
  current_mono
  from={@from}
  tray_class="split"
  id="issue-show"
  data-ui-complex-page
  data-clean-url={@gate_clean_url}
>
  <:head>
    <CymphoWeb.IssueLive.Show.Header.header
      issue={@issue}
      v={v}
      editing={@editing}
      all_agents={@all_agents}
      description_draft={@description_draft}
      delivery_brief_readiness={delivery_brief_readiness(@issue, issue_preflight)}
      flash={@flash}
    />
  </:head>

  <%!-- The Next step for this task's state: answer, review, retry, reopen or all clear. --%>
  <Task.task_next
    issue={@issue}
    v={v}
    item={@task_item}
    review_changes={@review_changes}
    reply_id={reply_id}
  />
  <Task.task_details issue={@issue} v={v} cost={@task_cost} mobile />
  <Task.task_thread issue={@issue} v={v} reply_id={reply_id} />
  <Task.task_deliverables
    v={v}
    issue={@issue}
    gate_actions={gate_resolution.actions}
    open_form={@show_work_product_form or @show_pr_form}
  >
    <%!-- Simple-mode forms for attach-proof / set-PR (Advanced uses the review-gate panel).
         Distinct input ids so the Simple and Advanced forms can coexist in the DOM. --%>
    <section
      :if={@show_work_product_form}
      id="issue-simple-work-product-form"
      data-testid="issue-simple-work-product-form"
      class="ui-simple-only dl-form"
    >
      <h3 class="h2">Attach proof</h3>
      <p class="help">Add a deliverable, spec, or URL so reviewers can see what changed.</p>
      <form
        id="simple-work-product-form"
        phx-submit="attach_work_product"
        class="grid gap-3 sm:grid-cols-[1fr_180px]"
      >
        <div>
          <label
            for="simple-work-product-title"
            class="mb-1 block text-xs font-510 text-text-secondary"
          >
            Title
          </label>
          <input
            id="simple-work-product-title"
            type="text"
            name="work_product[title]"
            value={@work_product_form[:title].value || ""}
            placeholder="Short evidence title"
            required
            class="w-full rounded-lg border border-border bg-surface px-3 py-2 text-sm text-text-primary placeholder:text-text-quaternary focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/30"
          />
        </div>
        <div>
          <label
            for="simple-work-product-kind"
            class="mb-1 block text-xs font-510 text-text-secondary"
          >
            Kind
          </label>
          <select
            id="simple-work-product-kind"
            name="work_product[kind]"
            required
            class="w-full rounded-lg border border-border bg-surface px-3 py-2 text-sm text-text-primary focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/30"
          >
            <option
              :for={{label, value} <- work_product_kind_options()}
              value={value}
              selected={to_string(@work_product_form[:kind].value || "document") == value}
            >
              {label}
            </option>
          </select>
        </div>
        <div class="sm:col-span-2">
          <label
            for="simple-work-product-url"
            class="mb-1 block text-xs font-510 text-text-secondary"
          >
            URL
          </label>
          <input
            id="simple-work-product-url"
            type="url"
            name="work_product[url]"
            value={@work_product_form[:url].value || ""}
            placeholder="https://github.com/org/repo/pull/123"
            class="w-full rounded-lg border border-border bg-surface px-3 py-2 text-sm text-text-primary placeholder:text-text-quaternary focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/30"
          />
        </div>
        <div class="sm:col-span-2">
          <label
            for="simple-work-product-description"
            class="mb-1 block text-xs font-510 text-text-secondary"
          >
            Description
          </label>
          <textarea
            id="simple-work-product-description"
            name="work_product[description]"
            rows="3"
            placeholder="What this proves and what a reviewer should inspect."
            class="w-full rounded-lg border border-border bg-surface px-3 py-2 text-sm text-text-primary placeholder:text-text-quaternary focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/30"
          >{@work_product_form[:description].value || ""}</textarea>
        </div>
        <div class="sm:col-span-2 flex flex-wrap items-center gap-2">
          <.pill type="submit">Attach proof</.pill>
          <.pill phx-click="cancel_work_product">Cancel</.pill>
        </div>
      </form>
    </section>

    <section
      :if={@show_pr_form}
      id="issue-simple-pr-form"
      data-testid="issue-simple-pr-form"
      class="ui-simple-only dl-form"
    >
      <h3 class="h2">Set PR</h3>
      <p class="help">Paste the pull request URL so proof links open the right change.</p>
      <form id="simple-pr-form" phx-submit="set_github_pr_url" class="space-y-3">
        <div>
          <label for="simple-pr-url" class="mb-1 block text-xs font-510 text-text-secondary">
            PR URL
          </label>
          <input
            id="simple-pr-url"
            type="url"
            name="url"
            value={@issue.github_pr_url || ""}
            placeholder="https://github.com/org/repo/pull/123"
            required
            class="w-full rounded-lg border border-border bg-surface px-3 py-2 text-sm text-text-primary transition-colors placeholder:text-text-quaternary focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/30"
          />
        </div>
        <div class="flex flex-wrap items-center gap-2">
          <.pill type="submit">Save PR</.pill>
          <.pill phx-click="cancel_pr_form">Cancel</.pill>
        </div>
      </form>
    </section>
  </Task.task_deliverables>
  <Task.task_runs v={v} />
  <Task.task_details issue={@issue} v={v} cost={@task_cost} />

  <div :if={@child_tree != []} class="card subtasks">
    <CymphoWeb.IssueLive.Show.ChildIssues.child_issues
      child_tree={@child_tree}
      child_health_cards={@child_health_cards}
    />
  </div>

  <%!-- Advanced: the operator panels and the old metadata sidebar, unchanged below the r3 page. --%>
  <div class="ui-advanced-only card task-adv">
    <div class="flex flex-col lg:flex-row">
      <div class="flex-1 flex flex-col min-w-0">
        <CymphoWeb.IssueLive.Show.Header.status_digest
          issue={@issue}
          timeline={@timeline}
          gate_resolution={gate_resolution}
        />
        <CymphoWeb.IssueLive.Show.ProgressPanel.run_progress progress={@run_progress} />

        <CymphoWeb.IssueLive.Show.SwarmPanel.swarm_panel
          issue={@issue}
          child_tree={@child_tree}
          swarm_events={@swarm_events}
        />

        <CymphoWeb.IssueLive.Show.Description.description
          :if={@editing != "description"}
          issue={@issue}
          editing={@editing}
          description_draft={@description_draft}
          delivery_brief_readiness={delivery_brief_readiness(@issue, issue_preflight)}
        />

        <.issue_digest_panel
          issue={@issue}
          runs={@runs}
          work_products={@work_products}
          child_issues={@child_issues}
          agents={@all_agents}
          review_gate_actions={gate_resolution.actions}
          review_nudges={gate_resolution.nudges}
        />

        <CymphoWeb.IssueLive.Show.ReviewGates.review_gates
          issue={@issue}
          runs={@runs}
          work_products={@work_products}
          child_issues={@child_issues}
          all_agents={@all_agents}
          orchestrator_enabled?={@orchestrator_enabled?}
          show_work_product_form={@show_work_product_form}
          work_product_form={@work_product_form}
          hoisted_state_label={gate_resolution.digest_label}
        />

        <CymphoWeb.IssueLive.Show.ExecutionBrief.execution_brief
          issue={@issue}
          runs={@runs}
          run_history={@run_history}
          pending_wake={@pending_wake}
          work_products={@work_products}
          child_issues={@child_issues}
          tool_call_traces={@tool_call_traces}
          all_agents={@all_agents}
          child_health_cards={@child_health_cards}
          orchestrator_enabled?={@orchestrator_enabled?}
        />

        <CymphoWeb.IssueLive.Show.ActivityTimeline.activity_timeline
          timeline={@timeline}
          timeline_filter={@timeline_filter}
          all_agents={@all_agents}
          comment_authors={@comment_authors}
        />

        <CymphoWeb.IssueLive.Show.Comments.comments
          comment_form={@comment_form}
          comment_templates={@comment_templates}
        />
      </div>

      <CymphoWeb.IssueLive.Show.Sidebar.sidebar
        issue={@issue}
        runs={@runs}
        all_agents={@all_agents}
        orchestrator_enabled?={@orchestrator_enabled?}
        show_agent_panel={@show_agent_panel}
        agents={@agents}
        documents={@documents}
        issue_preflight={issue_preflight}
      />
    </div>
  </div>
</.page_frame>
