<div class="ember-aurora p-6 lg:p-8 max-w-5xl mx-auto">
  <div class="relative z-[1]">
    <div class="mb-8 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
      <div class="min-w-0">
        <span class="ember-eyebrow">Assigned to you</span>
        <h1 class="ember-ink mt-4 font-serif text-[clamp(30px,4.5vw,44px)] font-510 leading-[1.08] tracking-[-0.02em]">
          My Issues
        </h1>
      </div>
      <.app_link
        navigate={~p"/issues/new"}
        class="cta-glow bg-brand hover:bg-brand/90 text-on-primary font-510 text-sm px-4 py-2 rounded-button transition-colors"
      >
        New Issue
      </.app_link>
    </div>

    <div class="flex items-center gap-1 mb-6 bg-surface border border-border rounded-xl p-1">
      <button
        phx-click="switch_tab"
        phx-value-tab="active"
        class={"flex-1 text-sm font-510 px-3 py-2 rounded-lg transition-colors duration-200 #{tab_active?("active", @current_tab)}"}
      >
        Active
      </button>
      <button
        phx-click="switch_tab"
        phx-value-tab="watching"
        class={"flex-1 text-sm font-510 px-3 py-2 rounded-lg transition-colors duration-200 #{tab_active?("watching", @current_tab)}"}
      >
        Watching
      </button>
      <button
        phx-click="switch_tab"
        phx-value-tab="all"
        class={"flex-1 text-sm font-510 px-3 py-2 rounded-lg transition-colors duration-200 #{tab_active?("all", @current_tab)}"}
      >
        All
      </button>
    </div>

    <.infinite_scroll
      id="issues"
      has_more={@infinite_scroll[:issues][:has_more?] || false}
      container_class="space-y-2"
    >
      <:empty>
        <div class="text-center py-16">
          <p class="font-serif text-lg text-text-secondary">Nothing on your plate.</p>
          <p class="mt-1 text-sm text-text-tertiary">
            Issues assigned to you or watched by you will land here.
          </p>
        </div>
      </:empty>

      <div
        :for={{dom_id, issue} <- @streams.issues}
        id={dom_id}
        class="bg-surface border border-border rounded-xl p-4 transition-[background-color,box-shadow,border-color] duration-200 hover:bg-subtle hover:border-border-hover hover:shadow-[inset_2px_0_0_0_var(--color-primary)]"
      >
        <.link navigate={~p"/issues/#{issue.id}"} class="block">
          <div class="flex items-start gap-3">
            <span class={"mt-1.5 w-2.5 h-2.5 rounded-full flex-shrink-0 #{status_color(issue.status)}"}>
            </span>
            <div class="flex-1 min-w-0">
              <div class="flex items-center gap-2">
                <span :if={issue.identifier} class="text-xs text-text-quaternary font-mono">
                  {issue.identifier}
                </span>
                <h3 class="font-serif text-sm font-510 text-text-primary truncate">
                  {issue.title}
                </h3>
              </div>
              <div class="flex items-center gap-3 mt-1.5">
                <span class={"text-xs #{priority_color(issue.priority)}"}>
                  {issue.priority |> to_string() |> String.capitalize()}
                </span>
                <span class="text-xs text-text-quaternary">
                  {issue.status |> to_string() |> String.replace("_", " ") |> String.capitalize()}
                </span>
                <span :if={issue.assignee} class="text-xs text-text-quaternary">
                  {issue.assignee.name}
                </span>
                <span :if={issue.project} class="text-xs text-text-quaternary">
                  {issue.project.name}
                </span>
              </div>
            </div>
            <span class="text-xs text-text-quaternary flex-shrink-0">
              {Calendar.strftime(issue.updated_at, "%b %d")}
            </span>
          </div>
        </.link>
      </div>
    </.infinite_scroll>
  </div>
</div>
