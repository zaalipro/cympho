<.page_frame page="mine" title="Tasks" data-ui-complex-page>
  <:aside>Mine</:aside>
  <:header_end>
    <%!-- Mine is on: pressing it again shows every task. --%>
    <.link class="chip mine" navigate={~p"/issues"} aria-current="page">Mine</.link>
  </:header_end>

  <.segmented label="Which tasks">
    <:item
      :for={{tab, label} <- tabs()}
      patch={~p"/my-issues?tab=#{tab}"}
      current={@current_tab == tab}
    >
      {label}
    </:item>
  </.segmented>

  <.infinite_scroll
    id="issues"
    has_more={@infinite_scroll[:issues][:has_more?] || false}
    container_class="rows trows"
  >
    <:empty>
      <.quiet_empty title="Nothing on your plate.">
        Tasks you created, or that your team is working on, land here.
      </.quiet_empty>
    </:empty>

    <div :for={{dom_id, issue} <- @streams.issues} id={dom_id} class="row tr">
      <% {kind, word} = status_state(issue.status) %>
      <span class="tg"><.status_glyph kind={kind} /></span>
      <span class="tid mono">{issue.identifier}</span>
      <span class="row-main">
        <.link class="rt2" navigate={~p"/issues/#{issue.id}?from=/my-issues"}>
          {issue.title}
        </.link>
        <span class="rm">
          {word}<span :if={issue.assignee}><span aria-hidden="true"> · </span>{issue.assignee.name}</span>
          <span :if={@multiple_projects? and issue.project}>
            <span aria-hidden="true"> · </span>{issue.project.name}
          </span>
          <span aria-hidden="true"> · </span><span class="mono">{Calendar.strftime(issue.updated_at, "%a %-d %b")}</span>
        </span>
      </span>
      <CymphoWeb.IssueLive.Tasks.priority priority={issue.priority} />
    </div>
  </.infinite_scroll>
</.page_frame>
