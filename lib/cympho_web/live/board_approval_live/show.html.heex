<.page_frame
  page="board-vote"
  kind={:deep}
  parent={{"/inbox", "Inbox"}}
  current={@approval.title}
  from={@from}
  data-ui-complex-page
>
  <:head>
    <div class="head">
      <h1 class="h1 big">{@approval.title}</h1>
      <p class="sub">
        Board decision · {category_label(@approval.category)} · Filed {format_datetime(
          @approval.inserted_at
        )}
      </p>
      <div class="chips">
        <span class={"inline-flex items-center rounded-lg border px-3 py-1.5 text-xs font-590 tracking-wide #{status_badge(@approval.status)}"}>
          {String.upcase(@approval.status)}
        </span>
      </div>
    </div>
  </:head>

  <div class="space-y-6">
    <section data-testid="governance-risk-brief" class="ember-glass overflow-hidden">
      <div class="flex flex-col gap-4 p-6 sm:flex-row sm:items-start sm:justify-between">
        <div class="min-w-0">
          <div class="flex flex-wrap items-center gap-2">
            <h3 class="font-serif text-[13px] font-510 italic tracking-[0.02em] text-brand/90">
              Governance Risk Brief
            </h3>
            <span class={"rounded-full border px-2.5 py-1 text-[12px] font-510 #{risk_badge(@governance_risk.level)}"}>
              {@governance_risk.label}
            </span>
          </div>
          <p class="mt-2 max-w-2xl text-[15px] leading-6 text-text-secondary">
            {@governance_risk.summary}
          </p>
          <p class="mt-3 inline-flex items-center gap-2 rounded-lg border border-brand/20 bg-brand/[0.06] px-3 py-1.5 text-xs font-510 text-text-primary">
            <span class="hero-arrow-right-mini h-3.5 w-3.5 text-brand"></span>
            {@governance_risk.next_action}
          </p>
        </div>

        <div class="grid shrink-0 grid-cols-2 gap-px overflow-hidden rounded-xl border border-hairline bg-hairline sm:min-w-[260px]">
          <div class="ember-stat bg-panel px-4 py-3 text-center">
            <p class="font-serif text-[26px] font-590 leading-tight text-emerald-300 tabular-nums">
              {@governance_risk.metrics.approve_votes}
            </p>
            <p class="mt-1.5 text-[12px] font-590 uppercase tracking-[0.1em] text-text-quaternary">
              Approve
            </p>
          </div>
          <div class="ember-stat bg-panel px-4 py-3 text-center">
            <p class="font-serif text-[26px] font-590 leading-tight text-red-300 tabular-nums">
              {@governance_risk.metrics.deny_votes}
            </p>
            <p class="mt-1.5 text-[12px] font-590 uppercase tracking-[0.1em] text-text-quaternary">
              Deny
            </p>
          </div>
          <div class="ember-stat bg-panel px-4 py-3 text-center">
            <p class="font-serif text-[26px] font-590 leading-tight text-amber-300 tabular-nums">
              {@governance_risk.metrics.missing_votes}
            </p>
            <p class="mt-1.5 text-[12px] font-590 uppercase tracking-[0.1em] text-text-quaternary">
              Missing
            </p>
          </div>
          <div class="ember-stat bg-panel px-4 py-3 text-center">
            <p class="font-serif text-[26px] font-590 leading-tight text-blue-300 tabular-nums">
              {@governance_risk.metrics.audit_events}
            </p>
            <p class="mt-1.5 text-[12px] font-590 uppercase tracking-[0.1em] text-text-quaternary">
              Audit
            </p>
          </div>
        </div>
      </div>

      <div class="ui-advanced-only grid gap-2 border-t border-hairline px-6 py-4 lg:grid-cols-2">
        <div
          :for={signal <- @governance_risk.signals}
          class={"rounded-lg border px-3 py-2.5 #{signal_class(signal.tone)}"}
        >
          <p class="text-[12px] font-590 uppercase tracking-[0.1em]">
            {signal.label}
          </p>
          <p class="mt-1 text-xs leading-5 opacity-85">
            {signal.detail}
          </p>
        </div>
      </div>
    </section>

    <div class="card-lift rounded-xl border border-border bg-panel p-6 shadow-card">
      <h3 class="font-serif text-[13px] font-510 italic tracking-[0.02em] text-brand/90">
        Description
      </h3>
      <p class="mt-3 leading-6 text-text-primary">{@approval.description}</p>
    </div>

    <div class="card-lift rounded-xl border border-border bg-panel p-6 shadow-card">
      <h3 class="mb-4 font-serif text-[13px] font-510 italic tracking-[0.02em] text-brand/90">
        Details
      </h3>
      <dl class="divide-y divide-border">
        <div class="flex justify-between py-2.5">
          <dt class="text-sm text-text-secondary">Category</dt>
          <dd class="text-sm font-510 text-text-primary">
            {category_label(@approval.category)}
          </dd>
        </div>
        <div class="flex items-center justify-between py-2.5">
          <dt class="text-sm text-text-secondary">Status</dt>
          <dd class={"rounded border px-2 py-0.5 text-sm font-510 #{status_badge(@approval.status)}"}>
            {String.upcase(@approval.status)}
          </dd>
        </div>
        <div class="flex justify-between py-2.5">
          <dt class="text-sm text-text-secondary">Requested By</dt>
          <dd class="text-sm text-text-primary">
            <%= if @approval.requested_by do %>
              {@approval.requested_by.name}
            <% else %>
              System
            <% end %>
          </dd>
        </div>
        <div class="flex justify-between py-2.5">
          <dt class="text-sm text-text-secondary">Review Deadline</dt>
          <dd class="font-serif text-sm tabular-nums text-text-primary">
            {format_datetime(@approval.review_deadline)}
          </dd>
        </div>
      </dl>
      <%= if @approval.decision_reasoning do %>
        <div class="mt-4 border-t border-border pt-4">
          <span class="text-sm text-text-secondary">Decision Reasoning</span>
          <p class="mt-1 text-sm leading-6 text-text-primary">{@approval.decision_reasoning}</p>
        </div>
      <% end %>
    </div>

    <%= if @approval.status == "pending" && @board_member? && !@voted? do %>
      <form
        id="vote"
        phx-submit="cast_vote"
        class="card-lift rounded-xl border border-border bg-panel p-6 shadow-card"
      >
        <h3 class="mb-4 font-serif text-[13px] font-510 italic tracking-[0.02em] text-brand/90">
          Cast your vote
        </h3>
        <label for="vote-reason" class="text-sm text-text-secondary">
          Your reason (optional, saved with your vote)
        </label>
        <textarea
          id="vote-reason"
          name="reason"
          rows="2"
          class="mb-4 mt-1.5 w-full resize-y rounded-lg border border-border bg-surface px-3 py-2 text-sm text-text-primary"
        ></textarea>
        <div class="flex flex-wrap gap-2">
          <button
            type="submit"
            name="vote"
            value="approve"
            class="btn-press inline-flex h-11 sm:h-10 items-center justify-center gap-2 rounded-lg bg-emerald-600 px-4 text-sm font-590 text-on-primary transition-colors hover:bg-emerald-700"
          >
            Approve
          </button>
          <button
            type="submit"
            name="vote"
            value="deny"
            class="btn-press inline-flex h-11 sm:h-10 items-center justify-center gap-2 rounded-lg border border-red-500/30 bg-red-500/10 px-4 text-sm font-590 text-red-300 transition-colors hover:bg-red-500/20"
          >
            Deny
          </button>
          <button
            type="submit"
            name="vote"
            value="abstain"
            class="btn-press inline-flex h-11 sm:h-10 items-center justify-center gap-2 rounded-lg border border-border bg-surface px-4 text-sm font-590 text-text-secondary transition-colors hover:bg-surface-hover hover:text-text-primary"
          >
            Abstain
          </button>
        </div>
      </form>
    <% end %>

    <%= if length(@approval.votes) > 0 do %>
      <div class="card-lift rounded-xl border border-border bg-panel p-6 shadow-card">
        <h3 class="mb-4 font-serif text-[13px] font-510 italic tracking-[0.02em] text-brand/90">
          Votes
        </h3>
        <div class="divide-y divide-border">
          <%= for vote <- @approval.votes do %>
            <div
              id={"board-vote-#{vote.id}"}
              class="flex items-start justify-between gap-4 py-2.5"
            >
              <div class="min-w-0">
                <span class="text-sm text-text-primary">
                  {(vote.user && vote.user.name) || "A former member"}
                </span>
                <p
                  :if={vote.reasoning}
                  data-vote-reason
                  class="mt-1 break-words text-sm leading-6 text-text-secondary"
                >
                  {vote.reasoning}
                </p>
              </div>
              <span class={
                  "shrink-0 rounded border px-2 py-1 text-xs font-510 " <>
                    (case vote.vote do
                      "approve" -> "bg-green-500/10 text-green-500 border-green-500/20"
                      "deny" -> "bg-brand/10 text-brand border-brand/20"
                      "abstain" -> "bg-gray-500/10 text-gray-500 border-gray-500/20"
                      _ -> "bg-gray-500/10 text-gray-500 border-gray-500/20"
                    end)
                }>
                {String.upcase(vote.vote)}
              </span>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</.page_frame>
