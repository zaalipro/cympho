<% pending? = @approval.status == "pending" %>
<% vote? = pending? && @board_member? && !@voted? %>
<% requester = (@approval.requested_by && @approval.requested_by.name) || "System" %>
<% metrics = @governance_risk.metrics %>

<.page_frame
  page="board-vote"
  kind={:deep}
  parent={{"/inbox", "Inbox"}}
  current={@approval.title}
  from={@from}
  tray_class="split"
  data-ui-complex-page
>
  <:head>
    <section class="head" aria-labelledby="bv-h">
      <h1 class="h1 big" id="bv-h">{@approval.title}</h1>
      <p class="sub">
        Board decision <span aria-hidden="true">·</span>
        {category_label(@approval.category)} <span aria-hidden="true">·</span>
        <span class="nw">
          Filed {day(@approval.inserted_at)}
          <span class="mono">{clock(@approval.inserted_at)}</span>
        </span>
      </p>
      <div class="chips">
        <span class={["chip", pending? && "st-wait"]}>
          <.status_word
            kind={elem(status(@approval.status), 0)}
            word={elem(status(@approval.status), 1)}
          />
        </span>
      </div>
      <.flash_line flash={@flash} />
    </section>
  </:head>

  <%!-- The vote (the Next step): the request, then the vote with its reason. Approve is the one primary. --%>
  <.next_step :if={vote?} id="bv-ns-">
    <:problem>
      <.problem_card title="Cast your vote" title_id="bv-ns-t">
        <:eyebrow>Next step<span aria-hidden="true"> · </span>Board vote</:eyebrow>
        <p class="obj">{@approval.description}</p>
        <:foot>
          <span class="who">
            <span class="tile-ag sm" aria-hidden="true">
              {CymphoWeb.AgentLive.Parts.initials(requester)}
            </span>
            <span>
              Requested by
              <b>{requester}</b><span :if={@approval.review_deadline}><span aria-hidden="true"> · </span>decide by
                <span class="mono">{day(@approval.review_deadline)} {clock(@approval.review_deadline)}</span></span>
            </span>
          </span>
        </:foot>
      </.problem_card>
    </:problem>
    <:resolution>
      <.ink_card form="Your vote" id="vote" phx-submit="cast_vote">
        <h3 class="ink-h">Your vote</h3>
        <.input
          type="textarea"
          id="vote-reason"
          name="reason"
          value=""
          rows={2}
          label="Your reason (optional, saved with your vote)"
        />
        <.ink_foot verb="approve">
          <:secondary>
            <.ghost_pill type="submit" name="vote" value="deny">Deny</.ghost_pill>
            <.ghost_pill type="submit" name="vote" value="abstain">Abstain</.ghost_pill>
          </:secondary>
          <:primary>
            <.primary_pill type="submit" name="vote" value="approve">Approve</.primary_pill>
          </:primary>
        </.ink_foot>
      </.ink_card>
    </:resolution>
  </.next_step>

  <.band_card id="bv-risk-t" title="Governance risk" data-testid="governance-risk-brief">
    <:header_end>
      <span class="bv-st">
        <.status_word
          kind={risk_kind(@governance_risk.level)}
          word={@governance_risk.label}
        />
      </span>
    </:header_end>
    <div class="gl-sec">
      <p class="gl-big">{@governance_risk.summary}</p>
      <p class="gl-sub">{@governance_risk.next_action}</p>
    </div>
    <div class="strip s4">
      <div class="cell">
        <span class="v mono">{metrics.approve_votes}</span><span class="l">Approve</span>
      </div>
      <div class="cell">
        <span class="v mono">{metrics.deny_votes}</span><span class="l">Deny</span>
      </div>
      <div class="cell">
        <span class="v mono">{metrics.missing_votes}</span><span class="l">Missing</span>
      </div>
      <div class="cell">
        <span class="v mono">{metrics.audit_events}</span><span class="l">Audit</span>
      </div>
    </div>
    <ul class="rows ui-advanced-only">
      <.list_row
        :for={{signal, n} <- Enum.with_index(@governance_risk.signals)}
        id={"bv-signal-#{n}"}
        title={signal.label}
        status={signal_status(signal.tone)}
      >
        <:meta>{signal.detail}</:meta>
      </.list_row>
    </ul>
  </.band_card>

  <.band_card :if={!vote?} id="bv-req-t" title="Request">
    <p class="bv-desc">{@approval.description}</p>
  </.band_card>

  <.band_card :if={@approval.votes != []} id="bv-votes-t" title="Votes">
    <:header_end><span class="meta mono">{length(@approval.votes)}</span></:header_end>
    <ul class="rows">
      <.list_row
        :for={vote <- @approval.votes}
        id={"board-vote-#{vote.id}"}
        title={(vote.user && vote.user.name) || "A former member"}
        status={vote_status(vote.vote)}
      >
        <:meta :if={vote.reasoning}><span data-vote-reason>{vote.reasoning}</span></:meta>
      </.list_row>
    </ul>
  </.band_card>

  <.band_card id="bv-det-t" title="Details" class="aside">
    <.kv_list>
      <:item term="Category">{category_label(@approval.category)}</:item>
      <:item term="Requested by">{requester}</:item>
      <:item :if={@approval.review_deadline} term="Decide by">
        {day(@approval.review_deadline)}
        <span class="mono">{clock(@approval.review_deadline)}</span>
      </:item>
      <:item :if={@approval.decision_reasoning} term="Decision reason">
        {@approval.decision_reasoning}
      </:item>
    </.kv_list>
  </.band_card>
</.page_frame>
