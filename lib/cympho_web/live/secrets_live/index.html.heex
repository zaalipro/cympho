<.settings_layout active={:secrets}>
  <.header title={@page_title}>
    <:actions>
      <button
        type="button"
        phx-click="show_create_form"
        class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg text-sm font-medium transition-colors"
      >
        Add Secret
      </button>
    </:actions>
  </.header>

  <div
    :if={@secret_action_error}
    data-testid="secret-action-error"
    class="mb-4 rounded-lg border border-red-500/25 bg-red-500/10 px-4 py-3 text-sm text-red-200"
  >
    {@secret_action_error}
  </div>

  <%= if @show_form do %>
    <.live_component
      module={CymphoWeb.SecretsLive.FormComponent}
      id={if @form_mode == :edit, do: "edit-#{@selected_secret.id}", else: "new"}
      secret={@selected_secret}
      form_mode={@form_mode}
      company_id={@company_id}
      prefill={@secret_prefill}
      return_to={@secret_prefill["return_to"]}
      on_cancel={JS.push("hide_form")}
    />
  <% end %>

  <section
    id="runtime-credential-guide"
    data-testid="runtime-credential-guide"
    class="ui-advanced-only mb-4 overflow-hidden rounded-lg border border-border bg-panel"
  >
    <div class="border-b border-border bg-gradient-to-b from-surface-2/50 to-transparent px-5 py-4">
      <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
        <div class="min-w-0">
          <div class="flex flex-wrap items-center gap-2">
            <p class="text-[11px] font-590 uppercase tracking-[0.14em] text-text-quaternary">
              Runtime credential cockpit
            </p>
            <span class={[
              "rounded-full border px-2 py-0.5 text-[11px] font-510",
              runtime_credential_badge_class(@runtime_credential_guide.status)
            ]}>
              {@runtime_credential_guide.ready_count} of {@runtime_credential_guide.total_count} ready
            </span>
          </div>
          <h2 class="mt-2 text-lg font-590 tracking-tight text-text-primary">
            Provider coverage for autonomous agents
          </h2>
          <p class="mt-1 max-w-2xl text-sm leading-5 text-text-tertiary">
            {@runtime_credential_guide.summary}
          </p>
        </div>
        <button
          type="button"
          phx-click="show_create_form"
          class="inline-flex shrink-0 items-center justify-center gap-2 rounded-lg border border-border bg-surface px-3 py-2 text-sm font-510 text-text-secondary transition hover:border-border-hover hover:bg-surface-hover hover:text-text-primary"
        >
          <.icon name="hero-plus" class="h-4 w-4" /> Add any secret
        </button>
      </div>
    </div>

    <div class="grid gap-3 p-4 xl:grid-cols-2">
      <article
        :for={profile <- @runtime_credential_guide.profiles}
        data-testid={"runtime-credential-profile-#{profile.id}"}
        class={[
          "rounded-lg border p-4 transition-colors",
          credential_profile_class(profile.ready)
        ]}
      >
        <div class="flex items-start justify-between gap-3">
          <div class="flex min-w-0 gap-3">
            <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-border bg-panel text-text-secondary">
              <span class={[profile.icon, "h-4 w-4"]}></span>
            </div>
            <div class="min-w-0">
              <div class="flex flex-wrap items-center gap-2">
                <h3 class="text-sm font-590 text-text-primary">{profile.title}</h3>
                <span class={[
                  "rounded-full border px-2 py-0.5 text-[11px] font-510",
                  credential_profile_status_class(profile.ready)
                ]}>
                  {profile.status_label}
                </span>
              </div>
              <p class="mt-1 text-sm leading-5 text-text-tertiary">{profile.summary}</p>
            </div>
          </div>
        </div>

        <dl class="mt-3 grid gap-2 sm:grid-cols-2">
          <div class="rounded-md border border-border bg-canvas/60 px-3 py-2">
            <dt class="text-[10px] font-590 uppercase tracking-[0.1em] text-text-quaternary">
              Profile
            </dt>
            <dd class="mt-1 break-words text-xs text-text-secondary">{profile.profile}</dd>
          </div>
          <div class="rounded-md border border-border bg-canvas/60 px-3 py-2">
            <dt class="text-[10px] font-590 uppercase tracking-[0.1em] text-text-quaternary">
              Model
            </dt>
            <dd class="mt-1 break-words text-xs text-text-secondary">{profile.model}</dd>
          </div>
          <div class="rounded-md border border-border bg-canvas/60 px-3 py-2 sm:col-span-2">
            <dt class="text-[10px] font-590 uppercase tracking-[0.1em] text-text-quaternary">
              Endpoint
            </dt>
            <dd class="mt-1 break-words text-xs text-text-secondary">{profile.endpoint}</dd>
          </div>
        </dl>

        <div class="mt-3 flex flex-col gap-2 border-t border-border pt-3 sm:flex-row sm:items-center sm:justify-between">
          <p class="text-xs leading-5 text-text-tertiary">{profile.status_detail}</p>
          <.link
            :if={!profile.ready}
            patch={profile.setup_path}
            class="inline-flex shrink-0 items-center justify-center gap-1.5 rounded-md border border-brand/25 bg-brand/10 px-2.5 py-1.5 text-xs font-510 text-brand transition hover:bg-brand/15"
          >
            <.icon name="hero-plus" class="h-3.5 w-3.5" /> Add key
          </.link>
        </div>
      </article>
    </div>
  </section>

  <div
    :if={@rotation_summary.total > 0}
    class="ui-advanced-only mb-4 rounded-lg border border-border bg-panel p-4"
  >
    <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <p class="text-xs font-590 uppercase tracking-[0.1em] text-text-quaternary">
          Rotation posture
        </p>
        <p class="mt-1 text-sm text-text-secondary">
          {@rotation_summary.needs_rotation} of {@rotation_summary.total} active secrets need rotation attention.
        </p>
      </div>
      <div class="grid grid-cols-3 overflow-hidden rounded-md border border-border bg-border text-center">
        <div class="bg-surface px-3 py-2">
          <p class="font-mono text-sm font-590 leading-none text-emerald-300">
            {@rotation_summary.fresh}
          </p>
          <p class="mt-1 text-[10px] font-590 uppercase tracking-[0.08em] text-text-quaternary">
            Fresh
          </p>
        </div>
        <div class="bg-surface px-3 py-2">
          <p class="font-mono text-sm font-590 leading-none text-amber-300">
            {@rotation_summary.due_soon}
          </p>
          <p class="mt-1 text-[10px] font-590 uppercase tracking-[0.08em] text-text-quaternary">
            Due
          </p>
        </div>
        <div class="bg-surface px-3 py-2">
          <p class="font-mono text-sm font-590 leading-none text-red-300">
            {@rotation_summary.overdue}
          </p>
          <p class="mt-1 text-[10px] font-590 uppercase tracking-[0.08em] text-text-quaternary">
            Overdue
          </p>
        </div>
      </div>
    </div>
  </div>
  
<!-- Secrets List -->
  <.infinite_scroll
    id="secrets"
    has_more={@infinite_scroll[:secrets][:has_more?] || false}
    container_class="space-y-4"
  >
    <:empty>
      <div class="flex flex-col items-center justify-center py-20 text-center">
        <div class="w-12 h-12 rounded-full bg-surface flex items-center justify-center mb-4">
          <svg
            class="w-6 h-6 text-text-tertiary"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"
            />
          </svg>
        </div>
        <div class="mb-4 max-w-md">
          <p class="text-sm font-590 text-text-primary">No runtime secrets stored yet</p>
          <p class="mt-1 text-sm leading-5 text-text-tertiary">
            Add a company-scoped provider key before assigning autonomous work. Runtime preflight uses these encrypted secrets to inject agent credentials.
          </p>
        </div>
        <button
          type="button"
          phx-click="show_create_form"
          class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg text-sm font-medium transition-colors"
        >
          Add runtime secret
        </button>
      </div>
    </:empty>

    <div
      :for={{dom_id, secret} <- @streams.secrets}
      id={dom_id}
      data-testid={"secret-row-#{secret.id}"}
      class="border border-border rounded-lg p-4 hover:bg-subtle transition-colors"
    >
      <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
        <div class="min-w-0 flex-1">
          <% rotation = secret_rotation(secret) %>
          <div class="mb-2 flex flex-wrap items-center gap-2">
            <h3 class="break-all font-serif text-lg font-semibold text-text-primary">
              {secret.key}
            </h3>
            <span class={[
              "text-xs px-2 py-0.5 rounded-full font-medium",
              scope_badge_class(secret.scope)
            ]}>
              {format_scope(secret.scope)}
            </span>
            <span class="text-xs text-text-quaternary">
              v{secret.version}
            </span>
            <span class={[
              "rounded-full border px-2 py-0.5 text-xs font-medium",
              rotation_badge_class(rotation.status)
            ]}>
              {rotation_status_label(rotation)}
            </span>
          </div>

          <p :if={secret.description} class="text-sm text-text-secondary mb-2">
            {secret.description}
          </p>

          <div class="ui-advanced-only text-xs leading-5 text-text-quaternary">
            Created: {Calendar.strftime(secret.inserted_at, "%b %d, %Y %H:%M")}
            <span class="mx-2">•</span>
            Updated: {Calendar.strftime(secret.updated_at, "%b %d, %Y %H:%M")}
          </div>
        </div>

        <div class="flex shrink-0 justify-end self-end sm:self-auto">
          <.overflow_menu
            label={"Manage #{secret.key}"}
            trigger_text="Manage"
            data-testid={"secret-manage-menu-#{secret.id}"}
          >
            <.menu_item phx-click="show_versions" phx-value-id={secret.id}>
              Version history
            </.menu_item>
            <.menu_item phx-click="show_edit_form" phx-value-id={secret.id}>
              Edit details
            </.menu_item>
            <.menu_item phx-click="rotate" phx-value-id={secret.id}>
              Rotate secret
            </.menu_item>
            <.menu_item
              danger
              phx-click="delete"
              phx-value-id={secret.id}
              data-confirm={"Delete #{secret.key}? Agents using this #{String.downcase(format_scope(secret.scope))}-scoped credential will fail runtime preflight until a replacement is stored."}
            >
              Delete secret
            </.menu_item>
          </.overflow_menu>
        </div>
      </div>
    </div>
  </.infinite_scroll>
  
<!-- Version History Modal -->
  <.modal
    :if={@show_versions}
    id="versions-modal"
    show={@show_versions}
    on_cancel={JS.push("hide_versions")}
    title="Version History"
  >
    <div class="space-y-3">
      <div :if={@versions == []} class="text-center py-8 text-text-tertiary">
        No version history available.
      </div>

      <div
        :for={version <- @versions}
        class="flex items-center justify-between p-3 bg-subtle rounded-lg"
      >
        <div>
          <div class="flex items-center gap-2 mb-1">
            <span class="text-sm font-medium text-text-primary">
              {version.key}
            </span>
            <span class="text-xs text-text-quaternary">
              v{version.version}
            </span>
            <span
              :if={!version.is_active}
              class="text-xs px-2 py-0.5 rounded-full bg-gray-500/20 text-gray-400"
            >
              Inactive
            </span>
          </div>
          <div class="text-xs text-text-quaternary">
            Created: {Calendar.strftime(version.inserted_at, "%b %d, %Y %H:%M")}
          </div>
        </div>
      </div>
    </div>

    <:footer>
      <button
        type="button"
        phx-click="hide_versions"
        class="px-4 py-2 bg-surface hover:bg-surface-hover text-text-secondary rounded-lg text-sm font-medium transition-colors"
      >
        Close
      </button>
    </:footer>
  </.modal>
</.settings_layout>
