<.settings_layout active={:secrets}>
  <.flash_line flash={@flash} />
  <p :if={@secret_action_error} class="err" role="alert" data-testid="secret-action-error">
    <.r3_icon name="i-alert" />{@secret_action_error}
  </p>

  <%= if @show_form and @can_manage_secrets do %>
    <.live_component
      module={CymphoWeb.SecretsLive.FormComponent}
      id={if @form_mode == :edit, do: "edit-#{@selected_secret.id}", else: "new"}
      secret={@selected_secret}
      form_mode={@form_mode}
      company_id={@company_id}
      current_user_id={@current_user.id}
      prefill={@secret_prefill}
      return_to={@secret_prefill["return_to"]}
      on_cancel={JS.push("hide_form")}
    />
  <% end %>

  <.band_card id="se-t" title="Keys and secrets">
    <:header_end>
      <%!-- While the list is empty its quiet line carries the one Add control. --%>
      <.pill
        :if={@can_manage_secrets and !@show_form and @rotation_summary.total > 0}
        phx-click="show_create_form"
      >
        <.r3_icon name="i-plus" />Add secret
      </.pill>
    </:header_end>
    <.infinite_scroll
      id="secrets"
      has_more={@infinite_scroll[:secrets][:has_more?] || false}
      container_class="rows"
    >
      <:empty>
        <.quiet_empty title="No keys or secrets yet">
          <span class="ui-advanced-only">
            Add a company-scoped provider key before assigning autonomous work. Runtime preflight uses these encrypted secrets to inject agent credentials.
          </span>
          <span class="ui-simple-only">
            Add your AI provider's API key here so your agents can start working.
          </span>
          <:action>
            <.pill :if={@can_manage_secrets and !@show_form} phx-click="show_create_form">
              <.r3_icon name="i-plus" />Add secret
            </.pill>
          </:action>
        </.quiet_empty>
      </:empty>

      <.list_row
        :for={{dom_id, secret} <- @streams.secrets}
        tag="div"
        id={dom_id}
        data-testid={"secret-row-#{secret.id}"}
        icon="i-shield"
        title={secret.key}
        status={rotation_status(secret_rotation(secret))}
      >
        <:meta>
          <span :if={secret.description}>
            {secret.description}<span aria-hidden="true"> · </span>
          </span>
          <span class="tag">{format_scope(secret.scope)}</span><span aria-hidden="true"> · </span><span class="mono">v{secret.version}</span>
        </:meta>
        <:actions>
          <.overflow_menu
            id={"secret-menu-#{secret.id}"}
            label={"Manage #{secret.key}"}
            trigger_text="Manage"
            data-testid={"secret-manage-menu-#{secret.id}"}
          >
            <.menu_item phx-click="show_versions" phx-value-id={secret.id}>
              Version history
            </.menu_item>
            <.menu_item
              :if={@can_manage_secrets}
              phx-click="show_edit_form"
              phx-value-id={secret.id}
            >
              Edit details
            </.menu_item>
            <.menu_item :if={@can_manage_secrets} phx-click="rotate" phx-value-id={secret.id}>
              Rotate secret
            </.menu_item>
            <.menu_item
              :if={@can_manage_secrets}
              danger
              phx-click="delete"
              phx-value-id={secret.id}
              data-confirm={"Delete #{secret.key}? Agents using this #{String.downcase(format_scope(secret.scope))}-scoped credential will fail runtime preflight until a replacement is stored."}
            >
              Delete secret
            </.menu_item>
          </.overflow_menu>
        </:actions>
      </.list_row>
    </.infinite_scroll>
    <p :if={!@can_manage_secrets} class="cfoot" data-testid="secrets-read-only">
      <span>
        Secret metadata is read-only. Only company owners, admins, and board members can make changes.
      </span>
    </p>
  </.band_card>

  <div class="ui-advanced-only">
    <.band_card
      id="rc-t"
      title="Runtime credentials"
      section_id="runtime-credential-guide"
      data-testid="runtime-credential-guide"
    >
      <:header_end>
        <span class="meta mono">
          {@runtime_credential_guide.ready_count} of {@runtime_credential_guide.total_count} ready
        </span>
      </:header_end>
      <p class="gl-sub rc-l">{@runtime_credential_guide.summary}</p>
      <ul class="rows">
        <.list_row
          :for={profile <- @runtime_credential_guide.profiles}
          id={"runtime-credential-#{profile.id}"}
          data-testid={"runtime-credential-profile-#{profile.id}"}
          icon="i-term"
          title={profile.title}
          status={if profile.ready, do: {:done, "Ready"}, else: {:waiting, "Needs a key"}}
        >
          <:meta>
            {profile.status_detail}<span aria-hidden="true"> · </span>{profile.model}<span aria-hidden="true"> · </span>{profile.endpoint}
          </:meta>
          <:actions :if={@can_manage_secrets and !profile.ready}>
            <.pill patch={profile.setup_path}><.r3_icon name="i-plus" />Add key</.pill>
          </:actions>
        </.list_row>
      </ul>
    </.band_card>
  </div>

  <div :if={@rotation_summary.total > 0} class="ui-advanced-only">
    <.band_card id="ro-t" title="Rotation status">
      <p class="gl-sub rc-l">
        {@rotation_summary.needs_rotation} of {@rotation_summary.total} active secrets need rotation attention.
      </p>
      <div class="strip s3">
        <div class="cell">
          <p class="v mono">{@rotation_summary.fresh}</p>
          <p class="l">Fresh</p>
        </div>
        <div class="cell">
          <p class="v mono">{@rotation_summary.due_soon}</p>
          <p class="l">Due</p>
        </div>
        <div class="cell">
          <p class="v mono">{@rotation_summary.overdue}</p>
          <p class="l">Overdue</p>
        </div>
      </div>
    </.band_card>
  </div>

  <.modal
    :if={@show_versions}
    id="versions-modal"
    show={@show_versions}
    on_cancel={JS.push("hide_versions")}
    title="Version history"
  >
    <.quiet_empty :if={@versions == []} title="No version history available." />
    <ul :if={@versions != []} class="rows">
      <.list_row
        :for={version <- @versions}
        id={"secret-version-#{version.id}"}
        title={"#{version.key} v#{version.version}"}
      >
        <:meta>
          Created {Calendar.strftime(version.inserted_at, "%a %-d %b")}
          <span class="mono">{Calendar.strftime(version.inserted_at, "%H:%M")}</span>
        </:meta>
        <:trail :if={!version.is_active}><span class="tag">Inactive</span></:trail>
      </.list_row>
    </ul>
    <:footer>
      <.pill phx-click="hide_versions">Close</.pill>
    </:footer>
  </.modal>
</.settings_layout>
