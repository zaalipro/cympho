[Unit]
Description=Cympho (Phoenix release)
After=network-online.target cympho-git-agent.service
Wants=network-online.target cympho-git-agent.service
# PostgreSQL runs natively on the host. Docker is build-only and is not a
# runtime dependency of the release service.

[Service]
Type=simple
User=cympho
Group=cympho
WorkingDirectory=/opt/cympho/current
Environment=MIX_ENV=prod
Environment=PORT=4000
# Keep the release's runtime pipe under the service's private /tmp so it works
# regardless of ProtectSystem restrictions on /opt.
Environment=RELEASE_TMP=/tmp
# Agent runtime (Claude Code CLI). ProtectHome=true hides /home, so the CLI and
# its mutable config home lives under /opt/cympho/claude-home. The command and
# release payload remain root-owned and read-only to this service. The
# provider base URL + auth token come from /etc/cympho.env (ANTHROPIC_*).
Environment=HOME=/opt/cympho/claude-home
Environment=CYMPHO_CLAUDE_COMMAND=/opt/cympho/bin/claude
Environment=CYMPHO_CODEX_SSH_AUTH_SOCK=/run/cympho-git-agent/agent.sock
Environment=CYMPHO_CODEX_KNOWN_HOSTS=/opt/cympho/claude-home/.ssh/known_hosts
EnvironmentFile=/etc/cympho.env
# Optional deployment-specific Git transport. Keep repo-scoped deploy keys and
# their absolute Git/SSH settings out of the release and the agent's isolated
# HOME. Missing files are intentionally ignored.
EnvironmentFile=-/etc/cympho-git.env
ExecStart=/opt/cympho/current/bin/cympho start
ExecStop=/opt/cympho/current/bin/cympho stop
Restart=on-failure
RestartSec=10
LimitNOFILE=65536

# Hardening — only explicit persistent runtime state is writable. Release
# payloads, the current symlink, and /opt/cympho/bin stay root-owned/read-only.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/cympho/data/uploads /opt/cympho/data/import-transfers /opt/cympho/claude-home

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
